{%- doc -%}
  Self-hosted MG fonts (latin subsets in theme assets), rendered once in <head> from
  layout/theme.liquid, before the stylesheets.

  - Prompt 400/500/600: UI and body (--mg-font-ui). Horizon's body, subheading, heading and
    accent font variables are pointed at it in assets/mg-theme.css.
  - Source Serif 4 600 (normal + italic): display statements only (--mg-font-display). Static
    instances pinned at optical size 40 (the display sizes the theme uses, 30 to 60px), about
    21KB each instead of 52KB for the full opsz axis.

  Prompt 400 is preloaded on every page. Source Serif 4 600 normal is preloaded only where a
  serif heading is above the fold: the home page, collections and the MG page templates
  (page.<suffix>). Product, cart, search, blog and the plain page template never use it.

  @example
  {% render 'mg-fonts' %}
{%- enddoc -%}

{%- liquid
  assign preload_serif = false
  case template.name
    when 'index', 'collection'
      assign preload_serif = true
    when 'page'
      if template.suffix != blank
        assign preload_serif = true
      endif
  endcase

  assign latin_range = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
-%}

{{ 'mg-prompt-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- if preload_serif -%}
  {{ 'mg-source-serif-4-600-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endif -%}

<style>
  @font-face {
    font-family: 'Prompt';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'mg-prompt-400-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Prompt';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('{{ 'mg-prompt-500-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Prompt';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('{{ 'mg-prompt-600-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Source Serif 4';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('{{ 'mg-source-serif-4-600-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Source Serif 4';
    font-style: italic;
    font-weight: 600;
    font-display: swap;
    src: url('{{ 'mg-source-serif-4-600-italic.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }
</style>
