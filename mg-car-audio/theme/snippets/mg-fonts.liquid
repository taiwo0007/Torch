{%- doc -%}
  Self-hosted MG fonts (latin subsets in theme assets, SIL Open Font License), rendered once in
  <head> from layout/theme.liquid, before the stylesheets.

  - Barlow 400/500/600/700: UI and body (--mg-font-ui). Horizon's body, subheading, heading and
    accent font variables are pointed at it in assets/mg-theme.css.
  - Barlow Condensed 700 (normal + italic): display headings, uppercase section heads and page
    h1s (--mg-font-display), the bold condensed look car and audio shops use.

  Barlow 400 is preloaded on every page, Barlow Condensed 700 where a display heading is above
  the fold (home, collections and the MG page templates).

  @example
  {% render 'mg-fonts' %}
{%- enddoc -%}

{%- liquid
  assign preload_display = false
  case template.name
    when 'index', 'collection'
      assign preload_display = true
    when 'page'
      if template.suffix != blank
        assign preload_display = true
      endif
  endcase

  assign latin_range = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD'
-%}

{{ 'mg-barlow-400-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- if preload_display -%}
  {{ 'mg-barlow-condensed-700-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{%- endif -%}

<style>
  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'mg-barlow-400-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('{{ 'mg-barlow-500-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('{{ 'mg-barlow-600-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('{{ 'mg-barlow-700-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Barlow Condensed';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('{{ 'mg-barlow-condensed-700-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }

  @font-face {
    font-family: 'Barlow Condensed';
    font-style: italic;
    font-weight: 700;
    font-display: swap;
    src: url('{{ 'mg-barlow-condensed-700-italic.woff2' | asset_url }}') format('woff2');
    unicode-range: {{ latin_range }};
  }
</style>
