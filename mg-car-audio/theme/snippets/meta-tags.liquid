{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="#0b0d10"
>

{%- liquid
  # MG Car Audio: title and description logic.
  # Car make pages (template page.car-make): the car_make metaobject's seo_title /
  # seo_description win; otherwise, when the page's SEO title isn't customised,
  # use "<Make> CarPlay & Screen Upgrades in Dublin". Every title ends with
  # " | <shop name>" unless it already contains it (so the home page isn't doubled).
  # Nothing in this theme outputs a robots noindex tag.
  assign mg_title = page_title | default: shop.name
  assign mg_description = page_description
  if template.name == 'page' and template.suffix == 'car-make'
    assign mg_car_make = page.metafields.custom.car_make.value
    assign mg_make_first_word = page.title | strip | split: ' ' | first
    assign mg_make_name = mg_car_make.name.value | strip | default: mg_make_first_word
    assign mg_seo_title = mg_car_make.seo_title.value | strip
    assign mg_seo_description = mg_car_make.seo_description.value | strip
    if mg_seo_title != blank
      assign mg_title = mg_seo_title
    elsif page_title == page.title and mg_make_name != blank
      assign mg_title = mg_make_name | append: ' CarPlay & Screen Upgrades in Dublin'
    endif
    if mg_seo_description != blank
      assign mg_description = mg_seo_description
    elsif mg_description == blank and mg_make_name != blank
      assign mg_locality = settings.mg_locality | default: 'Dublin'
      assign mg_description = 'Apple CarPlay, Android Auto and screen upgrades for ' | append: mg_make_name | append: ', fitted in-house in ' | append: mg_locality | append: '. Book a fitting or get a quote on WhatsApp.'
    endif
  endif
  assign mg_title_suffix = ' | ' | append: shop.name
  if mg_title contains shop.name
    assign mg_title_suffix = ''
  endif

  assign og_title = mg_title | append: mg_title_suffix
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = mg_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ mg_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {{- mg_title_suffix -}}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if mg_description != blank %}
  <meta
    name="description"
    content="{{ mg_description | escape }}"
  >
{% endif %}
