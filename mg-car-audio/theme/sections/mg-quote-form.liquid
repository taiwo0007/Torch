{%- liquid
  assign section_classes = 'mg-section mg-quote'
  if section.settings.background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--surface'
  endif
  if section.settings.spacing == 'tight'
    assign section_classes = section_classes | append: ' mg-section--tight'
  endif

  assign heading_tag = 'h2'
  assign sub_tag = 'h3'
  assign minor_tag = 'h4'
  if section.settings.heading_is_h1
    assign heading_tag = 'h1'
    assign sub_tag = 'h2'
    assign minor_tag = 'h3'
  endif

  assign heading = section.settings.heading
  if section.settings.use_page_title and page.title != blank
    assign heading = page.title
  endif

  assign uid = 'MgQuote-' | append: section.id
  assign form_id = 'MgQuoteForm-' | append: section.id
  assign heading_id = uid | append: '-heading'

  assign wa_number = settings.mg_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign business_name = settings.mg_business_name | default: shop.name
  assign fallback_photo_message = 'Hi ' | append: business_name | append: ", here's a photo of my dash."
  assign photo_message = section.settings.photo_message | strip | default: fallback_photo_message
  assign encoded_message = photo_message | url_encode
  assign photo_href = 'https://wa.me/' | append: wa_number | append: '?text=' | append: encoded_message

  assign show_photo = false
  if section.settings.show_whatsapp_photo_step and wa_number != blank
    assign show_photo = true
  endif

  assign make_lines = section.settings.make_list | newline_to_br | split: '<br />'
  assign service_lines = section.settings.service_list | newline_to_br | split: '<br />'
-%}

{%- capture photo_step -%}
  <div class="mg-quote__photo">
    <span class="mg-quote__photo-icon">{%- render 'mg-icon', icon: 'camera' -%}</span>
    <div class="mg-quote__photo-body">
      {%- if section.settings.photo_text != blank -%}
        <p class="mg-quote__photo-text">{{ section.settings.photo_text | escape }}</p>
      {%- endif -%}
      <a
        class="mg-btn mg-btn--whatsapp mg-quote__photo-btn"
        href="{{ photo_href }}"
        target="_blank"
        rel="noopener"
        data-mg-wa-photo
        aria-describedby="{{ uid }}-photo-note"
      >
        {%- render 'mg-icon', icon: 'whatsapp' -%}
        <span>{{ section.settings.photo_button_label | default: 'Send photo on WhatsApp' | escape }}</span>
        <span class="mg-visually-hidden">(opens WhatsApp in a new tab)</span>
      </a>
      <p
        class="mg-quote__photo-note"
        id="{{ uid }}-photo-note"
      >
        Opens WhatsApp with your car details filled in. Nothing is sent until you press send.
      </p>
    </div>
  </div>
{%- endcapture -%}

<section
  class="{{ section_classes }}"
  {% if heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="mg-container mg-quote__layout">
    <header class="mg-quote__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mg-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <{{ heading_tag }}
          id="{{ heading_id }}"
          class="mg-heading mg-quote__heading"
        >
          {{- heading | escape -}}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="mg-lede mg-quote__lede">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="mg-quote__main">
      <mg-quote-form
        class="mg-card mg-quote__card"
        data-section-id="{{ section.id }}"
        data-wa-number="{{ wa_number | escape }}"
        data-wa-message="{{ photo_message | escape }}"
      >
        {%- form 'contact', id: form_id, class: 'mg-quote__form' -%}
          <input
            type="hidden"
            name="contact[id]"
            value="{{ form_id }}"
          >
          <input
            type="hidden"
            name="contact[Enquiry]"
            value="{{ section.settings.enquiry_type | default: 'Quote request (website)' | escape }}"
          >

          {%- liquid
            assign form_matches = false
            if form.id == form_id or form.id == blank
              assign form_matches = true
            endif

            assign is_success = false
            if form.posted_successfully? and form_matches
              assign is_success = true
            endif

            assign has_errors = false
            if form.errors and form_matches
              assign has_errors = true
            endif

            assign email_invalid = false
            if has_errors and form.errors contains 'email'
              assign email_invalid = true
            endif
          -%}

          {%- if is_success -%}
            <div
              class="mg-quote__status mg-quote__status--success"
              tabindex="-1"
              autofocus
              data-mg-quote-status
              data-state="success"
              aria-labelledby="{{ uid }}-success-title"
            >
              <span class="mg-quote__status-icon">{%- render 'mg-icon', icon: 'check' -%}</span>
              <{{ sub_tag }}
                id="{{ uid }}-success-title"
                class="mg-quote__status-title"
              >
                {{- section.settings.success_heading | default: 'Thanks, your request is in' | escape -}}
              </{{ sub_tag }}>
              {%- if section.settings.success_text != blank -%}
                <p class="mg-quote__status-text">{{ section.settings.success_text }}</p>
              {%- endif -%}

              {%- if show_photo -%}
                <div class="mg-quote__status-photo">
                  <p class="mg-quote__label-row">
                    <span class="mg-quote__step-no" aria-hidden="true">+</span>
                    <span>{{ section.settings.photo_heading | default: 'Add a photo of your dash' | escape }}</span>
                  </p>
                  {{ photo_step }}
                </div>
              {%- endif -%}

              <div class="mg-quote__status-actions">
                {%- if settings.mg_phone_e164 != blank -%}
                  <a
                    class="mg-btn mg-btn--ghost"
                    href="tel:+{{ settings.mg_phone_e164 }}"
                  >
                    {%- render 'mg-icon', icon: 'phone' -%}
                    <span>Call {{ settings.mg_phone_display | escape }}</span>
                  </a>
                {%- endif -%}
                <a
                  class="mg-quote__again"
                  href="{{ request.path }}"
                >
                  Send another request
                </a>
              </div>
            </div>
          {%- else -%}
            <div class="mg-quote__card-head">
              {%- if section.settings.form_heading != blank -%}
                <{{ sub_tag }} class="mg-quote__card-title">{{ section.settings.form_heading | escape }}</{{ sub_tag }}>
              {%- endif -%}
              {%- if section.settings.form_text != blank -%}
                <p class="mg-quote__card-text">{{ section.settings.form_text | escape }}</p>
              {%- endif -%}
              <p class="mg-quote__required-note">
                Fields marked <span class="mg-quote__req" aria-hidden="true">*</span
                ><span class="mg-visually-hidden">with an asterisk</span> are required.
              </p>
            </div>

            {%- if has_errors -%}
              <div
                class="mg-quote__status mg-quote__status--error"
                tabindex="-1"
                autofocus
                data-mg-quote-status
                data-state="error"
                aria-labelledby="{{ uid }}-error-title"
              >
                <p
                  id="{{ uid }}-error-title"
                  class="mg-quote__status-title"
                >
                  We couldn't send that yet. Please check the details below.
                </p>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <fieldset class="mg-quote__group">
              <legend class="mg-quote__legend">
                <span class="mg-quote__label-row">
                  <span class="mg-quote__step-no" aria-hidden="true">01</span>
                  <span>About you</span>
                </span>
              </legend>
              <div class="mg-quote__grid">
                <div class="mg-quote__field mg-quote__field--full">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-name"
                  >
                    Your name <span class="mg-quote__req" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="mg-quote__input"
                    type="text"
                    id="{{ uid }}-name"
                    name="contact[name]"
                    autocomplete="name"
                    required
                    aria-required="true"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  >
                </div>

                <div class="mg-quote__field">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-phone"
                  >
                    Mobile number <span class="mg-quote__req" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="mg-quote__input"
                    type="tel"
                    id="{{ uid }}-phone"
                    name="contact[phone]"
                    autocomplete="tel"
                    inputmode="tel"
                    required
                    aria-required="true"
                    aria-describedby="{{ uid }}-phone-hint"
                    placeholder="e.g. 087 123 4567"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  >
                  <p
                    class="mg-quote__hint"
                    id="{{ uid }}-phone-hint"
                  >
                    We'll call or WhatsApp you on this number.
                  </p>
                </div>

                <div class="mg-quote__field">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-email"
                  >
                    Email <span class="mg-quote__req" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="mg-quote__input"
                    type="email"
                    id="{{ uid }}-email"
                    name="contact[email]"
                    autocomplete="email"
                    spellcheck="false"
                    autocapitalize="off"
                    required
                    aria-required="true"
                    {% if email_invalid %}
                      aria-invalid="true"
                      aria-describedby="{{ uid }}-email-error {{ uid }}-email-hint"
                    {% else %}
                      aria-describedby="{{ uid }}-email-hint"
                    {% endif %}
                    placeholder="you@example.ie"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  >
                  {%- if email_invalid -%}
                    <p
                      class="mg-quote__field-error"
                      id="{{ uid }}-email-error"
                    >
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </p>
                  {%- endif -%}
                  <p
                    class="mg-quote__hint"
                    id="{{ uid }}-email-hint"
                  >
                    Your written quote is sent here.
                  </p>
                </div>
              </div>
            </fieldset>

            <fieldset class="mg-quote__group">
              <legend class="mg-quote__legend">
                <span class="mg-quote__label-row">
                  <span class="mg-quote__step-no" aria-hidden="true">02</span>
                  <span>Your car</span>
                </span>
              </legend>
              <div class="mg-quote__grid mg-quote__grid--car">
                <div class="mg-quote__field mg-quote__field--full">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-reg"
                  >
                    Registration number
                  </label>
                  <div class="mg-quote__plate">
                    <div class="mg-quote__plate-inner">
                      <span
                        class="mg-quote__plate-band"
                        aria-hidden="true"
                      >
                        <span class="mg-quote__plate-stars"></span>
                        IRL
                      </span>
                      <input
                        class="mg-quote__input mg-quote__input--plate"
                        type="text"
                        id="{{ uid }}-reg"
                        name="contact[Registration number]"
                        autocomplete="off"
                        autocapitalize="characters"
                        spellcheck="false"
                        maxlength="16"
                        aria-describedby="{{ uid }}-reg-hint"
                        placeholder="181-D-12345"
                      >
                    </div>
                  </div>
                  <p
                    class="mg-quote__hint"
                    id="{{ uid }}-reg-hint"
                  >
                    Irish or UK reg. We use it to check your car's exact spec and factory screen.
                  </p>
                </div>

                <div class="mg-quote__field">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-make"
                  >
                    Make
                  </label>
                  <div class="mg-quote__select">
                    <select
                      class="mg-quote__input mg-quote__input--select"
                      id="{{ uid }}-make"
                      name="contact[Car make]"
                      autocomplete="off"
                    >
                      <option value="">Select make</option>
                      {%- for line in make_lines -%}
                        {%- assign make = line | strip -%}
                        {%- if make != blank -%}
                          <option value="{{ make | escape }}">{{ make | escape }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                    {%- render 'mg-icon', icon: 'chevron-down', class: 'mg-quote__select-icon' -%}
                  </div>
                </div>

                <div class="mg-quote__field">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-model"
                  >
                    Model
                  </label>
                  <input
                    class="mg-quote__input"
                    type="text"
                    id="{{ uid }}-model"
                    name="contact[Car model]"
                    autocomplete="off"
                    placeholder="e.g. 3 Series (F30)"
                  >
                </div>

                <div class="mg-quote__field">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-year"
                  >
                    Year
                  </label>
                  <input
                    class="mg-quote__input"
                    type="text"
                    id="{{ uid }}-year"
                    name="contact[Car year]"
                    autocomplete="off"
                    inputmode="numeric"
                    pattern="[0-9]{4}"
                    maxlength="4"
                    title="Four digits, for example 2018"
                    placeholder="e.g. 2018"
                  >
                </div>
              </div>
            </fieldset>

            <fieldset class="mg-quote__group">
              <legend class="mg-quote__legend">
                <span class="mg-quote__label-row">
                  <span class="mg-quote__step-no" aria-hidden="true">03</span>
                  <span>What you need</span>
                </span>
              </legend>
              <div class="mg-quote__grid">
                <div class="mg-quote__field mg-quote__field--full">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-service"
                  >
                    Service
                  </label>
                  <div class="mg-quote__select">
                    <select
                      class="mg-quote__input mg-quote__input--select"
                      id="{{ uid }}-service"
                      name="contact[Service]"
                      autocomplete="off"
                    >
                      <option value="">Choose a service</option>
                      {%- for line in service_lines -%}
                        {%- assign service = line | strip -%}
                        {%- if service != blank -%}
                          <option value="{{ service | escape }}">{{ service | escape }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                    {%- render 'mg-icon', icon: 'chevron-down', class: 'mg-quote__select-icon' -%}
                  </div>
                </div>

                <div class="mg-quote__field mg-quote__field--full">
                  <label
                    class="mg-quote__label"
                    for="{{ uid }}-body"
                  >
                    Anything else we should know?
                  </label>
                  <textarea
                    class="mg-quote__input mg-quote__input--textarea"
                    id="{{ uid }}-body"
                    name="contact[body]"
                    rows="4"
                    aria-describedby="{{ uid }}-body-hint"
                  >
                    {{- form.body -}}
                  </textarea>
                  <p
                    class="mg-quote__hint"
                    id="{{ uid }}-body-hint"
                  >
                    For example: factory screen with no CarPlay, want it wireless, plus a reversing camera.
                  </p>
                </div>
              </div>
            </fieldset>

            {%- if show_photo -%}
              <div
                class="mg-quote__group"
                role="group"
                aria-labelledby="{{ uid }}-photo-title"
              >
                <p class="mg-quote__legend">
                  <span
                    class="mg-quote__label-row"
                    id="{{ uid }}-photo-title"
                  >
                    <span class="mg-quote__step-no" aria-hidden="true">04</span>
                    <span>{{ section.settings.photo_heading | default: 'Add a photo of your dash' | escape }}</span>
                    <span class="mg-quote__optional">Optional</span>
                  </span>
                </p>
                {{ photo_step }}
              </div>
            {%- endif -%}

            <div class="mg-quote__submit">
              <button
                type="submit"
                class="mg-btn mg-btn--primary mg-btn--block mg-quote__submit-btn"
              >
                <span>{{ section.settings.submit_label | default: 'Send quote request' | escape }}</span>
                {%- render 'mg-icon', icon: 'arrow-right' -%}
              </button>
              {%- if section.settings.privacy_text != blank -%}
                <p class="mg-quote__privacy">
                  {{ section.settings.privacy_text | escape }}
                  {%- if shop.privacy_policy.url != blank %}
                    <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}
      </mg-quote-form>
    </div>

    <div class="mg-quote__details">
      {%- if section.settings.steps_heading != blank
        or section.settings.step_1_title != blank
        or section.settings.step_2_title != blank
        or section.settings.step_3_title != blank
      -%}
        <div class="mg-quote__next">
          {%- if section.settings.steps_heading != blank -%}
            <{{ sub_tag }} class="mg-quote__next-title">{{ section.settings.steps_heading | escape }}</{{ sub_tag }}>
          {%- endif -%}
          <ol
            class="mg-quote__steps"
            role="list"
          >
            {%- for i in (1..3) -%}
              {%- liquid
                assign title_key = 'step_' | append: i | append: '_title'
                assign text_key = 'step_' | append: i | append: '_text'
                assign step_title = section.settings[title_key]
                assign step_text = section.settings[text_key]
              -%}
              {%- if step_title != blank or step_text != blank -%}
                <li class="mg-quote__step">
                  <span
                    class="mg-quote__step-marker"
                    aria-hidden="true"
                  >
                    {{- '0' | append: i -}}
                  </span>
                  <div class="mg-quote__step-body">
                    {%- if step_title != blank -%}
                      <{{ minor_tag }} class="mg-quote__step-title">{{ step_title | escape }}</{{ minor_tag }}>
                    {%- endif -%}
                    {%- if step_text != blank -%}
                      <p class="mg-quote__step-text">{{ step_text | escape }}</p>
                    {%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        </div>
      {%- endif -%}

      {%- if section.settings.show_contact -%}
        <div class="mg-quote__contact">
          {%- if settings.mg_phone_display != blank and settings.mg_phone_e164 != blank -%}
            <a
              class="mg-quote__phone"
              href="tel:+{{ settings.mg_phone_e164 }}"
            >
              <span class="mg-quote__phone-icon">{%- render 'mg-icon', icon: 'phone' -%}</span>
              <span class="mg-quote__phone-text">
                <span class="mg-quote__phone-label">
                  {{- section.settings.contact_label | default: 'Prefer to talk?' | escape -}}
                </span>
                <span class="mg-quote__phone-number">{{ settings.mg_phone_display | escape }}</span>
              </span>
            </a>
          {%- endif -%}
          <dl class="mg-quote__hours">
            {%- if settings.mg_hours_weekdays != blank -%}
              <div class="mg-quote__hours-row">
                <dt>Mon – Fri</dt>
                <dd>{{ settings.mg_hours_weekdays | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if settings.mg_hours_saturday != blank -%}
              <div class="mg-quote__hours-row">
                <dt>Saturday</dt>
                <dd>{{ settings.mg_hours_saturday | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if settings.mg_hours_sunday != blank -%}
              <div class="mg-quote__hours-row">
                <dt>Sunday</dt>
                <dd>{{ settings.mg_hours_sunday | escape }}</dd>
              </div>
            {%- endif -%}
          </dl>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .mg-quote {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  /* Soft ignition-red glow behind the heading */
  .mg-quote::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 auto auto 0;
    width: min(900px, 110vw);
    aspect-ratio: 3 / 2;
    background: radial-gradient(closest-side, var(--mg-accent-soft), transparent);
    transform: translate(-35%, -45%);
    pointer-events: none;
  }

  /* ---------- Layout ---------- */

  .mg-quote__layout {
    display: grid;
    grid-template-areas:
      'intro'
      'main'
      'details';
    gap: clamp(32px, 5vw, 56px);
  }

  .mg-quote__intro {
    grid-area: intro;
  }

  .mg-quote__main {
    grid-area: main;
    min-width: 0;
  }

  .mg-quote__details {
    grid-area: details;
    display: grid;
    gap: 32px;
    min-width: 0;
  }

  @media (min-width: 990px) {
    .mg-quote__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'intro main'
        'details main';
      column-gap: clamp(48px, 6vw, 96px);
      row-gap: 48px;
    }

    .mg-quote__details {
      position: sticky;
      top: calc(var(--header-height, 0px) + 32px);
      align-self: start;
    }
  }

  .mg-quote .mg-quote__heading {
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .mg-quote .mg-quote__lede {
    margin-top: 1.25rem;
  }

  /* ---------- Form card ---------- */

  .mg-quote__card {
    display: block;
    padding: clamp(20px, 4vw, 44px);
    box-shadow: var(--mg-shadow);
    container-type: inline-size;
  }

  .mg-quote__card::before {
    content: '';
    position: absolute;
    top: -1px;
    inset-inline-start: clamp(20px, 4vw, 44px);
    width: 56px;
    height: 2px;
    background: var(--mg-accent);
  }

  .mg-quote__form {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .mg-quote__card-head {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--mg-border);
  }

  .mg-quote__card-title,
  .mg-quote__status-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--mg-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--mg-text);
  }

  .mg-quote__card-text {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-text-muted);
  }

  .mg-quote__required-note {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--mg-text-subtle);
  }

  .mg-quote__req {
    font-weight: 700;
    color: var(--mg-accent-hover);
  }

  /* ---------- Groups and fields ---------- */

  .mg-quote__group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mg-quote__legend {
    display: block;
    width: 100%;
    margin: 0 0 18px;
    padding: 0;
  }

  .mg-quote__label-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mg-text);
  }

  .mg-quote__label-row::after {
    content: '';
    flex: 1 1 24px;
    min-width: 24px;
    height: 1px;
    background: var(--mg-border);
  }

  .mg-quote__step-no {
    display: inline-grid;
    flex: none;
    place-items: center;
    min-width: 32px;
    height: 24px;
    padding: 0 6px;
    border: 1px solid var(--mg-border-strong);
    border-radius: 4px;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--mg-accent-hover);
  }

  .mg-quote__optional {
    flex: none;
    padding: 2px 8px;
    border: 1px solid var(--mg-border);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--mg-text-subtle);
  }

  .mg-quote__grid {
    display: grid;
    gap: 18px 16px;
  }

  @container (min-width: 420px) {
    .mg-quote__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mg-quote__field--full {
      grid-column: 1 / -1;
    }
  }

  @container (min-width: 560px) {
    .mg-quote__grid--car {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }

  .mg-quote__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .mg-quote__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--mg-text-muted);
  }

  .mg-quote__hint {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--mg-text-subtle);
  }

  .mg-quote__field-error {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--mg-accent-hover);
  }

  /* Two-class selectors so these win over Horizon's global input rules */
  .mg-quote .mg-quote__input {
    width: 100%;
    min-height: 52px;
    margin: 0;
    padding: 12px 16px;
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--mg-text);
    background-color: var(--mg-bg);
    border: 1px solid var(--mg-border);
    border-radius: var(--mg-radius-sm);
    box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
    transition:
      border-color 0.2s var(--mg-ease),
      box-shadow 0.2s var(--mg-ease);
  }

  .mg-quote .mg-quote__input::placeholder {
    color: var(--mg-text-subtle);
    opacity: 1;
  }

  .mg-quote .mg-quote__input:hover {
    border-color: var(--mg-border-strong);
  }

  .mg-quote .mg-quote__input:focus {
    outline: 2px solid transparent;
    outline-offset: 2px;
    border-color: var(--mg-accent);
    box-shadow: 0 0 0 3px var(--mg-accent-soft);
  }

  .mg-quote .mg-quote__input:-webkit-autofill {
    -webkit-text-fill-color: var(--mg-text);
    caret-color: var(--mg-text);
    box-shadow: 0 0 0 1000px var(--mg-bg) inset;
  }

  .mg-quote .mg-quote__input:-webkit-autofill:focus {
    box-shadow:
      0 0 0 1000px var(--mg-bg) inset,
      0 0 0 3px var(--mg-accent-soft);
  }

  .mg-quote .mg-quote__input[aria-invalid='true'] {
    border-color: var(--mg-accent-hover);
  }

  .mg-quote .mg-quote__input--textarea {
    min-height: 128px;
    padding-block: 14px;
    resize: vertical;
  }

  .mg-quote__select {
    position: relative;
  }

  .mg-quote .mg-quote__input--select {
    padding-inline-end: 44px;
    cursor: pointer;
  }

  .mg-quote .mg-quote__input--select:has(option[value='']:checked) {
    color: var(--mg-text-subtle);
  }

  .mg-quote .mg-quote__input--select option {
    color: var(--mg-text);
    background-color: var(--mg-surface);
  }

  .mg-quote__select-icon {
    position: absolute;
    top: 50%;
    inset-inline-end: 14px;
    width: 18px;
    height: 18px;
    color: var(--mg-text-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* ---------- Registration plate ---------- */

  .mg-quote__plate {
    padding: 3px;
    background: var(--mg-text);
    border-radius: var(--mg-radius-sm);
    transition: box-shadow 0.2s var(--mg-ease);
  }

  .mg-quote__plate:focus-within {
    outline: 2px solid var(--mg-accent);
    outline-offset: 3px;
  }

  .mg-quote__plate-inner {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    border: 1.5px solid var(--mg-bg);
    border-radius: 4px;
  }

  .mg-quote__plate-band {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
    width: 42px;
    padding: 7px 0 6px;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--mg-text);
    background: var(--mg-surface-2);
  }

  .mg-quote__plate-stars {
    width: 16px;
    height: 16px;
    border: 2px dotted var(--mg-star);
    border-radius: 50%;
  }

  .mg-quote .mg-quote__input--plate {
    flex: 1;
    min-width: 0;
    min-height: 56px;
    padding: 8px 14px;
    font-size: clamp(1.25rem, 5cqi, 1.625rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
    color: var(--mg-bg);
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .mg-quote .mg-quote__input--plate::placeholder {
    color: color-mix(in srgb, var(--mg-bg) 60%, var(--mg-text));
  }

  .mg-quote .mg-quote__input--plate:focus {
    border: 0;
    box-shadow: none;
  }

  /* ---------- Dash photo (WhatsApp) ---------- */

  .mg-quote__photo {
    display: grid;
    gap: 16px;
    padding: 20px;
    border: 1px dashed var(--mg-border-strong);
    border-radius: var(--mg-radius);
    background: color-mix(in srgb, var(--mg-whatsapp) 4%, transparent);
  }

  .mg-quote__photo-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    color: var(--mg-text);
    background: var(--mg-surface-2);
    border: 1px solid var(--mg-border);
    border-radius: 50%;
  }

  .mg-quote__photo-icon .mg-icon {
    width: 24px;
    height: 24px;
  }

  .mg-quote__photo-text {
    margin: 0 0 16px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-text-muted);
  }

  .mg-quote .mg-quote__photo-btn {
    width: 100%;
  }

  .mg-quote__photo-note {
    margin: 10px 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--mg-text-subtle);
  }

  @container (min-width: 420px) {
    .mg-quote__photo {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: 20px;
      padding: 24px;
    }

    .mg-quote .mg-quote__photo-btn {
      width: auto;
    }
  }

  /* ---------- Submit ---------- */

  .mg-quote__submit {
    display: grid;
    gap: 14px;
    padding-top: 24px;
    border-top: 1px solid var(--mg-border);
  }

  .mg-quote .mg-quote__submit-btn {
    min-height: 56px;
    font-size: 1rem;
  }

  .mg-quote__submit-btn .mg-icon {
    transition: transform 0.2s var(--mg-ease);
  }

  .mg-quote__submit-btn:hover .mg-icon {
    transform: translateX(3px);
  }

  .mg-quote__privacy {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--mg-text-subtle);
  }

  .mg-quote__privacy a,
  .mg-quote__again {
    color: var(--mg-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--mg-border-strong);
    text-underline-offset: 4px;
  }

  .mg-quote__privacy a:hover,
  .mg-quote__again:hover {
    color: var(--mg-text);
    text-decoration-color: var(--mg-accent);
  }

  /* ---------- Status panels ---------- */

  .mg-quote__status {
    display: grid;
    gap: 14px;
  }

  .mg-quote__status:focus {
    outline: none;
  }

  .mg-quote__status--error {
    padding: 16px 18px;
    color: var(--mg-text);
    background: var(--mg-accent-soft);
    border: 1px solid color-mix(in srgb, var(--mg-accent) 55%, transparent);
    border-radius: var(--mg-radius-sm);
  }

  .mg-quote__status--error .mg-quote__status-title {
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  .mg-quote__status--error ul {
    margin: 0;
    padding-inline-start: 1.1em;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .mg-quote__status-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    color: var(--mg-success);
    background: color-mix(in srgb, var(--mg-success) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--mg-success) 40%, transparent);
    border-radius: 50%;
  }

  .mg-quote__status-icon .mg-icon {
    width: 26px;
    height: 26px;
    stroke-width: 2.25;
  }

  .mg-quote__status-text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--mg-text-muted);
  }

  .mg-quote__status-photo {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }

  .mg-quote__status-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--mg-border);
  }

  .mg-quote__again {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* ---------- What happens next ---------- */

  .mg-quote__next-title {
    margin: 0 0 20px;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mg-text-muted);
  }

  .mg-quote__steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-quote__step {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding-bottom: 24px;
  }

  .mg-quote__step:last-child {
    padding-bottom: 0;
  }

  .mg-quote__step::before {
    content: '';
    position: absolute;
    top: 50px;
    bottom: 6px;
    inset-inline-start: 21.5px;
    width: 1px;
    background: var(--mg-border);
  }

  .mg-quote__step:last-child::before {
    display: none;
  }

  .mg-quote__step-marker {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--mg-text);
    background: var(--mg-surface);
    border: 1px solid var(--mg-border-strong);
    border-radius: 50%;
  }

  .mg-quote__step:first-child .mg-quote__step-marker {
    border-color: var(--mg-accent);
    box-shadow: var(--mg-glow);
  }

  .mg-quote__step-title {
    margin: 11px 0 6px;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mg-text);
  }

  .mg-quote__step-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-text-muted);
  }

  /* ---------- Phone and hours ---------- */

  .mg-quote__contact {
    display: grid;
    gap: 18px;
    padding: 24px;
    background: color-mix(in srgb, var(--mg-surface) 70%, transparent);
    border: 1px solid var(--mg-border);
    border-radius: var(--mg-radius);
  }

  .mg-quote__phone {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--mg-text);
    text-decoration: none;
    border-radius: var(--mg-radius-sm);
  }

  .mg-quote__phone:focus-visible {
    outline: 2px solid var(--mg-text);
    outline-offset: 4px;
  }

  .mg-quote__phone-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--mg-text);
    background: var(--mg-accent);
    border-radius: 50%;
    transition: background-color 0.2s var(--mg-ease);
  }

  .mg-quote__phone-icon .mg-icon {
    width: 22px;
    height: 22px;
  }

  .mg-quote__phone:hover .mg-quote__phone-icon {
    background: var(--mg-accent-hover);
  }

  .mg-quote__phone-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mg-text-subtle);
  }

  .mg-quote__phone-number {
    display: block;
    margin-top: 2px;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--mg-text);
  }

  .mg-quote__hours {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .mg-quote__phone + .mg-quote__hours {
    padding-top: 18px;
    border-top: 1px solid var(--mg-border);
  }

  .mg-quote__hours-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.9375rem;
  }

  .mg-quote__hours dt {
    color: var(--mg-text-muted);
  }

  .mg-quote__hours dd {
    margin: 0;
    font-weight: 600;
    text-align: end;
    color: var(--mg-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-quote .mg-quote__input,
    .mg-quote__plate,
    .mg-quote__phone-icon,
    .mg-quote__submit-btn .mg-icon {
      transition: none;
    }

    .mg-quote__submit-btn:hover .mg-icon {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('mg-quote-form')) {
    /**
     * Quote form helpers:
     * - builds the WhatsApp "dash photo" message live from the reg, car and service typed
     * - remembers the answers for this tab so the success panel can reuse them and an
     *   error reload does not wipe the custom fields
     * - pre-selects fields from the URL, e.g. ?service=Dashcam&make=BMW&reg=181-D-12345
     * - moves focus to the success or error panel after a submit
     */
    class MgQuoteForm extends HTMLElement {
      connectedCallback() {
        this.form = this.querySelector('form');
        this.storageKey = 'mg-quote:' + (this.dataset.sectionId || '');
        this.baseMessage = this.dataset.waMessage || '';
        this.waNumber = this.dataset.waNumber || '';

        const status = this.querySelector('[data-mg-quote-status]');
        const saved = this.load();

        if (status) {
          window.requestAnimationFrame(() => status.focus());
        }

        if (status && status.dataset.state === 'success') {
          this.updateLinks(saved || {});
          this.forget();
          return;
        }

        if (!this.form) return;

        if (status && saved) this.restore(saved);
        this.prefillFromUrl();
        this.updateLinks(this.collect());

        this.handleInput = this.onInput.bind(this);
        this.handleSubmit = this.onSubmit.bind(this);
        this.handleInvalid = this.onInvalid.bind(this);
        this.form.addEventListener('input', this.handleInput);
        this.form.addEventListener('change', this.handleInput);
        this.form.addEventListener('submit', this.handleSubmit);
        this.form.addEventListener('invalid', this.handleInvalid, true);
      }

      disconnectedCallback() {
        if (!this.form || !this.handleInput) return;
        this.form.removeEventListener('input', this.handleInput);
        this.form.removeEventListener('change', this.handleInput);
        this.form.removeEventListener('submit', this.handleSubmit);
        this.form.removeEventListener('invalid', this.handleInvalid, true);
      }

      field(name) {
        return this.form ? this.form.elements.namedItem('contact[' + name + ']') : null;
      }

      collect() {
        const data = {};
        if (!this.form) return data;
        Array.from(this.form.elements).forEach((el) => {
          if (!el.name || el.name.indexOf('contact[') !== 0 || el.type === 'hidden') return;
          data[el.name] = String(el.value || '').trim();
        });
        return data;
      }

      message(data) {
        const get = (name) => String(data['contact[' + name + ']'] || '').trim();
        const make = /^other\b/i.test(get('Car make')) ? '' : get('Car make');
        const car = [get('Car year'), make, get('Car model')].filter(Boolean).join(' ');
        const reg = get('Registration number').toUpperCase();
        const service = get('Service');
        const parts = [];
        if (reg) parts.push('Reg: ' + reg);
        if (car) parts.push('Car: ' + car);
        if (service) parts.push('Service: ' + service);
        return parts.length ? this.baseMessage + ' ' + parts.join(', ') : this.baseMessage;
      }

      updateLinks(data) {
        if (!this.waNumber) return;
        const href = 'https://wa.me/' + this.waNumber + '?text=' + encodeURIComponent(this.message(data));
        this.querySelectorAll('[data-mg-wa-photo]').forEach((link) => {
          link.setAttribute('href', href);
        });
      }

      onInput(event) {
        const target = event.target;
        if (event.type === 'change' && target.name === 'contact[Registration number]') {
          target.value = target.value.toUpperCase().trim();
        }
        if (target.getAttribute('aria-invalid') === 'true' && target.validity && target.validity.valid) {
          target.removeAttribute('aria-invalid');
        }
        this.updateLinks(this.collect());
      }

      onSubmit() {
        this.save(this.collect());
      }

      onInvalid(event) {
        event.target.setAttribute('aria-invalid', 'true');
      }

      restore(saved) {
        Object.keys(saved).forEach((name) => {
          const el = this.form.elements.namedItem(name);
          if (el && 'value' in el && !el.value && saved[name]) el.value = saved[name];
        });
      }

      prefillFromUrl() {
        let params;
        try {
          params = new URLSearchParams(window.location.search);
        } catch (error) {
          return;
        }
        const map = { reg: 'Registration number', make: 'Car make', model: 'Car model', year: 'Car year', service: 'Service' };
        Object.keys(map).forEach((param) => {
          const value = (params.get(param) || '').trim();
          const el = this.field(map[param]);
          if (!value || !el || el.value) return;
          if (el.tagName === 'SELECT') {
            const query = value.toLowerCase();
            const options = Array.from(el.options).filter((option) => option.value);
            const match =
              options.find((option) => option.value.toLowerCase() === query) ||
              options.find((option) => option.value.toLowerCase().indexOf(query) !== -1);
            if (match) el.value = match.value;
          } else {
            el.value = value.slice(0, 60);
          }
        });
      }

      load() {
        try {
          const raw = window.sessionStorage.getItem(this.storageKey);
          return raw ? JSON.parse(raw) : null;
        } catch (error) {
          return null;
        }
      }

      save(data) {
        try {
          window.sessionStorage.setItem(this.storageKey, JSON.stringify(data));
        } catch (error) {
          /* Storage unavailable: the form still submits normally. */
        }
      }

      forget() {
        try {
          window.sessionStorage.removeItem(this.storageKey);
        } catch (error) {
          /* Nothing to clear. */
        }
      }
    }

    customElements.define('mg-quote-form', MgQuoteForm);
  }
{% endjavascript %}

{% schema %}
{
  "name": "MG quote form",
  "tag": "div",
  "class": "mg-quote-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        {
          "value": "default",
          "label": "Standard"
        },
        {
          "value": "tight",
          "label": "Tight"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "No-obligation quote"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get a fixed quote"
    },
    {
      "type": "checkbox",
      "id": "use_page_title",
      "label": "Use the page title as the heading",
      "info": "On a page, shows the page's own title instead of the heading above.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "Use heading as the page's main title (H1)",
      "info": "Turn on when this is the main section of the page, for example the Get a quote page. Each page should have only one H1.",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "Tell us your reg and what you'd like fitted. We'll check the exact spec of your car and come back with a fixed price for parts and fitting, so there are no surprises on the day."
    },
    {
      "type": "header",
      "content": "What happens next"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Heading",
      "default": "What happens next"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 title",
      "default": "We check your car"
    },
    {
      "type": "textarea",
      "id": "step_1_text",
      "label": "Step 1 text",
      "default": "We look up your reg and factory screen to confirm exactly which CarPlay, screen or audio kit suits your car."
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Step 2 title",
      "default": "You get a fixed price"
    },
    {
      "type": "textarea",
