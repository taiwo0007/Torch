{%- liquid
  assign section_classes = 'mg-section mg-quote'
  if section.settings.background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--band mg-quote--band'
  endif

  # "panel": the inner-page header (breadcrumb, grey panel, serif h1) across the top, as on the
  # service, car make and collection pages. "plain": the heading sits in the left column.
  assign is_panel = false
  if section.settings.header_style == 'panel'
    assign is_panel = true
    assign section_classes = section_classes | append: ' mg-quote--panel'
  endif

  assign heading_tag = 'h2'
  assign heading_class = 'mg-head__title mg-quote__heading'
  assign sub_tag = 'h3'
  assign minor_tag = 'h4'
  if section.settings.heading_is_h1
    assign heading_tag = 'h1'
    assign heading_class = 'mg-h1-banner mg-quote__heading'
    assign sub_tag = 'h2'
    assign minor_tag = 'h3'
  endif

  assign heading = section.settings.heading
  if section.settings.use_page_title and page.title != blank
    assign heading = page.title
  endif

  # The page's own content (Online Store > Pages) can stand in for the intro text
  assign page_intro = ''
  if section.settings.intro_from_page and page.content != blank
    assign page_intro_text = page.content | strip_html | strip
    if page_intro_text != blank
      assign page_intro = page.content
    endif
  endif
  assign has_intro = false
  if page_intro != blank or section.settings.intro != blank
    assign has_intro = true
  endif

  assign crumb_current = page.title | default: heading

  assign uid = 'MgQuote-' | append: section.id
  assign form_id = 'MgQuoteForm-' | append: section.id
  assign heading_id = uid | append: '-heading'

  assign wa_number = settings.mg_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign business_name = settings.mg_business_name | default: shop.name
  assign fallback_photo_message = 'Hi ' | append: business_name | append: ", here's a photo of my dash."
  assign photo_message = section.settings.photo_message | strip | default: fallback_photo_message
  assign encoded_message = photo_message | url_encode
  assign photo_href = 'https://wa.me/' | append: wa_number | append: '?text=' | append: encoded_message

  assign show_photo = false
  if section.settings.show_whatsapp_photo_step and wa_number != blank
    assign show_photo = true
  endif

  assign make_lines = section.settings.make_list | newline_to_br | split: '<br />'
  assign service_lines = section.settings.service_list | newline_to_br | split: '<br />'
-%}

{%- capture photo_step -%}
  <div class="mg-quote__photo">
    <span
      class="mg-quote__photo-icon"
      aria-hidden="true"
    >
      {%- render 'mg-icon', icon: 'camera' -%}
    </span>
    <div class="mg-quote__photo-body">
      {%- if section.settings.photo_text != blank -%}
        <p class="mg-quote__photo-text">{{ section.settings.photo_text | escape }}</p>
      {%- endif -%}
      <a
        class="mg-btn mg-btn--whatsapp mg-quote__photo-btn"
        href="{{ photo_href }}"
        target="_blank"
        rel="noopener"
        data-mg-wa-photo
        aria-describedby="{{ uid }}-photo-note"
      >
        {%- render 'mg-icon', icon: 'whatsapp' -%}
        <span>{{ section.settings.photo_button_label | default: 'Send photo on WhatsApp' | escape }}</span>
        <span class="mg-visually-hidden"> (opens WhatsApp in a new tab)</span>
      </a>
      <p
        class="mg-help mg-quote__photo-note"
        id="{{ uid }}-photo-note"
      >
        Opens WhatsApp with your car details filled in. Nothing is sent until you press send.
      </p>
    </div>
  </div>
{%- endcapture -%}

<section
  class="{{ section_classes }}"
  {% if heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  {%- capture intro_inner -%}
    {%- if heading != blank -%}
      <{{ heading_tag }}
        id="{{ heading_id }}"
        class="{{ heading_class }}"
      >
        {{- heading | escape -}}
      </{{ heading_tag }}>
    {%- endif -%}
    {%- if page_intro != blank -%}
      <div class="mg-lede mg-quote__lede mg-quote__rte">{{ page_intro }}</div>
    {%- elsif section.settings.intro != blank -%}
      <p class="mg-lede mg-quote__lede">{{ section.settings.intro }}</p>
    {%- endif -%}
  {%- endcapture -%}

  {%- if is_panel -%}
    <div class="mg-container">
      {%- if section.settings.show_breadcrumb and crumb_current != blank -%}
        <nav
          class="mg-crumbs"
          aria-label="Breadcrumb"
        >
          <ol role="list">
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><span aria-current="page">{{ crumb_current | escape }}</span></li>
          </ol>
        </nav>
        <script type="application/ld+json">
          {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | append: routes.root_url | json }}},{"@type":"ListItem","position":2,"name":{{ crumb_current | json }},"item":{{ request.origin | append: request.path | json }}}]}
        </script>
      {%- endif -%}
      {%- if heading != blank or has_intro -%}
        <header class="mg-panel mg-quote__intro mg-quote__intro--panel">
          {{- intro_inner -}}
        </header>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="mg-container mg-quote__layout">
    {%- unless is_panel -%}
      {%- if heading != blank or has_intro -%}
        <header class="mg-quote__intro">
          {{- intro_inner -}}
        </header>
      {%- endif -%}
    {%- endunless -%}

    <div class="mg-quote__main">
      <mg-quote-form
        class="mg-card mg-card--raised mg-quote__card"
        data-section-id="{{ section.id }}"
        data-wa-number="{{ wa_number | escape }}"
        data-wa-message="{{ photo_message | escape }}"
      >
        {%- form 'contact', id: form_id, class: 'mg-quote__form' -%}
          <input
            type="hidden"
            name="contact[id]"
            value="{{ form_id }}"
          >
          <input
            type="hidden"
            name="contact[Enquiry]"
            value="{{ section.settings.enquiry_type | default: 'Quote request (website)' | escape }}"
          >

          {%- liquid
            assign form_matches = false
            if form.id == form_id or form.id == blank
              assign form_matches = true
            endif

            assign is_success = false
            if form.posted_successfully? and form_matches
              assign is_success = true
            endif

            assign has_errors = false
            if form.errors and form_matches
              assign has_errors = true
            endif

            assign email_invalid = false
            if has_errors and form.errors contains 'email'
              assign email_invalid = true
            endif
          -%}

          {%- if is_success -%}
            <div
              class="mg-quote__status mg-quote__status--success"
              tabindex="-1"
              autofocus
              data-mg-quote-status
              data-state="success"
              aria-labelledby="{{ uid }}-success-title"
            >
              <span
                class="mg-quote__status-icon"
                aria-hidden="true"
              >
                {%- render 'mg-icon', icon: 'check' -%}
              </span>
              <{{ sub_tag }}
                id="{{ uid }}-success-title"
                class="mg-quote__status-title"
              >
                {{- section.settings.success_heading | default: 'Thanks, your request is in' | escape -}}
              </{{ sub_tag }}>
              {%- if section.settings.success_text != blank -%}
                <p class="mg-quote__status-text">{{ section.settings.success_text }}</p>
              {%- endif -%}

              {%- if show_photo -%}
                <div class="mg-quote__status-photo">
                  <p class="mg-quote__legend">
                    {{- section.settings.photo_heading | default: 'Add a photo of your dash' | escape -}}
                  </p>
                  {{ photo_step }}
                </div>
              {%- endif -%}

              <div class="mg-quote__status-actions">
                {%- if settings.mg_phone_e164 != blank -%}
                  <a
                    class="mg-btn mg-btn--secondary"
                    href="tel:+{{ settings.mg_phone_e164 }}"
                  >
                    {%- render 'mg-icon', icon: 'phone' -%}
                    <span>Call {{ settings.mg_phone_display | escape }}</span>
                  </a>
                {%- endif -%}
                <a
                  class="mg-link mg-quote__again"
                  href="{{ request.path }}"
                >
                  Send another request
                </a>
              </div>
            </div>
          {%- else -%}
            <div class="mg-quote__card-head">
              {%- if section.settings.form_heading != blank -%}
                <{{ sub_tag }} class="mg-quote__card-title">{{ section.settings.form_heading | escape }}</{{ sub_tag }}>
              {%- endif -%}
              {%- if section.settings.form_text != blank -%}
                <p class="mg-quote__card-text">{{ section.settings.form_text | escape }}</p>
              {%- endif -%}
              <p class="mg-help mg-quote__required-note">
                Fields marked <span class="mg-quote__req" aria-hidden="true">*</span
                ><span class="mg-visually-hidden">with an asterisk</span> are required.
              </p>
            </div>

            {%- if has_errors -%}
              <div
                class="mg-quote__status mg-quote__status--error"
                tabindex="-1"
                autofocus
                data-mg-quote-status
                data-state="error"
                aria-labelledby="{{ uid }}-error-title"
              >
                <p
                  id="{{ uid }}-error-title"
                  class="mg-quote__status-title"
                >
                  We couldn't send that yet. Please check the details below.
                </p>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <fieldset class="mg-quote__group">
              <legend class="mg-quote__legend">About you</legend>
              <div class="mg-quote__grid">
                <div class="mg-field mg-quote__field mg-quote__field--full">
                  <label
                    class="mg-label"
                    for="{{ uid }}-name"
                  >
                    Your name <span class="mg-quote__req" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="mg-input"
                    type="text"
                    id="{{ uid }}-name"
                    name="contact[name]"
                    autocomplete="name"
                    required
                    aria-required="true"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  >
                </div>

                <div class="mg-field mg-quote__field">
                  <label
                    class="mg-label"
                    for="{{ uid }}-phone"
                  >
                    Mobile number <span class="mg-quote__req" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="mg-input"
                    type="tel"
                    id="{{ uid }}-phone"
                    name="contact[phone]"
                    autocomplete="tel"
                    inputmode="tel"
                    required
                    aria-required="true"
                    aria-describedby="{{ uid }}-phone-hint"
                    placeholder="e.g. 087 123 4567"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  >
                  <p
                    class="mg-help"
                    id="{{ uid }}-phone-hint"
                  >
                    We'll call or WhatsApp you on this number.
                  </p>
                </div>

                <div class="mg-field mg-quote__field">
                  <label
                    class="mg-label"
                    for="{{ uid }}-email"
                  >
                    Email <span class="mg-quote__req" aria-hidden="true">*</span>
                  </label>
                  <input
                    class="mg-input"
                    type="email"
                    id="{{ uid }}-email"
                    name="contact[email]"
                    autocomplete="email"
                    spellcheck="false"
                    autocapitalize="off"
                    required
                    aria-required="true"
                    {% if email_invalid %}
                      aria-invalid="true"
                      aria-describedby="{{ uid }}-email-error {{ uid }}-email-hint"
                    {% else %}
                      aria-describedby="{{ uid }}-email-hint"
                    {% endif %}
                    placeholder="you@example.ie"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  >
                  {%- if email_invalid -%}
                    <p
                      class="mg-error-text"
                      id="{{ uid }}-email-error"
                    >
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </p>
                  {%- endif -%}
                  <p
                    class="mg-help"
                    id="{{ uid }}-email-hint"
                  >
                    Your written quote is sent here.
                  </p>
                </div>
              </div>
            </fieldset>

            <fieldset class="mg-quote__group">
              <legend class="mg-quote__legend">Your car</legend>
              <div class="mg-quote__grid mg-quote__grid--car">
                <div class="mg-field mg-quote__field mg-quote__field--full">
                  <label
                    class="mg-label"
                    for="{{ uid }}-reg"
                  >
                    Registration number
                  </label>
                  <div class="mg-plate mg-quote__plate">
                    <span
                      class="mg-plate__band"
                      aria-hidden="true"
                      >IRL</span
                    >
                    <input
                      class="mg-plate__input"
                      type="text"
                      id="{{ uid }}-reg"
                      name="contact[Registration number]"
                      autocomplete="off"
                      autocapitalize="characters"
                      autocorrect="off"
                      spellcheck="false"
                      enterkeyhint="next"
                      maxlength="16"
                      aria-describedby="{{ uid }}-reg-hint"
                      placeholder="241-D-12345"
                      data-mg-quote-reg
                    >
                  </div>
                  <p
                    class="mg-help"
                    id="{{ uid }}-reg-hint"
                  >
                    Irish or UK reg. We use it to check your car's exact spec and factory screen.
                  </p>
                </div>

                <div class="mg-field mg-quote__field">
                  <label
                    class="mg-label"
                    for="{{ uid }}-make"
                  >
                    Make
                  </label>
                  <div class="mg-quote__select">
                    <select
                      class="mg-input"
                      id="{{ uid }}-make"
                      name="contact[Car make]"
                      autocomplete="off"
                    >
                      <option value="">Select make</option>
                      {%- for line in make_lines -%}
                        {%- assign make = line | strip -%}
                        {%- if make != blank -%}
                          <option value="{{ make | escape }}">{{ make | escape }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                    {%- render 'mg-icon', icon: 'chevron-down', class: 'mg-quote__select-icon' -%}
                  </div>
                </div>

                <div class="mg-field mg-quote__field">
                  <label
                    class="mg-label"
                    for="{{ uid }}-model"
                  >
                    Model
                  </label>
                  <input
                    class="mg-input"
                    type="text"
                    id="{{ uid }}-model"
                    name="contact[Car model]"
                    autocomplete="off"
                    placeholder="e.g. 3 Series (F30)"
                  >
                </div>

                <div class="mg-field mg-quote__field">
                  <label
                    class="mg-label"
                    for="{{ uid }}-year"
                  >
                    Year
                  </label>
                  <input
                    class="mg-input"
                    type="text"
                    id="{{ uid }}-year"
                    name="contact[Car year]"
                    autocomplete="off"
                    inputmode="numeric"
                    pattern="[0-9]{4}"
                    maxlength="4"
                    title="Four digits, for example 2018"
                    placeholder="e.g. 2018"
                  >
                </div>
              </div>
            </fieldset>

            <fieldset class="mg-quote__group">
              <legend class="mg-quote__legend">What you need</legend>
              <div class="mg-quote__grid">
                <div class="mg-field mg-quote__field mg-quote__field--full">
                  <label
                    class="mg-label"
                    for="{{ uid }}-service"
                  >
                    Service
                  </label>
                  <div class="mg-quote__select">
                    <select
                      class="mg-input"
                      id="{{ uid }}-service"
                      name="contact[Service]"
                      autocomplete="off"
                    >
                      <option value="">Choose a service</option>
                      {%- for line in service_lines -%}
                        {%- assign service = line | strip -%}
                        {%- if service != blank -%}
                          <option value="{{ service | escape }}">{{ service | escape }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                    {%- render 'mg-icon', icon: 'chevron-down', class: 'mg-quote__select-icon' -%}
                  </div>
                </div>

                <div class="mg-field mg-quote__field mg-quote__field--full">
                  <label
                    class="mg-label"
                    for="{{ uid }}-body"
                  >
                    Anything else we should know?
                  </label>
                  <textarea
                    class="mg-input"
                    id="{{ uid }}-body"
                    name="contact[body]"
                    rows="4"
                    aria-describedby="{{ uid }}-body-hint"
                  >
                    {{- form.body -}}
                  </textarea>
                  <p
                    class="mg-help"
                    id="{{ uid }}-body-hint"
                  >
                    For example: factory screen with no CarPlay, want it wireless, plus a reversing camera.
                  </p>
                </div>
              </div>
            </fieldset>

            {%- if show_photo -%}
              <div
                class="mg-quote__group"
                role="group"
                aria-labelledby="{{ uid }}-photo-title"
              >
                <p
                  class="mg-quote__legend"
                  id="{{ uid }}-photo-title"
                >
                  {{ section.settings.photo_heading | default: 'Add a photo of your dash' | escape }}
                  <span class="mg-label__optional">(optional)</span>
                </p>
                {{ photo_step }}
              </div>
            {%- endif -%}

            <div class="mg-quote__submit">
              <button
                type="submit"
                class="mg-btn mg-btn--primary mg-btn--lg mg-btn--block"
              >
                {{ section.settings.submit_label | default: 'Send quote request' | escape }}
              </button>
              {%- if section.settings.privacy_text != blank -%}
                <p class="mg-help mg-quote__privacy">
                  {{ section.settings.privacy_text | escape }}
                  {%- if shop.privacy_policy.url != blank %}
                    <a
                      class="mg-link"
                      href="{{ shop.privacy_policy.url }}"
                      >Privacy policy</a
                    >
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}
      </mg-quote-form>
    </div>

    <div class="mg-quote__details">
      {%- if section.settings.steps_heading != blank
        or section.settings.step_1_title != blank
        or section.settings.step_2_title != blank
        or section.settings.step_3_title != blank
      -%}
        <div class="mg-quote__next">
          {%- if section.settings.steps_heading != blank -%}
            <{{ sub_tag }} class="mg-quote__next-title">{{ section.settings.steps_heading | escape }}</{{ sub_tag }}>
          {%- endif -%}
          <ol
            class="mg-quote__steps"
            role="list"
          >
            {%- for i in (1..3) -%}
              {%- liquid
                assign title_key = 'step_' | append: i | append: '_title'
                assign text_key = 'step_' | append: i | append: '_text'
                assign step_title = section.settings[title_key]
                assign step_text = section.settings[text_key]
              -%}
              {%- if step_title != blank or step_text != blank -%}
                <li class="mg-quote__step">
                  <span
                    class="mg-quote__step-num"
                    aria-hidden="true"
                    >{{ i }}</span
                  >
                  <div class="mg-quote__step-body">
                    {%- if step_title != blank -%}
                      <{{ minor_tag }} class="mg-quote__step-title">{{ step_title | escape }}</{{ minor_tag }}>
                    {%- endif -%}
                    {%- if step_text != blank -%}
                      <p class="mg-quote__step-text">{{ step_text | escape }}</p>
                    {%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        </div>
      {%- endif -%}

      {%- if section.settings.show_contact -%}
        <div class="mg-card mg-quote__contact">
          {%- if settings.mg_phone_display != blank and settings.mg_phone_e164 != blank -%}
            <a
              class="mg-quote__phone"
              href="tel:+{{ settings.mg_phone_e164 }}"
            >
              <span
                class="mg-quote__phone-icon"
                aria-hidden="true"
              >
                {%- render 'mg-icon', icon: 'phone' -%}
              </span>
              <span class="mg-quote__phone-text">
                <span class="mg-quote__phone-label">
                  {{- section.settings.contact_label | default: 'Prefer to talk?' | escape -}}
                </span>
                <span class="mg-quote__phone-number">{{ settings.mg_phone_display | escape }}</span>
              </span>
            </a>
          {%- endif -%}
          <dl class="mg-quote__hours">
            {%- if settings.mg_hours_weekdays != blank -%}
              <div class="mg-quote__hours-row">
                <dt>Monday to Friday</dt>
                <dd>{{ settings.mg_hours_weekdays | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if settings.mg_hours_saturday != blank -%}
              <div class="mg-quote__hours-row">
                <dt>Saturday</dt>
                <dd>{{ settings.mg_hours_saturday | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if settings.mg_hours_sunday != blank -%}
              <div class="mg-quote__hours-row">
                <dt>Sunday</dt>
                <dd>{{ settings.mg_hours_sunday | escape }}</dd>
              </div>
            {%- endif -%}
          </dl>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /*
   * Quote form: intro and "what happens next" on the left, a raised form card on the right
   * from 990px (stacked on phones: intro, form, then steps). Fields, plate, buttons and
   * states are the shared components from mg-theme.css; this is layout only.
   */
  .mg-quote__layout {
    display: grid;
    grid-template-areas:
      'intro'
      'main'
      'details';
    gap: var(--mg-space-6);
  }

  .mg-quote__intro {
    grid-area: intro;
    min-width: 0;
  }

  .mg-quote__main {
    grid-area: main;
    min-width: 0;
  }

  .mg-quote__details {
    grid-area: details;
    display: grid;
    gap: var(--mg-space-6);
    align-content: start;
    min-width: 0;
  }

  .mg-quote__heading {
    max-width: 16ch;
  }

  /* Panel header: the heading may run wider, like the other inner-page banners */
  .mg-quote__intro--panel .mg-quote__heading {
    max-width: 22ch;
  }

  .mg-quote--panel .mg-quote__layout {
    grid-template-areas:
      'main'
      'details';
    margin-block-start: var(--mg-space-6);
  }

  .mg-quote__rte > * {
    margin: 0 0 0.75em;
  }

  .mg-quote__rte > :last-child {
    margin-bottom: 0;
  }

  .mg-quote__rte a {
    color: var(--mg-ink);
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.22em;
  }

  /* ---------- Form card ---------- */
  .mg-quote__card {
    display: block;
    padding: var(--mg-space-5) var(--mg-space-4);
    container-type: inline-size;
  }

  .mg-quote__form {
    display: flex;
    flex-direction: column;
    gap: var(--mg-space-6);
  }

  .mg-quote__card-head {
    padding-bottom: var(--mg-space-5);
    border-bottom: 1px solid var(--mg-line);
  }

  .mg-quote__card-title,
  .mg-quote__status-title {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-quote__card-text {
    margin: var(--mg-space-1) 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--mg-ink-2);
  }

  .mg-quote__required-note {
    margin-top: var(--mg-space-2);
  }

  .mg-quote__req {
    font-weight: 600;
    color: var(--mg-red-ink);
  }

  /* ---------- Groups and fields ---------- */
  .mg-quote__group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mg-quote__legend {
    display: block;
    width: 100%;
    margin: 0 0 var(--mg-space-4);
    padding: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--mg-ink);
  }

  .mg-quote__legend .mg-label__optional {
    font-size: var(--mg-fs-small);
  }

  /* Fields in a row start at the top: a field with a two-line hint must not stretch its neighbour */
  .mg-quote__grid {
    display: grid;
    align-items: start;
    gap: var(--mg-space-4);
  }

  @container (min-width: 420px) {
    .mg-quote__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mg-quote__field--full {
      grid-column: 1 / -1;
    }
  }

  @container (min-width: 560px) {
    .mg-quote__grid--car {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }

  /* Autofill keeps the field colours in both schemes */
  .mg-quote .mg-input:-webkit-autofill {
    -webkit-text-fill-color: var(--mg-ink);
    caret-color: var(--mg-ink);
    box-shadow: 0 0 0 1000px var(--mg-input) inset;
  }

  /* Selects: native control without the platform arrow, the MG chevron instead */
  .mg-quote__select {
    position: relative;
  }

  .mg-quote__select select.mg-input {
    padding-inline-end: 44px;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }

  .mg-quote__select select.mg-input:has(option[value='']:checked) {
    color: var(--mg-ink-3);
  }

  .mg-quote__select option {
    background-color: var(--mg-card);
    color: var(--mg-ink);
  }

  .mg-quote__select-icon {
    position: absolute;
    top: 50%;
    inset-inline-end: 14px;
    width: 18px;
    height: 18px;
    color: var(--mg-ink-2);
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* The plate is a real plate size, not the width of the card */
  .mg-quote__plate {
    width: 100%;
    max-width: 340px;
  }

  /* ---------- Dash photo (WhatsApp) ---------- */
  .mg-quote__photo {
    display: grid;
    gap: var(--mg-space-4);
    padding: var(--mg-space-4);
    border-radius: var(--mg-radius-md);
    background-color: var(--mg-band);
  }

  /* The icon only shows once it can sit beside the text (see the container query below) */
  .mg-quote__photo-icon {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--mg-radius-sm);
    background-color: var(--mg-card);
    color: var(--mg-ink);
  }

  .mg-quote__photo-icon .mg-icon {
    width: 22px;
    height: 22px;
  }

  .mg-quote__photo-text {
    margin: 0 0 var(--mg-space-3);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-ink-2);
  }

  /* On the grey box the outline button gets a card fill, so it reads as a button */
  .mg-quote .mg-quote__photo-btn {
    --mg-btn-bg: var(--mg-card);
    --mg-btn-bg-hover: var(--mg-card-raised);
    width: 100%;
  }

  .mg-quote__photo-note {
    margin-top: var(--mg-space-2);
  }

  @container (min-width: 420px) {
    .mg-quote__photo {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      padding: var(--mg-space-5);
    }

    .mg-quote__photo-icon {
      display: inline-grid;
    }

    .mg-quote .mg-quote__photo-btn {
      width: auto;
    }
  }

  /* ---------- Submit ---------- */
  .mg-quote__submit {
    display: grid;
    gap: var(--mg-space-3);
  }

  .mg-quote__privacy .mg-link,
  .mg-quote__again {
    text-decoration-color: currentcolor;
  }

  /* ---------- Status panels ---------- */
  .mg-quote__status {
    display: grid;
    justify-items: start;
    gap: var(--mg-space-3);
  }

  .mg-quote__status:focus {
    outline: none;
  }

  .mg-quote__status--error {
    padding: var(--mg-space-4);
    border: 1px solid var(--mg-red-ink);
    border-radius: var(--mg-radius-sm);
    background-color: var(--mg-red-tint);
    color: var(--mg-ink);
  }

  .mg-quote__status--error .mg-quote__status-title {
    font-size: 0.9375rem;
    color: var(--mg-red-ink);
  }

  .mg-quote__status--error ul {
    margin: 0;
    padding-inline-start: 1.1em;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .mg-quote__status-icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--mg-radius-pill);
    background-color: color-mix(in srgb, var(--mg-success) 14%, transparent);
    color: var(--mg-success);
  }

  .mg-quote__status-icon .mg-icon {
    width: 24px;
    height: 24px;
    stroke-width: 2.25;
  }

  .mg-quote__status-text {
    margin: 0;
    font-size: var(--mg-fs-body);
    line-height: var(--mg-lh-body);
    color: var(--mg-ink-2);
  }

  .mg-quote__status-photo {
    display: grid;
    justify-self: stretch;
    margin-top: var(--mg-space-3);
  }

  .mg-quote__status-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-self: stretch;
    gap: var(--mg-space-3) var(--mg-space-5);
    margin-top: var(--mg-space-3);
    padding-top: var(--mg-space-5);
    border-top: 1px solid var(--mg-line);
  }

  .mg-quote__again {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    font-size: 0.9375rem;
  }

  /* ---------- What happens next ---------- */
  .mg-quote__next-title {
    margin: 0 0 var(--mg-space-4);
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.3;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-quote__steps {
    display: grid;
    gap: var(--mg-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-quote__step {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: start;
    gap: var(--mg-space-4);
    margin: 0;
  }

  .mg-quote__step-num {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--mg-radius-pill);
    background-color: var(--mg-red-tint);
    color: var(--mg-red-ink);
    font-size: var(--mg-fs-small);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .mg-quote--band .mg-quote__step-num {
    background-color: var(--mg-card);
  }

  .mg-quote__step-body {
    display: grid;
    gap: var(--mg-space-1);
    min-width: 0;
    padding-top: 4px;
  }

  .mg-quote__step-title {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-title);
    font-weight: 600;
    line-height: 1.35;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-quote__step-text {
    max-width: 44ch;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-ink-2);
    text-wrap: pretty;
  }

  /* ---------- Phone and hours ---------- */
  .mg-quote__contact {
    display: grid;
    gap: var(--mg-space-4);
    padding: var(--mg-space-5);
  }

  .mg-quote__phone {
    display: flex;
    align-items: center;
    gap: var(--mg-space-3);
    border-radius: var(--mg-radius-sm);
    color: var(--mg-ink);
    text-decoration: none;
  }

  .mg-quote__phone:focus-visible {
    outline: 2px solid var(--mg-focus);
    outline-offset: 4px;
  }

  .mg-quote__phone-icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--mg-radius-pill);
    background-color: var(--mg-action);
    color: var(--mg-on-action);
    transition: background-color var(--mg-dur) var(--mg-ease);
  }

  .mg-quote__phone-icon .mg-icon {
    width: 22px;
    height: 22px;
  }

  @media (hover: hover) {
    .mg-quote__phone:hover .mg-quote__phone-icon {
      background-color: var(--mg-action-hover);
    }

    .mg-quote__phone:hover .mg-quote__phone-number {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.2em;
    }
  }

  .mg-quote__phone-label {
    display: block;
    font-size: var(--mg-fs-small);
    color: var(--mg-ink-2);
  }

  .mg-quote__phone-number {
    display: block;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
    color: var(--mg-ink);
  }

  .mg-quote__hours {
    display: grid;
    gap: var(--mg-space-2);
    margin: 0;
  }

  .mg-quote__phone + .mg-quote__hours {
    padding-top: var(--mg-space-4);
    border-top: 1px solid var(--mg-line);
  }

  .mg-quote__hours-row {
    display: flex;
    justify-content: space-between;
    gap: var(--mg-space-4);
    font-size: 0.9375rem;
  }

  .mg-quote__hours dt {
    color: var(--mg-ink-2);
  }

  .mg-quote__hours dd {
    margin: 0;
    font-weight: 500;
    text-align: end;
    font-variant-numeric: tabular-nums;
    color: var(--mg-ink);
  }

  @media screen and (min-width: 750px) {
    .mg-quote__card {
      padding: var(--mg-space-6);
    }
  }

  @media screen and (min-width: 990px) {
    .mg-quote__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'intro main'
        'details main';
      column-gap: var(--mg-space-8);
      row-gap: var(--mg-space-7);
    }

    .mg-quote--panel .mg-quote__layout {
      grid-template-rows: auto;
      grid-template-areas: 'details main';
      margin-block-start: var(--mg-space-7);
    }

    .mg-quote__details {
      position: sticky;
      top: calc(var(--header-height, 0px) + var(--mg-space-6));
      align-self: start;
    }

    .mg-quote__card {
      padding: var(--mg-space-7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-quote__phone-icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('mg-quote-form')) {
    /**
     * Quote form helpers:
     * - builds the WhatsApp "dash photo" message live from the reg, car and service typed
     * - remembers the answers for this tab so the success panel can reuse them and an
     *   error reload does not wipe the custom fields
     * - pre-fills fields from the URL, e.g. ?reg=241-D-12345&make=BMW&service=Dashcam (the home
     *   hero's plate form sends ?reg=; service and make links elsewhere send ?service= and ?make=)
     * - moves focus to the success or error panel after a submit
     */
    class MgQuoteForm extends HTMLElement {
      connectedCallback() {
        this.form = this.querySelector('form');
        this.storageKey = 'mg-quote:' + (this.dataset.sectionId || '');
        this.baseMessage = this.dataset.waMessage || '';
        this.waNumber = this.dataset.waNumber || '';

        const status = this.querySelector('[data-mg-quote-status]');
        const saved = this.load();

        if (status) {
          window.requestAnimationFrame(() => status.focus());
        }

        if (status && status.dataset.state === 'success') {
          this.updateLinks(saved || {});
          this.forget();
          return;
        }

        if (!this.form) return;

        if (status && saved) this.restore(saved);
        this.prefillFromUrl();
        this.updateLinks(this.collect());

        this.handleInput = this.onInput.bind(this);
        this.handleSubmit = this.onSubmit.bind(this);
        this.handleInvalid = this.onInvalid.bind(this);
        this.form.addEventListener('input', this.handleInput);
        this.form.addEventListener('change', this.handleInput);
        this.form.addEventListener('submit', this.handleSubmit);
        this.form.addEventListener('invalid', this.handleInvalid, true);
      }

      disconnectedCallback() {
        if (!this.form || !this.handleInput) return;
        this.form.removeEventListener('input', this.handleInput);
        this.form.removeEventListener('change', this.handleInput);
        this.form.removeEventListener('submit', this.handleSubmit);
        this.form.removeEventListener('invalid', this.handleInvalid, true);
      }

      field(name) {
        return this.form ? this.form.elements.namedItem('contact[' + name + ']') : null;
      }

      collect() {
        const data = {};
        if (!this.form) return data;
        Array.from(this.form.elements).forEach((el) => {
          if (!el.name || el.name.indexOf('contact[') !== 0 || el.type === 'hidden') return;
          data[el.name] = String(el.value || '').trim();
        });
        return data;
      }

      message(data) {
        const get = (name) => String(data['contact[' + name + ']'] || '').trim();
        const make = /^other\b/i.test(get('Car make')) ? '' : get('Car make');
        const car = [get('Car year'), make, get('Car model')].filter(Boolean).join(' ');
        const reg = get('Registration number').toUpperCase();
        const service = get('Service');
        const parts = [];
        if (reg) parts.push('Reg: ' + reg);
        if (car) parts.push('Car: ' + car);
        if (service) parts.push('Service: ' + service);
        return parts.length ? this.baseMessage + ' ' + parts.join(', ') : this.baseMessage;
      }

      updateLinks(data) {
        if (!this.waNumber) return;
        const href = 'https://wa.me/' + this.waNumber + '?text=' + encodeURIComponent(this.message(data));
        this.querySelectorAll('[data-mg-wa-photo]').forEach((link) => {
          link.setAttribute('href', href);
        });
      }

      onInput(event) {
        const target = event.target;
        if (event.type === 'change' && target.name === 'contact[Registration number]') {
          target.value = target.value.toUpperCase().trim();
        }
        if (target.getAttribute('aria-invalid') === 'true' && target.validity && target.validity.valid) {
          target.removeAttribute('aria-invalid');
        }
        this.updateLinks(this.collect());
      }

      onSubmit() {
        this.save(this.collect());
      }

      onInvalid(event) {
        event.target.setAttribute('aria-invalid', 'true');
      }

      restore(saved) {
        Object.keys(saved).forEach((name) => {
          const el = this.form.elements.namedItem(name);
          if (el && 'value' in el && !el.value && saved[name]) el.value = saved[name];
        });
      }

      prefillFromUrl() {
        let params;
        try {
          params = new URLSearchParams(window.location.search);
        } catch (error) {
          return;
        }
        const map = { reg: 'Registration number', make: 'Car make', model: 'Car model', year: 'Car year', service: 'Service' };
        Object.keys(map).forEach((param) => {
          let value = (params.get(param) || '').trim();
          const el = this.field(map[param]);
          if (!value || !el || el.value) return;
          if (el.tagName === 'SELECT') {
            const query = value.toLowerCase();
            const options = Array.from(el.options).filter((option) => option.value);
            const match =
              options.find((option) => option.value.toLowerCase() === query) ||
              options.find((option) => option.value.toLowerCase().indexOf(query) !== -1);
            if (match) el.value = match.value;
          } else {
            if (param === 'reg') value = value.toUpperCase().replace(/\s+/g, ' ');
            const max = el.maxLength > 0 ? el.maxLength : 60;
            el.value = value.slice(0, Math.min(max, 60));
          }
        });
      }

      load() {
        try {
          const raw = window.sessionStorage.getItem(this.storageKey);
          return raw ? JSON.parse(raw) : null;
        } catch (error) {
          return null;
        }
      }

      save(data) {
        try {
          window.sessionStorage.setItem(this.storageKey, JSON.stringify(data));
        } catch (error) {
          /* Storage unavailable: the form still submits normally. */
        }
      }

      forget() {
        try {
          window.sessionStorage.removeItem(this.storageKey);
        } catch (error) {
          /* Nothing to clear. */
        }
      }
    }

    customElements.define('mg-quote-form', MgQuoteForm);
  }
{% endjavascript %}

{% schema %}
{
  "name": "MG quote form",
  "tag": "div",
  "class": "mg-quote-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background",
