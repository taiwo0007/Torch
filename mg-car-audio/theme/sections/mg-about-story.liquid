{%- liquid
  assign heading = section.settings.heading | strip
  assign heading_id = 'MgAboutHeading-' | append: section.id

  assign section_classes = 'mg-section mg-about'
  if section.settings.background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--band'
  endif
  if section.settings.image_side == 'right'
    assign section_classes = section_classes | append: ' mg-about--flip'
  endif

  assign heading_tag = 'h2'
  assign heading_class = 'mg-pg-caps mg-about__title'
  if section.settings.heading_is_h1
    assign heading_tag = 'h1'
    assign heading_class = 'mg-pg-h1 mg-about__title mg-load-rise'
  endif

  assign asset = section.settings.fallback_asset | default: 'mg-showroom'
  assign asset_prefix = asset | slice: 0, 7
  assign fallback_alt = ''
  unless asset_prefix == 'mg-img-'
    case asset
      when 'mg-showroom'
        assign fallback_alt = 'The MG Car Audio showroom in Dublin 12, with screens and speakers on the wall'
      when 'mg-bmw-carplay-screen'
        assign fallback_alt = 'BMW widescreen display running Apple CarPlay'
      when 'mg-audi-carplay-screen'
        assign fallback_alt = 'Audi dashboard showing Apple CarPlay with an iPhone'
      when 'mg-dash-radio'
        assign fallback_alt = 'Dashboard with an upgraded head unit'
      when 'mg-door-speaker'
        assign fallback_alt = 'Upgraded speaker in a car door'
    endcase
  endunless

  assign img_sizes = '(min-width: 1184px) 560px, (min-width: 990px) 50vw, 100vw'
  assign img_loading = 'lazy'
  if section.settings.heading_is_h1
    assign img_loading = 'eager'
  endif

  assign stats = section.blocks | where: 'type', 'stat'
-%}

<div
  class="{{ section_classes }}"
  {% if heading != blank %}
    role="region" aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="mg-container">
    <div
      class="mg-panel mg-panel--flush mg-about__panel"
      data-mg-reveal
    >
      <div class="mg-about__media">
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign focal_style = 'object-position: ' | append: section.settings.image.presentation.focal_point
            assign image_alt = section.settings.image.alt | default: ''
          -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '480, 720, 960, 1200, 1400',
              sizes: img_sizes,
              loading: img_loading,
              alt: image_alt,
              class: 'mg-about__img',
              style: focal_style
          }}
        {%- else -%}
          {%- render 'mg-asset-image',
            asset: asset,
            sizes: img_sizes,
            loading: img_loading,
            alt: fallback_alt,
            class: 'mg-about__img'
          -%}
        {%- endif -%}
      </div>

      <div class="mg-about__content">
        {%- if heading != blank -%}
          <{{ heading_tag }}
            id="{{ heading_id }}"
            class="{{ heading_class }}"
          >
            {{ heading | escape }}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="mg-about__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if stats.size > 0 -%}
          <dl class="mg-about__stats">
            {%- for block in stats -%}
              {%- liquid
                assign stat_value = block.settings.value | strip
                case block.settings.source
                  when 'rating'
                    if settings.mg_review_rating != blank
                      assign stat_value = settings.mg_review_rating | strip | append: '★'
                    endif
                  when 'count'
                    if settings.mg_review_count != blank
                      assign stat_value = settings.mg_review_count | strip
                    endif
                endcase
              -%}
              {%- if stat_value != blank -%}
                <div
                  class="mg-about__stat"
                  {{ block.shopify_attributes }}
                >
                  <dt class="mg-pg-label mg-about__stat-label">{{ block.settings.label | escape }}</dt>
                  <dd class="mg-about__stat-value">{{ stat_value | escape }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
          <div class="mg-actions mg-about__actions">
            {%- if section.settings.button_label != blank -%}
              <a
                class="mg-btn mg-btn--primary"
                href="{{ section.settings.button_url | default: '/collections/all' }}"
              >
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button_2_label != blank -%}
              <a
                class="mg-btn mg-btn--secondary"
                href="{{ section.settings.button_2_url | default: '/collections/all' }}"
              >
                {{- section.settings.button_2_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /*
   * About split band: a photo and the story side by side from 990px (photo first on phones,
   * never hidden). Optional stat row under the text. Colour and type from mg-theme.css.
   */
  .mg-about__panel {
    display: grid;
  }

  .mg-about__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--mg-band-2);
  }

  .mg-about__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mg-about__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--mg-space-4);
    min-width: 0;
    padding: var(--mg-panel-pad);
  }

  .mg-about__title {
    margin: 0;
    max-width: 18ch;
    color: var(--mg-ink);
  }

  h2.mg-about__title {
    font-size: clamp(1.625rem, 4vw, 2.5rem);
    line-height: 1.04;
  }

  .mg-about__text {
    max-width: 60ch;
    font-size: var(--mg-fs-body);
    line-height: 1.65;
    color: var(--mg-ink-2);
  }

  .mg-about__text > * {
    margin: 0 0 0.9em;
  }

  .mg-about__text > :last-child {
    margin-bottom: 0;
  }

  .mg-about__text strong {
    color: var(--mg-ink);
  }

  .mg-about__text a {
    color: var(--mg-ink);
    font-weight: 500;
    text-decoration-line: underline;
    text-underline-offset: 0.22em;
  }

  /* Stats: big numbers with a small label, red rule on top */
  .mg-about__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--mg-space-5) var(--mg-space-4);
    align-self: stretch;
    margin: var(--mg-space-2) 0 0;
  }

  .mg-about__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--mg-space-1);
    min-width: 0;
    padding-top: var(--mg-space-3);
    border-top: 2px solid var(--mg-red);
  }

  .mg-about__stat-value {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--mg-ink);
    overflow-wrap: anywhere;
  }

  .mg-about__actions {
    margin-top: var(--mg-space-2);
  }

  @media screen and (min-width: 750px) {
    .mg-about__media {
      aspect-ratio: 16 / 9;
    }

    .mg-about__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mg-about__stats:has(> :nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mg-about__stats:has(> :nth-child(2):last-child) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .mg-about__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: 480px;
    }

    .mg-about--flip .mg-about__media {
      order: 2;
    }

    .mg-about__media {
      aspect-ratio: auto;
    }

    .mg-about__content {
      justify-content: center;
      padding: var(--mg-space-8);
    }

    .mg-about__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mg-about__stats:has(> :nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG about story",
  "tag": "section",
  "class": "mg-about-story-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "A photo and text side by side. Add up to four 'Stat' blocks for a row of figures under the text."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ireland's CarPlay and car audio specialist"
    },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "Heading is the page's main heading (H1)",
      "info": "Turn on for the first band of the About page only.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We make the car you already love feel brand new inside. From Apple CarPlay and Android Auto on your factory screen to widescreen upgrades and premium sound, we bring modern in-car technology to your dashboard with a clean, factory-quality finish.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "A real photo of the workshop, team or a finished job works best."
    },
    {
      "type": "select",
      "id": "fallback_asset",
      "label": "Photo to use until one is uploaded",
      "info": "Stock mood photos are marked (stock) and are never shown as MG's own work.",
      "options": [
        { "value": "mg-showroom", "label": "MG showroom" },
        { "value": "mg-bmw-carplay-screen", "label": "BMW CarPlay screen" },
        { "value": "mg-audi-carplay-screen", "label": "Audi CarPlay with iPhone" },
        { "value": "mg-dash-radio", "label": "Dash with head unit" },
        { "value": "mg-door-speaker", "label": "Door speaker" },
        { "value": "mg-img-panel-workshop", "label": "Car in a dark workshop (stock)" },
        { "value": "mg-img-panel-promise", "label": "Hands on wiring (stock)" }
      ],
      "default": "mg-showroom"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Photo side on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "surface", "label": "Grey band" }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Main button label",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Main button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label",
      "info": "Leave blank to hide."
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Second button link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Figure",
          "options": [
            { "value": "custom", "label": "Type my own" },
            { "value": "rating", "label": "Google rating (Theme settings)" },
            { "value": "count", "label": "Google review count (Theme settings)" }
          ],
          "default": "custom"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "Short, for example 20+ or D12. Used when Figure is 'Type my own', or when the Theme setting is blank.",
          "default": "20+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Makes covered"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MG about story",
      "category": "MG Car Audio"
    }
  ]
}
{% endschema %}
