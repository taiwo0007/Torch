{%- liquid
  assign heading_id = 'MgSvcCtaHeading-' | append: section.id
  assign book_url = section.settings.book_url | default: '/pages/book-a-fitting'
  assign wa_message = section.settings.whatsapp_message | default: settings.mg_whatsapp_message

  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_number != blank and section.settings.whatsapp_label != blank
    assign show_whatsapp = true
  endif

  assign show_call = false
  if section.settings.show_call and settings.mg_phone_e164 != blank
    assign show_call = true
  endif

  assign show_book = false
  if section.settings.book_label != blank
    assign show_book = true
  endif

  assign panel_classes = 'mg-panel mg-svc-cta__panel'
  if section.settings.style == 'band'
    assign panel_classes = panel_classes | append: ' mg-svc-cta__panel--band'
  else
    assign panel_classes = panel_classes | append: ' mg-surface-red'
  endif

  # WhatsApp is the main action here (the copy asks for a reg and a dash photo); without it, Book is
  assign book_class = 'mg-btn--secondary'
  unless show_whatsapp
    assign book_class = 'mg-btn--primary'
  endunless
-%}

<div class="mg-section mg-svc-cta">
  <div class="mg-container">
    <div
      class="{{ panel_classes }}"
      data-mg-reveal
      {% if section.settings.heading != blank %}
        role="region" aria-labelledby="{{ heading_id }}"
      {% endif %}
    >
      <div class="mg-svc-cta__content">
        {%- if section.settings.heading != blank -%}
          <h2
            class="mg-display mg-svc-cta__heading"
            id="{{ heading_id }}"
          >
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="mg-lede mg-svc-cta__text">{{ section.settings.text | escape | newline_to_br }}</p>
        {%- endif -%}

        {%- if section.settings.show_details -%}
          <ul
            class="mg-svc-cta__details"
            role="list"
          >
            {%- if settings.mg_hours_weekdays != blank -%}
              <li>
                {%- render 'mg-icon', icon: 'clock' -%}
                <span>
                  Mon to Fri {{ settings.mg_hours_weekdays | escape -}}
                  {%- if settings.mg_hours_saturday != blank %}, Sat {{ settings.mg_hours_saturday | escape }}{% endif -%}
                  {%- if settings.mg_hours_sunday != blank %}, Sun {{ settings.mg_hours_sunday | downcase | escape }}{% endif -%}
                </span>
              </li>
            {%- endif -%}
            {%- if settings.mg_street != blank or settings.mg_locality != blank -%}
              <li>
                {%- render 'mg-icon', icon: 'map-pin' -%}
                <span>
                  {{- settings.mg_street | escape -}}
                  {%- if settings.mg_street != blank and settings.mg_locality != blank %}, {% endif -%}
                  {{- settings.mg_locality | escape -}}
                </span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if show_whatsapp or show_call or show_book -%}
        <div class="mg-svc-cta__actions">
          {%- if show_whatsapp -%}
            <a
              class="mg-btn mg-btn--primary mg-btn--lg mg-btn--block"
              href="https://wa.me/{{ settings.mg_whatsapp_number }}?text={{ wa_message | url_encode }}"
              target="_blank"
              rel="noopener"
            >
              {%- render 'mg-icon', icon: 'whatsapp' -%}
              <span>{{ section.settings.whatsapp_label | escape }}</span>
              <span class="mg-visually-hidden"> (opens WhatsApp)</span>
            </a>
          {%- endif -%}
          {%- if show_book -%}
            <a
              class="mg-btn {{ book_class }} mg-btn--lg mg-btn--block"
              href="{{ book_url }}"
            >
              {%- render 'mg-icon', icon: 'calendar' -%}
              <span>{{ section.settings.book_label | escape }}</span>
            </a>
          {%- endif -%}
          {%- if show_call -%}
            <a
              class="mg-btn mg-btn--secondary mg-btn--lg mg-btn--block"
              href="tel:+{{ settings.mg_phone_e164 }}"
            >
              {%- render 'mg-icon', icon: 'phone' -%}
              <span>
                {{- section.settings.call_label | escape -}}
                {%- if settings.mg_phone_display != blank %} {{ settings.mg_phone_display | escape }}{% endif -%}
              </span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  /*
   * Closing call to action: a rounded MG red panel (or a grey one), statement heading and
   * text on the left, stacked buttons on the right from 990px. Layout only; colour, type and
   * button states come from mg-theme.css (.mg-panel, .mg-surface-red, .mg-display, .mg-btn).
   */
  .mg-svc-cta__panel {
    display: grid;
    gap: var(--mg-space-5);
  }

  .mg-svc-cta__content {
    min-width: 0;
  }

  .mg-svc-cta__heading {
    max-width: 18ch;
  }

  .mg-svc-cta__text {
    max-width: 52ch;
  }

  .mg-svc-cta__details {
    display: grid;
    gap: var(--mg-space-2);
    margin: var(--mg-space-5) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--mg-fs-small);
    line-height: 1.45;
  }

  .mg-svc-cta__details li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: start;
    gap: var(--mg-space-2);
  }

  .mg-svc-cta__details .mg-icon {
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }

  /* Grey panel: secondary lines in ink-2 (on red they follow the white text) */
  .mg-svc-cta__panel--band .mg-svc-cta__details {
    color: var(--mg-ink-2);
  }

  .mg-svc-cta__panel--band .mg-svc-cta__details .mg-icon {
    color: var(--mg-ink-3);
  }

  .mg-svc-cta__actions {
    display: grid;
    gap: var(--mg-space-3);
    align-content: center;
  }

  @media screen and (min-width: 750px) {
    .mg-svc-cta__details {
      display: flex;
      flex-wrap: wrap;
      gap: var(--mg-space-2) var(--mg-space-5);
    }

    .mg-svc-cta__actions {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .mg-svc-cta__panel {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
      align-items: center;
      gap: var(--mg-space-8);
    }

    .mg-svc-cta__actions {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG service call to action",
  "tag": "section",
  "class": "mg-service-cta-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Panel",
      "info": "MG red works as the closing panel of a page. Use grey when the section above is already red.",
      "options": [
        { "value": "red", "label": "MG red" },
        { "value": "band", "label": "Grey" }
      ],
      "default": "red"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure what fits your car?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Send your reg and a photo of your dash on WhatsApp. We'll tell you which option suits your car, what it costs and how long the fitting takes."
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show opening hours and location",
      "info": "From Theme settings > MG Car Audio: business details. Leave off when this banner ends the page: the footer below already lists the hours and address.",
      "default": false
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp button",
      "info": "The main button in this panel. Uses the WhatsApp number in Theme settings > MG Car Audio: business details.",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "WhatsApp us",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp pre-filled message",
      "info": "Leave blank to use the message from Theme settings.",
      "default": "Hi MG Car Audio, can you tell me which CarPlay or Android Auto option fits my car? My reg is: ",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "text",
      "id": "book_label",
      "label": "Booking button label",
      "info": "Leave blank to hide.",
      "default": "Book a fitting"
    },
    {
      "type": "url",
      "id": "book_url",
      "label": "Booking button link",
      "info": "Leave blank to link to /pages/book-a-fitting."
    },
    {
      "type": "checkbox",
      "id": "show_call",
      "label": "Show call button",
      "info": "Uses the phone number in Theme settings > MG Car Audio: business details.",
      "default": true
    },
    {
      "type": "text",
      "id": "call_label",
      "label": "Call button label",
      "info": "The phone number is added after this text.",
      "default": "Call",
      "visible_if": "{{ section.settings.show_call }}"
    }
  ],
  "presets": [
    {
      "name": "MG service call to action",
      "category": "MG Car Audio"
    }
  ]
}
{% endschema %}
