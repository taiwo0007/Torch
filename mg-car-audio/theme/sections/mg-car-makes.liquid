{%- liquid
  assign heading_id = 'MgMakesHeading-' | append: section.id
  assign view_all_url = section.settings.view_all_url | default: '/pages/get-a-quote'
  assign centred = false
  if section.settings.align_desktop == 'center'
    assign centred = true
  endif
-%}

{%- comment -%} Loads the chip focus helper (a focused chip scrolls clear of the edge fade) {%- endcomment -%}
{%- render 'mg-carousel-script' -%}

<div class="mg-section mg-makes{% if centred %} mg-makes--center{% endif %}">
  <div class="mg-container mg-makes__layout">
    {%- if section.settings.heading != blank or section.settings.view_all_label != blank -%}
      <div class="mg-head mg-makes__head">
        <div class="mg-head__text">
          {%- if section.settings.heading != blank -%}
            <h2
              class="mg-head__title"
              id="{{ heading_id }}"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mg-head__sub">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.view_all_label != blank -%}
          <a
            class="mg-link mg-head__link"
            href="{{ view_all_url }}"
          >
            {{- section.settings.view_all_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="mg-chips mg-chips--bleed mg-makes__chips"
        role="list"
        {% if section.settings.heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% else %}
          aria-label="Car makes"
        {% endif %}
      >
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'make' -%}
              {%- liquid
                assign make_name = block.settings.name | strip
                if make_name == blank
                  continue
                endif
                assign make_handle = make_name | handleize
                assign default_make_url = '/pages/' | append: make_handle | append: '-carplay'
                assign chip_url = block.settings.url | default: default_make_url
                assign chip_sub = block.settings.subtitle | strip
              -%}
              <li {{ block.shopify_attributes }}>
                <a
                  class="mg-chip mg-makes__chip"
                  href="{{ chip_url }}"
                  {% if request.path == chip_url %}
                    aria-current="page"
                  {% endif %}
                >
                  {%- if block.settings.image != blank -%}
                    <span
                      class="mg-makes__avatar"
                      aria-hidden="true"
                    >
                      {{-
                        block.settings.image
                        | image_url: width: 96, height: 96, crop: 'center'
                        | image_tag: width: 24, height: 24, loading: 'lazy', alt: ''
                      -}}
                    </span>
                  {%- endif -%}
                  <span class="mg-makes__name">{{ make_name | escape }}</span>
                  {%- if chip_sub != blank %}
                    <span class="mg-makes__sub">{{ chip_sub | escape }}</span>
                  {%- endif -%}
                </a>
              </li>
            {%- when 'link' -%}
              {%- liquid
                assign chip_label = block.settings.label | strip
                if chip_label == blank
                  continue
                endif
                assign chip_url = block.settings.url | default: '/pages/get-a-quote'
              -%}
              <li {{ block.shopify_attributes }}>
                <a
                  class="mg-chip mg-makes__chip"
                  href="{{ chip_url }}"
                  {% if request.path == chip_url %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="mg-makes__name">{{ chip_label | escape }}</span>
                </a>
              </li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mg-makes__avatar {
    display: block;
    flex: none;
    width: 24px;
    height: 24px;
    margin-inline-start: -4px;
    overflow: hidden;
    border-radius: var(--mg-radius-xs);
  }

  .mg-makes__avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The subtitle only shows where there is room: tablet and desktop */
  .mg-makes__sub {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .mg-makes__chips {
      flex-wrap: wrap;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
      animation: none;
    }

    .mg-makes--center .mg-makes__head {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .mg-makes--center .mg-makes__head .mg-head__text {
      flex: none;
      justify-items: center;
    }

    .mg-makes--center .mg-makes__chips {
      justify-content: center;
    }

    .mg-makes__sub {
      display: inline;
      font-size: var(--mg-fs-micro);
      font-weight: 400;
      color: var(--mg-ink-2);
    }

    .mg-makes__chip[aria-current] .mg-makes__sub {
      color: inherit;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "MG shop by car",
  "tag": "section",
  "class": "mg-makes-section",
  "max_blocks": 24,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by car"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Line under the heading",
      "info": "Optional. One short sentence."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label",
      "info": "Shown on the right of the heading. Leave blank to hide the link.",
      "default": "Other makes"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Link",
      "info": "Leave blank to link to /pages/get-a-quote."
    },
    {
      "type": "select",
      "id": "align_desktop",
      "label": "Alignment on tablet and desktop",
      "info": "The heading and link sit above the chips, as in the other sections. Phones always show one row you can swipe.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "make",
      "name": "Car make",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Make",
          "default": "BMW"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Small text after the make",
          "info": "Optional, e.g. iDrive. Shown on tablet and desktop only."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Leave blank to link to /pages/[make]-carplay, e.g. /pages/bmw-carplay or /pages/mercedes-benz-carplay."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Small image",
          "info": "Optional. Shown as a small square before the make. Don't use car-maker logos."
        }
      ]
    },
    {
      "type": "link",
      "name": "Other link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Japanese imports"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Leave blank to link to /pages/get-a-quote."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MG shop by car",
      "category": "MG Car Audio",
      "blocks": [
        { "type": "make", "settings": { "name": "BMW" } },
        { "type": "make", "settings": { "name": "Audi" } },
        { "type": "make", "settings": { "name": "Mercedes-Benz" } },
        { "type": "make", "settings": { "name": "Volkswagen" } },
        { "type": "make", "settings": { "name": "Toyota", "url": "/pages/get-a-quote?make=Toyota" } },
        { "type": "make", "settings": { "name": "Lexus", "url": "/pages/get-a-quote?make=Lexus" } },
        { "type": "make", "settings": { "name": "Ford", "url": "/pages/get-a-quote?make=Ford" } },
        { "type": "make", "settings": { "name": "Nissan", "url": "/pages/get-a-quote?make=Nissan" } },
        { "type": "make", "settings": { "name": "Honda", "url": "/pages/get-a-quote?make=Honda" } },
        { "type": "make", "settings": { "name": "Mazda", "url": "/pages/get-a-quote?make=Mazda" } },
        { "type": "make", "settings": { "name": "Hyundai", "url": "/pages/get-a-quote?make=Hyundai" } },
        { "type": "make", "settings": { "name": "Kia", "url": "/pages/get-a-quote?make=Kia" } },
        {
          "type": "link",
          "settings": {
            "label": "Japanese imports",
            "url": "/pages/get-a-quote?service=japan-to-europe"
          }
        }
      ]
    }
  ]
}
{% endschema %}
