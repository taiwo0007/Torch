{%- liquid
  assign statement = section.settings.statement | strip
  assign subline = section.settings.subline
-%}

<div class="mg-section mg-section--flush mg-trust-bar{% if section.settings.attach %} mg-trust-bar--attach{% endif %}">
  {%- if statement != blank or subline != blank -%}
    <div class="mg-container">
      <div
        class="mg-head mg-head--center mg-trust-bar__head"
        data-mg-reveal
      >
        <div class="mg-head__text">
          {%- if statement != blank -%}
            <h2 class="mg-head__title">{{ statement | escape }}</h2>
          {%- endif -%}
          {%- if subline != blank -%}
            <p class="mg-head__sub mg-trust-bar__sub">{{ subline }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="mg-trust-bar__strip">
      <div class="mg-container">
        <ul
          class="mg-trust-bar__list"
          role="list"
        >
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'rating' -%}
                {%- liquid
                  assign rating = settings.mg_review_rating | strip
                  assign rating_value = rating | replace: ',', '.' | plus: 0 | at_most: 5 | at_least: 0
                  assign rating_url = block.settings.url | default: settings.mg_review_url

                  assign review_line = block.settings.label | strip
                  if settings.mg_review_count != blank
                    assign count_part = settings.mg_review_count | strip
                    if block.settings.count_prefix != blank
                      assign count_part = block.settings.count_prefix | strip | append: ' ' | append: count_part
                    endif
                    assign review_line = count_part | append: ' ' | append: review_line | strip
                  endif
                -%}
                {%- if rating != blank -%}
                  <li
                    class="mg-trust-bar__item"
                    {{ block.shopify_attributes }}
                  >
                    {%- if rating_url != blank -%}
                      <a
                        class="mg-trust-bar__inner mg-trust-bar__inner--link"
                        href="{{ rating_url }}"
                        target="_blank"
                        rel="noopener"
                      >
                    {%- else -%}
                      <span class="mg-trust-bar__inner">
                    {%- endif -%}
                    {%- render 'mg-icon', icon: 'star', class: 'mg-trust-bar__icon' -%}
                    <span class="mg-trust-bar__body">
                      <span class="mg-trust-bar__title">
                        <span class="mg-trust-bar__score">{{ rating | escape }}</span>
                        <span
                          class="mg-stars mg-stars--sm"
                          style="--mg-rating: {{ rating_value }};"
                          role="img"
                          aria-label="Rated {{ rating | escape }} out of 5"
                        ></span>
                      </span>
                      {%- if review_line != blank -%}
                        <span class="mg-trust-bar__meta">{{ review_line | escape }}</span>
                      {%- endif -%}
                      {%- if rating_url != blank -%}
                        <span class="mg-visually-hidden"> (opens in a new tab)</span>
                      {%- endif -%}
                    </span>
                    {%- if rating_url != blank -%}
                      </a>
                    {%- else -%}
                      </span>
                    {%- endif -%}
                  </li>
                {%- endif -%}

              {%- when 'item' -%}
                {%- liquid
                  assign title = block.settings.title | strip
                  assign text = block.settings.text | strip
                  assign url = block.settings.url
                  assign is_external = false
                  assign external_note = ''

                  case block.settings.source
                    when 'warranty'
                      assign title = title | default: settings.mg_warranty_text
                    when 'phone'
                      assign title = title | default: settings.mg_phone_display
                      if settings.mg_hours_weekdays != blank
                        assign hours_text = 'Mon to Fri, ' | append: settings.mg_hours_weekdays
                        assign text = text | default: hours_text
                      endif
                      if url == blank and settings.mg_phone_e164 != blank
                        assign url = 'tel:+' | append: settings.mg_phone_e164
                      endif
                    when 'address'
                      if settings.mg_locality != blank
                        # Spaces become no-break spaces (U+00A0) so 'Dublin 12' never splits over two lines
                        assign locality_title = settings.mg_locality | strip | replace: ' ', ' ' | append: ' workshop'
                        assign title = title | default: locality_title
                      endif
                      if url == blank and settings.mg_map_query != blank
                        assign map_query = settings.mg_map_query | url_encode
                        assign url = 'https://www.google.com/maps/search/?api=1&query=' | append: map_query
                        assign is_external = true
                        assign external_note = ' (opens Google Maps in a new tab)'
                      endif
                  endcase
                -%}
                {%- if title != blank or text != blank -%}
                  <li
                    class="mg-trust-bar__item"
                    {{ block.shopify_attributes }}
                  >
                    {%- if url != blank -%}
                      <a
                        class="mg-trust-bar__inner mg-trust-bar__inner--link"
                        href="{{ url }}"
                        {% if is_external %}
                          target="_blank" rel="noopener"
                        {% endif %}
                      >
                    {%- else -%}
                      <span class="mg-trust-bar__inner">
                    {%- endif -%}
                    {%- render 'mg-icon', icon: block.settings.icon, class: 'mg-trust-bar__icon' -%}
                    <span class="mg-trust-bar__body">
                      {%- if title != blank -%}
                        <span class="mg-trust-bar__title">{{ title | escape }}</span>
                      {%- endif -%}
                      {%- if text != blank -%}
                        <span class="mg-trust-bar__meta">{{ text | escape }}</span>
                      {%- endif -%}
                      {%- if is_external -%}
                        <span class="mg-visually-hidden">{{ external_note }}</span>
                      {%- endif -%}
                    </span>
                    {%- if url != blank -%}
                      </a>
                    {%- else -%}
                      </span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /*
   * MG trust strip: a slim full-bleed band straight under the hero (the info strip of the
   * reference layout, moved below the header so phones keep a short header). 4 items in a row
   * with hairline dividers from 750px; a compact 2 by 2 grid on phones. Optional heading above.
   */
  /* Pulls the strip up against the section above (it cancels that section's bottom spacing) */
  .mg-trust-bar--attach {
    margin-block-start: calc(var(--mg-section-pad) * -1);
  }

  .mg-trust-bar__head {
    padding-block: var(--mg-space-7) var(--mg-space-5);
  }

  .mg-trust-bar__sub {
    max-width: 52ch;
    text-wrap: balance;
  }

  .mg-trust-bar__sub a {
    color: inherit;
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.22em;
  }

  .mg-trust-bar__strip {
    border-block-end: 1px solid var(--mg-line);
    background-color: var(--mg-band);
  }

  .mg-trust-bar__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--mg-space-3);
    margin: 0;
    padding: var(--mg-space-2) 0;
    list-style: none;
  }

  .mg-trust-bar__item {
    display: flex;
    min-width: 0;
    margin: 0;
  }

  .mg-trust-bar__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .mg-trust-bar__inner {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--mg-space-3);
    min-width: 0;
    min-height: 52px;
    border-radius: var(--mg-radius-sm);
    color: var(--mg-ink);
    text-decoration: none;
  }

  .mg-trust-bar .mg-trust-bar__icon {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--mg-red);
  }

  .mg-trust-bar__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .mg-trust-bar__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mg-space-1) var(--mg-space-2);
    font-size: var(--mg-fs-small);
    font-weight: 600;
    line-height: 1.25;
    text-wrap: pretty;
  }

  .mg-trust-bar__score {
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .mg-trust-bar__meta {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--mg-ink-2);
  }

  @media (hover: hover) {
    .mg-trust-bar__inner--link:hover .mg-trust-bar__meta {
      color: var(--mg-ink);
      text-decoration-line: underline;
      text-underline-offset: 0.22em;
    }
  }

  @media screen and (max-width: 374px) {
    .mg-trust-bar__title .mg-stars {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .mg-trust-bar__list {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      grid-auto-flow: column;
      gap: 0;
      padding: 0;
    }

    .mg-trust-bar__item:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .mg-trust-bar__item {
      justify-content: center;
      padding-inline: var(--mg-space-4);
    }

    .mg-trust-bar__item + .mg-trust-bar__item {
      border-inline-start: 1px solid var(--mg-line);
    }

    .mg-trust-bar__inner {
      flex: 0 1 auto;
      min-height: 72px;
    }
  }

  /* Tablet: four across is tight, so only the titles show */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .mg-trust-bar__meta {
      display: none;
    }

    .mg-trust-bar__item {
      padding-inline: var(--mg-space-2);
    }

    .mg-trust-bar__title .mg-stars {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-trust-bar .mg-trust-bar__icon {
      width: 24px;
      height: 24px;
    }

    .mg-trust-bar__title {
      font-size: 0.9375rem;
    }

    .mg-trust-bar__meta {
      font-size: var(--mg-fs-micro);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG trust bar",
  "tag": "section",
  "class": "mg-trust-section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "statement",
      "label": "Statement",
      "info": "Optional short line above the strip. Leave blank (with the subline) for the slim strip on its own, as on the home page."
    },
    {
      "type": "inline_richtext",
      "id": "subline",
      "label": "Subline",
      "info": "PLACEHOLDER: confirm the warranty wording with MG before launch. The strip's warranty item shows the warranty text from Theme settings, so keep the two consistent. You can add a link, for example to a warranty page."
    },
    {
      "type": "checkbox",
      "id": "attach",
      "label": "Sit flush under the section above",
      "info": "On for the home page, so the strip joins the bottom of the hero.",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "A slim strip under the hero: 4 items in a row on desktop, 2 by 2 on phones. Works best with 4 items. The phone, location, rating and warranty text come from Theme settings > MG Car Audio: business details. PLACEHOLDER: copy the Google rating and review count from MG's Google profile, and confirm the warranty wording, before launch."
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Google rating",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "PLACEHOLDER: the rating and review count come from Theme settings > MG Car Audio: business details. Replace them with MG's real Google Business figures before launch."
        },
        {
          "type": "text",
          "id": "count_prefix",
          "label": "Text before the review count",
          "default": "from"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Text after the review count",
          "default": "Google reviews"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Leave blank to use the Google reviews link from Theme settings."
