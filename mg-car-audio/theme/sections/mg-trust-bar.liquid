{%- liquid
  assign statement = section.settings.statement | strip
  assign subline = section.settings.subline

  assign item_count = 0
  for block in section.blocks
    if block.type == 'rating'
      if settings.mg_review_rating != blank
        assign item_count = item_count | plus: 1
      endif
    else
      assign item_count = item_count | plus: 1
    endif
  endfor
  assign tablet_cols = item_count | at_least: 1
  if tablet_cols > 4
    assign tablet_cols = 3
  endif
  assign desktop_cols = item_count | at_least: 1
-%}

<div class="mg-section mg-trust-bar">
  <div class="mg-container">
    {%- if statement != blank or subline != blank -%}
      <div class="mg-head mg-head--center mg-trust-bar__head">
        <div class="mg-head__text mg-trust-bar__text">
          {%- if statement != blank -%}
            <h2 class="mg-display mg-display--center">{{ statement | escape }}</h2>
          {%- endif -%}
          {%- if subline != blank -%}
            <p class="mg-lede mg-trust-bar__sub">{{ subline }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="mg-trust mg-trust-bar__list"
        role="list"
        style="--mg-trust-bar-tablet: {{ tablet_cols }}; --mg-trust-bar-desktop: {{ desktop_cols }};"
      >
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'rating' -%}
              {%- liquid
                assign rating = settings.mg_review_rating | strip
                assign rating_value = rating | plus: 0 | at_most: 5 | at_least: 0
                assign rating_url = block.settings.url | default: settings.mg_review_url

                assign review_line = block.settings.label | strip
                if settings.mg_review_count != blank
                  assign count_part = settings.mg_review_count | strip
                  if block.settings.count_prefix != blank
                    assign count_part = block.settings.count_prefix | strip | append: ' ' | append: count_part
                  endif
                  assign review_line = count_part | append: ' ' | append: review_line | strip
                endif
              -%}
              {%- if rating != blank -%}
                <li
                  class="mg-trust__item mg-trust-bar__item"
                  {{ block.shopify_attributes }}
                >
                  {%- if rating_url != blank -%}
                    <a
                      class="mg-trust-bar__inner mg-trust-bar__inner--link"
                      href="{{ rating_url }}"
                      target="_blank"
                      rel="noopener"
                    >
                  {%- else -%}
                    <span class="mg-trust-bar__inner">
                  {%- endif -%}
                  <span
                    class="mg-trust__icon mg-trust-bar__score"
                    aria-hidden="true"
                  >
                    {{- rating | escape -}}
                  </span>
                  <span class="mg-trust-bar__body">
                    <span
                      class="mg-stars mg-stars--sm"
                      style="--mg-rating: {{ rating_value }};"
                      role="img"
                      aria-label="Rated {{ rating | escape }} out of 5"
                    ></span>
                    {%- if review_line != blank -%}
                      <span class="mg-trust-bar__meta">{{ review_line | escape }}</span>
                    {%- endif -%}
                    {%- if rating_url != blank -%}
                      <span class="mg-visually-hidden"> (opens in a new tab)</span>
                    {%- endif -%}
                  </span>
                  {%- if rating_url != blank -%}
                    </a>
                  {%- else -%}
                    </span>
                  {%- endif -%}
                </li>
              {%- endif -%}

            {%- when 'item' -%}
              {%- liquid
                assign title = block.settings.title | strip
                assign text = block.settings.text | strip
                assign url = block.settings.url
                assign is_external = false
                assign external_note = ''

                case block.settings.source
                  when 'warranty'
                    assign title = title | default: settings.mg_warranty_text
                  when 'phone'
                    assign title = title | default: settings.mg_phone_display
                    if settings.mg_hours_weekdays != blank
                      assign hours_text = 'Mon to Fri, ' | append: settings.mg_hours_weekdays
                      assign text = text | default: hours_text
                    endif
                    if url == blank and settings.mg_phone_e164 != blank
                      assign url = 'tel:+' | append: settings.mg_phone_e164
                    endif
                  when 'address'
                    if settings.mg_locality != blank
                      # Spaces become no-break spaces (U+00A0) so 'Dublin 12' never splits over two lines
                      assign locality_title = settings.mg_locality | strip | replace: ' ', ' ' | append: ' workshop'
                      assign title = title | default: locality_title
                    endif
                    if url == blank and settings.mg_map_query != blank
                      assign map_query = settings.mg_map_query | url_encode
                      assign url = 'https://www.google.com/maps/search/?api=1&query=' | append: map_query
                      assign is_external = true
                      assign external_note = ' (opens Google Maps in a new tab)'
                    endif
                endcase
              -%}
              {%- if title != blank or text != blank -%}
                <li
                  class="mg-trust__item mg-trust-bar__item"
                  {{ block.shopify_attributes }}
                >
                  {%- if url != blank -%}
                    <a
                      class="mg-trust-bar__inner mg-trust-bar__inner--link"
                      href="{{ url }}"
                      {% if is_external %}
                        target="_blank" rel="noopener"
                      {% endif %}
                    >
                  {%- else -%}
                    <span class="mg-trust-bar__inner">
                  {%- endif -%}
                  {%- render 'mg-icon', icon: block.settings.icon, class: 'mg-trust__icon' -%}
                  <span class="mg-trust-bar__body">
                    {%- if title != blank -%}
                      <span class="mg-trust-bar__title">{{ title | escape }}</span>
                    {%- endif -%}
                    {%- if text != blank -%}
                      <span class="mg-trust-bar__meta">{{ text | escape }}</span>
                    {%- endif -%}
                    {%- if is_external -%}
                      <span class="mg-visually-hidden">{{ external_note }}</span>
                    {%- endif -%}
                  </span>
                  {%- if url != blank -%}
                    </a>
                  {%- else -%}
                    </span>
                  {%- endif -%}
                </li>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /*
   * MG trust bar: centred serif statement and subline, then the trust strip.
   * The strip is the shared ul.mg-trust (2x2 band panel on phones, a row from 750px,
   * a pill from 990px). Only layout lives here; rules that adjust a shared component are
   * scoped under .mg-trust-bar so they win whatever order the stylesheets load in.
   */
  .mg-trust-bar .mg-trust-bar__head {
    margin-block-end: var(--mg-space-5);
  }

  .mg-trust-bar .mg-trust-bar__text {
    max-width: none;
  }

  .mg-trust-bar .mg-trust-bar__sub {
    max-width: 44ch;
    text-wrap: balance;
  }

  /* Links added in the subline (rich text) look like .mg-link */
  .mg-trust-bar__sub a {
    color: inherit;
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .mg-trust-bar__sub a:hover {
    color: var(--mg-ink);
    text-decoration-thickness: 2px;
  }

  /* An odd last item spans the row on phones, so the 2x2 panel never has a hole */
  .mg-trust-bar__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .mg-trust-bar__inner {
    display: flex;
    flex: 1;
    align-items: center;
    gap: inherit; /* the icon-to-text gap of .mg-trust__item */
    min-width: 0;
    min-height: var(--mg-tap);
    border-radius: var(--mg-radius-sm);
    color: inherit;
    text-decoration: none;
  }

  .mg-trust-bar__body {
    display: flex;
    flex-direction: column;
    gap: var(--mg-space-1);
    min-width: 0;
  }

  .mg-trust-bar__title {
    text-wrap: pretty;
  }

  .mg-trust-bar__meta {
    font-size: var(--mg-fs-micro);
    font-weight: 400;
    line-height: 1.35;
    color: var(--mg-ink-2);
  }

  /* The rating score sits in the icon square and may be wider than an icon ("4.85") */
  .mg-trust-bar .mg-trust-bar__score {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 20px;
    font-size: var(--mg-fs-micro);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  @media (hover: hover) {
    .mg-trust-bar__inner--link:hover :is(.mg-trust-bar__title, .mg-trust-bar__meta) {
      text-decoration-line: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.22em;
    }
  }

  @media screen and (min-width: 750px) {
    .mg-trust-bar .mg-trust-bar__head {
      margin-block-end: var(--mg-space-6);
    }

    .mg-trust-bar .mg-trust-bar__sub {
      max-width: none;
    }

    .mg-trust-bar .mg-trust-bar__list {
      grid-template-columns: repeat(var(--mg-trust-bar-tablet, 4), minmax(0, 1fr));
    }

    .mg-trust-bar__item:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-trust-bar .mg-trust-bar__head {
      margin-block-end: var(--mg-space-7);
    }

    .mg-trust-bar .mg-trust-bar__list {
      grid-template-columns: repeat(var(--mg-trust-bar-desktop, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG trust bar",
  "tag": "section",
  "class": "mg-trust-section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "statement",
      "label": "Statement",
      "info": "A short centred line in the display serif. Leave blank (with the subline) to show the trust strip on its own.",
      "default": "Ireland's CarPlay and car audio specialist."
    },
    {
      "type": "inline_richtext",
      "id": "subline",
      "label": "Subline",
      "info": "PLACEHOLDER: confirm the warranty wording with MG before launch. The strip's warranty item shows the warranty text from Theme settings, so keep the two consistent. You can add a link, for example to a warranty page.",
      "default": "Fixed fitted prices at our Dublin 12 workshop. Backed by our warranty."
    },
    {
      "type": "paragraph",
      "content": "Works best with 4 items. The phone, location, rating and warranty text come from Theme settings > MG Car Audio: business details. PLACEHOLDER: copy the Google rating and review count from MG's Google profile, and confirm the warranty wording, before launch."
    }
  ],
  "blocks": [
    {
      "type": "rating",
      "name": "Google rating",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "PLACEHOLDER: the rating and review count come from Theme settings > MG Car Audio: business details. Replace them with MG's real Google Business figures before launch."
        },
        {
          "type": "text",
          "id": "count_prefix",
          "label": "Text before the review count",
          "default": "from"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Text after the review count",
          "default": "Google reviews"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Leave blank to use the Google reviews link from Theme settings."
        }
      ]
    },
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Content",
          "info": "Theme settings options fill a blank title (and link) from Theme settings > MG Car Audio: business details.",
          "options": [
            {
              "value": "custom",
              "label": "Custom text"
            },
            {
              "value": "warranty",
              "label": "Warranty (from Theme settings)"
            },
            {
              "value": "phone",
              "label": "Phone number (from Theme settings)"
            },
            {
              "value": "address",
              "label": "Workshop location (from Theme settings)"
            }
          ],
          "default": "custom"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "tag", "label": "Price tag" },
            { "value": "car", "label": "Car" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "check", "label": "Tick" },
            { "value": "screen", "label": "Screen" },
            { "value": "radio", "label": "Radio" },
            { "value": "speaker", "label": "Speaker" },
            { "value": "camera", "label": "Camera" },
            { "value": "phone", "label": "Phone" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "message", "label": "Message" },
            { "value": "mail", "label": "Email" },
            { "value": "clock", "label": "Clock" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "star", "label": "Star" },
            { "value": "award", "label": "Award" },
            { "value": "bolt", "label": "Lightning bolt" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "For Theme settings items, leave blank to use the warranty text, the phone number or '[town] workshop'.",
          "default": "Fixed fitted prices"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Second line",
          "info": "Optional small line under the title. For the phone item, leave blank to show weekday opening hours."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Optional. The phone item links to a tel: link and the location item to Google Maps when this is blank."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MG trust bar",
      "category": "MG Car Audio",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "source": "warranty",
            "icon": "shield",
            "title": ""
          }
        },
        {
          "type": "item",
          "settings": {
            "source": "custom",
            "icon": "tag",
            "title": "Fixed fitted prices"
          }
        },
        {
          "type": "item",
          "settings": {
            "source": "custom",
            "icon": "car",
            "title": "Factory features kept"
          }
        },
        {
          "type": "item",
          "settings": {
            "source": "address",
            "icon": "map-pin",
            "title": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
