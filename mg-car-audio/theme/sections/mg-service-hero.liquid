{%- liquid
  assign is_above_fold = true
  if section.index > 2
    assign is_above_fold = false
  endif

  assign heading = section.settings.heading | strip
  if heading == blank
    if page and page.title != blank
      assign heading = page.title
    else
      assign heading = 'Apple CarPlay and Android Auto installation in Dublin'
    endif
  endif

  assign crumb_current = heading
  if page and page.title != blank
    assign crumb_current = page.title
  endif
  assign crumb_parent_label = section.settings.breadcrumb_parent_label | strip
  assign crumb_parent_url = section.settings.breadcrumb_parent_url | default: '/collections/installation-services'

  assign book_url = section.settings.primary_url | default: '/pages/book-a-fitting'
  assign wa_message = section.settings.whatsapp_message | default: settings.mg_whatsapp_message
  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_number != blank and section.settings.whatsapp_label != blank
    assign show_whatsapp = true
  endif

  assign show_rating = false
  if section.settings.show_rating and settings.mg_review_rating != blank
    assign show_rating = true
  endif

  assign facts_count = 0
  for block in section.blocks
    if block.settings.text != blank
      assign facts_count = facts_count | plus: 1
    endif
  endfor

  assign fallback = section.settings.fallback_image | default: 'mg-bmw-carplay-screen.webp'
  assign fallback_w = 1536
  assign fallback_h = 1024
  assign fallback_small = ''
  case fallback
    when 'mg-bmw-carplay-screen.webp'
      assign fallback_alt = 'BMW widescreen display running Apple CarPlay'
      assign fallback_h = 840
      assign fallback_small = 'mg-bmw-carplay-screen-800.webp'
    when 'mg-audi-carplay-screen.webp'
      assign fallback_alt = 'Audi dashboard showing Apple CarPlay with a connected iPhone'
      assign fallback_small = 'mg-audi-carplay-screen-800.webp'
    when 'mg-android-auto-dash.webp'
      assign fallback_alt = 'Car dashboard screen running Android Auto'
      assign fallback_small = 'mg-android-auto-dash-800.webp'
    when 'mg-showroom.webp'
      assign fallback_alt = 'MG Car Audio showroom and product wall in Dublin'
      assign fallback_w = 1600
      assign fallback_h = 1200
      assign fallback_small = 'mg-showroom-800.webp'
    when 'mg-dash-radio.webp'
      assign fallback_alt = 'Dashboard with an upgraded touchscreen head unit'
      assign fallback_w = 1024
      assign fallback_h = 1024
    when 'mg-single-din-radio.webp'
      assign fallback_alt = 'Single-DIN car radio'
      assign fallback_w = 1024
      assign fallback_h = 1024
    when 'mg-door-speaker.webp'
      assign fallback_alt = 'Upgraded car door speaker'
      assign fallback_w = 1024
      assign fallback_h = 1024
    when 'mg-speaker-pair.webp'
      assign fallback_alt = 'Pair of car speakers'
      assign fallback_w = 1024
      assign fallback_h = 1024
    when 'mg-bmw-japan-to-europe.webp'
      assign fallback_alt = 'BMW infotainment converted from Japanese to European spec'
      assign fallback_small = 'mg-bmw-japan-to-europe-800.webp'
    when 'mg-mercedes-japan-to-europe.webp'
      assign fallback_alt = 'Mercedes-Benz infotainment converted from Japanese to European spec'
      assign fallback_small = 'mg-mercedes-japan-to-europe-800.webp'
    when 'mg-vw-japan-to-europe.webp'
      assign fallback_alt = 'Volkswagen infotainment converted from Japanese to European spec'
      assign fallback_small = 'mg-vw-japan-to-europe-800.webp'
    when 'mg-radio-frequency-conversion.webp'
      assign fallback_alt = 'Radio frequency conversion for an imported Japanese car'
      assign fallback_small = 'mg-radio-frequency-conversion-800.webp'
    else
      assign fallback_alt = heading
  endcase
  assign fallback_alt = fallback_alt | append: ', fitted by ' | append: settings.mg_business_name

  assign image_sizes = '(min-width: 1200px) 480px, (min-width: 990px) 40vw, (min-width: 750px) calc(100vw - 112px), calc(100vw - 80px)'
  if is_above_fold
    assign image_loading = 'eager'
    assign image_priority = 'high'
  else
    assign image_loading = 'lazy'
    assign image_priority = 'auto'
  endif
-%}

<div class="mg-section mg-svc-hero">
  <div class="mg-container">
    {%- if section.settings.show_breadcrumb -%}
      <nav
        class="mg-svc-hero__crumbs"
        aria-label="Breadcrumb"
      >
        <ol role="list">
          <li>
            <a href="{{ routes.root_url }}">Home</a>
          </li>
          {%- if crumb_parent_label != blank -%}
            <li>
              <a href="{{ crumb_parent_url }}">{{ crumb_parent_label | escape }}</a>
            </li>
          {%- endif -%}
          <li>
            <span aria-current="page">{{ crumb_current | escape }}</span>
          </li>
        </ol>
      </nav>
    {%- endif -%}

    <div class="mg-panel mg-svc-hero__panel">
      <div class="mg-svc-hero__content">
        <h1 class="mg-h1-banner mg-svc-hero__title">{{ heading | escape }}</h1>

        {%- if show_rating -%}
          {%- capture rating_inner -%}
            <span
              class="mg-stars mg-stars--sm"
              style="--mg-rating: {{ settings.mg_review_rating | strip | escape }};"
              role="img"
              aria-label="Rated {{ settings.mg_review_rating | strip | escape }} out of 5"
            ></span>
            <span class="mg-svc-hero__rating-text">
              {{- settings.mg_review_rating | strip | escape }}/5
              {%- if settings.mg_review_count != blank %} from {{ settings.mg_review_count | escape }} Google reviews{% else %} on Google{% endif -%}
            </span>
          {%- endcapture -%}
          {%- if settings.mg_review_url != blank -%}
            <a
              class="mg-svc-hero__rating mg-svc-hero__rating--link"
              href="{{ settings.mg_review_url }}"
              target="_blank"
              rel="noopener"
            >
              {{- rating_inner -}}
              <span class="mg-visually-hidden"> (opens Google reviews)</span>
            </a>
          {%- else -%}
            <p class="mg-svc-hero__rating">{{- rating_inner -}}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <p class="mg-lede mg-svc-hero__lede">{{ section.settings.intro | escape | newline_to_br }}</p>
        {%- endif -%}

        {%- if section.settings.price != blank or section.settings.price_note != blank -%}
          <div class="mg-svc-hero__offer{% if section.settings.price != blank %} mg-svc-hero__offer--price{% endif %}">
            {%- if section.settings.price != blank -%}
              <p class="mg-price mg-svc-hero__price">
                {%- if section.settings.price_prefix != blank -%}
                  <span class="mg-price__label">{{ section.settings.price_prefix | escape }} </span>
                {%- endif -%}
                <span class="mg-svc-hero__amount">{{ section.settings.price | escape }}</span>
                {%- if section.settings.price_suffix != blank -%}
                  <span class="mg-price__label"> {{ section.settings.price_suffix | escape }}</span>
                {%- endif -%}
              </p>
            {%- endif -%}
            {%- if section.settings.price_note != blank -%}
              <p class="mg-help mg-svc-hero__price-note">{{ section.settings.price_note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.primary_label != blank or show_whatsapp -%}
          <div class="mg-actions mg-svc-hero__actions">
            {%- if section.settings.primary_label != blank -%}
              <a
                class="mg-btn mg-btn--primary"
                href="{{ book_url }}"
              >
                {%- render 'mg-icon', icon: 'calendar' -%}
                <span>{{ section.settings.primary_label | escape }}</span>
              </a>
            {%- endif -%}
            {%- if show_whatsapp -%}
              <a
                class="mg-btn mg-btn--whatsapp"
                href="https://wa.me/{{ settings.mg_whatsapp_number }}?text={{ wa_message | url_encode }}"
                target="_blank"
                rel="noopener"
              >
                {%- render 'mg-icon', icon: 'whatsapp' -%}
                <span>{{ section.settings.whatsapp_label | escape }}</span>
                <span class="mg-visually-hidden"> (opens WhatsApp)</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_call and settings.mg_phone_display != blank and settings.mg_phone_e164 != blank -%}
          <p class="mg-svc-hero__call">
            {%- if section.settings.call_prefix != blank -%}
              {{ section.settings.call_prefix | escape }}
            {% endif -%}
            <a
              class="mg-link"
              href="tel:+{{ settings.mg_phone_e164 }}"
              >{{ settings.mg_phone_display | escape }}</a
            >
          </p>
        {%- endif -%}
      </div>

      <div class="mg-svc-hero__media">
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign image_alt = section.settings.image.alt | default: heading
            assign focal_style = 'object-position: ' | append: section.settings.image.presentation.focal_point | append: ';'
          -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '400, 600, 800, 1000, 1300, 1600',
              sizes: image_sizes,
              loading: image_loading,
              fetchpriority: image_priority,
              alt: image_alt,
              class: 'mg-svc-hero__img',
              style: focal_style
          }}
        {%- else -%}
          <img
            class="mg-svc-hero__img"
            src="{{ fallback | asset_url }}"
            {% if fallback_small != blank %}
              srcset="{{ fallback_small | asset_url }} 800w, {{ fallback | asset_url }} {{ fallback_w }}w"
              sizes="{{ image_sizes }}"
            {% endif %}
            alt="{{ fallback_alt | escape }}"
            width="{{ fallback_w }}"
            height="{{ fallback_h }}"
            loading="{{ image_loading }}"
            fetchpriority="{{ image_priority }}"
            {% unless is_above_fold %}
              decoding="async"
            {% endunless %}
          >
        {%- endif -%}
      </div>
    </div>

    {%- if facts_count > 0 -%}
      <ul
        class="mg-trust mg-svc-hero__facts"
        role="list"
        style="--mg-svc-facts: {{ facts_count }};"
      >
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li
              class="mg-trust__item"
              {{ block.shopify_attributes }}
            >
              {%- render 'mg-icon', icon: block.settings.icon, class: 'mg-trust__icon' -%}
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.show_breadcrumb and section.settings.breadcrumb_schema -%}
  {%- liquid
    assign home_url = request.origin | append: routes.root_url
    assign parent_abs = crumb_parent_url
    assign parent_first = crumb_parent_url | slice: 0
    if parent_first == '/'
      assign parent_abs = request.origin | append: crumb_parent_url
    endif
    assign current_abs = request.origin | append: request.path
    assign position = 2
  -%}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ home_url | json }}}
    {%- if crumb_parent_label != blank -%}
      ,{"@type":"ListItem","position":2,"name":{{ crumb_parent_label | json }},"item":{{ parent_abs | json }}}
      {%- assign position = 3 -%}
    {%- endif -%}
    ,{"@type":"ListItem","position":{{ position }},"name":{{ crumb_current | json }},"item":{{ current_abs | json }}}]}
  </script>
{%- endif -%}

{% stylesheet %}
  /*
   * Inner-page header (service, book-a-fitting, services): breadcrumb on the page, then a
   * rounded grey panel with the serif h1, rating, lede, fitted price, buttons and a rounded
   * photo, then the key facts as the shared trust strip. Phones: photo on top. From 990px:
   * copy left, photo right. Colour, type, radius and states come from mg-theme.css.
   */

  /* Breadcrumb: one line, the current page shortens with an ellipsis */
  .mg-svc-hero__crumbs {
    margin-block: calc(var(--mg-space-3) * -1) var(--mg-space-1);
  }

  .mg-svc-hero__crumbs ol {
    display: flex;
    align-items: center;
    gap: var(--mg-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--mg-fs-micro);
    line-height: 1.4;
    color: var(--mg-ink-2);
  }

  .mg-svc-hero__crumbs li {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--mg-space-2);
    min-width: 0;
    white-space: nowrap;
  }

  .mg-svc-hero__crumbs li:last-child {
    flex: 0 1 auto;
    overflow: hidden;
  }

  .mg-svc-hero__crumbs li + li::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    margin-inline-end: 2px;
    border-top: 1.5px solid var(--mg-ink-3);
    border-right: 1.5px solid var(--mg-ink-3);
    transform: rotate(45deg);
  }

  .mg-svc-hero__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    color: var(--mg-ink-2);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
  }

  .mg-svc-hero__crumbs a:hover {
    color: var(--mg-ink);
    text-decoration-color: currentcolor;
  }

  .mg-svc-hero__crumbs [aria-current] {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--mg-ink);
    font-weight: 500;
  }

  /* Panel */
  .mg-svc-hero__panel {
    display: grid;
    gap: var(--mg-space-5);
  }

  .mg-svc-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .mg-svc-hero__title {
    max-width: 22ch;
  }

  .mg-svc-hero__rating {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mg-space-2);
    min-height: var(--mg-tap);
    margin: var(--mg-space-1) 0 0;
    color: var(--mg-ink-2);
    font-size: var(--mg-fs-small);
    text-decoration: none;
  }

  .mg-svc-hero__rating .mg-stars {
    align-self: center;
  }

  .mg-svc-hero__rating-text {
    font-variant-numeric: tabular-nums;
  }

  .mg-svc-hero__rating--link .mg-svc-hero__rating-text {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
  }

  .mg-svc-hero__rating--link:hover .mg-svc-hero__rating-text {
    color: var(--mg-ink);
    text-decoration-color: currentcolor;
  }

  .mg-svc-hero__offer {
    display: grid;
    gap: var(--mg-space-1);
    margin-top: var(--mg-space-5);
  }

  .mg-svc-hero__price {
    margin: 0;
    line-height: 1.2;
  }

  .mg-svc-hero__amount {
    font-size: var(--mg-fs-h2);
    letter-spacing: -0.01em;
  }

  .mg-svc-hero__price-note {
    max-width: 48ch;
    font-size: var(--mg-fs-small);
  }

  .mg-svc-hero__actions {
    align-self: stretch;
    margin-top: var(--mg-space-5);
  }

  /* Phones have Call in the action bar, so the phone line starts at tablet width */
  .mg-svc-hero__call {
    display: none;
    margin: var(--mg-space-3) 0 0;
    color: var(--mg-ink-2);
    font-size: var(--mg-fs-small);
  }

  .mg-svc-hero__call .mg-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    text-decoration-color: currentcolor;
    font-variant-numeric: tabular-nums;
  }

  .mg-svc-hero__media {
    order: -1;
    min-width: 0;
  }

  .mg-svc-hero__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--mg-radius-md);
    object-fit: cover;
    background-color: var(--mg-band-2);
  }

  /* Facts: the shared trust strip, one column per fact from 750px. Scoped under the section so
     it beats mg-theme.css's :is(ul, ol).mg-trust { margin: 0 } whatever order the files load in. */
  .mg-svc-hero .mg-svc-hero__facts {
    margin-top: var(--mg-space-4);
  }

  /*
   * Phones: the fitted price comes straight after the heading and rating (a shop's product
   * order), so it is in the first screen even with a long intro. The buttons follow the intro;
   * the action bar keeps Call, WhatsApp and Book in reach meanwhile.
   */
  @media screen and (max-width: 749px) {
    .mg-svc-hero__offer--price {
      order: 1;
      margin-top: var(--mg-space-3);
    }

    .mg-svc-hero__content:has(> .mg-svc-hero__offer--price) > :is(.mg-svc-hero__lede, .mg-svc-hero__actions, .mg-svc-hero__call) {
      order: 2;
    }
  }

  /* Small phones: a tighter panel keeps both hero buttons on one row where they fit */
  @media screen and (max-width: 374px) {
    .mg-svc-hero .mg-svc-hero__panel {
      padding: var(--mg-space-4);
    }
  }

  @media screen and (min-width: 750px) {
    /* The rating row is 44px tall for the tap target; pull the intro up to an even gap */
    .mg-svc-hero__rating + .mg-svc-hero__lede {
      margin-top: var(--mg-space-1);
    }

    .mg-svc-hero__actions {
      align-self: flex-start;
    }

    .mg-svc-hero__call {
      display: block;
    }

    .mg-svc-hero__img {
      aspect-ratio: 2 / 1;
    }

    .mg-svc-hero .mg-svc-hero__facts {
      grid-template-columns: repeat(var(--mg-svc-facts, 4), minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .mg-svc-hero__panel {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--mg-space-7);
    }

    .mg-svc-hero__media {
      order: 0;
    }

    /* Same crop as the home hero banner */
    .mg-svc-hero__img {
      aspect-ratio: 16 / 11;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG service hero",
  "tag": "section",
  "class": "mg-service-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "info": "Home / Services / page title. Helps visitors and Google understand where this page sits.",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_parent_label",
      "label": "Middle link label",
      "info": "Leave blank to show only Home / page title.",
      "default": "Services",
      "visible_if": "{{ section.settings.show_breadcrumb }}"
    },
    {
      "type": "url",
      "id": "breadcrumb_parent_url",
      "label": "Middle link",
      "info": "Leave blank to link to /collections/installation-services.",
      "visible_if": "{{ section.settings.show_breadcrumb }}"
    },
    {
      "type": "checkbox",
      "id": "breadcrumb_schema",
      "label": "Add breadcrumb structured data for Google",
      "default": true,
      "visible_if": "{{ section.settings.show_breadcrumb }}"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (page H1)",
      "info": "Leave blank to use the page title. Sentence case, with the service and 'Dublin' for local search. Keep it under about 55 characters so it fits on two lines."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "info": "One or two short sentences, about 25 words.",
      "default": "Maps, music, calls and messages on your car's own screen. Wired or wireless, fitted at our Dublin 12 workshop with your factory features kept."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Google rating under the heading",
      "info": "Uses the rating in Theme settings > MG Car Audio: business details. PLACEHOLDER: those figures are placeholders until the real Google rating is entered.",
      "default": true
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Text before price",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "info": "Leave blank to hide. €299 is MG's real BMW Android Auto (iDrive 7) price from the current booking page.",
      "default": "€299"
    },
    {
      "type": "text",
      "id": "price_suffix",
      "label": "Text after price",
      "default": "fitted"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "info": "Real prices from MG's booking page.",
      "default": "BMW Android Auto (iDrive 7). BMW Apple CarPlay from €350. Other cars quoted from your reg."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Booking button label",
      "info": "Leave blank to hide.",
      "default": "Book a fitting"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Booking button link",
      "info": "Leave blank to link to /pages/book-a-fitting."
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp button",
      "info": "Uses the WhatsApp number in Theme settings > MG Car Audio: business details.",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "WhatsApp us",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp pre-filled message",
      "info": "Leave blank to use the message from Theme settings.",
      "default": "Hi MG Car Audio, I'd like a quote for CarPlay or Android Auto. My reg is: ",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "checkbox",
      "id": "show_call",
      "label": "Show phone number",
      "info": "Shown under the buttons from tablet width (phones have Call in the action bar). Uses the phone number in Theme settings > MG Car Audio: business details.",
      "default": true
    },
    {
      "type": "text",
      "id": "call_prefix",
      "label": "Text before the number",
      "default": "Prefer to talk? Call",
      "visible_if": "{{ section.settings.show_call }}"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Landscape, at least 1600px wide. Set a focal point: it is cropped to 16:9 on phones, 2:1 on tablets and 16:11 on desktop."
    },
    {
