{%- liquid
  assign heading = section.settings.heading | strip
  assign heading_id = 'MgGalleryHeading-' | append: section.id
  assign section_classes = 'mg-section mg-gallery'
  if section.settings.background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--band'
  endif

  assign item_count = section.blocks.size

  assign follow_link = section.settings.follow_link
  assign follow_label = section.settings.follow_label | strip
  assign follow_external = false
  if follow_link contains '://'
    assign follow_external = true
  endif

  # Desktop bento (4 columns). The first item is shown large; the last row is stretched so no
  # cell is ever left empty: 1 item fills the grid, 2 share it, 3 = large + 2 wide, 4 = large +
  # 2 small + 1 wide, 5 = large + 4 small, then rows of 4 where a short last row is widened.
  assign extra_items = item_count | minus: 5 | at_least: 0
  assign last_row_left = extra_items | modulo: 4
  assign last_row_start = item_count | minus: last_row_left | plus: 1
-%}

{%- render 'mg-carousel-script' -%}

<section
  class="{{ section_classes }}"
  {% if heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="mg-container">
    <mg-carousel
      class="mg-carousel mg-carousel--bleed mg-gallery__carousel"
      style="--mg-carousel-mobile: 1.6; --mg-carousel-tablet: 2.6;"
    >
      <div class="mg-head">
        <div class="mg-head__text">
          {%- if heading != blank -%}
            <h2
              id="{{ heading_id }}"
              class="mg-head__title"
            >
              {{ heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mg-head__sub">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
        {%- assign show_follow = false -%}
        {%- if follow_link != blank and follow_label != blank -%}
          {%- assign show_follow = true -%}
        {%- endif -%}
        {%- if show_follow or item_count > 1 -%}
          <div class="mg-head__actions{% unless show_follow %} mg-gallery__actions--nav{% endunless %}">
            {%- if show_follow -%}
              <a
                class="mg-link mg-head__link"
                href="{{ follow_link }}"
                {% if follow_external %}
                  target="_blank" rel="noopener"
                {% endif %}
              >
                {{- follow_label | escape -}}
                {%- if follow_external -%}
                  <span class="mg-visually-hidden"> (opens in a new tab)</span>
                {%- endif -%}
              </a>
            {%- endif -%}
            {%- if item_count > 1 -%}
              <div class="mg-carousel__nav mg-carousel__nav--desktop">
                <button
                  class="mg-carousel__btn"
                  type="button"
                  data-mg-carousel-prev
                  aria-label="Previous jobs"
                >
                  {%- render 'mg-icon', icon: 'chevron-left' -%}
                </button>
                <button
                  class="mg-carousel__btn"
                  type="button"
                  data-mg-carousel-next
                  aria-label="Next jobs"
                >
                  {%- render 'mg-icon', icon: 'chevron-right' -%}
                </button>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if item_count > 0 -%}
        <ul
          class="mg-carousel__track mg-gallery__grid"
          role="list"
          tabindex="0"
          aria-label="{{ heading | default: 'Latest jobs' | escape }}"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign bs = block.settings
              assign i = forloop.index

              assign cell_class = ''
              if item_count == 1
                assign cell_class = ' mg-gallery__item--span-4 mg-gallery__item--tall'
              elsif item_count == 2
                assign cell_class = ' mg-gallery__item--span-2 mg-gallery__item--tall'
              elsif i == 1
                assign cell_class = ' mg-gallery__item--span-2 mg-gallery__item--tall'
              elsif item_count == 3
                assign cell_class = ' mg-gallery__item--span-2'
              elsif item_count == 4
                if i == 4
                  assign cell_class = ' mg-gallery__item--span-2'
                endif
              elsif i > 5 and last_row_left > 0 and i >= last_row_start
                if last_row_left == 1
                  assign cell_class = ' mg-gallery__item--span-4'
                elsif last_row_left == 2
                  assign cell_class = ' mg-gallery__item--span-2'
                elsif i == item_count
                  assign cell_class = ' mg-gallery__item--span-2'
                endif
              endif

              if cell_class contains 'tall'
                assign img_sizes = '(min-width: 1184px) 552px, (min-width: 990px) 50vw, (min-width: 750px) 40vw, 64vw'
                assign img_widths = '400, 560, 720, 960, 1200, 1600'
              else
                assign img_sizes = '(min-width: 1184px) 268px, (min-width: 990px) 25vw, (min-width: 750px) 40vw, 64vw'
                assign img_widths = '320, 400, 560, 720, 960'
              endif

              assign has_video = false
              assign video_kind = ''
              if block.type == 'video'
                assign picked_image = bs.cover_image
                if picked_image == blank and bs.video != blank
                  assign picked_image = bs.video.preview_image
                endif
                assign fallback_key = bs.cover_fallback
                if bs.video != blank
                  assign has_video = true
                  assign video_kind = 'shopify'
                elsif bs.video_url != blank
                  assign has_video = true
                  assign video_kind = bs.video_url.type
                endif
              else
                assign picked_image = bs.image
                assign fallback_key = bs.fallback
              endif

              assign fallback_file = ''
              assign fallback_alt = ''
              case fallback_key
                when 'bmw-carplay'
                  assign fallback_file = 'mg-bmw-carplay-screen'
                  assign fallback_w = 1536
                  assign fallback_h = 840
                  assign fallback_alt = 'BMW widescreen running Apple CarPlay'
                when 'audi-carplay'
                  assign fallback_file = 'mg-audi-carplay-screen'
                  assign fallback_w = 1536
                  assign fallback_h = 1024
                  assign fallback_alt = 'Audi dashboard showing Apple CarPlay with an iPhone connected'
                when 'android-auto'
                  assign fallback_file = 'mg-android-auto-dash'
                  assign fallback_w = 1536
                  assign fallback_h = 1024
                  assign fallback_alt = 'Dashboard with an Android Auto touchscreen'
                when 'showroom'
                  assign fallback_file = 'mg-showroom'
                  assign fallback_w = 1600
                  assign fallback_h = 1200
                  assign fallback_alt = 'MG Car Audio showroom with screens and speakers on display'
                when 'dash-radio'
                  assign fallback_file = 'mg-dash-radio'
                  assign fallback_w = 1024
                  assign fallback_h = 1024
                  assign fallback_alt = 'Dashboard with a newly fitted head unit'
                when 'door-speaker'
                  assign fallback_file = 'mg-door-speaker'
                  assign fallback_w = 1024
                  assign fallback_h = 1024
                  assign fallback_alt = 'Upgraded speaker fitted in a car door'
                when 'single-din-radio'
                  assign fallback_file = 'mg-single-din-radio'
                  assign fallback_w = 1024
                  assign fallback_h = 1024
                  assign fallback_alt = 'Single-DIN car radio'
                when 'speaker-pair'
                  assign fallback_file = 'mg-speaker-pair'
                  assign fallback_w = 1024
                  assign fallback_h = 1024
                  assign fallback_alt = 'Pair of car speakers'
                when 'bmw-japan'
                  assign fallback_file = 'mg-bmw-japan-to-europe'
                  assign fallback_w = 1536
                  assign fallback_h = 1024
                  assign fallback_alt = 'BMW Japanese-to-European conversion'
                when 'mercedes-japan'
                  assign fallback_file = 'mg-mercedes-japan-to-europe'
                  assign fallback_w = 1536
                  assign fallback_h = 1024
                  assign fallback_alt = 'Mercedes-Benz Japanese-to-European conversion'
                when 'vw-japan'
                  assign fallback_file = 'mg-vw-japan-to-europe'
                  assign fallback_w = 1536
                  assign fallback_h = 1024
                  assign fallback_alt = 'Volkswagen Japanese-to-European conversion'
                when 'radio-frequency'
                  assign fallback_file = 'mg-radio-frequency-conversion'
                  assign fallback_w = 1536
                  assign fallback_h = 1024
                  assign fallback_alt = 'Radio frequency conversion for Japanese imports'
              endcase

              assign car = bs.car_label | strip
              assign job = bs.caption | strip
              assign item_label = car
              if job != blank
                if item_label != blank
                  assign item_label = item_label | append: ', ' | append: job
                else
                  assign item_label = job
                endif
              endif
              if item_label == blank
                assign item_label = fallback_alt | default: 'Recent job'
              endif

              if picked_image != blank
                assign item_alt = picked_image.alt | default: item_label
              else
                assign item_alt = fallback_alt | default: item_label
              endif
            -%}

            {%- capture media_image -%}
              {%- if picked_image != blank -%}
                {{
                  picked_image
                  | image_url: width: 1600
                  | image_tag:
                    widths: img_widths,
                    sizes: img_sizes,
                    loading: 'lazy',
                    alt: item_alt,
                    class: 'mg-gallery__img'
                }}
              {%- elsif fallback_file != blank -%}
                {%- liquid
                  assign fallback_src = fallback_file | append: '.webp'
                  assign fallback_small = ''
                  if fallback_w > 1024
                    assign fallback_small = fallback_file | append: '-800.webp'
                  endif
                -%}
                <img
                  class="mg-gallery__img"
                  src="{{ fallback_src | asset_url }}"
                  {% if fallback_small != blank %}
                    srcset="{{ fallback_small | asset_url }} 800w, {{ fallback_src | asset_url }} {{ fallback_w }}w"
                    sizes="{{ img_sizes }}"
                  {% endif %}
                  width="{{ fallback_w }}"
                  height="{{ fallback_h }}"
                  alt="{{ item_alt | escape }}"
                  loading="lazy"
                  decoding="async"
                >
              {%- else -%}
                <span
                  class="mg-gallery__empty"
                  aria-hidden="true"
                >
                  {%- render 'mg-icon', icon: 'camera' -%}
                </span>
              {%- endif -%}
            {%- endcapture -%}

            <li
              class="mg-carousel__slide mg-gallery__item{{ cell_class }}"
              {{ block.shopify_attributes }}
            >
              <figure class="mg-gallery__figure">
                {%- if block.type == 'video' and has_video -%}
                  <mg-gallery-video class="mg-gallery__media mg-gallery__media--video">
                    {{ media_image }}
                    <button
                      type="button"
                      class="mg-gallery__play"
                      data-mg-play
                      aria-label="Play video: {{ item_label | escape }}"
                    >
                      <span class="mg-gallery__play-icon">
                        {%- render 'mg-icon', icon: 'play' -%}
                      </span>
                    </button>
                    <div
                      class="mg-gallery__player"
                      data-mg-player
                    ></div>
                    <template data-mg-template>
                      {%- case video_kind -%}
                        {%- when 'shopify' -%}
                          {{ bs.video | video_tag: image_size: '1600x', autoplay: true, controls: true }}
                        {%- when 'youtube' -%}
                          <iframe
                            src="https://www.youtube-nocookie.com/embed/{{ bs.video_url.id }}?autoplay=1&amp;rel=0&amp;playsinline=1"
                            title="{{ item_label | escape }}"
                            allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                            allowfullscreen
                          ></iframe>
                        {%- when 'vimeo' -%}
                          <iframe
                            src="https://player.vimeo.com/video/{{ bs.video_url.id }}?autoplay=1&amp;dnt=1&amp;title=0&amp;byline=0"
                            title="{{ item_label | escape }}"
                            allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                            allowfullscreen
                          ></iframe>
                      {%- endcase -%}
                    </template>
                  </mg-gallery-video>
                {%- else -%}
                  <div class="mg-gallery__media">
                    {{ media_image }}
                    {%- if block.type == 'video' and request.design_mode -%}
                      <span class="mg-badge mg-badge--card mg-gallery__hint">Add a video or a YouTube or Vimeo link</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if car != blank or job != blank -%}
                  <figcaption class="mg-gallery__caption">
                    {%- if car != blank -%}
                      <span class="mg-gallery__car">{{ car | escape }}</span>
                    {%- endif -%}
                    {%- if job != blank -%}
                      <span class="mg-gallery__job">{{ job | escape }}</span>
                    {%- endif -%}
                  </figcaption>
                {%- endif -%}
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <p class="mg-help">Add "Image" or "Video" blocks to show recent jobs.</p>
      {%- endif -%}
    </mg-carousel>
  </div>
</section>

{% javascript %}
  if (!customElements.get('mg-gallery-video')) {
    class MgGalleryVideo extends HTMLElement {
      connectedCallback() {
        this.button = this.querySelector('[data-mg-play]');
        if (!this.button) return;
        this.handleClick = this.play.bind(this);
        this.button.addEventListener('click', this.handleClick);
      }

      disconnectedCallback() {
        if (this.button && this.handleClick) {
          this.button.removeEventListener('click', this.handleClick);
        }
      }

      play() {
        const template = this.querySelector('template[data-mg-template]');
        const player = this.querySelector('[data-mg-player]');
        if (!template || !player || this.classList.contains('is-playing')) return;

        player.appendChild(template.content.cloneNode(true));
        this.classList.add('is-playing');

        const video = player.querySelector('video');
        if (video) {
          video.setAttribute('playsinline', '');
          video.controls = true;
          const attempt = video.play();
          if (attempt && typeof attempt.catch === 'function') attempt.catch(() => {});
          video.focus({ preventScroll: true });
        } else {
          const frame = player.querySelector('iframe');
          if (frame) frame.focus({ preventScroll: true });
        }
      }
    }

    customElements.define('mg-gallery-video', MgGalleryVideo);
  }

  if (!window.mgGalleryEditorBound) {
    window.mgGalleryEditorBound = true;
    document.addEventListener('shopify:block:select', (event) => {
      const slide = event.target;
      if (!(slide instanceof HTMLElement) || !slide.closest('.mg-gallery')) return;
      const track = slide.closest('.mg-carousel__track');
      if (!track || track.scrollWidth <= track.clientWidth) return;
      const offset = slide.getBoundingClientRect().left - track.getBoundingClientRect().left;
      const inset = parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0;
      track.scrollBy({ left: offset - inset, behavior: 'auto' });
    });
  }
{% endjavascript %}

{% stylesheet %}
  /* Phones swipe: a head slot holding only the arrows is dropped below 750px */
  @media screen and (max-width: 749px) {
    .mg-gallery__actions--nav {
      display: none;
    }
  }

  .mg-gallery__figure {
    display: flex;
    flex-direction: column;
    gap: var(--mg-space-2);
    height: 100%;
    margin: 0;
  }

  .mg-gallery__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--mg-radius-md);
    background-color: var(--mg-band-2);
    isolation: isolate;
  }

  .mg-gallery__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mg-gallery__empty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--mg-ink-3);
  }

  .mg-gallery__empty .mg-icon {
    width: 40px;
    height: 40px;
  }

  .mg-gallery__hint {
    position: absolute;
    inset: var(--mg-space-3) var(--mg-space-3) auto;
    white-space: normal;
  }

  .mg-gallery__caption {
    display: grid;
    gap: 2px;
    padding-inline: var(--mg-space-1);
  }

  .mg-gallery__car {
    font-size: var(--mg-fs-small);
    font-weight: 600;
    line-height: 1.3;
    color: var(--mg-ink);
  }

  .mg-gallery__job {
    font-size: var(--mg-fs-micro);
    line-height: 1.35;
    color: var(--mg-ink-2);
  }

  /* Video facade: nothing loads until the play button is pressed */
  .mg-gallery__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .mg-gallery__play-icon {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--mg-radius-pill);
    background-color: var(--mg-white);
    color: var(--mg-black);
    box-shadow: var(--mg-shadow-float);
    transition: transform var(--mg-dur) var(--mg-ease);
  }

  .mg-gallery__play-icon .mg-icon {
    width: 24px;
    height: 24px;
    margin-left: 3px;
    fill: currentColor;
  }

  @media (hover: hover) {
    .mg-gallery__play:hover .mg-gallery__play-icon {
      transform: scale(1.06);
    }
  }

  .mg-gallery__play:active .mg-gallery__play-icon {
    transform: scale(0.96);
  }

  .mg-gallery__play:focus-visible {
    outline: none;
  }

  .mg-gallery__play:focus-visible .mg-gallery__play-icon {
    box-shadow:
      0 0 0 2px var(--mg-black),
      0 0 0 4px var(--mg-white);
  }

  .mg-gallery__player {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    background-color: var(--mg-black);
  }

  .mg-gallery__player > :is(iframe, video) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: contain;
  }

  mg-gallery-video.is-playing .mg-gallery__player {
    display: block;
  }

  mg-gallery-video.is-playing .mg-gallery__play {
    display: none;
  }

  /* Desktop: a bento grid instead of the swipe row */
  @media screen and (min-width: 990px) {
    .mg-gallery {
      --mg-gallery-row: 232px;
    }

    .mg-gallery .mg-gallery__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-columns: auto;
      grid-auto-rows: var(--mg-gallery-row);
      column-gap: var(--mg-gap);
      row-gap: var(--mg-space-5);
      overflow: visible;
      scroll-snap-type: none;
    }

    .mg-gallery__item--span-2 {
      grid-column: span 2;
    }

    .mg-gallery__item--span-4 {
      grid-column: span 4;
    }

    .mg-gallery__item--tall {
      grid-row: span 2;
    }

    .mg-gallery .mg-gallery__media {
      flex: 1 1 0;
      min-height: 0;
      aspect-ratio: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-gallery__play-icon {
      transition: none;
    }

    .mg-gallery__play:is(:hover, :active) .mg-gallery__play-icon {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG latest jobs",
  "tag": "div",
  "class": "mg-gallery-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Phones and tablets: a swipeable row. Desktop: a photo grid with the first job shown large. Five jobs fill the desktop grid exactly."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest jobs"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Intro text",
      "info": "Optional. One short line under the heading.",
      "default": "Recent fits from our Dublin\u00a012 workshop."
    },
    {
      "type": "text",
      "id": "follow_label",
      "label": "Link label",
      "default": "See all jobs"
    },
    {
      "type": "url",
      "id": "follow_link",
      "label": "Link",
      "info": "For example /pages/gallery or your Instagram profile. The link is hidden while this is blank."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "surface",
          "label": "Grey band"
        }
      ],
      "default": "page"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload a photo of a real job. Until you do, the fallback image below is shown."
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Fallback image",
          "info": "Shown when no image is uploaded above.",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "bmw-carplay",
              "label": "BMW CarPlay screen"
            },
            {
              "value": "audi-carplay",
              "label": "Audi CarPlay dash"
            },
            {
              "value": "android-auto",
              "label": "Android Auto dash"
            },
            {
              "value": "showroom",
              "label": "Showroom"
            },
            {
              "value": "dash-radio",
              "label": "Dash head unit"
            },
            {
              "value": "door-speaker",
              "label": "Door speaker"
            },
            {
              "value": "single-din-radio",
              "label": "Single-DIN radio"
            },
            {
              "value": "speaker-pair",
              "label": "Speaker pair"
            },
            {
              "value": "bmw-japan",
              "label": "BMW Japan-to-Europe graphic"
            },
            {
              "value": "mercedes-japan",
              "label": "Mercedes Japan-to-Europe graphic"
            },
            {
              "value": "vw-japan",
              "label": "VW Japan-to-Europe graphic"
            },
            {
              "value": "radio-frequency",
              "label": "Radio frequency conversion graphic"
            }
          ],
          "default": "bmw-carplay"
        },
        {
          "type": "text",
          "id": "car_label",
          "label": "Car",
          "info": "Short, for example: BMW 3 Series",
          "default": "BMW 3 Series"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Job",
          "info": "Placeholder in the demo: replace with a short line about the real job.",
          "default": "Wireless CarPlay on the factory screen"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (uploaded to Shopify)",
          "info": "Plays in place when clicked. Nothing loads until then."
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Or a YouTube or Vimeo link",
          "accept": ["youtube", "vimeo"],
          "info": "Used when no uploaded video is chosen. The player only loads after a click."
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover image",
          "info": "Optional. Uploaded videos use their own preview frame when this is blank."
        },
        {
          "type": "select",
          "id": "cover_fallback",
          "label": "Fallback cover image",
          "info": "Shown when there's no cover image and no uploaded video.",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "bmw-carplay",
              "label": "BMW CarPlay screen"
            },
