            },
            {
              "value": "android-auto",
              "label": "Android Auto dash"
            },
            {
              "value": "showroom",
              "label": "Showroom"
            },
            {
              "value": "dash-radio",
              "label": "Dash head unit"
            },
            {
              "value": "door-speaker",
              "label": "Door speaker"
            },
            {
              "value": "single-din-radio",
              "label": "Single-DIN radio"
            },
            {
              "value": "speaker-pair",
              "label": "Speaker pair"
            },
            {
              "value": "bmw-japan",
              "label": "BMW Japan-to-Europe graphic"
