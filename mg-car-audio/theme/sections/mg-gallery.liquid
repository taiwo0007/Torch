  "class": "mg-gallery-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recent installs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh out of the workshop"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Intro text",
      "default": "CarPlay retrofits, screen upgrades and sound systems fitted in Ballymount. Every job is finished to look like it left the factory that way."
    },
    {
      "type": "text",
      "id": "follow_label",
      "label": "Follow link label",
      "default": "Follow our installs"
    },
    {
      "type": "url",
      "id": "follow_link",
      "label": "Follow link",
      "info": "For example your Instagram or TikTok profile. The button is hidden while this is blank."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "paragraph",
      "content": "Mobile: a swipeable strip. Desktop: an editorial grid where the first item is shown large (when there are 3 or more items)."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "page",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised panel"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
