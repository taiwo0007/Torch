{%- liquid
  # ---------------------------------------------------------------------------
  # Car make landing page. Data source: the car_make metaobject linked to the
  # page through the page metafield custom.car_make (see docs/BUILD_SPEC.md §8).
  # Every field falls back to a section setting, so the page looks finished
  # before anything is set up in admin. [make] in any text = the make name.
  # ---------------------------------------------------------------------------
  assign car_make = page.metafields.custom.car_make.value

  assign title_first_word = page.title | strip | split: ' ' | first
  assign make_name = car_make.name.value | strip | default: section.settings.fallback_make | strip | default: title_first_word | default: 'BMW'

  assign heading_fallback = section.settings.fallback_heading | replace: '[make]', make_name | strip
  assign heading_pattern = make_name | append: ' CarPlay and screen upgrades in Dublin'
  assign heading = car_make.headline.value | strip | default: heading_fallback | default: heading_pattern

  assign title_id = 'MgCarMakeTitle-' | append: section.id
  assign book_url = section.settings.book_url | default: '/pages/book-a-fitting'
  assign quote_url = section.settings.quote_url | default: '/pages/get-a-quote'
  assign book_label = section.settings.book_label | replace: '[make]', make_name | strip

  # Intro: entry intro > page content (Online Store > Pages) > fallback setting
  assign page_content_text = page.content | strip_html | strip
  assign intro_text = car_make.intro.value | strip
  assign use_page_content = false
  if intro_text == blank
    if page_content_text != blank
      assign use_page_content = true
    else
      assign intro_text = section.settings.fallback_intro | replace: '[make]', make_name
    endif
  endif
  assign intro_lines = intro_text | escape | newline_to_br | split: '<br />'

  # "From" price: the entry's from_price (blank hides it), else the fallback setting
  assign from_price = car_make.from_price.value
  if car_make == blank
    assign from_price = section.settings.fallback_from_price
  endif
  assign from_price = from_price | strip | remove_first: 'From ' | remove_first: 'from ' | strip
  assign price_note = section.settings.price_note | replace: '[make]', make_name | strip

  # WhatsApp
  assign wa_message = section.settings.whatsapp_message | default: settings.mg_whatsapp_message | replace: '[make]', make_name
  assign wa_message_encoded = wa_message | url_encode
  assign wa_href = 'https://wa.me/' | append: settings.mg_whatsapp_number | append: '?text=' | append: wa_message_encoded
  assign whatsapp_label = section.settings.whatsapp_label | default: 'WhatsApp us' | replace: '[make]', make_name
  assign has_whatsapp = false
  if settings.mg_whatsapp_number != blank
    assign has_whatsapp = true
  endif

  # Hero image: entry hero_image > image picker > built-in theme photo
  assign hero_media = car_make.hero_image.value
  if hero_media.media_type != 'image'
    assign hero_media = section.settings.image
  endif

  # "auto": MG's own BMW or Audi CarPlay photo for those makes, the showroom otherwise
  assign fallback = section.settings.fallback_image | default: 'auto'
  if fallback == 'auto'
    assign make_lc = make_name | downcase
    assign fallback = 'mg-showroom.webp'
    if make_lc contains 'bmw'
      assign fallback = 'mg-bmw-carplay-screen.webp'
    elsif make_lc contains 'audi'
      assign fallback = 'mg-audi-carplay-screen.webp'
    endif
  endif
  assign fallback_alt = heading
  assign fallback_w = 1536
  assign fallback_h = 1024
  capture fallback_map
    echo 'mg-bmw-carplay-screen.webp~1536~840~BMW widescreen display running Apple CarPlay;'
    echo 'mg-audi-carplay-screen.webp~1536~1024~Audi dashboard showing Apple CarPlay with a connected iPhone;'
    echo 'mg-android-auto-dash.webp~1536~1024~Car dashboard screen running Android Auto;'
    echo 'mg-showroom.webp~1600~1200~MG Car Audio showroom and product wall in Dublin;'
    echo 'mg-bmw-japan-to-europe.webp~1536~1024~BMW infotainment converted from Japanese to European spec;'
    echo 'mg-mercedes-japan-to-europe.webp~1536~1024~Mercedes-Benz infotainment converted from Japanese to European spec;'
    echo 'mg-vw-japan-to-europe.webp~1536~1024~Volkswagen infotainment converted from Japanese to European spec'
  endcapture
  assign fallback_entries = fallback_map | split: ';'
  for fallback_entry in fallback_entries
    assign fallback_parts = fallback_entry | split: '~'
    if fallback_parts[0] == fallback
      assign fallback_w = fallback_parts[1]
      assign fallback_h = fallback_parts[2]
      assign fallback_alt = fallback_parts[3]
      break
    endif
  endfor
  assign fallback_alt = fallback_alt | append: ', fitted by ' | append: settings.mg_business_name
  # Every built-in photo in the list has an 800px copy for phones
  assign fallback_small = fallback | replace: '.webp', '-800.webp'
  assign image_sizes = '(min-width: 1200px) 480px, (min-width: 990px) 40vw, (min-width: 750px) calc(100vw - 112px), calc(100vw - 80px)'

  # Breadcrumb
  assign crumb_current = page.title | default: heading
  assign home_url = request.origin | append: routes.root_url
  assign current_url = request.origin | append: request.path

  # Systems and models come only from the entry
  assign systems = car_make.systems.value
  assign models = car_make.models.value
  unless section.settings.show_systems
    assign systems = nil
  endunless
  unless section.settings.show_models
    assign models = nil
  endunless

  # Services: entry list > fallback textarea. Format per line: Service name | Price | /link
  assign service_lines = car_make.services.value
  if service_lines == blank
    assign service_lines = section.settings.fallback_services | newline_to_br | split: '<br />'
  endif

  # Shop link: all products, filtered by the product metafield custom.car_make
  assign make_name_encoded = make_name | url_encode
  assign shop_url = routes.all_products_collection_url | append: '?filter.p.m.custom.car_make=' | append: make_name_encoded

  # Text settings with the [make] token
  assign facts = section.settings.facts | replace: '[make]', make_name | split: '|'
  assign facts_count = 0
  for fact in facts
    assign fact_text = fact | strip
    if fact_text != blank
      assign facts_count = facts_count | plus: 1
    endif
  endfor
  assign systems_heading = section.settings.systems_heading | replace: '[make]', make_name | strip
  assign systems_text = section.settings.systems_text | replace: '[make]', make_name | strip
  assign models_heading = section.settings.models_heading | replace: '[make]', make_name | strip
  assign models_note = section.settings.models_note | replace: '[make]', make_name | strip
  assign services_heading = section.settings.services_heading | replace: '[make]', make_name | strip
  assign services_text = section.settings.services_text | replace: '[make]', make_name | strip
  assign services_note = section.settings.services_note | replace: '[make]', make_name | strip
  assign shop_heading = section.settings.shop_heading | replace: '[make]', make_name | strip
  assign shop_text = section.settings.shop_text | replace: '[make]', make_name | strip
  assign shop_label = section.settings.shop_label | replace: '[make]', make_name | strip
  assign content_heading = section.settings.content_heading | replace: '[make]', make_name | strip
  assign faq_heading = section.settings.faq_heading | replace: '[make]', make_name | strip
  assign cta_heading = section.settings.cta_heading | replace: '[make]', make_name | strip
  assign cta_text = section.settings.cta_text | replace: '[make]', make_name | strip
-%}

{%- comment -%} Service price cards (captured first so an empty list hides the whole band) {%- endcomment -%}
{%- capture service_cards -%}
  {%- for line in service_lines -%}
    {%- liquid
      assign parts = line | replace: '[make]', make_name | split: '|'
      assign svc_name = parts[0] | strip
      if svc_name == blank
        continue
      endif

      # A leading "From" becomes the small label before the price
      assign svc_price_raw = parts[1] | strip
      assign svc_price = svc_price_raw | remove_first: 'From ' | remove_first: 'from ' | strip

      # Only site-relative or http(s) links; anything else sends people to the quote page
      assign svc_link = parts[2] | strip
      assign svc_link_head = svc_link | slice: 0
      assign svc_link_scheme = svc_link | slice: 0, 4 | downcase
      assign svc_href = quote_url
      assign svc_cta = 'Get a quote'
      if svc_link_head == '/' or svc_link_scheme == 'http'
        assign svc_href = svc_link
        assign svc_cta = 'View and book'
      endif

      # Icon from keywords in the service name
      assign svc_lc = svc_name | downcase
      assign svc_icon = 'wrench'
      if svc_lc contains 'conversion'
        assign svc_icon = 'globe'
      elsif svc_lc contains 'radio'
        assign svc_icon = 'radio'
      elsif svc_lc contains 'carplay' or svc_lc contains 'android' or svc_lc contains 'screen'
        assign svc_icon = 'screen'
      elsif svc_lc contains 'video'
        assign svc_icon = 'play'
      elsif svc_lc contains 'speaker' or svc_lc contains 'sound'
        assign svc_icon = 'speaker'
      elsif svc_lc contains 'camera'
        assign svc_icon = 'camera'
      endif
    -%}
    <li class="mg-carmake__svc-item">
      <a
        class="mg-card mg-card--link mg-carmake__svc"
        href="{{ svc_href | escape }}"
      >
        <span
          class="mg-carmake__svc-icon"
          aria-hidden="true"
        >
          {%- render 'mg-icon', icon: svc_icon -%}
        </span>
        <h3 class="mg-card__title mg-carmake__svc-name">{{ svc_name | escape }}</h3>
        <span class="mg-carmake__svc-foot">
          {%- if svc_price != blank -%}
            <span class="mg-price mg-price--lg">
              {%- if svc_price != svc_price_raw -%}
                <span class="mg-price__label">From </span>
              {%- endif -%}
              {{- svc_price | escape -}}
            </span>
          {%- else -%}
            <span class="mg-carmake__svc-request">Price on request</span>
          {%- endif -%}
          <span class="mg-carmake__svc-cta">{{ svc_cta | escape }}</span>
        </span>
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%} FAQ items: entry FAQs first, Question blocks as the fallback {%- endcomment -%}
{%- assign faq_json = '' -%}
{%- capture faq_items -%}
  {%- for faq in car_make.faqs.value -%}
    {%- liquid
      assign faq_q = faq.question.value | strip
      if faq_q == blank
        continue
      endif
      assign faq_a = faq.answer.value | strip
      assign faq_a_lines = faq_a | escape | newline_to_br | split: '<br />'
      if faq_a != blank
        assign faq_q_json = faq_q | json
        assign faq_a_json = faq_a | json
        assign faq_json = faq_json | append: ',{"@type":"Question","name":' | append: faq_q_json | append: ',"acceptedAnswer":{"@type":"Answer","text":' | append: faq_a_json | append: '}}'
      endif
    -%}
    <details class="mg-carmake__faq-item">
      <summary class="mg-carmake__faq-q">
        <span class="mg-carmake__faq-text">{{ faq_q | escape }}</span>
        {%- render 'mg-icon', icon: 'chevron-down', class: 'mg-carmake__faq-chevron' -%}
      </summary>
      <div class="mg-carmake__faq-a">
        {%- for faq_a_line in faq_a_lines -%}
          <p>{{ faq_a_line | strip }}</p>
        {%- endfor -%}
      </div>
    </details>
  {%- endfor -%}
{%- endcapture -%}

{%- if faq_items == blank -%}
  {%- capture faq_items -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign faq_q = block.settings.question | replace: '[make]', make_name | strip
        if faq_q == blank
          continue
        endif
        assign faq_a_html = block.settings.answer | replace: '[make]', make_name
        assign faq_a = faq_a_html | strip_html | strip
        if faq_a != blank
          assign faq_q_json = faq_q | json
          assign faq_a_json = faq_a | json
          assign faq_json = faq_json | append: ',{"@type":"Question","name":' | append: faq_q_json | append: ',"acceptedAnswer":{"@type":"Answer","text":' | append: faq_a_json | append: '}}'
        endif
      -%}
      <details
        class="mg-carmake__faq-item"
        {{ block.shopify_attributes }}
      >
        <summary class="mg-carmake__faq-q">
          <span class="mg-carmake__faq-text">{{ faq_q | escape }}</span>
          {%- render 'mg-icon', icon: 'chevron-down', class: 'mg-carmake__faq-chevron' -%}
        </summary>
        <div class="mg-carmake__faq-a">{{ faq_a_html }}</div>
      </details>
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

<div class="mg-carmake">
  {%- comment -%} ================= HERO ================= {%- endcomment -%}
  <section
    class="mg-section mg-carmake__hero"
    aria-labelledby="{{ title_id }}"
  >
    <div class="mg-container">
      {%- if section.settings.show_breadcrumb -%}
        <nav
          class="mg-carmake__crumbs"
          aria-label="Breadcrumb"
        >
          <ol role="list">
            <li>
              <a href="{{ routes.root_url }}">Home</a>
            </li>
            <li>
              <span aria-current="page">{{ crumb_current | escape }}</span>
            </li>
          </ol>
        </nav>
        <script type="application/ld+json">
          {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ home_url | json }}},{"@type":"ListItem","position":2,"name":{{ crumb_current | json }},"item":{{ current_url | json }}}]}
        </script>
      {%- endif -%}

      <div class="mg-panel mg-carmake__panel">
        <div class="mg-carmake__copy">
          <h1
            id="{{ title_id }}"
            class="mg-h1-banner mg-carmake__title"
          >
            {{- heading | escape -}}
          </h1>

          {%- if use_page_content -%}
            <div class="mg-lede mg-carmake__intro mg-carmake__rte">
              {{ page.content }}
            </div>
          {%- else -%}
            <div class="mg-lede mg-carmake__intro">
              {%- for intro_line in intro_lines -%}
                <p>{{ intro_line | strip }}</p>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if from_price != blank or price_note != blank -%}
            <div class="mg-carmake__offer{% if from_price != blank %} mg-carmake__offer--price{% endif %}">
              {%- if from_price != blank -%}
                <p class="mg-price mg-carmake__price">
                  <span class="mg-price__label">From </span>
                  <span class="mg-carmake__amount">{{ from_price | escape }}</span>
                  <span class="mg-price__label"> fitted</span>
                </p>
              {%- endif -%}
              {%- if price_note != blank -%}
                <p class="mg-help mg-carmake__price-note">{{ price_note | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if book_label != blank or has_whatsapp and section.settings.show_whatsapp -%}
            <div class="mg-actions mg-carmake__actions">
              {%- if book_label != blank -%}
                <a
                  class="mg-btn mg-btn--primary"
                  href="{{ book_url }}"
                >
                  {%- render 'mg-icon', icon: 'calendar' -%}
                  <span>{{ book_label | escape }}</span>
                </a>
              {%- endif -%}
              {%- if has_whatsapp and section.settings.show_whatsapp -%}
                <a
                  class="mg-btn mg-btn--whatsapp"
                  href="{{ wa_href }}"
                  target="_blank"
                  rel="noopener"
                >
                  {%- render 'mg-icon', icon: 'whatsapp' -%}
                  <span>{{ whatsapp_label | escape }}</span>
                  <span class="mg-visually-hidden"> (opens WhatsApp)</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if request.design_mode and car_make == blank -%}
            <p class="mg-help mg-carmake__editor-note">
              Editor note: no car make entry is linked to this page, so the fallback content from this section's
              settings is shown. Link one in the page's "Car make" metafield (custom.car_make).
            </p>
          {%- endif -%}
        </div>

        <div class="mg-carmake__media">
          {%- if hero_media != blank -%}
            {%- liquid
              assign image_alt = hero_media.alt | default: heading
              assign focal_point = hero_media.presentation.focal_point | default: '50% 50%'
              assign focal_style = 'object-position: ' | append: focal_point | append: ';'
            -%}
            {{
              hero_media
              | image_url: width: 1600
              | image_tag:
                widths: '400, 600, 800, 1000, 1300, 1600',
                sizes: image_sizes,
                loading: 'eager',
                fetchpriority: 'high',
                alt: image_alt,
                class: 'mg-carmake__img',
                style: focal_style
            }}
          {%- else -%}
            <img
              class="mg-carmake__img"
              src="{{ fallback | asset_url }}"
              srcset="{{ fallback_small | asset_url }} 800w, {{ fallback | asset_url }} {{ fallback_w }}w"
              sizes="{{ image_sizes }}"
              alt="{{ fallback_alt | escape }}"
              width="{{ fallback_w }}"
              height="{{ fallback_h }}"
              loading="eager"
              fetchpriority="high"
            >
          {%- endif -%}
        </div>
      </div>

      {%- if facts_count > 0 -%}
        <ul
          class="mg-trust mg-carmake__facts"
          role="list"
          style="--mg-carmake-facts: {{ facts_count }};"
        >
          {%- for fact in facts -%}
            {%- liquid
              assign fact_text = fact | strip
              if fact_text == blank
                continue
              endif
              assign fact_lc = fact_text | downcase
              assign fact_icon = 'check'
              if fact_lc contains 'dublin' or fact_lc contains 'workshop' or fact_lc contains 'in-house'
                assign fact_icon = 'map-pin'
              elsif fact_lc contains 'carplay' or fact_lc contains 'wireless' or fact_lc contains 'screen'
                assign fact_icon = 'screen'
              elsif fact_lc contains 'finish' or fact_lc contains 'oem' or fact_lc contains 'warranty'
                assign fact_icon = 'shield'
              elsif fact_lc contains 'price' or fact_lc contains '€'
                assign fact_icon = 'tag'
              elsif fact_lc contains 'hour' or fact_lc contains 'time'
                assign fact_icon = 'clock'
              endif
            -%}
            <li class="mg-trust__item">
              {%- render 'mg-icon', icon: fact_icon, class: 'mg-trust__icon' -%}
              <span>{{ fact_text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ================= SYSTEMS + MODELS ================= {%- endcomment -%}
  {%- if systems != blank or models != blank -%}
    <section
      class="mg-section mg-section--band mg-carmake__fit"
      aria-label="{{ make_name | escape }} compatibility"
    >
      <div class="mg-container mg-carmake__fit-grid">
        {%- if systems != blank -%}
          <div class="mg-carmake__systems">
            <div class="mg-head">
              <div class="mg-head__text">
                {%- if systems_heading != blank -%}
                  <h2 class="mg-head__title">{{ systems_heading | escape }}</h2>
                {%- endif -%}
                {%- if systems_text != blank -%}
                  <p class="mg-head__sub">{{ systems_text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
            <ul
              class="mg-chips mg-chips--wrap mg-carmake__chips"
              role="list"
            >
              {%- for system in systems -%}
                <li class="mg-chip">
                  {%- render 'mg-icon', icon: 'screen' -%}
                  <span>{{ system | strip | replace: '–', '-' | replace: '—', '-' | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if models != blank -%}
          <div class="mg-carmake__models">
            {%- if models_heading != blank -%}
              <div class="mg-head">
                <h2 class="mg-head__title">{{ models_heading | escape }}</h2>
              </div>
            {%- endif -%}
            <ul
              class="mg-grid mg-carmake__models-grid"
              role="list"
            >
              {%- for model in models -%}
                {%- liquid
                  # "3 Series (F30/F31, 2012-2019)" -> "3 Series" + "F30/F31, 2012-2019"
                  assign model_raw = model | strip | replace: '–', '-' | replace: '—', '-'
                  assign model_first = model_raw | split: '(' | first
                  assign model_name = model_first | strip | default: model_raw
                  assign model_detail = model_raw | remove_first: model_name | remove_first: '(' | remove: ')' | strip
                -%}
                <li class="mg-card mg-carmake__model">
                  {%- render 'mg-icon', icon: 'car', class: 'mg-carmake__model-icon' -%}
                  <span class="mg-carmake__model-text">
                    <span class="mg-carmake__model-name">{{ model_name | escape }}</span>
                    {%- if model_detail != blank -%}
                      <span class="mg-carmake__model-detail">{{ model_detail | escape }}</span>
                    {%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            </ul>
            {%- if models_note != blank -%}
              <p class="mg-carmake__models-note">
                {{ models_note | escape }}
                {%- if has_whatsapp %}
                  <a
                    class="mg-link"
                    href="{{ wa_href }}"
                    target="_blank"
                    rel="noopener"
                    >WhatsApp us<span class="mg-visually-hidden"> (opens WhatsApp)</span></a
                  >
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= SERVICES ================= {%- endcomment -%}
  {%- if section.settings.show_services and service_cards != blank -%}
    <section
      class="mg-section mg-carmake__services"
      aria-label="{{ make_name | escape }} services and prices"
    >
      <div class="mg-container">
        {%- if services_heading != blank or services_text != blank -%}
          <div class="mg-head">
            <div class="mg-head__text">
              {%- if services_heading != blank -%}
                <h2 class="mg-head__title">{{ services_heading | escape }}</h2>
              {%- endif -%}
              {%- if services_text != blank -%}
                <p class="mg-head__sub">{{ services_text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <ul
          class="mg-grid mg-carmake__svc-grid"
          role="list"
        >
          {{ service_cards }}
        </ul>

        {%- if services_note != blank -%}
          <p class="mg-help mg-carmake__svc-note">{{ services_note | escape }}</p>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= SHOP PARTS ================= {%- endcomment -%}
  {%- if section.settings.show_shop and shop_label != blank -%}
    <section
      class="mg-section mg-carmake__shop"
      aria-label="{{ shop_label | escape }}"
    >
      <div class="mg-container">
        <div class="mg-panel mg-carmake__shop-panel">
          <span
            class="mg-carmake__shop-icon"
            aria-hidden="true"
          >
            {%- render 'mg-icon', icon: 'screen' -%}
          </span>
          <div class="mg-carmake__shop-copy">
            {%- if shop_heading != blank -%}
              <h2 class="mg-carmake__shop-title">{{ shop_heading | escape }}</h2>
            {%- endif -%}
            {%- if shop_text != blank -%}
              <p class="mg-carmake__shop-text">{{ shop_text | escape }}</p>
            {%- endif -%}
          </div>
          <a
            class="mg-btn mg-btn--secondary mg-carmake__shop-btn"
            href="{{ shop_url }}"
          >
            {{- shop_label | escape -}}
          </a>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ======= PAGE CONTENT (when the entry supplies the intro) ======= {%- endcomment -%}
  {%- if section.settings.show_page_content and use_page_content == false and page_content_text != blank -%}
    <section
      class="mg-section mg-carmake__content"
      aria-label="About {{ make_name | escape }} upgrades"
    >
      <div class="mg-container mg-container--narrow">
        {%- if content_heading != blank -%}
          <div class="mg-head">
            <h2 class="mg-head__title">{{ content_heading | escape }}</h2>
          </div>
        {%- endif -%}
        <div class="mg-carmake__rte rte">
          {{ page.content }}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= FAQ ================= {%- endcomment -%}
  {%- if section.settings.show_faq and faq_items != blank -%}
    <section
      class="mg-section mg-carmake__faq"
      aria-label="{{ make_name | escape }} frequently asked questions"
    >
      <div class="mg-container mg-container--narrow">
        {%- if faq_heading != blank -%}
          <div class="mg-head mg-head--center">
            <h2 class="mg-head__title">{{ faq_heading | escape }}</h2>
          </div>
        {%- endif -%}
        <div class="mg-carmake__faq-list">
          {{ faq_items }}
        </div>
      </div>
    </section>

    {%- if section.settings.faq_schema and faq_json != blank -%}
      <script type="application/ld+json">
        {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_json | remove_first: ',' }}]}
      </script>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ================= CLOSING CTA ================= {%- endcomment -%}
  {%- if section.settings.show_cta and cta_heading != blank -%}
    {%- liquid
      assign cta_book_class = 'mg-btn--secondary'
      unless has_whatsapp
        assign cta_book_class = 'mg-btn--primary'
      endunless
    -%}
    <section
      class="mg-section mg-carmake__cta"
      aria-label="{{ cta_heading | escape }}"
    >
      <div class="mg-container">
        <div class="mg-panel mg-surface-red mg-carmake__cta-panel">
          <div class="mg-carmake__cta-copy">
            <h2 class="mg-display mg-carmake__cta-title">{{ cta_heading | escape }}</h2>
            {%- if cta_text != blank -%}
              <p class="mg-lede mg-carmake__cta-text">{{ cta_text | escape }}</p>
            {%- endif -%}
          </div>
          <div class="mg-carmake__cta-actions">
            {%- if has_whatsapp -%}
              <a
                class="mg-btn mg-btn--primary mg-btn--lg mg-btn--block"
                href="{{ wa_href }}"
                target="_blank"
                rel="noopener"
              >
                {%- render 'mg-icon', icon: 'whatsapp' -%}
                <span>{{ whatsapp_label | escape }}</span>
                <span class="mg-visually-hidden"> (opens WhatsApp)</span>
              </a>
            {%- endif -%}
            {%- if book_label != blank -%}
              <a
                class="mg-btn {{ cta_book_class }} mg-btn--lg mg-btn--block"
                href="{{ book_url }}"
              >
                {%- render 'mg-icon', icon: 'calendar' -%}
                <span>{{ book_label | escape }}</span>
              </a>
            {%- endif -%}
            {%- if settings.mg_phone_e164 != blank -%}
              <a
                class="mg-btn mg-btn--secondary mg-btn--lg mg-btn--block"
                href="tel:+{{ settings.mg_phone_e164 }}"
              >
                {%- render 'mg-icon', icon: 'phone' -%}
                <span>Call {{ settings.mg_phone_display | default: settings.mg_phone_e164 | escape }}</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% javascript %}
  if (!window.mgCarMakeEditorBound) {
    window.mgCarMakeEditorBound = true;
    document.addEventListener('shopify:block:select', (event) => {
      const item = event.target;
      if (item instanceof HTMLDetailsElement && item.classList.contains('mg-carmake__faq-item')) item.open = true;
    });
  }
{% endjavascript %}

{% stylesheet %}
  /*
   * Car make landing page (/pages/<make>-carplay). One section, several bands, each a
   * .mg-section: page header (breadcrumb, grey panel, facts strip), compatibility band
   * (systems and models), fitted prices, shop parts, page content, FAQ, and a red closing
   * panel. Same header pattern as the service pages (mg-service-hero). Layout only.
   */

  /* ---------- Header ---------- */
  .mg-carmake__crumbs {
    margin-block: calc(var(--mg-space-3) * -1) var(--mg-space-1);
  }

  .mg-carmake__crumbs ol {
    display: flex;
    align-items: center;
    gap: var(--mg-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--mg-fs-micro);
    line-height: 1.4;
    color: var(--mg-ink-2);
  }

  .mg-carmake__crumbs li {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--mg-space-2);
    min-width: 0;
    white-space: nowrap;
  }

  .mg-carmake__crumbs li:last-child {
    flex: 0 1 auto;
    overflow: hidden;
  }

  .mg-carmake__crumbs li + li::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    margin-inline-end: 2px;
    border-top: 1.5px solid var(--mg-ink-3);
    border-right: 1.5px solid var(--mg-ink-3);
    transform: rotate(45deg);
  }

  .mg-carmake__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    color: var(--mg-ink-2);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
  }

  .mg-carmake__crumbs a:hover {
    color: var(--mg-ink);
    text-decoration-color: currentcolor;
  }

  .mg-carmake__crumbs [aria-current] {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--mg-ink);
    font-weight: 500;
  }

  .mg-carmake__panel {
    display: grid;
    gap: var(--mg-space-5);
  }

  .mg-carmake__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .mg-carmake__title {
    max-width: 22ch;
  }

  .mg-carmake__intro > * {
    margin: 0 0 0.75em;
  }

  .mg-carmake__intro > :last-child {
    margin-bottom: 0;
  }

  .mg-carmake__offer {
    display: grid;
    gap: var(--mg-space-1);
    margin-top: var(--mg-space-5);
  }

  .mg-carmake__price {
    margin: 0;
    line-height: 1.2;
  }

  .mg-carmake__amount {
    font-size: var(--mg-fs-h2);
    letter-spacing: -0.01em;
  }

  .mg-carmake__price-note {
    max-width: 48ch;
    font-size: var(--mg-fs-small);
  }

  .mg-carmake__actions {
    align-self: stretch;
    margin-top: var(--mg-space-5);
  }

  .mg-carmake__editor-note {
    margin: var(--mg-space-4) 0 0;
    padding: var(--mg-space-2) var(--mg-space-3);
    border: 1px dashed var(--mg-ink-3);
    border-radius: var(--mg-radius-sm);
  }

  .mg-carmake__media {
    order: -1;
    min-width: 0;
  }

  .mg-carmake__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--mg-radius-md);
    object-fit: cover;
    background-color: var(--mg-band-2);
  }

  /* Scoped so it beats mg-theme.css's :is(ul, ol).mg-trust { margin: 0 } */
  .mg-carmake .mg-carmake__facts {
    margin-top: var(--mg-space-4);
  }

  /* ---------- Compatibility ---------- */
  .mg-carmake__fit-grid {
    display: grid;
    gap: var(--mg-space-7);
  }

  .mg-carmake__chips {
    margin: 0;
    padding: 0;
  }

  .mg-carmake__chips .mg-icon {
    color: var(--mg-ink-2);
  }

  .mg-carmake__models-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-carmake__model {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: start;
    gap: var(--mg-space-3);
    min-width: 0;
    margin: 0;
    padding: var(--mg-space-3) var(--mg-space-4);
  }

  .mg-carmake__model-icon {
    width: 20px;
    height: 20px;
    margin-top: 1px;
    color: var(--mg-ink-3);
  }

  .mg-carmake__model-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .mg-carmake__model-name {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .mg-carmake__model-detail {
    font-size: var(--mg-fs-micro);
    line-height: 1.4;
    color: var(--mg-ink-2);
    font-variant-numeric: tabular-nums;
  }

  .mg-carmake__models-note {
    margin: var(--mg-space-4) 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-ink-2);
  }

  .mg-carmake__models-note .mg-link {
    text-decoration-color: currentcolor;
    white-space: nowrap;
  }

  /* ---------- Fitted prices ---------- */
  .mg-carmake__svc-grid {
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-carmake__svc-item {
    display: flex;
    min-width: 0;
    margin: 0;
  }

  /* Icon beside the name, price and link on the bottom edge */
  .mg-carmake .mg-carmake__svc {
    display: grid;
    flex: 1 1 auto;
    grid-template-columns: 40px minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    align-items: center;
    gap: var(--mg-space-3);
    padding: var(--mg-space-4);
  }

  .mg-carmake__svc-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--mg-radius-sm);
    background-color: var(--mg-band);
    color: var(--mg-ink);
  }

  .mg-carmake__svc-icon .mg-icon {
    width: 20px;
    height: 20px;
  }

  .mg-carmake__svc-name {
    text-wrap: balance;
  }

  /* Price and link sit on the card's bottom edge, so a row of cards lines up */
  .mg-carmake__svc-foot {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    align-self: end;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--mg-space-1) var(--mg-space-3);
    padding-top: var(--mg-space-3);
    border-top: 1px solid var(--mg-line);
  }

  /* Same line box as a 1.5rem price, so rows with and without a price line up */
  .mg-carmake__svc-request {
    font-size: var(--mg-fs-small);
    font-weight: 500;
    line-height: calc(1.5rem * 1.2);
    color: var(--mg-ink-2);
  }

  .mg-carmake__svc-cta {
    font-size: var(--mg-fs-small);
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  @media (hover: hover) {
    .mg-carmake__svc:hover .mg-carmake__svc-cta {
      text-decoration-thickness: 2px;
    }
  }

  .mg-carmake__svc-note {
    max-width: 72ch;
    margin: var(--mg-space-4) 0 0;
  }

  /* ---------- Shop parts ---------- */
  .mg-carmake__shop-panel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--mg-space-4);
  }

  .mg-carmake__shop-icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--mg-radius-md);
    background-color: var(--mg-card);
    color: var(--mg-ink);
  }

  .mg-carmake__shop-icon .mg-icon {
    width: 24px;
    height: 24px;
  }

  .mg-carmake__shop-title {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.3;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-carmake__shop-text {
    margin: var(--mg-space-1) 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-ink-2);
  }

  .mg-carmake__shop-btn {
    grid-column: 1 / -1;
  }

  /* ---------- Page content ---------- */
  .mg-carmake__rte {
    font-size: var(--mg-fs-body);
    line-height: 1.65;
    color: var(--mg-ink-2);
  }

  .mg-carmake__rte :is(h2, h3, h4) {
    margin: 1.5em 0 0.5em;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.3;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-carmake__rte p {
    margin: 0 0 1em;
    color: inherit;
  }

  .mg-carmake__rte > :last-child {
    margin-bottom: 0;
  }

  .mg-carmake__rte strong {
    color: var(--mg-ink);
  }

  .mg-carmake .mg-carmake__rte a {
    color: var(--mg-ink);
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  /* ---------- FAQ: centred rows, a hairline between questions, no boxes ---------- */
  .mg-carmake__faq-item {
    interpolate-size: allow-keywords;
  }

  .mg-carmake__faq-item + .mg-carmake__faq-item {
    border-top: 1px solid var(--mg-line);
  }

  .mg-carmake__faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--mg-space-4);
    min-height: 60px;
    padding: var(--mg-space-3) 0;
    border-radius: var(--mg-radius-sm);
    color: var(--mg-ink);
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .mg-carmake__faq-q::-webkit-details-marker {
    display: none;
  }

  .mg-carmake__faq-q:focus-visible {
    outline: 2px solid var(--mg-focus);
    outline-offset: 2px;
  }

  .mg-carmake__faq-text {
    font-size: var(--mg-fs-body);
    font-weight: 500;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .mg-carmake__faq-chevron {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--mg-ink-2);
    transition:
      transform var(--mg-dur) var(--mg-ease),
      color var(--mg-dur) var(--mg-ease);
  }

  .mg-carmake__faq-item[open] .mg-carmake__faq-chevron {
    transform: rotate(180deg);
    color: var(--mg-ink);
  }

  .mg-carmake__faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.25s var(--mg-ease),
      content-visibility 0.25s allow-discrete;
  }

  .mg-carmake__faq-item[open]::details-content {
    block-size: auto;
  }

  .mg-carmake__faq-a {
    max-width: 65ch;
    padding: 0 var(--mg-space-6) var(--mg-space-5) 0;
    font-size: var(--mg-fs-body);
    line-height: 1.6;
    color: var(--mg-ink-2);
  }

  .mg-carmake__faq-a :is(p, ul, ol) {
    margin: 0 0 0.75em;
    color: inherit;
  }

  .mg-carmake__faq-a > :last-child {
    margin-bottom: 0;
  }

  .mg-carmake__faq-a strong {
    color: var(--mg-ink);
  }

  .mg-carmake .mg-carmake__faq-a a {
    color: var(--mg-ink);
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.22em;
  }

  /* ---------- Closing panel ---------- */
  .mg-carmake__cta-panel {
    display: grid;
    gap: var(--mg-space-5);
  }

  .mg-carmake__cta-copy {
    min-width: 0;
  }

  .mg-carmake__cta-title {
    max-width: 18ch;
  }

  .mg-carmake__cta-text {
    max-width: 52ch;
  }

  .mg-carmake__cta-actions {
    display: grid;
    gap: var(--mg-space-3);
    align-content: center;
  }

  /* ---------- Phones: price straight after the heading, as on the service pages ---------- */
  @media screen and (max-width: 749px) {
    .mg-carmake__offer--price {
      order: 1;
      margin-top: var(--mg-space-4);
    }

    .mg-carmake__copy:has(> .mg-carmake__offer--price) > :is(.mg-carmake__intro, .mg-carmake__actions, .mg-carmake__editor-note) {
      order: 2;
    }
  }

  @media screen and (max-width: 374px) {
    .mg-carmake .mg-carmake__panel {
      padding: var(--mg-space-4);
    }
  }

  /* ---------- Tablet ---------- */
  @media screen and (min-width: 750px) {
    .mg-carmake__actions {
      align-self: flex-start;
    }

    .mg-carmake__img {
      aspect-ratio: 2 / 1;
    }

    .mg-carmake .mg-carmake__facts {
      grid-template-columns: repeat(var(--mg-carmake-facts, 4), minmax(0, 1fr));
    }

    .mg-carmake__svc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* An odd card out at the end takes the full row (tablet) */
    .mg-carmake__svc-item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .mg-carmake .mg-carmake__svc {
      padding: var(--mg-space-5);
    }

    .mg-carmake__shop-panel {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: var(--mg-space-5);
    }

    .mg-carmake__shop-btn {
      grid-column: auto;
    }

    .mg-carmake__cta-actions {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .mg-carmake__faq-text {
      font-size: 1.0625rem;
    }

    .mg-carmake__faq-a {
      padding-right: var(--mg-space-7);
    }
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .mg-carmake__panel {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--mg-space-7);
    }

    .mg-carmake__media {
      order: 0;
    }

    /* Same crop as the home hero banner */
    .mg-carmake__img {
      aspect-ratio: 16 / 11;
    }

    .mg-carmake__fit-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--mg-space-8);
    }

    .mg-carmake__fit-grid > :only-child {
      grid-column: 1 / -1;
    }

    /* Three across on a 6-track grid; a short last row stretches, so there's never a hole */
    .mg-carmake__svc-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .mg-carmake__svc-item,
    .mg-carmake__svc-item:last-child:nth-child(odd) {
      grid-column: span 2;
    }

    .mg-carmake__svc-item:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
    }

    .mg-carmake__svc-item:nth-last-child(2):nth-child(3n + 1),
    .mg-carmake__svc-item:last-child:nth-child(3n + 2) {
      grid-column: span 3;
    }

    .mg-carmake__cta-panel {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
      align-items: center;
      gap: var(--mg-space-8);
    }

    .mg-carmake__cta-actions {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-carmake__faq-chevron,
    .mg-carmake__faq-item::details-content {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG car make page",
  "tag": "div",
  "class": "mg-car-make-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads the car make entry linked to the page (page metafield custom.car_make, a car_make metaobject). Anything the entry doesn't have falls back to these settings. Type [make] in any text to insert the make name."
    },
    {
      "type": "header",
      "content": "Fallback content"
    },
    {
      "type": "text",
      "id": "fallback_make",
      "label": "Make name",
      "info": "Used only when no car make entry is linked. Leave blank to use the first word of the page title, for example 'BMW' from 'BMW CarPlay'."
    },
    {
      "type": "text",
      "id": "fallback_heading",
      "label": "Main heading (H1)",
      "info": "Used when the car make entry has no headline. Sentence case.",
      "default": "[make] CarPlay and screen upgrades in Dublin"
    },
    {
      "type": "textarea",
      "id": "fallback_intro",
      "label": "Intro",
      "info": "Used when the car make entry has no intro and the page has no content. Each line becomes a paragraph. One sentence of about 25 words reads best above the price and buttons.",
      "default": "Wired and wireless Apple CarPlay, Android Auto and screen upgrades for your [make], fitted at our Dublin 12 workshop with your factory screen and controls kept."
    },
    {
      "type": "text",
      "id": "fallback_from_price",
      "label": "From price",
      "info": "Used only when no car make entry is linked. €299 is the site-wide CarPlay and Android Auto 'from' price shown on the home page (MG's real BMW Android Auto, iDrive 7, price). Put each make's own price on its car make entry (from_price). Leave blank to hide.",
