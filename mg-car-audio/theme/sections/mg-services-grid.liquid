{%- comment -%}
  Fitted prices: a price board. Every service with its real fitted price in two columns of rows
  (one on phones), each row a link to the service, with a small photo, a line of text and the
  time in the workshop. Filter tabs are built from each service's "Tab" setting; without
  JavaScript every row shows and the tabs stay hidden.
{%- endcomment -%}

{%- liquid
  assign sid = 'MgPrices-' | append: section.id
  assign heading_id = sid | append: '-heading'
  assign button_url = section.settings.button_url | default: '/pages/services'
  assign price_suffix = section.settings.price_suffix | strip
  assign on_request_label = section.settings.on_request_label | default: 'Price on request'
  assign book_label = section.settings.book_label | strip
  assign quote_label = section.settings.quote_label | strip
  assign show_image = section.settings.show_image

  assign group_keys = 'carplay,screens,radios,conversions,audio' | split: ','
  assign present = ','
  assign card_count = 0
  for block in section.blocks
    assign title = block.settings.title | strip
    if title != blank
      assign card_count = card_count | plus: 1
      assign present = present | append: block.settings.group | append: ','
    endif
  endfor

  assign tab_count = 0
  for key in group_keys
    assign probe = ',' | append: key | append: ','
    if present contains probe
      assign tab_count = tab_count | plus: 1
    endif
  endfor

  assign show_tabs = false
  if section.settings.show_tabs and tab_count > 1
    assign show_tabs = true
  endif
-%}

<div class="mg-section mg-prices{% if show_image %} mg-prices--image{% endif %}">
  <div class="mg-container">
    {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
      <div
        class="mg-head mg-head--caps"
        data-mg-reveal
      >
        <div class="mg-head__text">
          {%- if section.settings.heading != blank -%}
            <h2
              class="mg-head__title"
              id="{{ heading_id }}"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mg-head__sub">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a
            class="mg-link mg-head__link"
            href="{{ button_url }}"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_count > 0 -%}
      <mg-price-tabs class="mg-prices__content">
        {%- if show_tabs -%}
          <div
            class="mg-chips mg-chips--bleed mg-prices__tabs"
            role="tablist"
            aria-label="{{ section.settings.tabs_label | default: 'Filter by system' | escape }}"
            hidden
            data-mg-prices-tabs
          >
            <button
              class="mg-chip"
              type="button"
              role="tab"
              id="{{ sid }}-tab-all"
              aria-selected="true"
              aria-controls="{{ sid }}-panel"
              data-mg-tab="all"
            >
              {{- section.settings.tab_all | default: 'All' | escape -}}
            </button>
            {%- for key in group_keys -%}
              {%- liquid
                assign probe = ',' | append: key | append: ','
                unless present contains probe
                  continue
                endunless
                assign label_id = 'tab_' | append: key
                assign tab_label = section.settings[label_id] | default: key
              -%}
              <button
                class="mg-chip"
                type="button"
                role="tab"
                id="{{ sid }}-tab-{{ key }}"
                aria-selected="false"
                aria-controls="{{ sid }}-panel"
                tabindex="-1"
                data-mg-tab="{{ key }}"
              >
                {{- tab_label | escape -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div
          class="mg-prices__panel-body"
          id="{{ sid }}-panel"
          data-mg-prices-panel
        >
          <ul
            class="mg-prices__list"
            role="list"
            data-mg-reveal-stagger
            {% if section.settings.heading != blank %}
              aria-labelledby="{{ heading_id }}"
            {% else %}
              aria-label="Fitted prices"
            {% endif %}
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign title = block.settings.title | strip
                if title == blank
                  continue
                endif

                assign card_id = sid | append: '-' | append: block.id
                assign card_url = block.settings.url | default: '/pages/get-a-quote'
                assign group = block.settings.group | default: 'other'
                assign price = block.settings.price | strip
                assign price_label = block.settings.price_label | strip
                assign price_label_first = price_label | slice: 0 | upcase
                assign price_label_rest = price_label | slice: 1, 60
                assign price_label_cap = price_label_first | append: price_label_rest
                assign duration = block.settings.duration | strip
                assign badge = block.settings.badge | strip

                assign price_main = price
                assign price_cents = ''
                if price contains '.'
                  assign price_parts = price | split: '.'
                  assign price_main = price_parts.first
                  assign price_cents = price_parts.last
                endif

                assign fallback = block.settings.fallback_image | default: 'mg-showroom.webp'
                assign fallback_base = fallback | remove: '.webp'
              -%}
              <li
                class="mg-prices__item"
                data-mg-group="{{ group }}"
                {{ block.shopify_attributes }}
              >
                <a
                  class="mg-prices__row"
                  href="{{ card_url }}"
                  aria-labelledby="{{ card_id }}-title {{ card_id }}-price"
                  {% if block.settings.text != blank %}
                    aria-describedby="{{ card_id }}-text"
                  {% endif %}
                >
                  {%- if show_image -%}
                    <span class="mg-prices__thumb">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 240, height: 240, crop: 'center'
                          | image_tag: widths: '120, 180, 240', sizes: '(min-width: 990px) 80px, 64px', loading: 'lazy', alt: ''
                        }}
                      {%- else -%}
                        {%- render 'mg-asset-image', asset: fallback_base, sizes: '(min-width: 990px) 80px, 64px', loading: 'lazy', alt: '' -%}
                      {%- endif -%}
                    </span>
                  {%- endif -%}

                  <span class="mg-prices__info">
                    <h3
                      class="mg-prices__title"
                      id="{{ card_id }}-title"
                    >
                      {{ title | escape }}
                    </h3>
                    {%- if block.settings.text != blank -%}
                      <span
                        class="mg-prices__text"
                        id="{{ card_id }}-text"
                      >
                        {{- block.settings.text | escape -}}
                      </span>
                    {%- endif -%}
                    {%- if duration != blank or badge != blank -%}
                      <span class="mg-prices__facts">
                        {%- if duration != blank -%}
                          <span class="mg-prices__time">
                            {%- render 'mg-icon', icon: 'clock' -%}
                            {{- duration | escape -}}
                          </span>
                        {%- endif -%}
                        {%- if badge != blank -%}
                          <span class="mg-badge mg-badge--red">{{ badge | escape }}</span>
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                  </span>

                  <span class="mg-prices__amount">
                    {%- if price != blank -%}
                      <span
                        class="mg-price mg-prices__price"
                        id="{{ card_id }}-price"
                      >
                        {%- if price_label != blank -%}
                          <span class="mg-price__label mg-prices__from">{{ price_label_cap | escape }} </span>
                        {%- endif -%}
                        <span class="mg-prices__figure">
                          {{- price_main | escape -}}
                          {%- if price_cents != blank -%}
                            <span class="mg-price__cents">{{ price_cents | escape }}</span>
                          {%- endif -%}
                        </span>
                        {%- if price_suffix != blank -%}
                          <span class="mg-price__label mg-prices__suffix"> {{ price_suffix | escape }}</span>
                        {%- endif -%}
                      </span>
                      {%- if book_label != blank -%}
                        <span
                          class="mg-prices__cta"
                          aria-hidden="true"
                        >
                          {{- book_label | escape -}}
                        </span>
                      {%- endif -%}
                    {%- else -%}
                      <span
                        class="mg-prices__request"
                        id="{{ card_id }}-price"
                      >
                        {{- on_request_label | escape -}}
                      </span>
                      {%- if quote_label != blank -%}
                        <span
                          class="mg-prices__cta"
                          aria-hidden="true"
                        >
                          {{- quote_label | escape -}}
                        </span>
                      {%- endif -%}
                    {%- endif -%}
                  </span>

                  <span
                    class="mg-prices__chev"
                    aria-hidden="true"
                  >
                    {%- render 'mg-icon', icon: 'chevron-right' -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if section.settings.footnote != blank -%}
          <p class="mg-prices__note">
            {%- render 'mg-icon', icon: 'tag' -%}
            <span>{{ section.settings.footnote | escape }}</span>
          </p>
        {%- endif -%}

        {%- if show_tabs -%}
          <p
            class="mg-visually-hidden"
            role="status"
            data-mg-prices-status
            data-one="Showing 1 service"
            data-many="Showing [count] services"
          ></p>
        {%- endif -%}
      </mg-price-tabs>
    {%- elsif request.design_mode -%}
      <p class="mg-help">Add "Service" blocks to show fitted prices.</p>
    {%- endif -%}
  </div>
</div>

{% javascript %}
  if (!customElements.get('mg-price-tabs')) {
    /* Filter tabs for the Fitted prices carousel (sections/mg-services-grid.liquid).
       WAI-ARIA tabs: one tabpanel (the carousel) whose slides are filtered by data-mg-group. */
    class MgPriceTabs extends HTMLElement {
      connectedCallback() {
        this.tablist = this.querySelector('[data-mg-prices-tabs]');
        this.panel = this.querySelector('[data-mg-prices-panel]');
        if (!this.tablist || !this.panel) return;

        this.tabs = Array.from(this.tablist.querySelectorAll('[role="tab"]'));
        this.slides = Array.from(this.panel.querySelectorAll('[data-mg-group]'));
        this.carousel = this.panel.querySelector('mg-carousel');
        this.status = this.querySelector('[data-mg-prices-status]');

        this.onClick = (event) => {
          const tab = event.target.closest('[role="tab"]');
          if (tab && this.tablist.contains(tab)) this.select(tab);
        };
        this.onKeydown = (event) => {
          const index = this.tabs.indexOf(document.activeElement);
          if (index < 0) return;
          let next = -1;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % this.tabs.length;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + this.tabs.length) % this.tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = this.tabs.length - 1;
          if (next < 0) return;
          event.preventDefault();
          this.select(this.tabs[next], { focus: true });
        };
        this.onBlockSelect = (event) => {
          const slide = event.target;
          if (!(slide instanceof HTMLElement) || !this.slides.includes(slide)) return;
          if (slide.hidden) this.select(this.tabs[0], { announce: false });
          requestAnimationFrame(() => slide.scrollIntoView({ block: 'nearest', inline: 'start' }));
        };

        this.tablist.addEventListener('click', this.onClick);
        this.tablist.addEventListener('keydown', this.onKeydown);
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        this.panel.setAttribute('role', 'tabpanel');
        this.tablist.hidden = false;
        const current = this.tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') || this.tabs[0];
        this.select(current, { announce: false, keepScroll: true });
      }

      disconnectedCallback() {
        if (!this.tablist) return;
        this.tablist.removeEventListener('click', this.onClick);
        this.tablist.removeEventListener('keydown', this.onKeydown);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      select(tab, { focus = false, announce = true, keepScroll = false } = {}) {
        if (!tab) return;
        const group = tab.dataset.mgTab;
        this.tabs.forEach((item) => {
          const selected = item === tab;
          item.setAttribute('aria-selected', String(selected));
          item.tabIndex = selected ? 0 : -1;
        });
        this.panel.setAttribute('aria-labelledby', tab.id);

        let count = 0;
        this.slides.forEach((slide) => {
          const show = group === 'all' || slide.dataset.mgGroup === group;
          slide.hidden = !show;
          if (show) count += 1;
        });

        if (focus) tab.focus();
        const row = this.tablist;
        const start = tab.offsetLeft - row.offsetLeft;
        if (start < row.scrollLeft || start + tab.offsetWidth > row.scrollLeft + row.clientWidth) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          row.scrollTo({ left: Math.max(0, start - 24), behavior: reduce ? 'auto' : 'smooth' });
        }

        if (!keepScroll) this.rewind();

        if (announce && this.status) {
          const template = count === 1 ? this.status.dataset.one : this.status.dataset.many;
          this.status.textContent = (template || '').replace('[count]', String(count));
        }
      }

      /* Back to the first card straight away. The track scrolls smoothly (CSS), and after a filter
         the browser re-snaps to the card that was snapped before, so jump without animation. */
      rewind() {
        const track = this.carousel && this.carousel.querySelector('.mg-carousel__track');
        if (!track) return;
        const behavior = track.style.scrollBehavior;
        track.style.scrollBehavior = 'auto';
        track.scrollLeft = 0;
        track.style.scrollBehavior = behavior;
        customElements.whenDefined('mg-carousel').then(() => {
          if (typeof this.carousel.reset === 'function') this.carousel.reset();
        });
      }
    }

    customElements.define('mg-price-tabs', MgPriceTabs);
  }
{% endjavascript %}
{% stylesheet %}
  /* Price board: layout only; colour and type come from the tokens */
  .mg-prices mg-price-tabs {
    display: block;
  }

  .mg-prices__tabs[hidden] {
    display: none;
  }

  .mg-prices__tabs {
    margin-block-end: var(--mg-space-4);
  }

  .mg-prices__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--mg-line);
    list-style: none;
  }

  .mg-prices__item {
    display: flex;
    margin: 0;
    border-block-end: 1px solid var(--mg-line);
  }

  .mg-prices__item[hidden] {
    display: none;
  }

  .mg-prices__row {
    position: relative;
    display: grid;
    flex: 1 1 auto;
    grid-template-columns: minmax(0, 1fr) auto 20px;
    align-items: center;
    gap: var(--mg-space-3);
    min-width: 0;
    padding: var(--mg-space-3) var(--mg-space-1);
    color: var(--mg-ink);
    text-decoration: none;
    transition: background-color var(--mg-dur) var(--mg-ease);
  }

  .mg-prices--image .mg-prices__row {
    grid-template-columns: 64px minmax(0, 1fr) auto 20px;
  }

  /* A red tail-light edge on the left on hover and focus */
  .mg-prices__row::before {
    content: '';
    position: absolute;
    inset-block: var(--mg-space-3);
    inset-inline-start: 0;
    width: 2px;
    border-radius: 2px;
    background-color: var(--mg-red);
    opacity: 0;
    transition: opacity var(--mg-dur) var(--mg-ease);
  }

  .mg-prices__thumb {
    display: block;
    width: 64px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--mg-radius-sm);
    background-color: var(--mg-band);
  }

  .mg-prices__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--mg-dur-slow) var(--mg-ease-out);
  }

  .mg-prices__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .mg-prices .mg-prices__title {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--mg-ink);
    text-wrap: pretty;
  }

  .mg-prices__text {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--mg-fs-micro);
    line-height: 1.4;
    color: var(--mg-ink-2);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  @media screen and (max-width: 749px) {
    .mg-prices__text {
      display: none;
    }
  }

  .mg-prices__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mg-space-2);
    margin-block-start: 2px;
  }

  .mg-prices__time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--mg-ink-3);
  }

  .mg-prices__time .mg-icon {
    flex: none;
    width: 14px;
    height: 14px;
  }

  /* Price column: "From" over the big figure, "fitted" under it */
  .mg-prices__amount {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--mg-space-1);
    text-align: end;
  }

  .mg-prices__price {
    display: grid;
    justify-items: end;
    line-height: 1.1;
  }

  .mg-prices__from,
  .mg-prices__suffix {
    font-size: 0.6875rem;
    line-height: 1.2;
  }

  .mg-prices__figure {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--mg-ink);
  }

  .mg-prices__request {
    max-width: 9ch;
    font-size: var(--mg-fs-micro);
    font-weight: 500;
    line-height: 1.3;
    color: var(--mg-ink-2);
  }

  .mg-prices__cta {
    display: none;
    font-size: var(--mg-fs-micro);
    font-weight: 500;
    color: var(--mg-ink);
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.22em;
    white-space: nowrap;
  }

  .mg-prices__chev {
    display: grid;
    place-items: center;
    color: var(--mg-ink-3);
    transition: transform var(--mg-dur) var(--mg-ease), color var(--mg-dur) var(--mg-ease);
  }

  .mg-prices__chev .mg-icon {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) {
    .mg-prices__row:hover {
      background-color: var(--mg-band);
    }

    .mg-prices__row:hover::before {
      opacity: 1;
    }

    .mg-prices__row:hover .mg-prices__thumb img {
      transform: scale(1.08);
    }

    .mg-prices__row:hover .mg-prices__chev {
      color: var(--mg-red-ink);
      transform: translateX(3px);
    }
  }

  .mg-prices__row:focus-visible {
    outline: 2px solid var(--mg-focus);
    outline-offset: -2px;
  }

  .mg-prices__row:focus-visible::before {
    opacity: 1;
  }

  .mg-prices__note {
    display: flex;
    align-items: flex-start;
    gap: var(--mg-space-2);
    max-width: 72ch;
    margin: var(--mg-space-4) 0 0;
    font-size: var(--mg-fs-micro);
    line-height: 1.45;
    color: var(--mg-ink-2);
  }

  .mg-prices__note .mg-icon {
    flex: none;
    width: 16px;
    height: 16px;
    margin-block-start: 1px;
    color: var(--mg-red);
  }

  @media screen and (min-width: 750px) {
    .mg-prices__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--mg-space-6);
      border-block-start: 0;
    }

    /* Two columns: every row keeps its own top line so both columns start ruled */
    .mg-prices__item {
      border-block-start: 1px solid var(--mg-line);
      border-block-end: 0;
    }

    .mg-prices__list {
      border-block-end: 1px solid var(--mg-line);
    }

    .mg-prices__row {
      padding: var(--mg-space-4) var(--mg-space-3);
    }

    .mg-prices .mg-prices__title {
      font-size: 1rem;
    }

    .mg-prices__text {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-prices--image .mg-prices__row {
      grid-template-columns: 80px minmax(0, 1fr) auto 20px;
      gap: var(--mg-space-4);
    }

    .mg-prices__thumb {
      width: 80px;
    }

    .mg-prices__figure {
      font-size: 1.625rem;
    }

    .mg-prices__cta {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-prices__row,
    .mg-prices__row::before,
    .mg-prices__thumb img,
    .mg-prices__chev {
      transition: none;
    }

    .mg-prices__row:hover .mg-prices__thumb img,
    .mg-prices__row:hover .mg-prices__chev {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG fitted prices",
  "tag": "section",
  "class": "mg-services-section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fitted prices"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Line under the heading",
      "info": "Optional. One short sentence under the heading."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "info": "Shown to the right of the heading. Leave blank to hide it.",
      "default": "All services"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link",
      "info": "Leave blank to link to /pages/services."
    },
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show a photo on each row",
      "info": "A small photo of the job beside each service. Uses the service's image, or its fallback.",
      "default": true
    },
    {
      "type": "header",
      "content": "Filter tabs"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show filter tabs",
      "info": "Tabs come from each service's Tab setting and only show when services use two or more tabs.",
      "default": true
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Tabs name for screen readers",
      "default": "Filter by system"
    },
    {
      "type": "text",
      "id": "tab_all",
      "label": "Tab for every service",
      "default": "All"
    },
    {
      "type": "text",
      "id": "tab_carplay",
      "label": "CarPlay tab",
