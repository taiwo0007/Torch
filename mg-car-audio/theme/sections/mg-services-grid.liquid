{%- comment -%}
  Fitted prices (docs/DESIGN.md §3 item 5): Back Market's "best deals" panel.
  A band panel with a workshop photo on the left (desktop) and, on the right, filter tabs
  plus a carousel of service cards with real fitted prices. Tabs are built from the "Tab"
  setting of the services present; without JavaScript every card shows and the tabs stay hidden.
{%- endcomment -%}

{%- liquid
  assign sid = 'MgPrices-' | append: section.id
  assign heading_id = sid | append: '-heading'
  assign button_url = section.settings.button_url | default: '/pages/services'
  assign price_suffix = section.settings.price_suffix | strip
  assign on_request_label = section.settings.on_request_label | default: 'Price on request'
  assign book_label = section.settings.book_label | strip
  assign quote_label = section.settings.quote_label | strip

  assign group_keys = 'carplay,screens,radios,conversions,audio' | split: ','
  assign present = ','
  assign card_count = 0
  for block in section.blocks
    assign title = block.settings.title | strip
    if title != blank
      assign card_count = card_count | plus: 1
      assign present = present | append: block.settings.group | append: ','
    endif
  endfor

  assign tab_count = 0
  for key in group_keys
    assign probe = ',' | append: key | append: ','
    if present contains probe
      assign tab_count = tab_count | plus: 1
    endif
  endfor

  assign show_tabs = false
  if section.settings.show_tabs and tab_count > 1
    assign show_tabs = true
  endif

  assign show_image = section.settings.show_image
-%}

<div class="mg-section mg-prices{% if show_image %} mg-prices--image{% endif %}">
  <div class="mg-container">
    {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
      <div class="mg-head">
        <div class="mg-head__text">
          {%- if section.settings.heading != blank -%}
            <h2
              class="mg-head__title"
              id="{{ heading_id }}"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mg-head__sub">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a
            class="mg-link mg-head__link"
            href="{{ button_url }}"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_count > 0 -%}
      <div class="mg-panel mg-panel--flush mg-prices__panel">
        {%- if show_image -%}
          <div class="mg-prices__media">
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 1184px) 373px, 32vw',
                  loading: 'lazy',
                  alt: section.settings.image.alt,
                  class: 'mg-prices__photo'
              }}
            {%- else -%}
              <img
                class="mg-prices__photo"
                src="{{ 'mg-showroom-800.webp' | asset_url }}"
                srcset="{{ 'mg-showroom-800.webp' | asset_url }} 800w, {{ 'mg-showroom.webp' | asset_url }} 1600w"
                sizes="(min-width: 1184px) 373px, 32vw"
                alt="Car audio and CarPlay kits on the wall of the MG Car Audio showroom"
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
          </div>
        {%- endif -%}

        <mg-price-tabs class="mg-prices__content">
          {%- if show_tabs -%}
            <div
              class="mg-chips mg-chips--bleed mg-prices__tabs"
              role="tablist"
              aria-label="{{ section.settings.tabs_label | default: 'Filter by system' | escape }}"
              hidden
              data-mg-prices-tabs
            >
              <button
                class="mg-chip"
                type="button"
                role="tab"
                id="{{ sid }}-tab-all"
                aria-selected="true"
                aria-controls="{{ sid }}-panel"
                data-mg-tab="all"
              >
                {{- section.settings.tab_all | default: 'All' | escape -}}
              </button>
              {%- for key in group_keys -%}
                {%- liquid
                  assign probe = ',' | append: key | append: ','
                  unless present contains probe
                    continue
                  endunless
                  assign label_id = 'tab_' | append: key
                  assign tab_label = section.settings[label_id] | default: key
                -%}
                <button
                  class="mg-chip"
                  type="button"
                  role="tab"
                  id="{{ sid }}-tab-{{ key }}"
                  aria-selected="false"
                  aria-controls="{{ sid }}-panel"
                  tabindex="-1"
                  data-mg-tab="{{ key }}"
                >
                  {{- tab_label | escape -}}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div
            class="mg-prices__panel-body"
            id="{{ sid }}-panel"
            data-mg-prices-panel
          >
            {%- render 'mg-carousel-script' -%}
            <mg-carousel class="mg-carousel mg-carousel--bleed mg-prices__carousel">
              <ul
                class="mg-carousel__track"
                role="list"
                tabindex="0"
                {% if section.settings.heading != blank %}
                  aria-labelledby="{{ heading_id }}"
                {% else %}
                  aria-label="Fitted prices"
                {% endif %}
              >
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign title = block.settings.title | strip
                    if title == blank
                      continue
                    endif

                    assign card_id = sid | append: '-' | append: block.id
                    assign card_url = block.settings.url | default: '/pages/get-a-quote'
                    assign group = block.settings.group | default: 'other'
                    assign price = block.settings.price | strip
                    assign price_label = block.settings.price_label | strip
                    assign price_label_first = price_label | slice: 0 | upcase
                    assign price_label_rest = price_label | slice: 1, 60
                    assign price_label_cap = price_label_first | append: price_label_rest
                    assign duration = block.settings.duration | strip
                    assign badge = block.settings.badge | strip

                    assign price_main = price
                    assign price_cents = ''
                    if price contains '.'
                      assign price_parts = price | split: '.'
                      assign price_main = price_parts.first
                      assign price_cents = price_parts.last
                    endif

                    assign fallback = block.settings.fallback_image | default: 'mg-showroom.webp'
                    assign fallback_small = fallback | replace: '.webp', '-800.webp'
                    assign fallback_w = 1536
                    assign fallback_h = 1024
                    assign small_h = 533
                    assign has_small = true
                    case fallback
                      when 'mg-showroom.webp'
                        assign fallback_w = 1600
                        assign fallback_h = 1200
                        assign small_h = 600
                      when 'mg-bmw-carplay-screen.webp'
                        assign fallback_h = 840
                        assign small_h = 438
                      when 'mg-speaker-range-banner.webp'
                        assign fallback_w = 1600
                        assign fallback_h = 320
                        assign small_h = 160
                      when 'mg-single-din-radio.webp', 'mg-door-speaker.webp', 'mg-speaker-pair.webp', 'mg-dash-radio.webp'
                        assign fallback_w = 1024
                        assign fallback_h = 1024
                        assign has_small = false
                    endcase
                  -%}
                  <li
                    class="mg-carousel__slide"
                    data-mg-group="{{ group }}"
                    {{ block.shopify_attributes }}
                  >
                    <a
                      class="mg-card mg-card--link mg-prices__card"
                      href="{{ card_url }}"
                      aria-labelledby="{{ card_id }}-title {{ card_id }}-price"
                      {% if block.settings.text != blank %}
                        aria-describedby="{{ card_id }}-text"
                      {% endif %}
                    >
                      <div class="mg-card__media mg-prices__media-card">
                        {%- if block.settings.image != blank -%}
                          {{
                            block.settings.image
                            | image_url: width: 800
                            | image_tag:
                              widths: '400, 600, 800',
                              sizes: '(min-width: 990px) 260px, (min-width: 750px) 270px, 76vw',
                              loading: 'lazy',
                              alt: ''
                          }}
                        {%- elsif has_small -%}
                          <img
                            src="{{ fallback_small | asset_url }}"
                            srcset="{{ fallback_small | asset_url }} 800w, {{ fallback | asset_url }} {{ fallback_w }}w"
                            sizes="(min-width: 990px) 260px, (min-width: 750px) 270px, 76vw"
                            alt=""
                            width="800"
                            height="{{ small_h }}"
                            loading="lazy"
                            decoding="async"
                          >
                        {%- else -%}
                          <img
                            src="{{ fallback | asset_url }}"
                            alt=""
                            width="{{ fallback_w }}"
                            height="{{ fallback_h }}"
                            loading="lazy"
                            decoding="async"
                          >
                        {%- endif -%}
                      </div>

                      <div class="mg-card__body mg-prices__body">
                        <h3
                          class="mg-card__title"
                          id="{{ card_id }}-title"
                        >
                          {{ title | escape }}
                        </h3>
                        {%- if block.settings.text != blank -%}
                          <p
                            class="mg-card__meta mg-prices__text"
                            id="{{ card_id }}-text"
                          >
                            {{ block.settings.text | escape }}
                          </p>
                        {%- endif -%}

                        {%- if duration != blank or badge != blank -%}
                          <p class="mg-prices__facts">
                            {%- if duration != blank -%}
                              <span class="mg-card__meta mg-prices__time">
                                {%- render 'mg-icon', icon: 'clock' -%}
                                {{- duration | escape -}}
                              </span>
                            {%- endif -%}
                            {%- if badge != blank -%}
                              <span class="mg-badge mg-badge--red">{{ badge | escape }}</span>
                            {%- endif -%}
                          </p>
                        {%- endif -%}

                        <div class="mg-prices__foot-card">
                          {%- if price != blank -%}
                            <p
                              class="mg-price mg-price--lg mg-prices__price"
                              id="{{ card_id }}-price"
                            >
                              {%- if price_label != blank -%}
                                <span class="mg-price__label">{{ price_label_cap | escape }} </span>
                              {%- endif -%}
                              {{- price_main | escape -}}
                              {%- if price_cents != blank -%}
                                <span class="mg-price__cents">{{ price_cents | escape }}</span>
                              {%- endif -%}
                              {%- if price_suffix != blank -%}
                                <span class="mg-price__label"> {{ price_suffix | escape }}</span>
                              {%- endif -%}
                            </p>
                            {%- if book_label != blank -%}
                              <span
                                class="mg-link mg-prices__cta"
                                aria-hidden="true"
                              >
                                {{- book_label | escape -}}
                              </span>
                            {%- endif -%}
                          {%- else -%}
                            <p
                              class="mg-price mg-prices__price mg-prices__price--request"
                              id="{{ card_id }}-price"
                            >
                              {{ on_request_label | escape }}
                            </p>
                            {%- if quote_label != blank -%}
                              <span
                                class="mg-link mg-prices__cta"
                                aria-hidden="true"
                              >
                                {{- quote_label | escape -}}
                              </span>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                      </div>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>

              <div class="mg-prices__foot">
                {%- if section.settings.footnote != blank -%}
                  <p class="mg-help mg-prices__note">{{ section.settings.footnote | escape }}</p>
                {%- endif -%}
                <div class="mg-carousel__nav mg-carousel__nav--desktop mg-prices__nav">
                  <button
                    class="mg-carousel__btn"
                    type="button"
                    data-mg-carousel-prev
                    aria-label="Previous services"
                  >
                    {%- render 'mg-icon', icon: 'chevron-left' -%}
                  </button>
                  <button
                    class="mg-carousel__btn"
                    type="button"
                    data-mg-carousel-next
                    aria-label="Next services"
                  >
                    {%- render 'mg-icon', icon: 'chevron-right' -%}
                  </button>
                </div>
              </div>
            </mg-carousel>
          </div>

          {%- if show_tabs -%}
            <p
              class="mg-visually-hidden"
              role="status"
              data-mg-prices-status
              data-one="Showing 1 service"
              data-many="Showing [count] services"
            ></p>
          {%- endif -%}
        </mg-price-tabs>
      </div>
    {%- elsif request.design_mode -%}
      <p class="mg-help">Add "Service" blocks to show fitted prices.</p>
    {%- endif -%}
  </div>
</div>

{% javascript %}
  if (!customElements.get('mg-price-tabs')) {
    /* Filter tabs for the Fitted prices carousel (sections/mg-services-grid.liquid).
       WAI-ARIA tabs: one tabpanel (the carousel) whose slides are filtered by data-mg-group. */
    class MgPriceTabs extends HTMLElement {
      connectedCallback() {
        this.tablist = this.querySelector('[data-mg-prices-tabs]');
        this.panel = this.querySelector('[data-mg-prices-panel]');
        if (!this.tablist || !this.panel) return;

        this.tabs = Array.from(this.tablist.querySelectorAll('[role="tab"]'));
        this.slides = Array.from(this.panel.querySelectorAll('[data-mg-group]'));
        this.carousel = this.panel.querySelector('mg-carousel');
        this.status = this.querySelector('[data-mg-prices-status]');

        this.onClick = (event) => {
          const tab = event.target.closest('[role="tab"]');
          if (tab && this.tablist.contains(tab)) this.select(tab);
        };
        this.onKeydown = (event) => {
          const index = this.tabs.indexOf(document.activeElement);
          if (index < 0) return;
          let next = -1;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % this.tabs.length;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + this.tabs.length) % this.tabs.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = this.tabs.length - 1;
          if (next < 0) return;
          event.preventDefault();
          this.select(this.tabs[next], { focus: true });
        };
        this.onBlockSelect = (event) => {
          const slide = event.target;
          if (!(slide instanceof HTMLElement) || !this.slides.includes(slide)) return;
          if (slide.hidden) this.select(this.tabs[0], { announce: false });
          requestAnimationFrame(() => slide.scrollIntoView({ block: 'nearest', inline: 'start' }));
        };

        this.tablist.addEventListener('click', this.onClick);
        this.tablist.addEventListener('keydown', this.onKeydown);
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        this.panel.setAttribute('role', 'tabpanel');
        this.tablist.hidden = false;
        const current = this.tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') || this.tabs[0];
        this.select(current, { announce: false, keepScroll: true });
      }

      disconnectedCallback() {
        if (!this.tablist) return;
        this.tablist.removeEventListener('click', this.onClick);
        this.tablist.removeEventListener('keydown', this.onKeydown);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      select(tab, { focus = false, announce = true, keepScroll = false } = {}) {
        if (!tab) return;
        const group = tab.dataset.mgTab;
        this.tabs.forEach((item) => {
          const selected = item === tab;
          item.setAttribute('aria-selected', String(selected));
          item.tabIndex = selected ? 0 : -1;
        });
        this.panel.setAttribute('aria-labelledby', tab.id);

        let count = 0;
        this.slides.forEach((slide) => {
          const show = group === 'all' || slide.dataset.mgGroup === group;
          slide.hidden = !show;
          if (show) count += 1;
        });

        if (focus) tab.focus();
        const row = this.tablist;
        const start = tab.offsetLeft - row.offsetLeft;
        if (start < row.scrollLeft || start + tab.offsetWidth > row.scrollLeft + row.clientWidth) {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          row.scrollTo({ left: Math.max(0, start - 24), behavior: reduce ? 'auto' : 'smooth' });
        }

        if (!keepScroll) this.rewind();

        if (announce && this.status) {
          const template = count === 1 ? this.status.dataset.one : this.status.dataset.many;
          this.status.textContent = (template || '').replace('[count]', String(count));
        }
      }

      /* Back to the first card straight away. The track scrolls smoothly (CSS), and after a filter
         the browser re-snaps to the card that was snapped before, so jump without animation. */
      rewind() {
        const track = this.carousel && this.carousel.querySelector('.mg-carousel__track');
        if (!track) return;
        const behavior = track.style.scrollBehavior;
        track.style.scrollBehavior = 'auto';
        track.scrollLeft = 0;
        track.style.scrollBehavior = behavior;
        customElements.whenDefined('mg-carousel').then(() => {
          if (typeof this.carousel.reset === 'function') this.carousel.reset();
        });
      }
    }

    customElements.define('mg-price-tabs', MgPriceTabs);
  }
{% endjavascript %}

{% stylesheet %}
  /* Layout only: colour, type, radius and states come from assets/mg-theme.css */
  .mg-prices mg-price-tabs {
    display: block;
  }

  /* Phones: the panel runs edge to edge as a band; from 750px it is a rounded panel */
  .mg-prices__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-inline: calc(var(--mg-gutter) * -1);
    border-radius: 0;
  }

  .mg-prices__media {
    display: none;
  }

  .mg-prices__content {
    min-width: 0;
    padding: var(--mg-space-5) var(--mg-gutter);
  }

  .mg-prices__tabs[hidden] {
    display: none;
  }

  .mg-prices__tabs {
    margin-block-end: var(--mg-space-4);
  }

  /* Cards: about 80% of a phone screen with the next card peeking in */
  .mg-prices .mg-prices__carousel {
    --mg-carousel-mobile: 1.2;
    --mg-carousel-tablet: 2.4;
    --mg-carousel-desktop: 2.9;
  }

  /* Beside the photo: a little over two cards. Cards stay 250px or wider so price and link share a line. */
  .mg-prices--image .mg-prices__carousel {
    --mg-carousel-desktop: 2.15;
  }

  @media screen and (min-width: 1200px) {
    .mg-prices .mg-prices__carousel {
      --mg-carousel-desktop: 3.4;
    }

    .mg-prices--image .mg-prices__carousel {
      --mg-carousel-desktop: 2.4;
    }
  }

  .mg-prices .mg-prices__card {
    display: flex;
    flex-direction: column;
  }

  .mg-prices__media-card {
    --mg-media-ratio: 3 / 2;
  }

  .mg-prices__body {
    flex: 1 1 auto;
  }

  .mg-prices__body .mg-card__title {
    text-wrap: balance;
  }

  .mg-prices__text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .mg-prices__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mg-space-2);
    margin: var(--mg-space-1) 0 0;
  }

  .mg-prices__time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .mg-prices__time .mg-icon {
    flex: none;
    width: 16px;
    height: 16px;
  }

  /* Price and link sit on the card's bottom edge, so a row of cards lines up */
  .mg-prices__foot-card {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--mg-space-1) var(--mg-space-3);
    margin-block-start: auto;
    padding-block-start: var(--mg-space-3);
  }

  .mg-prices__price {
    margin: 0;
  }

  /* Same line box as a 1.5rem price, so "Price on request" sits on the same line as the prices beside it */
  .mg-prices__price--request {
    font-size: var(--mg-fs-small);
    line-height: 1.8rem;
  }

  .mg-prices__cta {
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .mg-prices__card:hover .mg-prices__cta {
      text-decoration-thickness: 2px;
    }
  }

  /* The panel clips its children, so draw the track's own focus ring inside it */
  .mg-prices__carousel .mg-carousel__track:focus-visible {
    outline-offset: -2px;
  }

  .mg-prices__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--mg-space-3) var(--mg-space-5);
    margin-block-start: var(--mg-space-4);
  }

  .mg-prices__note {
    max-width: 60ch;
  }

  .mg-prices__nav {
    margin-inline-start: auto;
  }

  @media screen and (min-width: 750px) {
    .mg-prices__panel {
      margin-inline: 0;
      border-radius: var(--mg-radius-lg);
    }

    .mg-prices__content {
      padding: var(--mg-panel-pad);
    }

    /* The track runs to the panel's right edge, so the next card is cut by the panel, not the padding.
       4px at the start keeps the first card's (and first tab's) focus ring clear of the scroll edge. */
    .mg-prices__carousel .mg-carousel__track {
      margin-inline: -4px calc(var(--mg-panel-pad) * -1);
      padding-inline: 4px var(--mg-panel-pad);
      scroll-padding-inline: 4px var(--mg-panel-pad);
    }

    .mg-prices__tabs {
      margin-inline: -4px;
      padding-inline: 4px;
      scroll-padding-inline: 4px;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-prices--image .mg-prices__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }

    .mg-prices--image .mg-prices__media {
      position: relative;
      display: block;
      min-height: 100%;
    }

    .mg-prices__photo {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG fitted prices",
  "tag": "section",
  "class": "mg-services-section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fitted prices"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Line under the heading",
      "info": "Optional. One short sentence."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "info": "Shown to the right of the heading. Leave blank to hide it.",
      "default": "All services"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link",
      "info": "Leave blank to link to /pages/services."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show a photo beside the cards",
      "info": "Desktop only. Phones and tablets show the cards on their own.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "A workshop or showroom photo, shown tall beside the cards. Until one is uploaded, the MG showroom photo is used."
    },
    {
      "type": "header",
      "content": "Filter tabs"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
