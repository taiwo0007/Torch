{%- liquid
  assign heading_id = 'MgSvcDetailsHeading-' | append: section.id
  assign card_heading_id = 'MgSvcCardHeading-' | append: section.id

  assign book_url = section.settings.card_button_url | default: '/products/carplay-installation-bmw'
  assign wa_message = section.settings.card_whatsapp_message | default: settings.mg_whatsapp_message
  assign show_whatsapp = false
  if section.settings.card_show_whatsapp and settings.mg_whatsapp_number != blank and section.settings.card_whatsapp_label != blank
    assign show_whatsapp = true
  endif

  assign price_rows = section.blocks | where: 'type', 'price_row'
  assign has_card = false
  if section.settings.show_card
    if price_rows.size > 0 or section.settings.card_heading != blank or section.settings.card_button_label != blank or show_whatsapp
      assign has_card = true
    endif
  endif

  assign layout = section.settings.layout
  if has_card == false
    assign layout = 'stacked'
  endif

  assign section_classes = 'mg-section mg-svc-details mg-svc-details--' | append: layout
  if section.settings.background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--surface'
  endif
  if section.settings.sticky_card
    assign section_classes = section_classes | append: ' mg-svc-details--sticky'
  endif
  if section.settings.show_numbers
    assign section_classes = section_classes | append: ' mg-svc-details--numbered'
  endif
-%}

<div class="{{ section_classes }}">
  <div class="mg-container">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.intro != blank
    -%}
      <div class="mg-section-head mg-svc-details__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mg-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2
            class="mg-heading"
            id="{{ heading_id }}"
          >
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="mg-lede">{{ section.settings.intro | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="mg-svc-details__layout">
      <div class="mg-svc-details__main">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              {%- liquid
                assign text_content = block.settings.content
                if block.settings.use_page_content and page and page.content != blank
                  assign text_content = page.content
                endif
              -%}
              {%- if block.settings.title != blank or text_content != blank -%}
                <div
                  class="mg-svc-details__block mg-svc-details__block--text"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.title != blank -%}
                    <h3 class="mg-svc-details__title">
                      <span
                        class="mg-svc-details__num"
                        aria-hidden="true"
                      ></span>
                      {{- block.settings.title | escape -}}
                    </h3>
                  {%- endif -%}
                  {%- if text_content != blank -%}
                    <div class="mg-svc-details__rte">{{ text_content }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'included' or 'benefits' -%}
              {%- liquid
                assign lines = block.settings.items | newline_to_br | split: '<br />'
                assign show_warranty = false
                if block.type == 'included' and block.settings.show_warranty and settings.mg_warranty_text != blank
                  assign show_warranty = true
                endif
                assign item_icon = 'check'
                if block.type == 'benefits' and block.settings.icon != blank
                  assign item_icon = block.settings.icon
                endif
              -%}
              {%- if block.settings.title != blank or block.settings.items != blank or show_warranty -%}
                <div
                  class="mg-svc-details__block mg-svc-details__block--{{ block.type }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.title != blank -%}
                    <h3 class="mg-svc-details__title">
                      <span
                        class="mg-svc-details__num"
                        aria-hidden="true"
                      ></span>
                      {{- block.settings.title | escape -}}
                    </h3>
                  {%- endif -%}
                  <ul
                    class="mg-svc-details__list mg-svc-details__list--{{ block.type }}"
                    role="list"
                  >
                    {%- for line in lines -%}
                      {%- assign item = line | strip -%}
                      {%- if item != blank -%}
                        <li class="mg-svc-details__item">
                          <span class="mg-svc-details__tick">
                            {%- render 'mg-icon', icon: item_icon -%}
                          </span>
                          <span>{{ item | escape }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if show_warranty -%}
                      <li class="mg-svc-details__item mg-svc-details__item--warranty">
                        <span class="mg-svc-details__tick">
                          {%- render 'mg-icon', icon: 'shield' -%}
                        </span>
                        <span>{{ settings.mg_warranty_text | escape }}</span>
                      </li>
                    {%- endif -%}
                  </ul>
                </div>
              {%- endif -%}

            {%- when 'makes' -%}
              {%- liquid
                assign makes = block.settings.makes | newline_to_br | replace: '<br />', ',' | split: ','
                assign makes_link = block.settings.link_url | default: '/pages/get-a-quote'
              -%}
              {%- if block.settings.title != blank or block.settings.makes != blank -%}
                <div
                  class="mg-svc-details__block mg-svc-details__block--makes"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.title != blank -%}
                    <h3 class="mg-svc-details__title">
                      <span
                        class="mg-svc-details__num"
                        aria-hidden="true"
                      ></span>
                      {{- block.settings.title | escape -}}
                    </h3>
                  {%- endif -%}
                  <ul
                    class="mg-svc-details__makes"
                    role="list"
                  >
                    {%- for make in makes -%}
                      {%- assign make_name = make | strip -%}
                      {%- if make_name != blank -%}
                        <li class="mg-chip mg-svc-details__make">{{ make_name | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                  {%- if block.settings.note != blank or block.settings.link_label != blank -%}
                    <div class="mg-svc-details__makes-foot">
                      {%- if block.settings.note != blank -%}
                        <p class="mg-svc-details__note">{{ block.settings.note | escape }}</p>
                      {%- endif -%}
                      {%- if block.settings.link_label != blank -%}
                        <a
                          class="mg-svc-details__link"
                          href="{{ makes_link }}"
                        >
                          <span>{{ block.settings.link_label | escape }}</span>
                          {%- render 'mg-icon', icon: 'arrow-right' -%}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if has_card -%}
        <aside
          class="mg-svc-details__aside"
          {% if section.settings.card_heading != blank %}
            aria-labelledby="{{ card_heading_id }}"
          {% else %}
            aria-label="Prices and booking"
          {% endif %}
        >
          <div class="mg-svc-card">
            {%- if section.settings.card_heading != blank -%}
              <h2
                class="mg-svc-card__title"
                id="{{ card_heading_id }}"
              >
                {{ section.settings.card_heading | escape }}
              </h2>
            {%- endif -%}
            {%- if section.settings.card_text != blank -%}
              <p class="mg-svc-card__text">{{ section.settings.card_text | escape }}</p>
            {%- endif -%}

            {%- if price_rows.size > 0 -%}
              <ul
                class="mg-svc-card__prices"
                role="list"
              >
                {%- for block in price_rows -%}
                  {%- if block.settings.label != blank -%}
                    {%- liquid
                      assign row_tag = 'div'
                      if block.settings.url != blank
                        assign row_tag = 'a'
                      endif
                    -%}
                    <li {{ block.shopify_attributes }}>
                      <{{ row_tag }}
                        class="mg-svc-card__row{% if row_tag == 'a' %} mg-svc-card__row--link{% endif %}"
                        {% if row_tag == 'a' %}
                          href="{{ block.settings.url }}"
                        {% endif %}
                      >
                        <span class="mg-svc-card__row-main">
                          <span class="mg-svc-card__row-label">{{ block.settings.label | escape }}</span>
                          {%- if block.settings.note != blank -%}
                            <span class="mg-svc-card__row-note">{{ block.settings.note | escape }}</span>
                          {%- endif -%}
                        </span>
                        {%- if block.settings.price != blank -%}
                          <span class="mg-svc-card__row-price">{{ block.settings.price | escape }}</span>
                        {%- endif -%}
                        {%- if row_tag == 'a' -%}
                          {%- render 'mg-icon', icon: 'arrow-right', class: 'mg-svc-card__row-arrow' -%}
                        {%- endif -%}
                      </{{ row_tag }}>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if section.settings.deposit_text != blank -%}
              <p class="mg-svc-card__deposit">
                {%- render 'mg-icon', icon: 'calendar' -%}
                <span>{{ section.settings.deposit_text | escape }}</span>
              </p>
            {%- endif -%}

            {%- if section.settings.card_button_label != blank or show_whatsapp -%}
              <div class="mg-svc-card__actions">
                {%- if section.settings.card_button_label != blank -%}
                  <a
                    class="mg-btn mg-btn--primary mg-btn--block"
                    href="{{ book_url }}"
                  >
                    {%- render 'mg-icon', icon: 'calendar' -%}
                    <span>{{ section.settings.card_button_label | escape }}</span>
                  </a>
                {%- endif -%}
                {%- if show_whatsapp -%}
                  <a
                    class="mg-btn mg-btn--whatsapp mg-btn--block"
                    href="https://wa.me/{{ settings.mg_whatsapp_number }}?text={{ wa_message | url_encode }}"
                    target="_blank"
                    rel="noopener"
                  >
                    {%- render 'mg-icon', icon: 'whatsapp' -%}
                    <span>{{ section.settings.card_whatsapp_label | escape }}</span>
                    <span class="mg-visually-hidden">(opens WhatsApp)</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.card_show_contact -%}
              <ul
                class="mg-svc-card__contact"
                role="list"
              >
                {%- if settings.mg_phone_display != blank -%}
                  <li>
                    {%- render 'mg-icon', icon: 'phone' -%}
                    <a href="tel:+{{ settings.mg_phone_e164 }}">{{ settings.mg_phone_display | escape }}</a>
                  </li>
                {%- endif -%}
                {%- if settings.mg_hours_weekdays != blank -%}
                  <li>
                    {%- render 'mg-icon', icon: 'clock' -%}
                    <span>
                      Mon–Fri {{ settings.mg_hours_weekdays | escape -}}
                      {%- if settings.mg_hours_saturday != blank %}, Sat {{ settings.mg_hours_saturday | escape }}{% endif -%}
                    </span>
                  </li>
                {%- endif -%}
                {%- if settings.mg_street != blank or settings.mg_locality != blank -%}
                  <li>
                    {%- render 'mg-icon', icon: 'map-pin' -%}
                    <span>
                      {{- settings.mg_street | escape -}}
                      {%- if settings.mg_street != blank and settings.mg_locality != blank %}, {% endif -%}
                      {{- settings.mg_locality | escape -}}
                    </span>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.output_schema -%}
  {%- liquid
    assign service_name = section.settings.schema_name | strip
    if service_name == blank
      if page and page.title != blank
        assign service_name = page.title
      else
        assign service_name = 'Apple CarPlay & Android Auto Installation'
      endif
    endif
    assign service_url = canonical_url | default: request.path
    assign business_id = shop.url | append: '/#localbusiness'
    assign business_image = 'mg-showroom.webp' | asset_url | prepend: 'https:'
    assign phone_e164 = '+' | append: settings.mg_phone_e164
  -%}
  {%- capture offers_json -%}
    {%- for block in price_rows -%}
      {%- liquid
        assign price_clean = block.settings.price | downcase | remove: 'from' | remove: '€' | remove: 'eur' | remove: ',' | strip
        assign price_value = price_clean | plus: 0
      -%}
      {%- if block.settings.label != blank and price_value > 0 -%}
        {"@type":"Offer","name":{{ block.settings.label | json }},"price":{{ price_clean | json }},"priceCurrency":"EUR"
        {%- if block.settings.url != blank -%}
          {%- liquid
            assign offer_url = block.settings.url
            assign offer_first = block.settings.url | slice: 0
            if offer_first == '/'
              assign offer_url = request.origin | append: block.settings.url
            endif
          -%}
          ,"url":{{ offer_url | json }}
        {%- endif -%}
        },
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign offers_json = offers_json | strip | remove_last: ',' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": {{ service_name | json }},
      "serviceType": {{ service_name | json }},
      {%- if section.settings.schema_description != blank %}
        "description": {{ section.settings.schema_description | strip_newlines | json }},
      {%- endif %}
      "url": {{ service_url | json }},
      "areaServed": [
        { "@type": "City", "name": "Dublin" },
        { "@type": "Country", "name": "Ireland" }
      ],
      "provider": {
        "@type": "LocalBusiness",
        "@id": {{ business_id | json }},
        "name": {{ settings.mg_business_name | json }},
        "url": {{ shop.url | json }},
        "image": {{ business_image | json }},
        {%- if settings.mg_phone_e164 != blank %}
          "telephone": {{ phone_e164 | json }},
        {%- endif %}
        {%- if settings.mg_email != blank %}
          "email": {{ settings.mg_email | json }},
        {%- endif %}
        {%- if settings.mg_geo_lat != blank and settings.mg_geo_lng != blank %}
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": {{ settings.mg_geo_lat | strip | json }},
            "longitude": {{ settings.mg_geo_lng | strip | json }}
          },
        {%- endif %}
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ settings.mg_street | json }},
          "addressLocality": {{ settings.mg_locality | json }},
          "addressRegion": {{ settings.mg_region | json }},
          "postalCode": {{ settings.mg_postcode | json }},
          "addressCountry": {{ settings.mg_country_code | default: 'IE' | json }}
        }
      }
      {%- if offers_json != blank %},
        "offers": [{{ offers_json }}]
      {%- endif %}
    }
  </script>
{%- endif -%}

{% stylesheet %}
  /*
   * Service details: numbered content blocks in the main column, with a sticky
   * price card on the right from 990px. Stacked layout puts the card underneath.
   */
  .mg-svc-details {
    --mg-svc-panel: var(--mg-surface);
    padding-top: calc(var(--mg-section-space) * 0.8);
    background: var(--mg-bg);
  }

  .mg-svc-details.mg-section--surface {
    --mg-svc-panel: var(--mg-surface-2);
    background: var(--mg-surface);
  }

  .mg-svc-details__head {
    max-width: 820px;
  }

  .mg-svc-details__layout {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
  }

  .mg-svc-details__main {
    min-width: 0;
    counter-reset: mg-svc-block;
  }

  /* Content blocks */
  .mg-svc-details__block {
    counter-increment: mg-svc-block;
    padding-block: clamp(28px, 4vw, 40px);
    border-top: 1px solid var(--mg-border);
  }

  .mg-svc-details__block:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .mg-svc-details__block:last-child {
    padding-bottom: 0;
  }

  .mg-svc-details__title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--mg-h3);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--mg-text);
    text-wrap: balance;
  }

  .mg-svc-details__num {
    display: none;
  }

  .mg-svc-details--numbered .mg-svc-details__num {
    display: inline-block;
    flex: none;
    min-width: 2.2em;
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: var(--mg-accent);
  }

  .mg-svc-details--numbered .mg-svc-details__num::before {
    content: counter(mg-svc-block, decimal-leading-zero);
  }

  /* Rich text */
  .mg-svc-details__rte {
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--mg-text-muted);
  }

  .mg-svc-details__rte > * {
    margin: 0 0 1em;
  }

  .mg-svc-details__rte > :last-child {
    margin-bottom: 0;
  }

  .mg-svc-details__rte strong,
  .mg-svc-details__rte b {
    color: var(--mg-text);
  }

  .mg-svc-details__rte a {
    color: var(--mg-text);
    text-decoration: underline;
    text-decoration-color: var(--mg-accent);
    text-underline-offset: 3px;
  }

  .mg-svc-details__rte ul,
  .mg-svc-details__rte ol {
    padding-left: 1.25em;
  }

  /* Tick lists */
  .mg-svc-details__list {
    display: grid;
    gap: 14px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-svc-details__item {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--mg-text);
  }

  .mg-svc-details__tick {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    margin-top: -1px;
    border-radius: 50%;
    background: var(--mg-accent-soft);
    color: var(--mg-accent);
  }

  .mg-svc-details__tick .mg-icon {
    width: 15px;
    height: 15px;
    stroke-width: 2.5;
  }

  .mg-svc-details__item--warranty .mg-svc-details__tick .mg-icon {
    stroke-width: 2;
  }

  /* Benefits: hairline tiles */
  .mg-svc-details__list--benefits {
    gap: 10px;
  }

  .mg-svc-details__list--benefits .mg-svc-details__item {
    align-items: center;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--mg-border);
    border-radius: var(--mg-radius);
    background: var(--mg-svc-panel);
    font-size: 0.9375rem;
    font-weight: 600;
    transition: border-color 0.25s var(--mg-ease);
  }

  .mg-svc-details__list--benefits .mg-svc-details__item:hover {
    border-color: var(--mg-border-strong);
  }

  .mg-svc-details__list--benefits .mg-svc-details__tick {
    width: 30px;
    height: 30px;
    border-radius: var(--mg-radius-sm);
  }

  .mg-svc-details__list--benefits .mg-svc-details__tick .mg-icon {
    width: 17px;
    height: 17px;
    stroke-width: 2;
  }

  /* Makes */
  .mg-svc-details__makes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-svc-details__make {
    padding: 0.5rem 0.9rem;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    color: var(--mg-text);
    transition:
      border-color 0.2s var(--mg-ease),
      background-color 0.2s var(--mg-ease);
  }

  .mg-svc-details__make:hover {
    border-color: var(--mg-border-strong);
    background: color-mix(in srgb, var(--mg-text) 6%, transparent);
  }

  .mg-svc-details__makes-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }

  .mg-svc-details__note {
    flex: 1 1 320px;
    max-width: 62ch;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--mg-text-muted);
  }

  .mg-svc-details__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mg-text);
    text-decoration: none;
  }

  .mg-svc-details__link .mg-icon {
    width: 18px;
    height: 18px;
    color: var(--mg-accent);
    transition: transform 0.2s var(--mg-ease);
  }

  .mg-svc-details__link:hover .mg-icon {
    transform: translateX(3px);
  }

  .mg-svc-details__link:focus-visible {
    outline: 2px solid var(--mg-text);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Price card */
  .mg-svc-details__aside {
    min-width: 0;
  }

  .mg-svc-card {
    position: relative;
    overflow: hidden;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--mg-border);
    border-radius: var(--mg-radius-lg);
    background:
      radial-gradient(120% 60% at 100% 0%, color-mix(in srgb, var(--mg-accent) 10%, transparent), transparent 60%),
      var(--mg-svc-panel);
    box-shadow: var(--mg-shadow);
  }

  .mg-svc-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--mg-accent), color-mix(in srgb, var(--mg-accent) 0%, transparent));
  }

  .mg-svc-card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--mg-text);
  }

  .mg-svc-card__text {
    margin: 0.6rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-text-muted);
  }

  .mg-svc-card__prices {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--mg-border);
  }

  .mg-svc-card__prices li {
    border-bottom: 1px solid var(--mg-border);
  }

  .mg-svc-card__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 0;
    color: var(--mg-text);
    text-decoration: none;
  }

  .mg-svc-card__row-main {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .mg-svc-card__row-label {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  .mg-svc-card__row-note {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--mg-text-subtle);
  }

  .mg-svc-card__row-price {
    flex: none;
    font-size: 1.0625rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--mg-text);
    white-space: nowrap;
  }

  .mg-svc-card__row-arrow {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--mg-text-subtle);
    transition:
      transform 0.2s var(--mg-ease),
      color 0.2s var(--mg-ease);
  }

  .mg-svc-card__row--link {
    transition: color 0.2s var(--mg-ease);
  }

  .mg-svc-card__row--link:hover .mg-svc-card__row-arrow {
    color: var(--mg-accent);
    transform: translateX(3px);
  }

  .mg-svc-card__row--link:hover .mg-svc-card__row-label {
    text-decoration: underline;
    text-decoration-color: var(--mg-border-strong);
    text-underline-offset: 3px;
  }

  .mg-svc-card__row--link:focus-visible {
    outline: 2px solid var(--mg-text);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .mg-svc-card__deposit {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--mg-text-muted);
  }

  .mg-svc-card__deposit .mg-icon {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--mg-accent);
  }

  .mg-svc-card__actions {
    display: grid;
    gap: 10px;
    margin-top: 1.25rem;
  }

  .mg-svc-card__contact {
    display: grid;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 1.1rem 0 0;
    list-style: none;
    border-top: 1px solid var(--mg-border);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--mg-text-muted);
  }

  .mg-svc-card__contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .mg-svc-card__contact .mg-icon {
    width: 16px;
    height: 16px;
    flex: none;
    margin-top: 1px;
    color: var(--mg-text-subtle);
  }

  .mg-svc-card__contact a {
    font-weight: 700;
    color: var(--mg-text);
    text-decoration: underline;
    text-decoration-color: var(--mg-border-strong);
    text-underline-offset: 3px;
  }

  .mg-svc-card__contact a:hover {
    text-decoration-color: var(--mg-accent);
  }

  .mg-svc-card__contact a:focus-visible {
    outline: 2px solid var(--mg-text);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (min-width: 560px) {
    .mg-svc-details__list--benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mg-svc-details__list--benefits .mg-svc-details__item {
      min-height: 64px;
      padding: 0.9rem 1rem;
    }
  }

  @media (min-width: 750px) {
    .mg-svc-details__list--included {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mg-svc-details--stacked .mg-svc-details__aside {
      max-width: 640px;
    }
  }

  @media (min-width: 990px) {
    .mg-svc-details--sidebar .mg-svc-details__layout {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
      align-items: start;
      gap: clamp(48px, 6vw, 96px);
    }

    .mg-svc-details--sidebar.mg-svc-details--sticky .mg-svc-details__aside {
      position: sticky;
      top: calc(var(--header-height, 72px) + 24px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-svc-details__list--benefits .mg-svc-details__item,
    .mg-svc-details__make,
    .mg-svc-details__link .mg-icon,
    .mg-svc-card__row--link,
    .mg-svc-card__row-arrow {
      transition: none;
    }

    .mg-svc-details__link:hover .mg-icon,
    .mg-svc-card__row--link:hover .mg-svc-card__row-arrow {
      transform: none;
    }
  }
{% endstylesheet %}

