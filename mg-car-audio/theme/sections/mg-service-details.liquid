{%- liquid
  assign heading_id = 'MgSvcDetailsHeading-' | append: section.id
  assign card_heading_id = 'MgSvcCardHeading-' | append: section.id

  assign book_url = section.settings.card_button_url | default: '/pages/book-a-fitting'
  assign wa_message = section.settings.card_whatsapp_message | default: settings.mg_whatsapp_message
  assign show_whatsapp = false
  if section.settings.card_show_whatsapp and settings.mg_whatsapp_number != blank and section.settings.card_whatsapp_label != blank
    assign show_whatsapp = true
  endif

  assign price_rows = section.blocks | where: 'type', 'price_row'
  assign any_row_link = false
  for block in price_rows
    if block.settings.url != blank
      assign any_row_link = true
    endif
  endfor
  assign has_card = false
  if section.settings.show_card
    if price_rows.size > 0 or section.settings.card_heading != blank or section.settings.card_button_label != blank or show_whatsapp
      assign has_card = true
    endif
  endif

  assign layout = section.settings.layout
  if has_card == false
    assign layout = 'stacked'
  endif

  assign section_classes = 'mg-section mg-svc-details mg-svc-details--' | append: layout
  if section.settings.background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--band mg-svc-details--band'
  endif
  if section.settings.sticky_card
    assign section_classes = section_classes | append: ' mg-svc-details--sticky'
  endif
-%}

{%- comment -%}
  The price card is captured once. From 990px it sits in the aside (sidebar or below the
  content); on phones and tablets a copy follows the first content block, so the prices and
  the Book button aren't five screens down. Only one copy is displayed at a time.
{%- endcomment -%}
{%- if has_card -%}
  {%- capture card_html -%}
        <aside
          class="mg-svc-details__aside mg-svc-details__aside--side"
          {% if section.settings.card_heading != blank %}
            aria-labelledby="{{ card_heading_id }}"
          {% else %}
            aria-label="Prices and booking"
          {% endif %}
        >
          <div class="mg-card mg-card--raised mg-svc-card">
            <div class="mg-svc-card__main">
            {%- if section.settings.card_heading != blank -%}
              <h2
                class="mg-svc-card__title"
                id="{{ card_heading_id }}"
              >
                {{ section.settings.card_heading | escape }}
              </h2>
            {%- endif -%}
            {%- if section.settings.card_text != blank -%}
              <p class="mg-svc-card__text">{{ section.settings.card_text | escape }}</p>
            {%- endif -%}

            {%- if price_rows.size > 0 -%}
              <ul
                class="mg-svc-card__prices"
                role="list"
              >
                {%- for block in price_rows -%}
                  {%- if block.settings.label != blank -%}
                    {%- liquid
                      assign row_tag = 'div'
                      if block.settings.url != blank
                        assign row_tag = 'a'
                      endif

                      # "€149.99" shows as €149 with superscript 99; "€350" stays as it is
                      assign row_price = block.settings.price | strip
                      assign row_whole = row_price
                      assign row_cents = ''
                      if row_price contains '.'
                        assign row_parts = row_price | split: '.'
                        assign row_tail = row_parts.last | strip
                        assign row_digits = row_tail | plus: 0
                        if row_parts.size == 2 and row_tail.size == 2 and row_digits > 0
                          assign row_whole = row_parts.first
                          assign row_cents = row_tail
                        endif
                      endif
                    -%}
                    <li {{ block.shopify_attributes }}>
                      <{{ row_tag }}
                        class="mg-svc-card__row{% if row_tag == 'a' %} mg-svc-card__row--link{% endif %}"
                        {% if row_tag == 'a' %}
                          href="{{ block.settings.url }}"
                        {% endif %}
                      >
                        <span class="mg-svc-card__row-main">
                          <span class="mg-svc-card__row-label">{{ block.settings.label | escape }}</span>
                          {%- if block.settings.note != blank -%}
                            <span class="mg-svc-card__row-note">{{ block.settings.note | escape }}</span>
                          {%- endif -%}
                        </span>
                        {%- if row_price != blank -%}
                          <span class="mg-price mg-svc-card__row-price">
                            {{- row_whole | escape -}}
                            {%- if row_cents != blank -%}
                              <span class="mg-price__cents">{{ row_cents | escape }}</span>
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                        {%- if row_tag == 'a' -%}
                          {%- render 'mg-icon', icon: 'chevron-right', class: 'mg-svc-card__row-chevron' -%}
                        {%- elsif any_row_link -%}
                          {%- comment -%} Same width as the chevron, so every price sits in one column {%- endcomment -%}
                          <span
                            class="mg-svc-card__row-chevron"
                            aria-hidden="true"
                          ></span>
                        {%- endif -%}
                      </{{ row_tag }}>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            </div>

            <div class="mg-svc-card__side">
            {%- if section.settings.deposit_text != blank -%}
              <p class="mg-svc-card__deposit">
                {%- render 'mg-icon', icon: 'calendar' -%}
                <span>{{ section.settings.deposit_text | escape }}</span>
              </p>
            {%- endif -%}

            {%- if section.settings.card_button_label != blank or show_whatsapp -%}
              <div class="mg-svc-card__actions">
                {%- if section.settings.card_button_label != blank -%}
                  <a
                    class="mg-btn mg-btn--primary mg-btn--block"
                    href="{{ book_url }}"
                  >
                    {%- render 'mg-icon', icon: 'calendar' -%}
                    <span>{{ section.settings.card_button_label | escape }}</span>
                  </a>
                {%- endif -%}
                {%- if show_whatsapp -%}
                  <a
                    class="mg-btn mg-btn--whatsapp mg-btn--block"
                    href="https://wa.me/{{ settings.mg_whatsapp_number }}?text={{ wa_message | url_encode }}"
                    target="_blank"
                    rel="noopener"
                  >
                    {%- render 'mg-icon', icon: 'whatsapp' -%}
                    <span>{{ section.settings.card_whatsapp_label | escape }}</span>
                    <span class="mg-visually-hidden"> (opens WhatsApp)</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.card_show_contact -%}
              <ul
                class="mg-svc-card__contact"
                role="list"
              >
                {%- if settings.mg_phone_display != blank and settings.mg_phone_e164 != blank -%}
                  <li>
                    {%- render 'mg-icon', icon: 'phone' -%}
                    <a
                      class="mg-link"
                      href="tel:+{{ settings.mg_phone_e164 }}"
                      >{{ settings.mg_phone_display | escape }}</a
                    >
                  </li>
                {%- endif -%}
                {%- if settings.mg_hours_weekdays != blank -%}
                  <li>
                    {%- render 'mg-icon', icon: 'clock' -%}
                    <span>
                      Mon to Fri {{ settings.mg_hours_weekdays | escape -}}
                      {%- if settings.mg_hours_saturday != blank -%}
                        <br>Sat {{ settings.mg_hours_saturday | escape -}}
                      {%- endif -%}
                    </span>
                  </li>
                {%- endif -%}
                {%- if settings.mg_street != blank or settings.mg_locality != blank -%}
                  <li>
                    {%- render 'mg-icon', icon: 'map-pin' -%}
                    <span>
                      {{- settings.mg_street | escape -}}
                      {%- if settings.mg_street != blank and settings.mg_locality != blank %}, {% endif -%}
                      {{- settings.mg_locality | escape -}}
                    </span>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
            </div>
          </div>
        </aside>
  {%- endcapture -%}
  {%- liquid
    assign card_heading_id_inline = card_heading_id | append: '-inline'
    assign card_html_inline = card_html | replace: card_heading_id, card_heading_id_inline | replace: 'mg-svc-details__aside--side', 'mg-svc-details__aside--inline' | replace: 'data-shopify-editor-block', 'data-mg-editor-copy'
  -%}
{%- endif -%}

<div
  class="{{ section_classes }}"
  {% if section.settings.heading != blank %}
    role="region" aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="mg-container">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="mg-head mg-svc-details__head">
        <div class="mg-head__text">
          {%- if section.settings.heading != blank -%}
            <h2
              class="mg-head__title"
              id="{{ heading_id }}"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="mg-head__sub">{{ section.settings.intro | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="mg-svc-details__layout">
      <div class="mg-svc-details__main">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              {%- liquid
                assign text_content = block.settings.content
                if block.settings.use_page_content and page and page.content != blank
                  assign text_content = page.content
                endif
              -%}
              {%- if block.settings.title != blank or text_content != blank -%}
                <div
                  class="mg-svc-details__block mg-svc-details__block--text"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.title != blank -%}
                    <h3 class="mg-svc-details__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if text_content != blank -%}
                    <div class="mg-svc-details__rte">{{ text_content }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'included' or 'benefits' -%}
              {%- liquid
                assign lines = block.settings.items | newline_to_br | split: '<br />'
                assign show_warranty = false
                if block.type == 'included' and block.settings.show_warranty and settings.mg_warranty_text != blank
                  assign show_warranty = true
                endif
                assign item_icon = 'check'
                if block.type == 'benefits' and block.settings.icon != blank
                  assign item_icon = block.settings.icon
                endif
              -%}
              {%- if block.settings.title != blank or block.settings.items != blank or show_warranty -%}
                <div
                  class="mg-svc-details__block mg-svc-details__block--{{ block.type }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.title != blank -%}
                    <h3 class="mg-svc-details__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  <ul
                    class="mg-svc-details__list mg-svc-details__list--{{ block.type }}"
                    role="list"
                  >
                    {%- for line in lines -%}
                      {%- assign item = line | strip -%}
                      {%- if item != blank -%}
                        <li class="mg-svc-details__item">
                          <span class="mg-svc-details__tick">
                            {%- render 'mg-icon', icon: item_icon -%}
                          </span>
                          <span class="mg-svc-details__item-text">{{ item | escape }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if show_warranty -%}
                      <li class="mg-svc-details__item mg-svc-details__item--warranty">
                        <span class="mg-svc-details__tick">
                          {%- render 'mg-icon', icon: 'shield' -%}
                        </span>
                        <span class="mg-svc-details__item-text">{{ settings.mg_warranty_text | escape }}</span>
                      </li>
                    {%- endif -%}
                  </ul>
                </div>
              {%- endif -%}

            {%- when 'makes' -%}
              {%- liquid
                assign makes = block.settings.makes | newline_to_br | replace: '<br />', ',' | split: ','
                assign makes_link = block.settings.link_url | default: '/pages/get-a-quote'
              -%}
              {%- if block.settings.title != blank or block.settings.makes != blank -%}
                <div
                  class="mg-svc-details__block mg-svc-details__block--makes"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.title != blank -%}
                    <h3 class="mg-svc-details__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  <ul
                    class="mg-chips mg-chips--wrap mg-svc-details__makes"
                    role="list"
                  >
                    {%- for make in makes -%}
                      {%- assign make_name = make | strip -%}
                      {%- if make_name != blank -%}
                        <li class="mg-chip">{{ make_name | escape }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                  {%- if block.settings.note != blank or block.settings.link_label != blank -%}
                    <p class="mg-svc-details__note">
                      {%- if block.settings.note != blank -%}
                        {{ block.settings.note | escape }}
                      {% endif -%}
                      {%- if block.settings.link_label != blank -%}
                        <a
                          class="mg-link"
                          href="{{ makes_link }}"
                          >{{ block.settings.link_label | escape }}</a
                        >
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                </div>
              {%- endif -%}
          {%- endcase -%}
          {%- if forloop.first and has_card -%}
            {{ card_html_inline }}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if has_card -%}
        {{ card_html }}
      {%- endif -%}
    </div>
  </div>
</div>

{%- if section.settings.output_schema -%}
  {%- liquid
    assign service_name = section.settings.schema_name | strip
    if service_name == blank
      if page and page.title != blank
        assign service_name = page.title
      else
        assign service_name = 'Apple CarPlay and Android Auto installation'
      endif
    endif
    assign service_url = canonical_url | default: request.path
    assign business_id = shop.url | append: '/#localbusiness'
    assign business_image = 'mg-showroom.webp' | asset_url | prepend: 'https:'
    assign phone_e164 = '+' | append: settings.mg_phone_e164
  -%}
  {%- capture offers_json -%}
    {%- for block in price_rows -%}
      {%- liquid
        assign price_clean = block.settings.price | downcase | remove: 'from' | remove: '€' | remove: 'eur' | remove: ',' | strip
        assign price_value = price_clean | plus: 0
      -%}
      {%- if block.settings.label != blank and price_value > 0 -%}
        {"@type":"Offer","name":{{ block.settings.label | json }},"price":{{ price_clean | json }},"priceCurrency":"EUR"
        {%- if block.settings.url != blank -%}
          {%- liquid
            assign offer_url = block.settings.url
            assign offer_first = block.settings.url | slice: 0
            if offer_first == '/'
              assign offer_url = request.origin | append: block.settings.url
            endif
          -%}
          ,"url":{{ offer_url | json }}
        {%- endif -%}
        },
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign offers_json = offers_json | strip | remove_last: ',' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": {{ service_name | json }},
      "serviceType": {{ service_name | json }},
      {%- if section.settings.schema_description != blank %}
        "description": {{ section.settings.schema_description | strip_newlines | json }},
      {%- endif %}
      "url": {{ service_url | json }},
      "areaServed": [
        { "@type": "City", "name": "Dublin" },
        { "@type": "Country", "name": "Ireland" }
      ],
      "provider": {
        "@type": "LocalBusiness",
        "@id": {{ business_id | json }},
        "name": {{ settings.mg_business_name | json }},
        "url": {{ shop.url | json }},
        "image": {{ business_image | json }},
        {%- if settings.mg_phone_e164 != blank %}
          "telephone": {{ phone_e164 | json }},
        {%- endif %}
        {%- if settings.mg_email != blank %}
          "email": {{ settings.mg_email | json }},
        {%- endif %}
        {%- if settings.mg_geo_lat != blank and settings.mg_geo_lng != blank %}
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": {{ settings.mg_geo_lat | strip | json }},
            "longitude": {{ settings.mg_geo_lng | strip | json }}
          },
        {%- endif %}
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ settings.mg_street | json }},
          "addressLocality": {{ settings.mg_locality | json }},
          "addressRegion": {{ settings.mg_region | json }},
          "postalCode": {{ settings.mg_postcode | json }},
          "addressCountry": {{ settings.mg_country_code | default: 'IE' | json }}
        }
      }
      {%- if offers_json != blank %},
        "offers": [{{ offers_json }}]
      {%- endif %}
    }
  </script>
{%- endif -%}

{% stylesheet %}
  /*
   * Service details: content blocks in the main column (text, tick lists, make chips) and
   * a raised price card that stays in view on desktop. Phones and tablets get a copy of the
   * card after the first block. Layout only; the rest comes from mg-theme.css.
   */
  .mg-svc-details__layout {
    display: grid;
    gap: var(--mg-space-7);
  }

  .mg-svc-details__main {
    min-width: 0;
  }

  /* Blocks: one hairline between them, nothing around them */
  .mg-svc-details__block {
    padding-block: var(--mg-space-6);
    border-top: 1px solid var(--mg-line);
  }

  .mg-svc-details__block:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .mg-svc-details__block:last-child {
    padding-bottom: 0;
  }

  /* After the inline price card the next block needs no divider */
  .mg-svc-details__aside--inline + .mg-svc-details__block {
    border-top: 0;
  }

  .mg-svc-details__title {
    margin: 0 0 var(--mg-space-4);
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-transform: none;
    text-wrap: balance;
    color: var(--mg-ink);
  }

  /* Rich text */
  .mg-svc-details__rte {
    max-width: 68ch;
    font-size: var(--mg-fs-body);
    line-height: 1.65;
    color: var(--mg-ink-2);
  }

  .mg-svc-details__rte > * {
    margin: 0 0 1em;
  }

  .mg-svc-details__rte > :last-child {
    margin-bottom: 0;
  }

  .mg-svc-details__rte :is(strong, b) {
    color: var(--mg-ink);
  }

  .mg-svc-details__rte a {
    color: var(--mg-ink);
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .mg-svc-details__rte a:hover {
    text-decoration-thickness: 2px;
  }

  .mg-svc-details__rte :is(ul, ol) {
    padding-left: 1.25em;
  }

  /* Tick lists */
  .mg-svc-details__list {
    display: grid;
    gap: var(--mg-space-3) var(--mg-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-svc-details__item {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    align-items: start;
    gap: var(--mg-space-3);
    margin: 0;
    font-size: var(--mg-fs-body);
    line-height: 1.5;
    color: var(--mg-ink);
  }

  .mg-svc-details__item-text {
    min-width: 0;
    padding-top: 2px;
    text-wrap: pretty;
  }

  .mg-svc-details__tick {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--mg-radius-pill);
    background-color: var(--mg-red-tint);
    color: var(--mg-red-ink);
  }

  .mg-svc-details__tick .mg-icon {
    width: 16px;
    height: 16px;
    stroke-width: 2.25;
  }

  .mg-svc-details__item--warranty .mg-svc-details__tick .mg-icon {
    stroke-width: 1.75;
  }

  /* Benefits use the same tick list as "What's included" (one check style per page) */

  /* Makes */
  .mg-svc-details__makes {
    margin: 0;
    padding: 0;
  }

  .mg-svc-details__note {
    max-width: 64ch;
    margin: var(--mg-space-4) 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--mg-ink-2);
  }

  .mg-svc-details__note .mg-link {
    text-decoration-color: currentcolor;
    white-space: nowrap;
  }

  /* Price card */
  .mg-svc-details__aside {
    min-width: 0;
  }

  .mg-svc-details__aside--side {
    display: none;
  }

  .mg-svc-details__aside--inline {
    margin-block: var(--mg-space-6) 0;
  }

  .mg-svc-details__aside--inline + .mg-svc-details__block {
    margin-top: var(--mg-space-6);
  }

  .mg-svc-card {
    padding: var(--mg-space-5);
  }

  .mg-svc-card__title {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.3;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-svc-card__text {
    margin: var(--mg-space-1) 0 0;
    font-size: var(--mg-fs-small);
    line-height: 1.5;
    color: var(--mg-ink-2);
  }

  .mg-svc-card__prices {
    margin: var(--mg-space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .mg-svc-card__prices li + li {
    border-top: 1px solid var(--mg-line);
  }

  .mg-svc-card__row {
    display: flex;
    align-items: center;
    gap: var(--mg-space-3);
    min-height: 56px;
    padding: var(--mg-space-3) 0;
    color: var(--mg-ink);
    text-decoration: none;
  }

  .mg-svc-card__row-main {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .mg-svc-card__row-label {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .mg-svc-card__row-note {
    font-size: var(--mg-fs-micro);
    line-height: 1.35;
    color: var(--mg-ink-2);
  }

  .mg-svc-card__row-price {
    flex: none;
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .mg-svc-card__row-chevron {
    flex: none;
    width: 16px;
    height: 16px;
    margin-inline-start: calc(var(--mg-space-1) * -1);
    color: var(--mg-ink-3);
    transition:
      color var(--mg-dur) var(--mg-ease),
      transform var(--mg-dur) var(--mg-ease);
  }

  @media (hover: hover) {
    .mg-svc-card__row--link:hover .mg-svc-card__row-label {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.22em;
    }

    .mg-svc-card__row--link:hover .mg-svc-card__row-chevron {
      color: var(--mg-ink);
      transform: translateX(2px);
    }
  }

  .mg-svc-card__row--link:focus-visible {
    border-radius: var(--mg-radius-xs);
    outline: 2px solid var(--mg-focus);
    outline-offset: 2px;
  }

  .mg-svc-card__deposit {
    display: flex;
    align-items: center;
    gap: var(--mg-space-2);
    margin: var(--mg-space-2) 0 0;
    padding: var(--mg-space-3);
    border-radius: var(--mg-radius-sm);
    background-color: var(--mg-band);
    color: var(--mg-ink);
    font-size: var(--mg-fs-small);
    line-height: 1.4;
  }

  .mg-svc-card__deposit .mg-icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--mg-ink-2);
  }

  .mg-svc-card__actions {
    display: grid;
    gap: var(--mg-space-2);
    margin-top: var(--mg-space-4);
  }

  .mg-svc-card__contact {
    display: grid;
    gap: var(--mg-space-2);
    margin: var(--mg-space-4) 0 0;
    padding: var(--mg-space-4) 0 0;
    border-top: 1px solid var(--mg-line);
    list-style: none;
    font-size: var(--mg-fs-small);
    line-height: 1.45;
    color: var(--mg-ink-2);
  }

  .mg-svc-card__contact li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: start;
    gap: var(--mg-space-2);
  }

  .mg-svc-card__contact .mg-icon {
    width: 18px;
    height: 18px;
    margin-top: 1px;
    color: var(--mg-ink-3);
  }

  .mg-svc-card__contact li:first-child {
    align-items: center;
  }

  .mg-svc-card__contact .mg-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: var(--mg-tap);
    margin-block: calc(var(--mg-space-3) * -1);
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    text-decoration-color: currentcolor;
  }

  .mg-svc-card__side > :first-child {
    margin-top: var(--mg-space-4);
  }

  @media screen and (min-width: 750px) {
    .mg-svc-details__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mg-svc-card {
      padding: var(--mg-space-6);
    }

    /* Tablet (inline) and the stacked layout: the card spans the column, with the prices on
       the left and the deposit, buttons and contact lines on the right */
    :is(.mg-svc-details__aside--inline, .mg-svc-details--stacked .mg-svc-details__aside) .mg-svc-card {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--mg-space-6);
    }

    :is(.mg-svc-details__aside--inline, .mg-svc-details--stacked .mg-svc-details__aside) .mg-svc-card__side > :first-child {
      margin-top: 0;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-svc-details__aside--side {
      display: block;
    }

    .mg-svc-details__aside--inline {
      display: none;
    }

    .mg-svc-details__aside--inline + .mg-svc-details__block {
      margin-top: 0;
      border-top: 1px solid var(--mg-line);
    }

    .mg-svc-details--sidebar .mg-svc-details__layout {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 360px);
      align-items: start;
      gap: var(--mg-space-8);
    }

    .mg-svc-details--sidebar.mg-svc-details--sticky .mg-svc-details__aside {
      position: sticky;
      top: calc(var(--header-height, 72px) + var(--mg-space-5));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-svc-card__row-chevron {
      transition: none;
    }

    .mg-svc-card__row--link:hover .mg-svc-card__row-chevron {
      transform: none;
    }
  }
{% endstylesheet %}

