      "id": "heading",
      "label": "Heading",
      "default": "From your reg to CarPlay in four steps"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Intro text",
      "default": "No guesswork and no chasing call-backs. Send us a couple of details and we'll tell you exactly what fits your car, what it costs and when we can fit it."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
