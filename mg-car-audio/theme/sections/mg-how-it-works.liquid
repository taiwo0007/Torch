{%- comment -%}
  How it works (docs/DESIGN.md §3 item 9): a compact row of numbered steps with the
  WhatsApp and Book buttons under it. Steps stack on phones, sit two by two on tablets and in one
  row of up to four from 990px (a fifth or sixth step starts a second row).
{%- endcomment -%}

{%- liquid
  assign section_classes = 'mg-section mg-how'
  if section.settings.background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--band'
  endif
  if section.settings.align == 'center'
    assign section_classes = section_classes | append: ' mg-how--center'
  endif

  assign step_count = 0
  for block in section.blocks
    if block.settings.title != blank
      assign step_count = step_count | plus: 1
    endif
  endfor
  assign step_cols = step_count | at_least: 1 | at_most: 4

  assign wa_text = settings.mg_whatsapp_message | url_encode
  assign wa_href = 'https://wa.me/' | append: settings.mg_whatsapp_number | append: '?text=' | append: wa_text
  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_enabled and settings.mg_whatsapp_number != blank and section.settings.whatsapp_label != blank
    assign show_whatsapp = true
  endif

  assign button_link = section.settings.button_link | default: '/pages/book-a-fitting'
  assign heading_id = 'MgHowHeading-' | append: section.id
-%}

<div class="{{ section_classes }}">
  <div class="mg-container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="mg-head{% if section.settings.align == 'center' %} mg-head--center{% endif %}">
        <div class="mg-head__text">
          {%- if section.settings.heading != blank -%}
            <h2
              class="mg-head__title"
              id="{{ heading_id }}"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mg-head__sub">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if step_count > 0 -%}
      <ol
        class="mg-how__steps"
        role="list"
        style="--mg-how-cols: {{ step_cols }};"
        {% if section.settings.heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% endif %}
      >
        {%- assign step_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.title == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign step_number = step_number | plus: 1 -%}
          <li
            class="mg-how__step"
            {{ block.shopify_attributes }}
          >
            <span
              class="mg-how__num"
              aria-hidden="true"
            >
              {{- step_number -}}
            </span>
            <div class="mg-how__body">
              <h3 class="mg-card__title mg-how__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="mg-card__meta mg-how__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- elsif request.design_mode -%}
      <p class="mg-help">Add "Step" blocks to build the steps.</p>
    {%- endif -%}

    {%- if show_whatsapp or section.settings.button_label != blank -%}
      <div class="mg-how__cta">
        <div class="mg-actions">
          {%- if show_whatsapp -%}
            <a
              class="mg-btn mg-btn--whatsapp"
              href="{{ wa_href }}"
              target="_blank"
              rel="noopener"
            >
              {%- render 'mg-icon', icon: 'whatsapp' -%}
              <span>{{ section.settings.whatsapp_label | escape }}</span>
              <span class="mg-visually-hidden">(opens WhatsApp)</span>
            </a>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a
              class="mg-btn mg-btn--primary"
              href="{{ button_link }}"
            >
              {%- render 'mg-icon', icon: 'calendar' -%}
              <span>{{ section.settings.button_label | escape }}</span>
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.show_phone and settings.mg_phone_display != blank -%}
          <p class="mg-how__phone">
            {%- if section.settings.phone_prefix != blank -%}
              {{ section.settings.phone_prefix | escape }}
            {% endif -%}
            <a
              class="mg-link"
              href="tel:+{{ settings.mg_phone_e164 }}"
            >
              {{- settings.mg_phone_display | escape -}}
            </a>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Layout only: colour, type, radius and states come from assets/mg-theme.css */
  .mg-how__steps {
    display: grid;
    gap: var(--mg-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones and tablets: number on the left, text beside it */
  .mg-how__step {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-content: start;
    align-items: start;
    gap: var(--mg-space-4);
    margin: 0;
  }

  .mg-how__num {
    box-sizing: border-box;
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--mg-radius-pill);
    background-color: var(--mg-red-tint);
    color: var(--mg-red-ink);
    font-size: var(--mg-fs-small);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .mg-how__body {
    display: grid;
    gap: var(--mg-space-1);
    min-width: 0;
    padding-block-start: 3px;
  }

  .mg-how__text {
    max-width: 42ch;
    text-wrap: pretty;
  }

  .mg-how__text strong {
    color: var(--mg-ink);
  }

  .mg-how__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mg-space-3) var(--mg-space-5);
    margin-block-start: var(--mg-space-6);
  }

  .mg-how__cta .mg-actions {
    flex: 1 1 100%;
  }

  .mg-how__phone {
    margin: 0;
    font-size: var(--mg-fs-small);
    color: var(--mg-ink-2);
  }

  .mg-how__phone .mg-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
  }

  .mg-how--center .mg-how__cta,
  .mg-how--center .mg-actions {
    justify-content: center;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .mg-how__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--mg-space-6) var(--mg-space-5);
    }

    .mg-how__cta .mg-actions {
      flex: 0 1 auto;
    }
  }

  /* Desktop: one row, the number above each step with a hairline running to the next one */
  @media screen and (min-width: 990px) {
    .mg-how__steps {
      grid-template-columns: repeat(var(--mg-how-cols, 4), minmax(0, 1fr));
      gap: var(--mg-space-6);
    }

    .mg-how__step {
      position: relative;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--mg-space-4);
    }

    .mg-how__step:not(:last-child, :nth-child(4n))::after {
      content: '';
      position: absolute;
      top: 16px;
      left: calc(32px + var(--mg-space-3));
      right: calc(var(--mg-space-3) - var(--mg-space-6));
      height: 1px;
      background-color: var(--mg-line-strong);
    }

    .mg-how__body {
      padding-block-start: 0;
    }

    .mg-how--center .mg-how__step {
      justify-items: center;
      text-align: center;
    }

    .mg-how--center .mg-how__step:not(:last-child, :nth-child(4n))::after {
      left: calc(50% + 16px + var(--mg-space-3));
      right: calc(-50% + 16px + var(--mg-space-3) - var(--mg-space-6));
    }

    .mg-how--center .mg-how__text {
      margin-inline: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG how it works",
  "tag": "section",
  "class": "mg-how-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Line under the heading",
      "default": "From your reg to driving away, with a fixed price agreed first."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "surface",
          "label": "Grey band"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp button",
      "info": "Uses the WhatsApp number and message from Theme settings > MG Car Audio: business details, and follows Show WhatsApp buttons there.",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "WhatsApp us"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Main button label",
      "info": "Leave blank to hide the button.",
      "default": "Book a fitting"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Main button link",
      "info": "Leave blank to link to /pages/book-a-fitting."
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone number",
      "default": true
    },
    {
      "type": "text",
      "id": "phone_prefix",
      "label": "Text before phone number",
      "default": "Prefer to talk? Call"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "info": "One short sentence.",
          "default": "Describe this step in one short sentence."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MG how it works",
      "category": "MG Car Audio",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Send your reg",
            "text": "WhatsApp us your reg and a photo of your dash, or use the quote form."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Get a fixed price",
            "text": "We confirm what fits your car and the fitted price before you commit."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Book your slot",
            "text": "Pick a day that suits you. A <strong>€50 deposit</strong> secures it."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Drive away",
            "text": "We fit it, test it with your phone and show you how it works."
          }
        }
      ]
    }
  ]
}
{% endschema %}
