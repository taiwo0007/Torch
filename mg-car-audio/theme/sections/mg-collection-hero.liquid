{%- liquid
  assign business_name = settings.mg_business_name | default: shop.name
  assign heading_id = 'MgCollectionHeroTitle-' | append: section.id
  assign desc_id = 'MgCollectionHeroDesc-' | append: section.id

  # Image: collection image, then the section's fallback image, then a theme asset.
  assign hero_image = collection.image
  if hero_image == blank
    assign hero_image = section.settings.fallback_image
  endif

  if hero_image == blank
    assign asset_name = section.settings.fallback_asset
    if section.settings.auto_image
      case collection.handle
        when 'carplay-android-auto'
          assign asset_name = 'mg-img-sys-carplay'
        when 'android-radios'
          assign asset_name = 'mg-img-sys-android-radio'
        when 'screen-upgrades'
          assign asset_name = 'mg-img-sys-screens'
        when 'speakers'
          assign asset_name = 'mg-img-sys-speakers'
        when 'subwoofers', 'amplifiers'
          assign asset_name = 'mg-img-sys-subs-amps'
        when 'dashcams'
          assign asset_name = 'mg-img-sys-dashcam'
        when 'reverse-cameras'
          assign asset_name = 'mg-img-sys-reverse-camera'
        when 'japanese-import-conversion', 'conversions'
          assign asset_name = 'mg-img-sys-conversion'
      endcase
    endif
  endif

  assign image_sizes = '(min-width: 1200px) 650px, (min-width: 990px) 58vw, 100vw'

  assign description = collection.description | strip
  if description == blank and section.settings.fallback_text != blank
    assign description = section.settings.fallback_text | escape | newline_to_br | prepend: '<p>' | append: '</p>'
  endif

  # Long descriptions are clamped server-side (over ~3 lines even at full width), so the
  # "Read more" button is in the first paint and nothing below it shifts.
  assign desc_chars = description | strip_html | strip | size
  assign desc_clamped = false
  if desc_chars > 200
    assign desc_clamped = true
  endif

  assign product_count = collection.all_products_count | default: collection.products_count | default: 0

  assign chip_lines = section.settings.chips | newline_to_br | split: '<br />'

  assign wa_number = settings.mg_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign show_help = false
  if section.settings.show_help and wa_number != blank and section.settings.help_link_label != blank
    assign show_help = true
    assign wa_message = 'Hi ' | append: business_name | append: ", I'm looking at " | append: collection.title | append: '. What fits my car? My reg is: '
    assign wa_text = wa_message | url_encode
  endif

  assign show_collections_crumb = false
  if section.settings.breadcrumb_label != blank and collection.handle != 'all'
    assign show_collections_crumb = true
  endif

  # "From €X fitted": the collection metafield custom.from_price (text, e.g. €299), else the lowest
  # custom.fitted_price among the first 50 products. Hidden when neither exists.
  assign from_price = ''
  if section.settings.show_from_price
    assign from_price = collection.metafields.custom.from_price.value | strip
    if from_price == blank
      assign min_cents = 0
      for item in collection.products limit: 50
        assign fp = item.metafields.custom.fitted_price.value | remove: '€' | remove: ',' | strip
        if fp == blank
          continue
        endif
        assign fp_cents = fp | times: 100 | round
        if fp_cents > 0
          if min_cents == 0 or fp_cents < min_cents
            assign min_cents = fp_cents
          endif
        endif
      endfor
      if min_cents > 0
        assign from_price = min_cents | money_without_trailing_zeros
      endif
    endif
  endif

  # Shop by car: storefront filter on custom.car_make when it is enabled (Search & Discovery),
  # else the product tag make:<Make> (single make) or a product search (a group of makes).
  assign make_filter = nil
  for filter in collection.filters
    if filter.param_name == 'filter.p.m.custom.car_make'
      assign make_filter = filter
      break
    endif
  endfor
  assign base_url = collection.url | default: routes.all_products_collection_url

  # No products at all (not a filtered empty result): show the MG empty state instead of Horizon's
  assign store_empty = false
  if collection.all_products_count == 0 or collection.all_products_count == nil
    assign active_filter_count = 0
    for filter in collection.filters
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endfor
    if active_filter_count == 0 and collection.products_count == 0
      assign store_empty = true
    endif
  endif

  assign panel_classes = 'mg-panel mg-surface-night mg-red-line mg-ch__panel'
  if section.settings.show_image
    assign panel_classes = panel_classes | append: ' mg-ch__panel--media'
  endif
-%}

<div class="mg-section mg-ch">
  <div class="mg-container">
    {%- if section.settings.show_breadcrumbs -%}
      <nav
        class="mg-ch__crumbs"
        aria-label="Breadcrumb"
      >
        <ol role="list">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          {%- if show_collections_crumb -%}
            <li>
              <a href="{{ routes.collections_url }}">{{ section.settings.breadcrumb_label | escape }}</a>
            </li>
          {%- endif -%}
          <li>
            <span aria-current="page">{{ collection.title | escape }}</span>
          </li>
        </ol>
      </nav>
    {%- endif -%}

    <div class="{{ panel_classes }}">
      <div class="mg-ch__copy">
        <h1
          id="{{ heading_id }}"
          class="mg-h1-banner mg-ch__title mg-load-rise"
        >
          {{ collection.title | escape }}
        </h1>

        {%- if from_price != blank or section.settings.show_count and product_count > 0 -%}
          <p class="mg-ch__meta">
            {%- if from_price != blank -%}
              <span class="mg-price mg-ch__from">
                <span class="mg-price__label">{{ section.settings.from_label | default: 'From' | escape }}</span>
                {{ from_price }}
                <span class="mg-price__label">{{ section.settings.fitted_label | default: 'fitted' | escape }}</span>
              </span>
            {%- endif -%}
            {%- if section.settings.show_count and product_count > 0 -%}
              <span class="mg-ch__count">
                {{- product_count }}
                {% if product_count == 1 %}product{% else %}products{% endif -%}
              </span>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if description != blank -%}
          <mg-read-more
            class="mg-ch__desc-wrap{% if desc_clamped %} is-clamped{% endif %}"
            data-more="{{ section.settings.read_more_label | default: 'Read more' | escape }}"
            data-less="{{ section.settings.read_less_label | default: 'Show less' | escape }}"
          >
            <div
              id="{{ desc_id }}"
              class="mg-lede mg-ch__desc"
              data-mg-readmore-content
            >
              {{ description }}
            </div>
            {%- if desc_clamped -%}
              <button
                type="button"
                class="mg-ch__more"
                aria-controls="{{ desc_id }}"
                aria-expanded="false"
                data-mg-readmore-toggle
              >
                <span data-mg-readmore-label>{{ section.settings.read_more_label | default: 'Read more' | escape }}</span>
                {%- render 'mg-icon', icon: 'chevron-down' -%}
              </button>
            {%- endif -%}
          </mg-read-more>
        {%- endif -%}

        {%- if section.settings.chips != blank -%}
          {%- comment -%} Static facts, not filters: a plain inline list with ticks, no chip outline {%- endcomment -%}
          <ul
            class="mg-ch__points"
            role="list"
          >
            {%- for chip in chip_lines -%}
              {%- assign chip_text = chip | strip -%}
              {%- if chip_text != blank -%}
                <li class="mg-ch__point">
                  {%- render 'mg-icon', icon: 'check' -%}
                  <span>{{ chip_text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if show_help -%}
          <p class="mg-ch__help">
            {%- if section.settings.help_text != blank -%}
              {{ section.settings.help_text | escape }}
            {% endif -%}
            <a
              class="mg-link mg-ch__help-link"
              href="https://wa.me/{{ wa_number }}?text={{ wa_text }}"
              target="_blank"
              rel="noopener"
            >
              {%- render 'mg-icon', icon: 'whatsapp' -%}
              <span>{{ section.settings.help_link_label | escape }}</span>
              <span class="mg-visually-hidden"> (opens WhatsApp in a new tab)</span>
            </a>
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_image -%}
        <div
          class="mg-ch__media"
          aria-hidden="true"
        >
          {%- if hero_image != blank -%}
            {%- assign focal_style = 'object-position: ' | append: hero_image.presentation.focal_point -%}
            {{-
              hero_image
              | image_url: width: 1200
              | image_tag:
                widths: '400, 600, 800, 1000, 1200',
                sizes: image_sizes,
                loading: 'eager',
                fetchpriority: 'high',
                alt: '',
                style: focal_style,
                class: 'mg-ch__img'
            -}}
          {%- else -%}
            {%- render 'mg-asset-image',
              asset: asset_name,
              sizes: image_sizes,
              loading: 'eager',
              priority: 'high',
              alt: '',
              class: 'mg-ch__img'
            -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 and store_empty == false -%}
      {%- capture make_chips -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign chip_label = block.settings.label | strip
            assign chip_values = block.settings.makes | default: block.settings.label | split: ','
            if chip_label == blank
              continue
            endif

            assign chip_url = ''
            assign chip_active = false

            if make_filter
              assign query = ''
              assign found = 0
              assign active_found = 0
              for raw_value in chip_values
                assign wanted = raw_value | strip | downcase
                for filter_value in make_filter.values
                  assign have = filter_value.value | downcase
                  if have == wanted
                    assign found = found | plus: 1
                    if filter_value.active
                      assign active_found = active_found | plus: 1
                    endif
                    assign encoded_value = filter_value.value | url_encode
                    assign query = query | append: '&' | append: make_filter.param_name | append: '=' | append: encoded_value
                  endif
                endfor
              endfor
              if found == 0
                continue
              endif
              if active_found == found
                assign chip_active = true
                assign chip_url = make_filter.url_to_remove
              else
                assign chip_url = base_url | append: '?' | append: query | replace_first: '?&', '?'
              endif
            else
              if chip_values.size > 1
                assign search_terms = chip_values | join: ' OR '
                assign encoded_terms = search_terms | url_encode
                assign chip_url = routes.search_url | append: '?type=product&q=' | append: encoded_terms
              else
                assign tag_handle = 'make-' | append: chip_values.first | strip | handleize
                assign chip_url = base_url | append: '/' | append: tag_handle
                for current_tag in current_tags
                  assign current_handle = current_tag | handleize
                  if current_handle == tag_handle
                    assign chip_active = true
                    assign chip_url = base_url
                  endif
                endfor
              endif
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            <a
              class="mg-chip mg-ch__make"
              href="{{ chip_url | escape }}"
              {% if chip_active %}
                aria-current="true"
              {% endif %}
            >
              {{- chip_label | escape -}}
              {%- if chip_active -%}
                {%- render 'mg-icon', icon: 'x' -%}
                <span class="mg-visually-hidden"> (remove filter)</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if make_chips != blank -%}
        <nav
          class="mg-ch__cars"
          aria-labelledby="MgShopByCar-{{ section.id }}"
        >
          <p
            id="MgShopByCar-{{ section.id }}"
            class="mg-ch__cars-label"
          >
            {{ section.settings.cars_label | default: 'Shop by car' | escape }}
          </p>
          <ul
            class="mg-chips mg-ch__chips"
            role="list"
          >
            {{ make_chips }}
          </ul>
        </nav>
      {%- endif -%}
    {%- endif -%}

    {%- if store_empty -%}
      <div class="mg-card mg-ch-empty">
        <span
          class="mg-ch-empty__icon"
          aria-hidden="true"
        >
          {%- render 'mg-icon', icon: 'wrench' -%}
        </span>
        <div class="mg-ch-empty__copy">
          <h2 class="mg-ch-empty__title">{{ section.settings.empty_heading | escape }}</h2>
          {%- if section.settings.empty_text != blank -%}
            <p class="mg-ch-empty__text">{{ section.settings.empty_text | escape }}</p>
          {%- endif -%}
        </div>
        <div class="mg-actions mg-ch-empty__actions">
          {%- if section.settings.empty_primary_label != blank -%}
            <a
              class="mg-btn mg-btn--primary"
              href="{{ section.settings.empty_primary_url | default: '/pages/get-a-quote' }}"
            >
              {{- section.settings.empty_primary_label | escape -}}
            </a>
          {%- endif -%}
          {%- if wa_number != blank and settings.mg_whatsapp_enabled -%}
            {%- assign empty_wa = 'Hi ' | append: business_name | append: ", I'm looking for " | append: collection.title | append: '. My reg is: ' | url_encode -%}
            <a
              class="mg-btn mg-btn--whatsapp"
              href="https://wa.me/{{ wa_number }}?text={{ empty_wa }}"
              target="_blank"
              rel="noopener"
            >
              {%- render 'mg-icon', icon: 'whatsapp' -%}
              <span>WhatsApp us</span>
              <span class="mg-visually-hidden"> (opens WhatsApp in a new tab)</span>
            </a>
          {%- endif -%}
          {%- if section.settings.empty_link_label != blank -%}
            <a
              class="mg-link mg-ch-empty__link"
              href="{{ section.settings.empty_link_url | default: '/pages/services' }}"
            >
              {{- section.settings.empty_link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.show_breadcrumbs -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | append: routes.root_url | json }}
        },
        {%- if show_collections_crumb %}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ section.settings.breadcrumb_label | json }},
            "item": {{ request.origin | append: routes.collections_url | json }}
          },
        {%- endif %}
        {
          "@type": "ListItem",
          "position": {% if show_collections_crumb %}3{% else %}2{% endif %},
          "name": {{ collection.title | json }},
          "item": {{ request.origin | append: collection.url | json }}
        }
      ]
    }
  </script>
{%- endif -%}

{% javascript %}
  if (!customElements.get('mg-read-more')) {
    class MgReadMore extends HTMLElement {
      connectedCallback() {
        this.content = this.querySelector('[data-mg-readmore-content]');
        this.button = this.querySelector('[data-mg-readmore-toggle]');
        this.label = this.querySelector('[data-mg-readmore-label]');
        if (!this.content || !this.button || this.dataset.ready) return;
        this.dataset.ready = 'true';
        /* The clamp and the button are rendered by Liquid (long descriptions only), so this only toggles */

        this.button.addEventListener('click', () => {
          const expanded = this.button.getAttribute('aria-expanded') === 'true';
          this.button.setAttribute('aria-expanded', String(!expanded));
          this.classList.toggle('is-clamped', expanded);
          if (this.label) {
            this.label.textContent = expanded ? this.dataset.more : this.dataset.less;
          }
        });
      }
    }

    customElements.define('mg-read-more', MgReadMore);
  }
{% endjavascript %}

{% stylesheet %}
  /*
   * Collection header: the inner-page header pattern (breadcrumb, grey panel, serif h1),
   * compact so the products start high. Phones: text only. From 750px: a rounded photo on
   * the right. Layout only; colour, type and components come from mg-theme.css.
   */
  .mg-ch__crumbs {
    margin-block: calc(var(--mg-space-3) * -1) var(--mg-space-1);
  }

  .mg-ch__crumbs ol {
    display: flex;
    align-items: center;
    gap: var(--mg-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--mg-fs-micro);
    line-height: 1.4;
    color: var(--mg-ink-2);
  }

  .mg-ch__crumbs li {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--mg-space-2);
    min-width: 0;
    white-space: nowrap;
  }

  .mg-ch__crumbs li:last-child {
    flex: 0 1 auto;
    overflow: hidden;
  }

  .mg-ch__crumbs li + li::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    margin-inline-end: 2px;
    border-top: 1.5px solid var(--mg-ink-3);
    border-right: 1.5px solid var(--mg-ink-3);
    transform: rotate(45deg);
  }

  .mg-ch__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    color: var(--mg-ink-2);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
  }

  .mg-ch__crumbs a:hover {
    color: var(--mg-ink);
    text-decoration-color: currentcolor;
  }

  .mg-ch__crumbs [aria-current] {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--mg-ink);
    font-weight: 500;
  }

  .mg-ch__panel {
    display: grid;
    gap: var(--mg-space-5);
  }

  .mg-ch__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .mg-ch__title {
    max-width: 22ch;
  }

  .mg-ch__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--mg-space-1) var(--mg-space-4);
    margin: var(--mg-space-2) 0 0;
  }

  .mg-ch__from {
    font-size: 1.125rem;
  }

  .mg-ch__from .mg-price__label {
    font-size: var(--mg-fs-small);
  }

  .mg-ch__count {
    font-size: var(--mg-fs-small);
    color: var(--mg-ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* Shop by car: label then a chip row (scrolls on phones, wraps from 750px) */
  .mg-ch__cars {
    display: grid;
    gap: var(--mg-space-2);
    margin-block-start: var(--mg-space-4);
  }

  .mg-ch__cars-label {
    margin: 0;
    font-size: var(--mg-fs-small);
    font-weight: 600;
    color: var(--mg-ink);
  }

  .mg-ch__chips {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-ch__chips > li {
    margin: 0;
  }

  .mg-ch__make .mg-icon {
    width: 16px;
    height: 16px;
  }

  @media screen and (min-width: 750px) {
    .mg-ch__cars {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: var(--mg-space-4);
    }

    .mg-ch__chips.mg-chips {
      flex-wrap: wrap;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* Empty collection */
  .mg-ch-empty {
    display: grid;
    justify-items: start;
    gap: var(--mg-space-4);
    margin-block-start: var(--mg-space-5);
    padding: var(--mg-space-5);
  }

  .mg-ch-empty__icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--mg-radius-sm);
    background-color: var(--mg-band-2);
    color: var(--mg-ink);
  }

  .mg-ch-empty__icon .mg-icon {
    width: 24px;
    height: 24px;
  }

  .mg-ch-empty .mg-ch-empty__title {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.25;
    color: var(--mg-ink);
  }

  .mg-ch-empty .mg-ch-empty__text {
    max-width: 56ch;
    margin: var(--mg-space-2) 0 0;
    color: var(--mg-ink-2);
  }

  .mg-ch-empty__actions {
    align-items: center;
  }

  .mg-ch-empty__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    padding-inline: var(--mg-space-2);
  }

  @media screen and (min-width: 750px) {
    .mg-ch-empty {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: var(--mg-space-4) var(--mg-space-5);
      padding: var(--mg-space-6);
    }

    .mg-ch-empty__actions {
      grid-column: 2;
    }
  }

  /* Description with optional clamp */
  .mg-ch__desc-wrap {
    display: block;
    align-self: stretch;
  }

  .mg-ch__desc > * {
    margin: 0 0 0.75em;
  }

  .mg-ch__desc > :last-child {
    margin-bottom: 0;
  }

  .mg-ch__desc a {
    color: var(--mg-ink);
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: currentcolor;
    text-underline-offset: 0.22em;
  }

  .mg-ch__desc :is(h2, h3, h4) {
    font-family: var(--mg-font-ui);
    font-size: 1rem;
    font-weight: 600;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-ch__desc-wrap.is-clamped .mg-ch__desc {
    max-height: calc(3 * var(--mg-lh-body) * 1em);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, var(--mg-mask) 55%, transparent);
    mask-image: linear-gradient(180deg, var(--mg-mask) 55%, transparent);
  }

  .mg-ch__more {
    display: inline-flex;
    align-items: center;
    gap: var(--mg-space-1);
    min-height: var(--mg-tap);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--mg-radius-xs);
    background: none;
    color: var(--mg-ink);
    font: inherit;
    font-size: var(--mg-fs-small);
    font-weight: 500;
    cursor: pointer;
  }

  .mg-ch__more span {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .mg-ch__more:hover span {
    text-decoration-thickness: 2px;
  }

  .mg-ch__more:focus-visible {
    outline: 2px solid var(--mg-focus);
    outline-offset: 2px;
  }

  .mg-ch__more .mg-icon {
    width: 16px;
    height: 16px;
    transition: transform var(--mg-dur) var(--mg-ease);
  }

  .mg-ch__more[aria-expanded='true'] .mg-icon {
    transform: rotate(180deg);
  }

  .mg-ch__points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mg-space-2) var(--mg-space-5);
    margin: var(--mg-space-4) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--mg-fs-small);
    font-weight: 500;
    line-height: 1.35;
    color: var(--mg-ink);
  }

  .mg-ch__point {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .mg-ch__point .mg-icon {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--mg-ink-2);
  }

  .mg-ch__help {
    margin: var(--mg-space-3) 0 0;
    font-size: var(--mg-fs-small);
    color: var(--mg-ink-2);
  }

  .mg-ch__help-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--mg-tap);
    vertical-align: middle;
  }

  /* A flex link does not pass its underline to the text: draw it on the label */
  .mg-ch__help-link > span {
    text-decoration: inherit;
    text-decoration-color: currentcolor;
  }

  .mg-ch__help-link .mg-icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--mg-whatsapp);
  }

  /*
   * The photo sits behind the copy on the night panel. Phones: a faint full-panel backdrop under
   * a heavy shade, so the panel stays short and the products start in the first screen. From
   * 990px: it fills the right side and fades left under the copy.
   */
  .mg-ch__panel {
    isolation: isolate;
    overflow: hidden;
  }

  .mg-ch__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    min-width: 0;
  }

  .mg-ch__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: var(--mg-band-2);
  }

  .mg-ch__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(var(--mg-night-rgb) / 0.96) 0%, rgb(var(--mg-night-rgb) / 0.84) 55%, rgb(var(--mg-night-rgb) / 0.6) 100%);
  }

  @media screen and (min-width: 750px) {
    .mg-ch__panel--media {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: center;
      min-height: 240px;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-ch__panel--media {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      min-height: 280px;
    }

    .mg-ch__media {
      inset: 0 0 0 auto;
      width: 60%;
    }

    .mg-ch__media::after {
      background:
        linear-gradient(to right, var(--mg-night) 0%, rgb(var(--mg-night-rgb) / 0.76) 24%, rgb(var(--mg-night-rgb) / 0.12) 66%, rgb(var(--mg-night-rgb) / 0) 100%),
        linear-gradient(to top, rgb(var(--mg-night-rgb) / 0.5), rgb(var(--mg-night-rgb) / 0) 45%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-ch__more .mg-icon {
      transition: none;
    }
  }
{% endstylesheet %}

