{%- liquid
  assign business_name = settings.mg_business_name | default: shop.name
  assign row = section.settings.row | default: 'columns'

  # Contact row: the home and contact pages already end with the map, address, hours and the
  # Call / WhatsApp buttons (mg-contact-map), so there the row slims down to the name and tagline.
  assign is_compact = false
  if row == 'contact' and section.settings.compact_on_contact_pages
    if template.name == 'index'
      assign is_compact = true
    elsif template.name == 'page' and template.suffix == 'contact'
      assign is_compact = true
    endif
  endif

  assign section_classes = 'mg-footer-contact mg-footer-contact--' | append: row
  if is_compact
    assign section_classes = section_classes | append: ' mg-footer-contact--compact'
  endif

  assign heading_id = 'MgFooterContactHeading-' | append: section.id

  assign phone_e164 = settings.mg_phone_e164 | remove: '+' | remove: ' ' | remove: '-'

  assign wa_number = settings.mg_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_enabled and wa_number != blank
    assign show_whatsapp = true
  endif
  assign wa_fallback = 'Hi ' | append: business_name | append: ','
  assign wa_message = settings.mg_whatsapp_message | strip | default: wa_fallback
  assign wa_text = wa_message | url_encode

  assign map_query = settings.mg_map_query
  if map_query == blank
    assign map_query = business_name | append: ', ' | append: settings.mg_street | append: ', ' | append: settings.mg_postcode
  endif
  assign map_query_encoded = map_query | url_encode

  assign street_lines = settings.mg_street | split: ', '

  assign has_hours = false
  if settings.mg_hours_weekdays != blank or settings.mg_hours_saturday != blank or settings.mg_hours_sunday != blank
    assign has_hours = true
  endif

  assign quote_url = section.settings.quote_url | default: '/pages/get-a-quote'
-%}

{%- if row == 'bottom' -%}
  {%- comment -%} Bottom row: copyright, policy links and the Auto / Light / Dark theme control {%- endcomment -%}
  <div class="{{ section_classes }}">
    <div class="mg-container">
      <div class="mg-footer-contact__bottom">
        <p class="mg-footer-contact__copyright">
          &copy; {{ 'now' | date: '%Y' }}
          <a href="{{ routes.root_url }}">{{ business_name | escape }}</a>
        </p>

        {%- liquid
          assign bottom_menu = section.settings.bottom_menu
          assign has_bottom_links = false
          if bottom_menu != blank and bottom_menu.links.size > 0
            assign has_bottom_links = true
          elsif shop.policies.size > 0
            assign has_bottom_links = true
          endif
        -%}
        {%- if has_bottom_links -%}
          <nav
            class="mg-footer-contact__legal"
            aria-label="{{ section.settings.bottom_links_label | default: 'Policies' | escape }}"
          >
            <ul
              class="mg-footer-contact__legal-list"
              role="list"
            >
              {%- if bottom_menu != blank and bottom_menu.links.size > 0 -%}
                {%- for link in bottom_menu.links -%}
                  <li>
                    <a
                      href="{{ link.url }}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for policy in shop.policies -%}
                  {%- if policy != blank -%}
                    <li>
                      <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="mg-footer-contact__payments">
            <span class="mg-visually-hidden">Payment methods</span>
            <ul
              class="mg-footer-contact__payment-list"
              role="list"
            >
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'mg-footer-contact__payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.show_theme_control -%}
          {%- assign theme_control_id = 'mg-footer-theme-' | append: section.id -%}
          {%- render 'mg-theme-mode',
            control: true,
            id: theme_control_id,
            label: section.settings.theme_label,
            class: 'mg-footer-contact__theme'
          -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- elsif row == 'columns' -%}
  {%- comment -%}
    Four columns: three link lists (Systems, Shop by car, Help) and Visit us (address, hours,
    directions, Call and WhatsApp). Phones: each column is an accordion row; Visit us starts open.
    A link column reads the children of one main-menu item (for example the "Shop" item) so the
    footer follows the header menu; with no menu match it shows the fallback links.
  {%- endcomment -%}
  {%- liquid
    assign review_rating = settings.mg_review_rating
    assign review_count = settings.mg_review_count
    assign socials = 'instagram,facebook,tiktok' | split: ','
    assign has_socials = false
    for social in socials
      assign social_key = 'social_' | append: social
      if section.settings[social_key] != blank
        assign has_socials = true
      endif
    endfor
  -%}
  <div class="{{ section_classes }}">
    <div class="mg-container">
      <div class="mg-footer-cols__brand">
        <div class="mg-footer-cols__brand-copy">
          <p class="mg-footer-cols__logo">
            <a href="{{ routes.root_url }}" aria-label="{{ business_name | escape }}">
              <img
                src="{{ 'mg-logo-512.webp' | asset_url }}"
                alt=""
                width="72"
                height="72"
                loading="lazy"
                class="mg-footer-cols__badge"
              >
            </a>
          </p>
          {%- if section.settings.show_tagline and settings.mg_tagline != blank -%}
            <p class="mg-footer-cols__tagline">{{ settings.mg_tagline | escape }}</p>
          {%- endif -%}
          {%- if review_rating != blank -%}
            {%- capture rating_badge -%}
              {%- render 'mg-icon', icon: 'star', class: 'mg-footer-cols__star' -%}
              <strong>{{ review_rating | escape }}</strong>
              {%- if review_count != blank %}
                <span>from {{ review_count | escape }} Google reviews</span>
              {%- endif -%}
            {%- endcapture -%}
            {%- if settings.mg_review_url != blank -%}
              <a
                class="mg-footer-cols__rating"
                href="{{ settings.mg_review_url }}"
                target="_blank"
                rel="noopener"
              >
                {{- rating_badge -}}
                <span class="mg-visually-hidden"> (opens in a new tab)</span>
              </a>
            {%- else -%}
              <p class="mg-footer-cols__rating">{{ rating_badge }}</p>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if section.settings.show_newsletter -%}
          <div class="mg-footer-cols__news">
            {%- assign news_id = 'MgFooterNews-' | append: section.id -%}
            {%- form 'customer', id: news_id, class: 'mg-footer-cols__news-form' -%}
              <input
                type="hidden"
                name="contact[tags]"
                value="newsletter"
              >
              <label
                class="mg-footer-cols__news-label"
                for="{{ news_id }}-email"
              >
                {{- section.settings.newsletter_heading | default: 'Offers and open fitting slots' | escape -}}
              </label>
              {%- if form.posted_successfully? -%}
                <p
                  class="mg-footer-cols__news-note"
                  role="status"
                >
                  Thanks, you're on the list.
                </p>
              {%- else -%}
                <div class="mg-footer-cols__news-row">
                  <input
                    class="mg-input mg-footer-cols__news-input"
                    id="{{ news_id }}-email"
                    type="email"
                    name="contact[email]"
                    autocomplete="email"
                    autocapitalize="off"
                    spellcheck="false"
                    placeholder="Email address"
                    required
                    {% if form.errors %}
                      aria-invalid="true"
                      aria-describedby="{{ news_id }}-error"
                    {% endif %}
                  >
                  <button
                    class="mg-btn mg-btn--secondary mg-footer-cols__news-btn"
                    type="submit"
                  >
                    Sign up
                  </button>
                </div>
                {%- if form.errors -%}
                  <p
                    class="mg-footer-cols__news-note mg-footer-cols__news-note--error"
                    id="{{ news_id }}-error"
                  >
                    Please check the email address.
                  </p>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      <div class="mg-footer-cols__grid">
        {%- for i in (1..3) -%}
          {%- liquid
            assign heading_key = 'col' | append: i | append: '_heading'
            assign menu_key = 'col' | append: i | append: '_menu'
            assign parent_key = 'col' | append: i | append: '_parent'
            assign fallback_key = 'col' | append: i | append: '_fallback'

            assign col_heading = section.settings[heading_key]
            assign col_menu = section.settings[menu_key]
            assign col_parent = section.settings[parent_key] | handleize
            assign col_links = nil
            assign col_parent_url = nil

            if col_menu != blank
              if col_parent != blank
                for menu_link in col_menu.links
                  if menu_link.handle == col_parent and menu_link.links.size > 0
                    assign col_links = menu_link.links
                    assign col_parent_url = menu_link.url
                    break
                  endif
                endfor
              elsif col_menu.links.size > 0
                assign col_links = col_menu.links
              endif
            endif

            assign fallback_lines = section.settings[fallback_key] | newline_to_br | split: '<br />'
          -%}
          {%- if col_heading == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- capture col_children -%}
            <details
              class="mg-footer-cols__col"
              open
            >
              <summary class="mg-footer-cols__summary">
                <span class="mg-footer-cols__heading">{{ col_heading | escape }}</span>
                {%- render 'mg-icon', icon: 'chevron-down', class: 'mg-footer-cols__chevron' -%}
              </summary>
              <div class="details-content mg-footer-cols__panel">
                <ul
                  class="mg-footer-cols__links"
                  role="list"
                >
                  {%- if col_links != nil -%}
                    {%- for link in col_links -%}
                      {%- comment -%} The header's promo and see-all links stay out of the footer lists {%- endcomment -%}
                      {%- if col_parent_url != nil and link.url == col_parent_url -%}
                        {%- continue -%}
                      {%- endif -%}
                      {%- if col_parent_url != nil and link.url contains 'book-a-fitting' -%}
                        {%- continue -%}
                      {%- endif -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for line in fallback_lines -%}
                      {%- assign parts = line | strip | split: '|' -%}
                      {%- assign link_title = parts[0] | strip -%}
                      {%- assign link_url = parts[1] | strip -%}
                      {%- if link_title != blank and link_url != blank -%}
                        <li>
                          <a
                            href="{{ link_url | escape }}"
                            {% if request.path == link_url %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- link_title | escape -}}
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </div>
            </details>
          {%- endcapture -%}
          {%- render 'accordion-custom-component',
            children: col_children,
            class: 'mg-footer-cols__accordion',
            open_by_default_on_desktop: true,
            disable_on_desktop: true
          -%}
        {%- endfor -%}

        {%- capture visit_children -%}
          <details
            class="mg-footer-cols__col mg-footer-cols__col--visit"
            open
          >
            <summary class="mg-footer-cols__summary">
              <span class="mg-footer-cols__heading">
                {{- section.settings.address_heading | default: 'Visit us' | escape -}}
              </span>
              {%- render 'mg-icon', icon: 'chevron-down', class: 'mg-footer-cols__chevron' -%}
            </summary>
            <div class="details-content mg-footer-cols__panel">
              <address class="mg-footer-cols__address">
                <strong>{{ business_name | escape }}</strong><br>
                {%- for line in street_lines -%}
                  {{ line | strip | escape }}<br>
                {%- endfor -%}
                {%- if settings.mg_locality != blank -%}
                  {{ settings.mg_locality | escape }}
                  {%- if settings.mg_postcode != blank %} {{ settings.mg_postcode | escape }}{% endif -%}
                {%- elsif settings.mg_postcode != blank -%}
                  {{ settings.mg_postcode | escape }}
                {%- endif -%}
              </address>

              {%- if section.settings.show_hours and has_hours -%}
                <dl class="mg-footer-cols__hours">
                  <div>
                    <dt>Mon to Fri</dt>
                    <dd>{{ settings.mg_hours_weekdays | default: 'Closed' | escape }}</dd>
                  </div>
                  <div>
                    <dt>Saturday</dt>
                    <dd>{{ settings.mg_hours_saturday | default: 'Closed' | escape }}</dd>
                  </div>
                  <div>
                    <dt>Sunday</dt>
                    <dd>{{ settings.mg_hours_sunday | default: 'Closed' | escape }}</dd>
                  </div>
                </dl>
              {%- endif -%}

              <ul
                class="mg-footer-cols__links mg-footer-cols__links--visit"
                role="list"
              >
                {%- if section.settings.directions_label != blank -%}
                  <li>
                    <a
                      href="https://www.google.com/maps/dir/?api=1&amp;destination={{ map_query_encoded }}"
                      target="_blank"
                      rel="noopener"
                    >
                      {%- render 'mg-icon', icon: 'map-pin' -%}
                      {{- section.settings.directions_label | escape -}}
                      <span class="mg-visually-hidden"> (opens Google Maps in a new tab)</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.mg_email != blank -%}
                  <li>
                    <a href="mailto:{{ settings.mg_email | escape }}">
                      {%- render 'mg-icon', icon: 'mail' -%}
                      {{- settings.mg_email | escape -}}
                    </a>
                  </li>
                {%- endif -%}
              </ul>

              <div class="mg-footer-cols__actions">
                {%- if phone_e164 != blank -%}
                  <a
                    class="mg-btn mg-btn--primary mg-btn--sm"
                    href="tel:+{{ phone_e164 }}"
                  >
                    {%- render 'mg-icon', icon: 'phone' -%}
                    <span>
                      {{- section.settings.call_label | default: 'Call' | escape -}}
                      {%- if settings.mg_phone_display != blank %} {{ settings.mg_phone_display | escape }}{% endif -%}
                    </span>
                  </a>
                {%- endif -%}
                {%- if show_whatsapp -%}
                  <a
                    class="mg-btn mg-btn--whatsapp mg-btn--sm"
                    href="https://wa.me/{{ wa_number }}?text={{ wa_text }}"
                    target="_blank"
                    rel="noopener"
                  >
                    {%- render 'mg-icon', icon: 'whatsapp' -%}
                    <span>{{ section.settings.whatsapp_label | default: 'WhatsApp us' | escape }}</span>
                    <span class="mg-visually-hidden">(opens in a new tab)</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </details>
        {%- endcapture -%}
        {%- render 'accordion-custom-component',
          children: visit_children,
          class: 'mg-footer-cols__accordion mg-footer-cols__accordion--visit',
          open_by_default_on_desktop: true,
          open_by_default_on_mobile: section.settings.visit_open_on_mobile,
          disable_on_desktop: true
        -%}
      </div>

      {%- if has_socials -%}
        <ul
          class="mg-footer-cols__socials"
          role="list"
        >
          {%- for social in socials -%}
            {%- assign social_key = 'social_' | append: social -%}
            {%- if section.settings[social_key] != blank -%}
              <li>
                <a
                  class="mg-footer-cols__social"
                  href="{{ section.settings[social_key] }}"
                  target="_blank"
                  rel="noopener"
                >
                  {%- render 'mg-icon', icon: social -%}
                  <span class="mg-visually-hidden">{{ business_name | escape }} on {{ social | capitalize }} (opens in a new tab)</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  <div
    class="{{ section_classes }}"
    role="region"
    aria-labelledby="{{ heading_id }}"
  >
    <div class="mg-container">
      <div class="mg-footer-contact__inner">
        <div class="mg-footer-contact__intro">
          <h2
            id="{{ heading_id }}"
            class="mg-footer-contact__brand"
          >
            {{ business_name | escape }}
          </h2>

          {%- if section.settings.show_tagline and settings.mg_tagline != blank -%}
            <p class="mg-footer-contact__tagline">{{ settings.mg_tagline | escape }}</p>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <p class="mg-footer-contact__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>

        <div class="mg-footer-contact__cta">
          {%- unless is_compact -%}
          <div class="mg-actions mg-footer-contact__actions">
            {%- if phone_e164 != blank -%}
              <a
                class="mg-btn mg-btn--primary"
                href="tel:+{{ phone_e164 }}"
              >
                {%- render 'mg-icon', icon: 'phone' -%}
                <span>
                  {{- section.settings.call_label | default: 'Call' | escape -}}
                  {%- if settings.mg_phone_display != blank %} {{ settings.mg_phone_display | escape }}{% endif -%}
                </span>
              </a>
            {%- endif -%}

            {%- if show_whatsapp -%}
              <a
                class="mg-btn mg-btn--whatsapp"
                href="https://wa.me/{{ wa_number }}?text={{ wa_text }}"
                target="_blank"
                rel="noopener"
              >
                {%- render 'mg-icon', icon: 'whatsapp' -%}
                <span>{{ section.settings.whatsapp_label | default: 'WhatsApp us' | escape }}</span>
                <span class="mg-visually-hidden">(opens in a new tab)</span>
              </a>
            {%- endif -%}
          </div>
          {%- endunless -%}

          {%- if section.settings.quote_label != blank -%}
            <p class="mg-footer-contact__quote">
              <a
                class="mg-link"
                href="{{ quote_url }}"
              >
                {{- section.settings.quote_label | escape -}}
              </a>
            </p>
          {%- endif -%}
        </div>

        {%- unless is_compact -%}
          <div class="mg-footer-contact__details">
            <div class="mg-footer-contact__block">
              <h3 class="mg-footer-contact__label">
                {{- section.settings.address_heading | default: 'Visit us' | escape -}}
              </h3>
              <address class="mg-footer-contact__address">
                {%- for line in street_lines -%}
                  {{ line | strip | escape }}<br>
                {%- endfor -%}
                {%- if settings.mg_locality != blank -%}
                  {{ settings.mg_locality | escape }}
                  {%- if settings.mg_postcode != blank %} {{ settings.mg_postcode | escape }}{% endif -%}
                {%- elsif settings.mg_postcode != blank -%}
                  {{ settings.mg_postcode | escape }}
                {%- endif -%}
              </address>
              <ul
                class="mg-footer-contact__links"
                role="list"
              >
                {%- if section.settings.directions_label != blank -%}
                  <li>
                    <a
                      class="mg-link"
                      href="https://www.google.com/maps/dir/?api=1&amp;destination={{ map_query_encoded }}"
                      target="_blank"
                      rel="noopener"
                    >
                      {{- section.settings.directions_label | escape -}}
                      <span class="mg-visually-hidden"> (opens Google Maps in a new tab)</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.mg_email != blank -%}
                  <li>
                    <a
                      class="mg-link"
                      href="mailto:{{ settings.mg_email | escape }}"
                    >
                      {{- settings.mg_email | escape -}}
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </div>

            {%- if section.settings.show_hours and has_hours -%}
              <div class="mg-footer-contact__block">
                <h3 class="mg-footer-contact__label">
                  {{- section.settings.hours_heading | default: 'Opening hours' | escape -}}
                </h3>
                <dl class="mg-footer-contact__hours">
                  <div class="mg-footer-contact__hours-row">
                    <dt>Mon to Fri</dt>
                    <dd>{{ settings.mg_hours_weekdays | default: 'Closed' | escape }}</dd>
                  </div>
                  <div class="mg-footer-contact__hours-row">
                    <dt>Saturday</dt>
                    <dd>{{ settings.mg_hours_saturday | default: 'Closed' | escape }}</dd>
                  </div>
                  <div class="mg-footer-contact__hours-row">
                    <dt>Sunday</dt>
                    <dd>{{ settings.mg_hours_sunday | default: 'Closed' | escape }}</dd>
                  </div>
                </dl>
              </div>
            {%- endif -%}
          </div>
        {%- endunless -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Footer rows sit on the grey footer band painted by assets/mg-horizon.css (footer element).
     Layout only here; colours, type and buttons come from the shared MG classes and tokens. */
  .mg-footer-contact {
    color: var(--mg-ink);
  }

  /* ---------- Contact row ---------- */
  .mg-footer-contact--contact {
    padding-block-start: var(--mg-space-7);
  }

  .mg-footer-contact__inner {
    display: grid;
    gap: var(--mg-space-5);
    padding-block-end: var(--mg-space-6);
    border-bottom: 1px solid var(--mg-line);
  }

  .mg-footer-contact__brand {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-footer-contact__tagline {
    margin: var(--mg-space-1) 0 0;
    font-size: var(--mg-fs-body);
    line-height: 1.45;
    color: var(--mg-ink-2);
  }

  .mg-footer-contact__text {
    max-width: 46ch;
    margin: var(--mg-space-3) 0 0;
    font-size: var(--mg-fs-small);
    line-height: var(--mg-lh-body);
    color: var(--mg-ink-2);
    text-wrap: pretty;
  }

  .mg-footer-contact__quote {
    margin: var(--mg-space-4) 0 0;
    font-size: var(--mg-fs-small);
  }

  /* Home and contact pages: one stacked column (name, tagline, text, quote link) */
  .mg-footer-contact--compact .mg-footer-contact__inner {
    gap: 0;
  }

  .mg-footer-contact--compact .mg-footer-contact__quote {
    margin-block-start: var(--mg-space-3);
  }

  .mg-footer-contact__details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--mg-space-6) var(--mg-space-5);
    align-content: start;
  }

  .mg-footer-contact__block {
    min-width: 0;
  }

  .mg-footer-contact__label {
    margin: 0 0 var(--mg-space-3);
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-body);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-footer-contact__address {
    font-style: normal;
    font-size: var(--mg-fs-small);
    line-height: 1.6;
    color: var(--mg-ink-2);
  }

  .mg-footer-contact__links {
    display: grid;
    gap: var(--mg-space-1);
    margin: var(--mg-space-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--mg-fs-small);
  }

  .mg-footer-contact__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    overflow-wrap: anywhere;
  }

  .mg-footer-contact__hours {
    display: grid;
    gap: var(--mg-space-2);
    margin: 0;
    font-size: var(--mg-fs-small);
  }

  .mg-footer-contact__hours-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--mg-space-4);
  }

  .mg-footer-contact__hours dt {
    color: var(--mg-ink-2);
  }

  .mg-footer-contact__hours dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--mg-ink);
  }

  @media screen and (min-width: 750px) {
    .mg-footer-contact--contact {
      padding-block-start: var(--mg-space-8);
    }

    .mg-footer-contact__inner {
      padding-block-end: var(--mg-space-7);
    }

  }

  /* Desktop: name, text and buttons left; address and hours right */
  @media screen and (min-width: 990px) {
    .mg-footer-contact--contact:not(.mg-footer-contact--compact) .mg-footer-contact__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--mg-space-8);
      row-gap: var(--mg-space-5);
    }

    .mg-footer-contact--contact:not(.mg-footer-contact--compact) .mg-footer-contact__details {
      grid-column: 2;
      grid-row: 1 / span 2;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Compact row: name and tagline left, the line of text and the quote link right, on the
       same columns as the full row, so the row doesn't leave most of the band empty */
    .mg-footer-contact--compact .mg-footer-contact__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--mg-space-8);
      align-items: start;
    }

    .mg-footer-contact--compact .mg-footer-contact__intro {
      display: contents;
    }

    .mg-footer-contact--compact .mg-footer-contact__brand {
      grid-area: 1 / 1;
    }

    .mg-footer-contact--compact .mg-footer-contact__tagline {
      grid-area: 2 / 1;
    }

    .mg-footer-contact--compact .mg-footer-contact__text {
      grid-area: 1 / 2;
      margin-block-start: 0;
    }

    .mg-footer-contact--compact .mg-footer-contact__cta {
      grid-area: 2 / 2;
    }

    .mg-footer-contact--compact .mg-footer-contact__quote {
      margin-block-start: var(--mg-space-1);
    }
  }

  /* ---------- Bottom row ---------- */
  .mg-footer-contact--bottom {
    padding-block: var(--mg-space-5) var(--mg-space-6);
  }

  .mg-footer-contact__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mg-space-1) var(--mg-space-5);
    padding-block-start: var(--mg-space-5);
    border-top: 1px solid var(--mg-line);
    font-size: var(--mg-fs-micro);
    line-height: 1.45;
    color: var(--mg-ink-2);
  }

  @media screen and (max-width: 749px) {
    .mg-footer-contact__payments,
    .mg-footer-contact__theme {
      flex-basis: 100%;
      margin-block-start: var(--mg-space-3);
    }
  }

  .mg-footer-contact__copyright {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .mg-footer-contact__copyright a,
  .mg-footer-contact__legal-list a {
    color: inherit;
    text-decoration: none;
  }

  .mg-footer-contact__legal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--mg-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-footer-contact__legal-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
  }

  @media (hover: hover) {
    .mg-footer-contact__copyright a:hover,
    .mg-footer-contact__legal-list a:hover {
      color: var(--mg-ink);
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
  }

  .mg-footer-contact__legal-list a[aria-current='page'] {
    color: var(--mg-ink);
  }

  @media screen and (min-width: 750px) {
    /* Room below the row for the floating WhatsApp button at the end of the page */
    .mg-footer-contact--bottom {
      padding-block-end: calc(var(--mg-space-5) + 64px);
    }

    .mg-footer-contact__bottom {
      gap: var(--mg-space-2) var(--mg-space-6);
    }

    .mg-footer-contact__theme {
      margin-inline-start: auto;
    }
  }

  /* ---------- Columns row: brand strip, four columns (accordions on phones), socials ---------- */
  .mg-footer-contact--columns {
    padding-block: var(--mg-space-7) var(--mg-space-2);
  }

  .mg-footer-cols__brand {
    display: grid;
    gap: var(--mg-space-5);
    padding-block-end: var(--mg-space-6);
    border-bottom: 1px solid var(--mg-line);
  }

  .mg-footer-cols__logo {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .mg-footer-cols__logo a {
    display: inline-flex;
    align-items: center;
    gap: var(--mg-space-2);
    color: var(--mg-ink);
    text-decoration: none;
  }

  .mg-footer-cols__badge {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--mg-line);
  }

  .mg-footer-cols__tagline {
    max-width: 44ch;
    margin: var(--mg-space-2) 0 0;
    font-size: var(--mg-fs-small);
    line-height: var(--mg-lh-body);
    color: var(--mg-ink-2);
  }

  .mg-footer-cols__rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--mg-tap);
    margin: var(--mg-space-2) 0 0;
    font-size: var(--mg-fs-small);
    color: var(--mg-ink-2);
    text-decoration: none;
  }

  .mg-footer-cols__rating strong {
    font-weight: 600;
    color: var(--mg-ink);
    font-variant-numeric: tabular-nums;
  }

  a.mg-footer-cols__rating:hover span {
    color: var(--mg-ink);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .mg-footer-cols__star {
    width: 16px;
    height: 16px;
    color: var(--mg-red);
  }

  .mg-footer-cols__news-label {
    display: block;
    margin-block-end: var(--mg-space-2);
    font-size: var(--mg-fs-body);
    font-weight: 600;
    color: var(--mg-ink);
  }

  .mg-footer-cols__news-row {
    display: flex;
    gap: var(--mg-space-2);
  }

  .mg-footer-cols__news-input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
  }

  .mg-footer-cols__news-btn {
    flex: none;
  }

  .mg-footer-cols__news-note {
    margin: var(--mg-space-2) 0 0;
    font-size: var(--mg-fs-small);
    color: var(--mg-ink-2);
  }

  .mg-footer-cols__news-note--error {
    color: var(--mg-red-ink);
  }

  .mg-footer-cols__grid {
    display: grid;
  }

  /* Phones: accordion rows with hairlines (the bottom row draws the last one) */
  .mg-footer-cols__accordion {
    border-bottom: 1px solid var(--mg-line);
  }

  .mg-footer-cols__accordion:last-child {
    border-bottom: 0;
  }

  /* The bottom row follows straight on */
  .mg-footer-contact--columns + .mg-footer-contact--bottom,
  .mg-footer-contact-section:has(.mg-footer-contact--columns) + .mg-footer-contact-section .mg-footer-contact--bottom {
    padding-block-start: 0;
  }

  .mg-footer-cols__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--mg-space-3);
    min-height: 56px;
    cursor: pointer;
    list-style: none;
  }

  .mg-footer-cols__summary::-webkit-details-marker {
    display: none;
  }

  .mg-footer-cols__summary:focus-visible {
    outline: 2px solid var(--mg-focus);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .mg-footer-cols__heading {
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-body);
    font-weight: 600;
    line-height: 1.3;
    color: var(--mg-ink);
  }

  .mg-footer-cols__chevron {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--mg-ink-2);
    transition: transform var(--mg-dur) var(--mg-ease);
  }

  .mg-footer-cols__col[open] .mg-footer-cols__chevron {
    transform: rotate(180deg);
  }

  .mg-footer-cols__panel {
    padding-block-end: var(--mg-space-4);
  }

  .mg-footer-cols__links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--mg-fs-small);
  }

  .mg-footer-cols__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--mg-space-2);
    min-height: var(--mg-tap);
    color: var(--mg-ink-2);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--mg-dur) var(--mg-ease);
  }

  .mg-footer-cols__links a .mg-icon {
    flex: none;
    width: 18px;
    height: 18px;
  }

  .mg-footer-cols__links a[aria-current='page'] {
    color: var(--mg-ink);
  }

  @media (hover: hover) {
    .mg-footer-cols__links a:hover {
      color: var(--mg-ink);
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
  }

  .mg-footer-cols__address {
    font-style: normal;
    font-size: var(--mg-fs-small);
    line-height: 1.6;
    color: var(--mg-ink-2);
  }

  .mg-footer-cols__address strong {
    font-weight: 500;
    color: var(--mg-ink);
  }

  .mg-footer-cols__hours {
    display: grid;
    gap: var(--mg-space-1);
    margin: var(--mg-space-4) 0 var(--mg-space-1);
    font-size: var(--mg-fs-small);
  }

  .mg-footer-cols__hours > div {
    display: flex;
    justify-content: space-between;
    gap: var(--mg-space-4);
  }

  .mg-footer-cols__hours dt {
    color: var(--mg-ink-2);
  }

  .mg-footer-cols__hours dd {
    margin: 0;
    font-weight: 500;
    color: var(--mg-ink);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .mg-footer-cols__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mg-space-2);
    margin-block-start: var(--mg-space-3);
  }

  .mg-footer-cols__socials {
    display: flex;
    gap: var(--mg-space-2);
    margin: var(--mg-space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .mg-footer-cols__social {
    display: grid;
    place-items: center;
    width: var(--mg-tap);
    height: var(--mg-tap);
    border: 1px solid var(--mg-line);
    border-radius: var(--mg-radius-pill);
    color: var(--mg-ink);
    transition: border-color var(--mg-dur) var(--mg-ease);
  }

  .mg-footer-cols__social:hover {
    border-color: var(--mg-line-strong);
  }

  .mg-footer-cols__social .mg-icon {
    width: 20px;
    height: 20px;
  }

  /* Tablets and up: brand strip in a row, four columns always open */
  @media screen and (min-width: 750px) {
    .mg-footer-contact--columns {
      padding-block-start: var(--mg-space-8);
    }

    .mg-footer-cols__brand {
      grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
      align-items: end;
      gap: var(--mg-space-7);
      padding-block-end: var(--mg-space-7);
    }

    .mg-footer-cols__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--mg-space-6) var(--mg-space-6);
      padding-block-start: var(--mg-space-7);
    }

    .mg-footer-cols__accordion {
      border-bottom: 0;
    }

    .mg-footer-cols__summary {
      min-height: 0;
      margin-block-end: var(--mg-space-3);
      cursor: default;
    }

    .mg-footer-cols__chevron {
      display: none;
    }

    .mg-footer-cols__panel {
      padding-block-end: 0;
    }

    .mg-footer-cols__links a {
      min-height: 34px;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-footer-cols__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 0.9fr) minmax(0, 1.3fr);
      gap: var(--mg-space-7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-footer-cols__chevron,
    .mg-footer-cols__links a {
      transition: none;
    }
  }

  /* ---------- Bottom row: payment icons ---------- */
  .mg-footer-contact__payment-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-footer-contact__payment-list li {
    display: flex;
  }

  .mg-footer-contact__payment-icon {
    width: 38px;
    height: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG footer",
  "tag": "div",
  "class": "mg-footer-contact-section",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Name, tagline, phone, WhatsApp, address, hours and rating come from Theme settings > MG Car Audio: business details. Use one Columns row and one Bottom row."
    },
    {
      "type": "select",
      "id": "row",
      "label": "Row",
      "options": [
        {
          "value": "columns",
          "label": "Columns: links, visit us and newsletter"
        },
        {
          "value": "contact",
          "label": "Contact: name, buttons, address and hours"
        },
        {
          "value": "bottom",
          "label": "Bottom: copyright, policies and theme control"
        }
      ],
      "default": "columns"
    },
    {
      "type": "header",
      "content": "Column 1",
      "visible_if": "{{ section.settings.row == 'columns' }}"
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "Heading",
      "info": "Leave blank to hide the column.",
