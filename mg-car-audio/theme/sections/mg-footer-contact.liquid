{%- liquid
  assign business_name = settings.mg_business_name | default: shop.name
  assign row = section.settings.row | default: 'contact'

  # Contact row: the home and contact pages already end with the map, address, hours and the
  # Call / WhatsApp buttons (mg-contact-map), so there the row slims down to the name and tagline.
  assign is_compact = false
  if row == 'contact' and section.settings.compact_on_contact_pages
    if template.name == 'index'
      assign is_compact = true
    elsif template.name == 'page' and template.suffix == 'contact'
      assign is_compact = true
    endif
  endif

  assign section_classes = 'mg-footer-contact mg-footer-contact--' | append: row
  if is_compact
    assign section_classes = section_classes | append: ' mg-footer-contact--compact'
  endif

  assign heading_id = 'MgFooterContactHeading-' | append: section.id

  assign phone_e164 = settings.mg_phone_e164 | remove: '+' | remove: ' ' | remove: '-'

  assign wa_number = settings.mg_whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_enabled and wa_number != blank
    assign show_whatsapp = true
  endif
  assign wa_fallback = 'Hi ' | append: business_name | append: ','
  assign wa_message = settings.mg_whatsapp_message | strip | default: wa_fallback
  assign wa_text = wa_message | url_encode

  assign map_query = settings.mg_map_query
  if map_query == blank
    assign map_query = business_name | append: ', ' | append: settings.mg_street | append: ', ' | append: settings.mg_postcode
  endif
  assign map_query_encoded = map_query | url_encode

  assign street_lines = settings.mg_street | split: ', '

  assign has_hours = false
  if settings.mg_hours_weekdays != blank or settings.mg_hours_saturday != blank or settings.mg_hours_sunday != blank
    assign has_hours = true
  endif

  assign quote_url = section.settings.quote_url | default: '/pages/get-a-quote'
-%}

{%- if row == 'bottom' -%}
  {%- comment -%} Bottom row: copyright, policy links and the Auto / Light / Dark theme control {%- endcomment -%}
  <div class="{{ section_classes }}">
    <div class="mg-container">
      <div class="mg-footer-contact__bottom">
        <p class="mg-footer-contact__copyright">
          &copy; {{ 'now' | date: '%Y' }}
          <a href="{{ routes.root_url }}">{{ business_name | escape }}</a>
        </p>

        {%- liquid
          assign bottom_menu = section.settings.bottom_menu
          assign has_bottom_links = false
          if bottom_menu != blank and bottom_menu.links.size > 0
            assign has_bottom_links = true
          elsif shop.policies.size > 0
            assign has_bottom_links = true
          endif
        -%}
        {%- if has_bottom_links -%}
          <nav
            class="mg-footer-contact__legal"
            aria-label="{{ section.settings.bottom_links_label | default: 'Policies' | escape }}"
          >
            <ul
              class="mg-footer-contact__legal-list"
              role="list"
            >
              {%- if bottom_menu != blank and bottom_menu.links.size > 0 -%}
                {%- for link in bottom_menu.links -%}
                  <li>
                    <a
                      href="{{ link.url }}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for policy in shop.policies -%}
                  {%- if policy != blank -%}
                    <li>
                      <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if section.settings.show_theme_control -%}
          {%- assign theme_control_id = 'mg-footer-theme-' | append: section.id -%}
          {%- render 'mg-theme-mode',
            control: true,
            id: theme_control_id,
            label: section.settings.theme_label,
            class: 'mg-footer-contact__theme'
          -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- else -%}
  <div
    class="{{ section_classes }}"
    role="region"
    aria-labelledby="{{ heading_id }}"
  >
    <div class="mg-container">
      <div class="mg-footer-contact__inner">
        <div class="mg-footer-contact__intro">
          <h2
            id="{{ heading_id }}"
            class="mg-footer-contact__brand"
          >
            {{ business_name | escape }}
          </h2>

          {%- if section.settings.show_tagline and settings.mg_tagline != blank -%}
            <p class="mg-footer-contact__tagline">{{ settings.mg_tagline | escape }}</p>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <p class="mg-footer-contact__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>

        <div class="mg-footer-contact__cta">
          {%- unless is_compact -%}
          <div class="mg-actions mg-footer-contact__actions">
            {%- if phone_e164 != blank -%}
              <a
                class="mg-btn mg-btn--primary"
                href="tel:+{{ phone_e164 }}"
              >
                {%- render 'mg-icon', icon: 'phone' -%}
                <span>
                  {{- section.settings.call_label | default: 'Call' | escape -}}
                  {%- if settings.mg_phone_display != blank %} {{ settings.mg_phone_display | escape }}{% endif -%}
                </span>
              </a>
            {%- endif -%}

            {%- if show_whatsapp -%}
              <a
                class="mg-btn mg-btn--whatsapp"
                href="https://wa.me/{{ wa_number }}?text={{ wa_text }}"
                target="_blank"
                rel="noopener"
              >
                {%- render 'mg-icon', icon: 'whatsapp' -%}
                <span>{{ section.settings.whatsapp_label | default: 'WhatsApp us' | escape }}</span>
                <span class="mg-visually-hidden">(opens in a new tab)</span>
              </a>
            {%- endif -%}
          </div>
          {%- endunless -%}

          {%- if section.settings.quote_label != blank -%}
            <p class="mg-footer-contact__quote">
              <a
                class="mg-link"
                href="{{ quote_url }}"
              >
                {{- section.settings.quote_label | escape -}}
              </a>
            </p>
          {%- endif -%}
        </div>

        {%- unless is_compact -%}
          <div class="mg-footer-contact__details">
            <div class="mg-footer-contact__block">
              <h3 class="mg-footer-contact__label">
                {{- section.settings.address_heading | default: 'Visit us' | escape -}}
              </h3>
              <address class="mg-footer-contact__address">
                {%- for line in street_lines -%}
                  {{ line | strip | escape }}<br>
                {%- endfor -%}
                {%- if settings.mg_locality != blank -%}
                  {{ settings.mg_locality | escape }}
                  {%- if settings.mg_postcode != blank %} {{ settings.mg_postcode | escape }}{% endif -%}
                {%- elsif settings.mg_postcode != blank -%}
                  {{ settings.mg_postcode | escape }}
                {%- endif -%}
              </address>
              <ul
                class="mg-footer-contact__links"
                role="list"
              >
                {%- if section.settings.directions_label != blank -%}
                  <li>
                    <a
                      class="mg-link"
                      href="https://www.google.com/maps/dir/?api=1&amp;destination={{ map_query_encoded }}"
                      target="_blank"
                      rel="noopener"
                    >
                      {{- section.settings.directions_label | escape -}}
                      <span class="mg-visually-hidden"> (opens Google Maps in a new tab)</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.mg_email != blank -%}
                  <li>
                    <a
                      class="mg-link"
                      href="mailto:{{ settings.mg_email | escape }}"
                    >
                      {{- settings.mg_email | escape -}}
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </div>

            {%- if section.settings.show_hours and has_hours -%}
              <div class="mg-footer-contact__block">
                <h3 class="mg-footer-contact__label">
                  {{- section.settings.hours_heading | default: 'Opening hours' | escape -}}
                </h3>
                <dl class="mg-footer-contact__hours">
                  <div class="mg-footer-contact__hours-row">
                    <dt>Mon to Fri</dt>
                    <dd>{{ settings.mg_hours_weekdays | default: 'Closed' | escape }}</dd>
                  </div>
                  <div class="mg-footer-contact__hours-row">
                    <dt>Saturday</dt>
                    <dd>{{ settings.mg_hours_saturday | default: 'Closed' | escape }}</dd>
                  </div>
                  <div class="mg-footer-contact__hours-row">
                    <dt>Sunday</dt>
                    <dd>{{ settings.mg_hours_sunday | default: 'Closed' | escape }}</dd>
                  </div>
                </dl>
              </div>
            {%- endif -%}
          </div>
        {%- endunless -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Footer rows sit on the grey footer band painted by assets/mg-horizon.css (footer element).
     Layout only here; colours, type and buttons come from the shared MG classes and tokens. */
  .mg-footer-contact {
    color: var(--mg-ink);
  }

  /* ---------- Contact row ---------- */
  .mg-footer-contact--contact {
    padding-block-start: var(--mg-space-7);
  }

  .mg-footer-contact__inner {
    display: grid;
    gap: var(--mg-space-5);
    padding-block-end: var(--mg-space-6);
    border-bottom: 1px solid var(--mg-line);
  }

  .mg-footer-contact__brand {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-h3);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-footer-contact__tagline {
    margin: var(--mg-space-1) 0 0;
    font-size: var(--mg-fs-body);
    line-height: 1.45;
    color: var(--mg-ink-2);
  }

  .mg-footer-contact__text {
    max-width: 46ch;
    margin: var(--mg-space-3) 0 0;
    font-size: var(--mg-fs-small);
    line-height: var(--mg-lh-body);
    color: var(--mg-ink-2);
    text-wrap: pretty;
  }

  .mg-footer-contact__quote {
    margin: var(--mg-space-4) 0 0;
    font-size: var(--mg-fs-small);
  }

  /* Home and contact pages: one stacked column (name, tagline, text, quote link) */
  .mg-footer-contact--compact .mg-footer-contact__inner {
    gap: 0;
  }

  .mg-footer-contact--compact .mg-footer-contact__quote {
    margin-block-start: var(--mg-space-3);
  }

  .mg-footer-contact__details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--mg-space-6) var(--mg-space-5);
    align-content: start;
  }

  .mg-footer-contact__block {
    min-width: 0;
  }

  .mg-footer-contact__label {
    margin: 0 0 var(--mg-space-3);
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-body);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-footer-contact__address {
    font-style: normal;
    font-size: var(--mg-fs-small);
    line-height: 1.6;
    color: var(--mg-ink-2);
  }

  .mg-footer-contact__links {
    display: grid;
    gap: var(--mg-space-1);
    margin: var(--mg-space-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--mg-fs-small);
  }

  .mg-footer-contact__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    overflow-wrap: anywhere;
  }

  .mg-footer-contact__hours {
    display: grid;
    gap: var(--mg-space-2);
    margin: 0;
    font-size: var(--mg-fs-small);
  }

  .mg-footer-contact__hours-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--mg-space-4);
  }

  .mg-footer-contact__hours dt {
    color: var(--mg-ink-2);
  }

  .mg-footer-contact__hours dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--mg-ink);
  }

  @media screen and (min-width: 750px) {
    .mg-footer-contact--contact {
      padding-block-start: var(--mg-space-8);
    }

    .mg-footer-contact__inner {
      padding-block-end: var(--mg-space-7);
    }

  }

  /* Desktop: name, text and buttons left; address and hours right */
  @media screen and (min-width: 990px) {
    .mg-footer-contact--contact:not(.mg-footer-contact--compact) .mg-footer-contact__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--mg-space-8);
      row-gap: var(--mg-space-5);
    }

    .mg-footer-contact--contact:not(.mg-footer-contact--compact) .mg-footer-contact__details {
      grid-column: 2;
      grid-row: 1 / span 2;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Compact row: name and tagline left, the line of text and the quote link right, on the
       same columns as the full row, so the row doesn't leave most of the band empty */
    .mg-footer-contact--compact .mg-footer-contact__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--mg-space-8);
      align-items: start;
    }

    .mg-footer-contact--compact .mg-footer-contact__intro {
      display: contents;
    }

    .mg-footer-contact--compact .mg-footer-contact__brand {
      grid-area: 1 / 1;
    }

    .mg-footer-contact--compact .mg-footer-contact__tagline {
      grid-area: 2 / 1;
    }

    .mg-footer-contact--compact .mg-footer-contact__text {
      grid-area: 1 / 2;
      margin-block-start: 0;
    }

    .mg-footer-contact--compact .mg-footer-contact__cta {
      grid-area: 2 / 2;
    }

    .mg-footer-contact--compact .mg-footer-contact__quote {
      margin-block-start: var(--mg-space-1);
    }
  }

  /* ---------- Bottom row ---------- */
  .mg-footer-contact--bottom {
    padding-block: var(--mg-space-5) var(--mg-space-6);
  }

  .mg-footer-contact__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--mg-space-4);
    padding-block-start: var(--mg-space-5);
    border-top: 1px solid var(--mg-line);
    font-size: var(--mg-fs-micro);
    line-height: 1.45;
    color: var(--mg-ink-2);
  }

  .mg-footer-contact__copyright {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .mg-footer-contact__copyright a,
  .mg-footer-contact__legal-list a {
    color: inherit;
    text-decoration: none;
  }

  .mg-footer-contact__legal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--mg-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-footer-contact__legal-list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
  }

  @media (hover: hover) {
    .mg-footer-contact__copyright a:hover,
    .mg-footer-contact__legal-list a:hover {
      color: var(--mg-ink);
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
  }

  .mg-footer-contact__legal-list a[aria-current='page'] {
    color: var(--mg-ink);
  }

  @media screen and (min-width: 750px) {
    /* Room below the row for the floating WhatsApp button at the end of the page */
    .mg-footer-contact--bottom {
      padding-block-end: calc(var(--mg-space-5) + 76px);
    }

    .mg-footer-contact__bottom {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--mg-space-2) var(--mg-space-6);
    }

    .mg-footer-contact__theme {
      margin-inline-start: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG footer: contact",
  "tag": "div",
  "class": "mg-footer-contact-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Name, tagline, phone, WhatsApp, address and hours come from Theme settings > MG Car Audio: business details. Add this section twice to the footer: once as the contact row at the top and once as the bottom row."
    },
    {
      "type": "select",
      "id": "row",
      "label": "Row",
      "options": [
        {
          "value": "contact",
          "label": "Contact: name, buttons, address and hours"
        },
        {
          "value": "bottom",
          "label": "Bottom: copyright, policies and theme control"
        }
      ],
      "default": "contact"
    },
    {
      "type": "checkbox",
      "id": "show_tagline",
      "label": "Show tagline",
      "default": true,
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Send us your reg and we'll tell you what fits, with a fixed fitted price.",
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "text",
      "id": "call_label",
      "label": "Call button label",
      "info": "The phone number is added after this text.",
      "default": "Call",
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp",
      "info": "Also needs Show WhatsApp buttons turned on in the business details.",
      "default": true,
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "WhatsApp us",
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Quote link label",
      "info": "A text link under the buttons. Leave blank to hide.",
      "default": "Get a quote",
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "url",
      "id": "quote_url",
      "label": "Quote link",
      "info": "Leave blank to link to /pages/get-a-quote.",
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "text",
      "id": "address_heading",
      "label": "Address heading",
      "default": "Visit us",
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions link label",
      "info": "Opens Google Maps using the map search in the business details. Leave blank to hide.",
      "default": "Get directions",
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show opening hours",
      "default": true,
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "text",
      "id": "hours_heading",
      "label": "Hours heading",
      "default": "Opening hours",
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "checkbox",
      "id": "compact_on_contact_pages",
      "label": "Slim row on the home and contact pages",
      "info": "Those pages already end with the map, address, hours and call buttons, so the row shows only the name, tagline and quote link there.",
      "default": true,
      "visible_if": "{{ section.settings.row == 'contact' }}"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom row links",
      "info": "Leave blank to list the store policies (privacy, refunds, terms and so on).",
      "visible_if": "{{ section.settings.row == 'bottom' }}"
    },
    {
      "type": "text",
      "id": "bottom_links_label",
      "label": "Links label for screen readers",
      "default": "Policies",
      "visible_if": "{{ section.settings.row == 'bottom' }}"
    },
    {
      "type": "checkbox",
      "id": "show_theme_control",
      "label": "Show the Auto / Light / Dark control",
      "info": "Also needs Show theme control turned on in Theme settings > MG Car Audio: business details.",
      "default": true,
      "visible_if": "{{ section.settings.row == 'bottom' }}"
    },
    {
      "type": "text",
      "id": "theme_label",
      "label": "Theme control label",
      "default": "Theme",
      "visible_if": "{{ section.settings.row == 'bottom' }}"
    }
  ],
  "presets": [
    {
      "name": "MG footer: contact row",
      "category": "Footer"
    },
    {
      "name": "MG footer: bottom row",
      "category": "Footer",
      "settings": {
        "row": "bottom"
      }
    }
  ]
}
{% endschema %}
