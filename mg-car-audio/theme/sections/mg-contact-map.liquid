{%- liquid
  assign heading = section.settings.heading | strip
  assign heading_id = 'MgContactHeading-' | append: section.id
  assign on_band = false
  if section.settings.background == 'surface'
    assign on_band = true
  endif

  assign section_classes = 'mg-section mg-contact'
  if on_band
    assign section_classes = section_classes | append: ' mg-section--band'
  endif
  if section.settings.dark_map
    assign section_classes = section_classes | append: ' mg-contact--dim-map'
  endif

  assign panel_classes = 'mg-panel mg-panel--flush mg-contact__panel'
  if on_band
    assign panel_classes = panel_classes | append: ' mg-panel--card'
  endif

  assign business_name = settings.mg_business_name | default: shop.name
  assign map_query = settings.mg_map_query
  if map_query == blank
    assign map_query = business_name | append: ', ' | append: settings.mg_street | append: ', ' | append: settings.mg_postcode
  endif
  assign map_query_encoded = map_query | url_encode
  assign map_src = 'https://maps.google.com/maps?q=' | append: map_query_encoded | append: '&output=embed'
  assign directions_href = 'https://www.google.com/maps/dir/?api=1&destination=' | append: map_query_encoded
  assign map_title = 'Map showing ' | append: business_name
  if settings.mg_locality != blank
    assign map_title = map_title | append: ', ' | append: settings.mg_locality
  endif

  assign wa_text = settings.mg_whatsapp_message | url_encode
  assign wa_href = 'https://wa.me/' | append: settings.mg_whatsapp_number | append: '?text=' | append: wa_text
  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_number != blank
    assign show_whatsapp = true
  endif

  assign street_lines = settings.mg_street | escape | split: ', '

  assign place_line = settings.mg_locality | strip
  if settings.mg_postcode != blank
    if place_line != blank
      assign place_line = place_line | append: ', '
    endif
    assign place_line = place_line | append: settings.mg_postcode
  endif

  # The Call button carries the number ("Call 087 034 4355"), so the number is only listed as a
  # line of its own when there is no Call button (no international number set).
  assign has_call = false
  if settings.mg_phone_e164 != blank
    assign has_call = true
  endif
  assign show_phone_line = false
  if settings.mg_phone_display != blank and has_call == false
    assign show_phone_line = true
  endif

  assign contact_label = 'Phone'
  if show_phone_line and settings.mg_email != blank
    assign contact_label = 'Phone and email'
  elsif show_phone_line == false
    assign contact_label = 'Email'
  endif
-%}

{%- capture map_iframe -%}
  <iframe
    class="mg-contact__iframe"
    src="{{ map_src | replace: '&', '&amp;' }}"
    title="{{ map_title | escape }}"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
{%- endcapture -%}

<section
  class="{{ section_classes }}"
  {% if heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="mg-container">
    {%- if heading != blank or section.settings.text != blank -%}
      <div
        class="mg-head"
        data-mg-reveal
      >
        <div class="mg-head__text">
          {%- if heading != blank -%}
            <h2
              id="{{ heading_id }}"
              class="mg-head__title"
            >
              {{ heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mg-head__sub">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <mg-contact-map
      class="{{ panel_classes }}"
      data-mg-reveal
    >
      <div class="mg-contact__info">
        <div class="mg-contact__details">
          <div class="mg-contact__group">
            <h3 class="mg-contact__label">
              {%- render 'mg-icon', icon: 'map-pin' -%}
              Address
            </h3>
            <address class="mg-contact__address">
              <strong>{{ business_name | escape }}</strong>
              {%- for line in street_lines -%}
                <br>{{ line }}
              {%- endfor -%}
              {%- if settings.mg_locality != blank or settings.mg_region != blank -%}
                <br>
                {{- settings.mg_locality | escape -}}
                {%- if settings.mg_locality != blank and settings.mg_region != blank %}, {% endif -%}
                {{- settings.mg_region | escape -}}
              {%- endif -%}
              {%- if settings.mg_postcode != blank -%}
                <br>{{ settings.mg_postcode | escape }}
              {%- endif -%}
            </address>
            <a
              class="mg-link mg-contact__directions"
              href="{{ directions_href | replace: '&', '&amp;' }}"
              target="_blank"
              rel="noopener"
            >
              Get directions
              <span class="mg-visually-hidden">(opens Google Maps in a new tab)</span>
            </a>
          </div>

          <div class="mg-contact__group">
            <h3 class="mg-contact__label">
              {%- render 'mg-icon', icon: 'clock' -%}
              Opening hours
            </h3>
            <table class="mg-contact__hours">
              <caption class="mg-visually-hidden">Opening hours</caption>
              <tbody>
                <tr data-days="1,2,3,4,5">
                  <th scope="row">Monday to Friday</th>
                  <td>{{ settings.mg_hours_weekdays | default: 'Closed' | escape }}</td>
                </tr>
                <tr data-days="6">
                  <th scope="row">Saturday</th>
                  <td>{{ settings.mg_hours_saturday | default: 'Closed' | escape }}</td>
                </tr>
                <tr data-days="0">
                  <th scope="row">Sunday</th>
                  <td>{{ settings.mg_hours_sunday | default: 'Closed' | escape }}</td>
                </tr>
              </tbody>
            </table>
          </div>

          {%- if show_phone_line or settings.mg_email != blank -%}
            <div class="mg-contact__group">
              <h3 class="mg-contact__label">
                {%- if show_phone_line -%}
                  {%- render 'mg-icon', icon: 'phone' -%}
                {%- else -%}
                  {%- render 'mg-icon', icon: 'mail' -%}
                {%- endif -%}
                {{ contact_label }}
              </h3>
              <ul
                class="mg-contact__lines"
                role="list"
              >
                {%- if show_phone_line -%}
                  <li>{{ settings.mg_phone_display | escape }}</li>
                {%- endif -%}
                {%- if settings.mg_email != blank -%}
                  <li>
                    <a
                      class="mg-link"
                      href="mailto:{{ settings.mg_email | escape }}"
                      >{{ settings.mg_email | escape }}</a
                    >
                  </li>
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        </div>

        {%- if settings.mg_phone_e164 != blank or show_whatsapp -%}
          <div class="mg-actions mg-contact__actions">
            {%- if settings.mg_phone_e164 != blank -%}
              <a
                class="mg-btn mg-btn--primary"
                href="tel:+{{ settings.mg_phone_e164 }}"
              >
                {%- render 'mg-icon', icon: 'phone' -%}
                <span>Call {{ settings.mg_phone_display | default: settings.mg_phone_e164 | escape }}</span>
              </a>
            {%- endif -%}
            {%- if show_whatsapp -%}
              <a
                class="mg-btn mg-btn--whatsapp"
                href="{{ wa_href }}"
                target="_blank"
                rel="noopener"
              >
                {%- render 'mg-icon', icon: 'whatsapp' -%}
                <span>WhatsApp us</span>
                <span class="mg-visually-hidden">(opens in a new tab)</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div
        class="mg-contact__map"
        data-mg-map
      >
        {%- if section.settings.map_mode == 'embed' -%}
          {{ map_iframe }}
        {%- else -%}
          <div
            class="mg-contact__facade{% if section.settings.facade_photo %} mg-contact__facade--photo{% endif %}"
            data-mg-facade
          >
            {%- if section.settings.facade_photo -%}
              {%- if section.settings.facade_image != blank -%}
                {{
                  section.settings.facade_image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '480, 720, 960, 1200, 1600',
                    sizes: '(min-width: 1184px) 653px, (min-width: 990px) 58vw, 100vw',
                    loading: 'lazy',
                    alt: '',
                    class: 'mg-contact__facade-img'
                }}
              {%- else -%}
                <img
                  class="mg-contact__facade-img"
                  src="{{ 'mg-showroom.webp' | asset_url }}"
                  srcset="{{ 'mg-showroom-800.webp' | asset_url }} 800w, {{ 'mg-showroom.webp' | asset_url }} 1600w"
                  sizes="(min-width: 1184px) 653px, (min-width: 990px) 58vw, 100vw"
                  width="1600"
                  height="1200"
                  alt=""
                  loading="lazy"
                  decoding="async"
                >
              {%- endif -%}
            {%- endif -%}
            <div class="mg-card mg-card--raised mg-contact__facade-card">
              <div class="mg-contact__place">
                <span
                  class="mg-contact__pin"
                  aria-hidden="true"
                >
                  {%- render 'mg-icon', icon: 'map-pin' -%}
                </span>
                <span class="mg-contact__place-text">
                  <span class="mg-contact__place-name">{{ business_name | escape }}</span>
                  {%- if place_line != blank -%}
                    <span class="mg-contact__place-line">{{ place_line | escape }}</span>
                  {%- endif -%}
                </span>
              </div>
              <button
                type="button"
                class="mg-btn mg-btn--secondary mg-btn--sm mg-btn--block"
                data-mg-load-map
              >
                Show map
              </button>
              <p class="mg-help">Loads Google Maps, which may set cookies.</p>
            </div>
          </div>
          <template data-mg-map-template>
            {{- map_iframe -}}
          </template>
        {%- endif -%}
      </div>
    </mg-contact-map>
  </div>
</section>

{% javascript %}
  if (!customElements.get('mg-contact-map')) {
    class MgContactMap extends HTMLElement {
      connectedCallback() {
        this.markToday();

        this.loadButton = this.querySelector('[data-mg-load-map]');
        if (this.loadButton) {
          this.handleLoad = this.loadMap.bind(this);
          this.loadButton.addEventListener('click', this.handleLoad);
        }
      }

      disconnectedCallback() {
        if (this.loadButton && this.handleLoad) {
          this.loadButton.removeEventListener('click', this.handleLoad);
        }
      }

      loadMap() {
        const container = this.querySelector('[data-mg-map]');
        const template = this.querySelector('template[data-mg-map-template]');
        const facade = this.querySelector('[data-mg-facade]');
        if (!container || !template) return;

        container.appendChild(template.content.cloneNode(true));
        if (facade) facade.remove();
        template.remove();

        const frame = container.querySelector('iframe');
        if (frame) frame.focus({ preventScroll: true });
      }

      markToday() {
        let day;
        try {
          const name = new Intl.DateTimeFormat('en-GB', { weekday: 'short', timeZone: 'Europe/Dublin' }).format(
            new Date()
          );
          day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(name);
        } catch (error) {
          day = new Date().getDay();
        }
        if (day < 0) return;

        this.querySelectorAll('tr[data-days]').forEach((row) => {
          const days = (row.getAttribute('data-days') || '').split(',');
          if (!days.includes(String(day)) || row.classList.contains('is-today')) return;
          row.classList.add('is-today');
          const cell = row.querySelector('th');
          if (cell) {
            const badge = document.createElement('span');
            badge.className = 'mg-badge mg-badge--red mg-contact__today';
            badge.textContent = 'Today';
            cell.appendChild(badge);
          }
        });
      }
    }

    customElements.define('mg-contact-map', MgContactMap);
  }
{% endjavascript %}

{% stylesheet %}
  mg-contact-map {
    display: block;
  }

  .mg-contact {
    --mg-contact-highlight: var(--mg-card);
  }

  .mg-contact.mg-section--band {
    --mg-contact-highlight: var(--mg-band);
  }

  .mg-contact__panel {
    display: grid;
  }

  .mg-contact__info {
    display: grid;
    align-content: start;
    gap: var(--mg-space-6);
    padding: var(--mg-panel-pad);
  }

  .mg-contact__details {
    display: grid;
    gap: var(--mg-space-5);
  }

  .mg-contact__group {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--mg-space-2);
    min-width: 0;
  }

  .mg-contact__label {
    display: flex;
    align-items: center;
    gap: var(--mg-space-2);
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: var(--mg-fs-small);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
    color: var(--mg-ink);
  }

  .mg-contact__label .mg-icon {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--mg-ink-2);
  }

  .mg-contact__address {
    font-style: normal;
    font-size: var(--mg-fs-body);
    line-height: var(--mg-lh-body);
    color: var(--mg-ink-2);
  }

  .mg-contact__address strong {
    color: var(--mg-ink);
  }

  .mg-contact__directions {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    font-size: var(--mg-fs-small);
  }

  /* Opening hours, today's row highlighted */
  .mg-contact__hours {
    width: calc(100% + var(--mg-space-4));
    max-width: calc(400px + var(--mg-space-4));
    margin: 0 calc(var(--mg-space-2) * -1);
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
  }

  .mg-contact__hours :is(th, td) {
    padding: 6px var(--mg-space-2);
    border: 0;
    line-height: 1.4;
    vertical-align: middle;
  }

  .mg-contact__hours th {
    white-space: nowrap;
    font-weight: 400;
    text-align: left;
    color: var(--mg-ink-2);
  }

  .mg-contact__hours td {
    color: var(--mg-ink);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .mg-contact__hours tr.is-today > * {
    background-color: var(--mg-contact-highlight);
    font-weight: 600;
    color: var(--mg-ink);
  }

  .mg-contact__hours tr.is-today > :first-child {
    border-radius: var(--mg-radius-sm) 0 0 var(--mg-radius-sm);
  }

  .mg-contact__hours tr.is-today > :last-child {
    border-radius: 0 var(--mg-radius-sm) var(--mg-radius-sm) 0;
  }

  .mg-contact__today {
    min-height: 20px;
    margin-left: var(--mg-space-2);
    padding: 0 6px;
    font-size: 0.75rem;
    vertical-align: 1px;
  }

  .mg-contact__lines {
    display: grid;
    gap: var(--mg-space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-contact__lines {
    font-size: 1.0625rem;
  }

  /* 44px tap target for the email link */
  .mg-contact__lines a {
    display: inline-flex;
    align-items: center;
    min-height: var(--mg-tap);
    overflow-wrap: anywhere;
  }

  /* The buttons share the row, and fill it when they wrap */
  .mg-contact__actions > .mg-btn {
    flex: 1 1 auto;
  }

  /* Map: a click-to-load facade, then the Google map */
  .mg-contact__map {
    position: relative;
    min-width: 0;
    min-height: 320px;
    aspect-ratio: 1 / 1;
    background-color: var(--mg-band-2);
  }

  .mg-contact__iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  html[data-mg-scheme='dark'] .mg-contact--dim-map .mg-contact__iframe {
    filter: invert(0.9) hue-rotate(180deg) saturate(0.7) brightness(0.95);
  }

  .mg-contact__facade {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--mg-space-4);
  }

  /* Phones and tablets without the workshop photo: a shorter map area, so the card isn't
     floating in a large empty square (the square is for the photo) */
  @media screen and (max-width: 989px) {
    .mg-contact__map:has(> .mg-contact__facade:not(.mg-contact__facade--photo)) {
      min-height: 240px;
      aspect-ratio: auto;
    }
  }

  .mg-contact__facade-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mg-contact__facade-card {
    position: relative;
    display: grid;
    gap: var(--mg-space-3);
    width: min(100%, 300px);
    padding: var(--mg-space-4);
  }

  .mg-contact__place {
    display: flex;
    align-items: center;
    gap: var(--mg-space-3);
  }

  .mg-contact__pin {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--mg-radius-pill);
    background-color: var(--mg-red);
    color: var(--mg-on-red);
  }

  .mg-contact__pin .mg-icon {
    width: 20px;
    height: 20px;
  }

  .mg-contact__place-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .mg-contact__place-name {
    font-size: var(--mg-fs-title);
    font-weight: 600;
    line-height: 1.3;
    color: var(--mg-ink);
  }

  .mg-contact__place-line {
    font-size: var(--mg-fs-small);
    line-height: 1.35;
    color: var(--mg-ink-2);
  }

  @media screen and (min-width: 750px) {
    .mg-contact__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--mg-space-5) var(--mg-space-6);
    }

    .mg-contact__details > :nth-child(2) {
      grid-row: span 2;
    }

    .mg-contact__map {
      aspect-ratio: 16 / 9;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-contact__panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .mg-contact__details {
      grid-template-columns: minmax(0, 1fr);
    }

    .mg-contact__details > :nth-child(2) {
      grid-row: auto;
    }

    .mg-contact__map {
      min-height: 480px;
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG contact and map",
  "tag": "div",
  "class": "mg-contact-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Address, phone, WhatsApp, opening hours and the map search come from Theme settings > MG Car Audio: business details."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit the workshop"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Intro text",
      "info": "Optional. One short line under the heading.",
      "default": "See screens and speakers in person, or drop your car in for a fitting."
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp button",
      "default": true
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "select",
      "id": "map_mode",
      "label": "Map loading",
      "info": "\"Click to load\" keeps the page fast and doesn't load Google Maps (or its cookies) until the visitor asks for it.",
      "options": [
        {
          "value": "facade",
          "label": "Click to load (recommended)"
        },
        {
          "value": "embed",
          "label": "Load straight away"
        }
      ],
      "default": "facade"
    },
    {
      "type": "checkbox",
      "id": "facade_photo",
      "label": "Show a workshop photo until the map loads",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "facade_image",
      "label": "Workshop photo",
      "info": "Uses the showroom photo until you upload one."
    },
    {
      "type": "checkbox",
      "id": "dark_map",
      "label": "Darken the map in dark mode",
      "info": "Tints the Google map to match the page when a visitor uses dark mode. The light theme always shows the normal map.",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "surface",
          "label": "Grey band"
        }
      ],
      "default": "page"
    }
  ],
  "presets": [
    {
      "name": "MG contact and map",
      "category": "MG Car Audio"
    }
  ]
}
{% endschema %}
