{%- liquid
  assign heading_id = 'MgSystemsHeading-' | append: section.id
  assign cols = section.settings.columns_desktop | default: 3
  assign link_url = section.settings.link_url | default: '/collections'
  assign price_fallback = section.settings.price_fallback | strip
  assign cta_label = section.settings.cta_label | strip
  assign feature_first = section.settings.feature_first

  if cols == 4
    assign img_sizes = '(min-width: 750px) 25vw, 50vw'
  elsif cols == 2
    assign img_sizes = '(min-width: 750px) 50vw, 50vw'
  else
    assign img_sizes = '(min-width: 750px) 33vw, 50vw'
  endif
  assign feature_sizes = '(min-width: 750px) 50vw, 100vw'

  assign section_classes = 'mg-section mg-systems mg-systems--cols-' | append: cols
  if section.settings.full_width
    assign section_classes = section_classes | append: ' mg-systems--bleed'
  endif
-%}

<div class="{{ section_classes }}">
  {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
    <div class="mg-container">
      <div
        class="mg-head mg-head--caps"
        data-mg-reveal
      >
        <div class="mg-head__text">
          {%- if section.settings.heading != blank -%}
            <h2
              class="mg-head__title"
              id="{{ heading_id }}"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="mg-head__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}
          <a
            class="mg-link mg-head__link"
            href="{{ link_url }}"
          >
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="mg-systems__wrap{% unless section.settings.full_width %} mg-container{% endunless %}">
      <ul
        class="mg-systems__grid"
        role="list"
        data-mg-reveal-stagger
        {% if section.settings.heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% endif %}
      >
        {%- assign shown = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign title = block.settings.title | strip
            if title == blank
              continue
            endif
            assign shown = shown | plus: 1

            assign is_feature = false
            if feature_first and shown <= 2
              assign is_feature = true
            endif

            assign tile_url = block.settings.url | default: '/collections/all'
            assign price = block.settings.price | strip
            assign price_label = block.settings.price_label | strip
            assign price_suffix = block.settings.price_suffix | strip
            assign asset = block.settings.fallback_asset | default: 'none'
            assign icon = block.settings.icon | default: 'none'

            if is_feature
              assign sizes = feature_sizes
            else
              assign sizes = img_sizes
            endif

            # Crops that keep each stock photo's subject (usually a screen) in frame:
            # --mg-pos on small portrait tiles, --mg-pos-wide on the big landscape tiles
            case asset
              when 'mg-img-sys-carplay'
                assign pos = '--mg-pos: 40% 50%; --mg-pos-wide: 50% 58%;'
              when 'mg-img-sys-android-radio'
                assign pos = '--mg-pos: 60% 45%; --mg-pos-wide: 50% 42%;'
              when 'mg-img-sys-screens'
                assign pos = '--mg-pos: 50% 40%; --mg-pos-wide: 50% 38%;'
              when 'mg-img-sys-dashcam'
                assign pos = '--mg-pos: 55% 40%; --mg-pos-wide: 50% 30%;'
              when 'mg-img-sys-reverse-camera'
                assign pos = '--mg-pos: 50% 40%; --mg-pos-wide: 50% 40%;'
              when 'mg-img-sys-conversion'
                assign pos = '--mg-pos: 40% 60%; --mg-pos-wide: 50% 65%;'
              else
                assign pos = '--mg-pos: 50% 50%; --mg-pos-wide: 50% 50%;'
            endcase

            assign media = 'none'
            if block.settings.image != blank
              assign media = 'image'
              assign focal = block.settings.image.presentation.focal_point | default: '50% 50%'
              assign pos = '--mg-pos: ' | append: focal | append: '; --mg-pos-wide: ' | append: focal | append: ';'
            elsif asset != 'none'
              assign media = 'asset'
            elsif icon != 'none'
              assign media = 'icon'
            endif
          -%}
          <li
            class="mg-systems__item{% if is_feature %} mg-systems__item--feature{% endif %}"
            {{ block.shopify_attributes }}
          >
            <a
              class="mg-systems__tile"
              href="{{ tile_url }}"
            >
              <span class="mg-systems__media">
                {%- case media -%}
                  {%- when 'image' -%}
                    {{-
                      block.settings.image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '360, 540, 720, 900, 1100, 1400',
                        sizes: sizes,
                        loading: 'lazy',
                        alt: '',
                        style: pos,
                        class: 'mg-systems__img'
                    -}}
                  {%- when 'asset' -%}
                    {%- render 'mg-asset-image',
                      asset: asset,
                      sizes: sizes,
                      loading: 'lazy',
                      alt: '',
                      class: 'mg-systems__img',
                      style: pos
                    -%}
                  {%- when 'icon' -%}
                    <span class="mg-systems__icon">{% render 'mg-icon', icon: icon %}</span>
                {%- endcase -%}
              </span>
              <span class="mg-systems__body">
                <span class="mg-systems__label">{{ title | escape }}</span>
                {%- if price != blank -%}
                  <span class="mg-systems__price">
                    {%- if price_label != blank %}{{ price_label | escape }} {% endif -%}
                    <strong class="mg-price">{{ price | escape }}</strong>
                    {%- if price_suffix != blank %} {{ price_suffix | escape }}{% endif -%}
                  </span>
                {%- elsif price_fallback != blank -%}
                  <span class="mg-systems__price">{{ price_fallback | escape }}</span>
                {%- endif -%}
                {%- if cta_label != blank -%}
                  <span
                    class="mg-systems__cta"
                    aria-hidden="true"
                  >
                    {{- cta_label | escape -}}
                    {%- render 'mg-icon', icon: 'arrow-right' -%}
                  </span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /*
   * Shop by system: full-photo tiles in a tight mosaic with big uppercase labels, the fitted
   * price and an outlined "Shop now" button. The first two tiles can be big (a wide row of 2);
   * the rest run 3 (or 2, 4) across. Phones: big tiles full width, the rest 2 across.
   * Hover or focus: the photo zooms slowly, a red edge lights up and the button fills red.
   */
  .mg-systems__grid {
    --mg-systems-gap: 2px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--mg-systems-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-systems:not(.mg-systems--bleed) .mg-systems__grid {
    --mg-systems-gap: var(--mg-gap);
  }

  .mg-systems__item {
    display: flex;
    min-width: 0;
    margin: 0;
  }

  .mg-systems__item--feature {
    grid-column: span 2;
  }

  .mg-systems__tile {
    position: relative;
    isolation: isolate;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: flex-end;
    min-width: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--mg-night);
    color: var(--mg-white);
    text-decoration: none;
  }

  .mg-systems__item--feature .mg-systems__tile {
    aspect-ratio: 16 / 10;
  }

  .mg-systems:not(.mg-systems--bleed) .mg-systems__tile {
    border-radius: var(--mg-radius-md);
  }

  .mg-systems__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .mg-systems .mg-systems__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--mg-pos, 50% 50%);
    transition: transform var(--mg-dur-slow) var(--mg-ease-out);
  }

  .mg-systems__img {
    filter: brightness(1.18) saturate(1.08);
  }

  .mg-systems__item--feature .mg-systems__img {
    object-position: var(--mg-pos-wide, 50% 50%);
  }

  /* Scrim: dark only under the text, the photo itself stays bright */
  .mg-systems__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(var(--mg-night-rgb) / 0.82) 0%, rgb(var(--mg-night-rgb) / 0.34) 34%, rgb(var(--mg-night-rgb) / 0) 62%);
  }

  /* Red edge on hover and focus, drawn above the photo */
  .mg-systems__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px rgb(var(--mg-red-rgb) / 0);
    transition: box-shadow var(--mg-dur) var(--mg-ease);
    pointer-events: none;
  }

  .mg-systems__icon {
    display: grid;
    place-items: center;
    height: 70%;
    color: var(--mg-red-ink);
  }

  .mg-systems__icon .mg-icon {
    width: 40%;
    height: 40%;
    stroke-width: 1.25;
  }

  .mg-systems__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--mg-space-1);
    padding: var(--mg-space-3);
  }

  .mg-systems__label {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-wrap: balance;
    text-shadow: 0 1px 14px rgb(var(--mg-night-rgb) / 0.6);
  }

  .mg-systems__price {
    font-size: var(--mg-fs-micro);
    line-height: 1.35;
    color: rgb(255 255 255 / 0.82);
  }

  .mg-systems__price .mg-price {
    font-weight: 600;
    color: var(--mg-white);
  }

  /* Outlined button: a label, not a separate link (the tile is the link) */
  .mg-systems__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--mg-space-2);
    height: 32px;
    margin-block-start: var(--mg-space-2);
    padding-inline: var(--mg-space-3);
    border: 1px solid rgb(255 255 255 / 0.72);
    border-radius: var(--mg-radius-xs);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color var(--mg-dur) var(--mg-ease),
      border-color var(--mg-dur) var(--mg-ease);
  }

  .mg-systems__cta .mg-icon {
    width: 14px;
    height: 14px;
    transition: transform var(--mg-dur) var(--mg-ease);
  }

  .mg-systems__item--feature .mg-systems__label {
    font-size: 1.5rem;
  }

  @media (hover: hover) {
    .mg-systems__tile:hover .mg-systems__img {
      transform: scale(1.06);
    }

    .mg-systems__tile:hover::after {
      box-shadow: inset 0 0 0 2px var(--mg-red);
    }

    .mg-systems__tile:hover .mg-systems__cta {
      border-color: var(--mg-red);
      background-color: var(--mg-red);
    }

    .mg-systems__tile:hover .mg-systems__cta .mg-icon {
      transform: translateX(3px);
    }
  }

  /* MG's own tile CTA: sentence-case label beside a red round arrow chip (not an outlined box) */
  .mg-systems__tile .mg-systems__cta {
    height: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .mg-systems__tile .mg-systems__cta .mg-icon {
    box-sizing: content-box;
    width: 14px;
    height: 14px;
    padding: 7px;
    border-radius: 999px;
    background-color: var(--mg-red);
    color: #fff;
  }

  @media (hover: hover) {
    .mg-systems__tile:hover .mg-systems__cta {
      border-color: transparent;
      background: none;
    }
  }

  .mg-systems__tile:focus-visible .mg-systems__cta {
    border-color: transparent;
    background: none;
  }

  .mg-systems__tile:focus-visible {
    outline: 2px solid var(--mg-white);
    outline-offset: -6px;
  }

  .mg-systems__tile:focus-visible::after {
    box-shadow: inset 0 0 0 2px var(--mg-red);
  }

  .mg-systems__tile:focus-visible .mg-systems__cta {
    border-color: var(--mg-red);
    background-color: var(--mg-red);
  }

  @media screen and (max-width: 374px) {
    .mg-systems__label {
      font-size: 0.9375rem;
    }

    .mg-systems__cta {
      padding-inline: var(--mg-space-2);
      letter-spacing: 0.08em;
    }
  }

  /* Tablet and desktop: a 12-column mosaic with fixed row heights */
  @media screen and (min-width: 750px) {
    .mg-systems__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .mg-systems__item {
      grid-column: span 4;
    }

    .mg-systems--cols-2 .mg-systems__item,
    .mg-systems__item--feature {
      grid-column: span 6;
    }

    .mg-systems--cols-4 .mg-systems__item:not(.mg-systems__item--feature) {
      grid-column: span 3;
    }

    .mg-systems__tile,
    .mg-systems__item--feature .mg-systems__tile {
      aspect-ratio: auto;
      height: clamp(260px, 26vw, 400px);
    }

    .mg-systems--cols-4 .mg-systems__item:not(.mg-systems__item--feature) .mg-systems__tile {
      height: clamp(240px, 22vw, 340px);
    }

    .mg-systems__item--feature .mg-systems__tile {
      height: clamp(300px, 32vw, 480px);
    }

    .mg-systems__body {
      gap: var(--mg-space-2);
      padding: var(--mg-space-5);
    }

    .mg-systems__label {
      font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    }

    .mg-systems--cols-4 .mg-systems__label {
      font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    }

    .mg-systems__item--feature .mg-systems__label {
      font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    }

    .mg-systems__price {
      font-size: var(--mg-fs-small);
    }

    .mg-systems__cta {
      height: 40px;
      padding-inline: var(--mg-space-4);
      font-size: 0.75rem;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-systems__body {
      padding: var(--mg-space-6);
    }

    .mg-systems__item--feature .mg-systems__price {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-systems .mg-systems__img,
    .mg-systems__cta,
    .mg-systems__cta .mg-icon,
    .mg-systems__tile::after {
      transition: none;
    }

    .mg-systems__tile:hover .mg-systems__img,
    .mg-systems__tile:hover .mg-systems__cta .mg-icon {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG shop by system",
  "tag": "section",
  "class": "mg-systems-section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by system"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Line under the heading",
      "info": "Optional. One short sentence."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Shown on the right of the heading. Leave blank to hide the link.",
      "default": "See all"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link",
      "info": "Leave blank to link to /collections (every collection)."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "Make the first 2 tiles big",
      "info": "The first two tiles share a wide row. On phones they run full width and the rest sit 2 across.",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Tiles per row on tablet and desktop",
      "info": "For the tiles after the big ones. With 2 big tiles and 3 per row, 8 tiles fill every row; with 4 per row, use 10.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Run the tiles edge to edge",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text on each tile",
      "info": "An outlined button under each label. The whole tile is the link. Leave blank to hide it.",
      "default": "See options"
    },
    {
      "type": "text",
      "id": "price_fallback",
      "label": "Text when a tile has no price",
      "info": "Shown under a tile whose price is blank. Leave blank (recommended) so only real prices show, in one red price line. Placeholder: add prices for screen upgrades, speakers, subwoofers and amps, dash cams and reverse cameras once MG confirms them."
    }
  ],
  "blocks": [
    {
      "type": "system",
      "name": "System tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "CarPlay & Android Auto"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Usually a collection, e.g. /collections/speakers. Leave blank to link to /collections/all."
        },
        {
          "type": "header",
          "content": "Price line"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "info": "Real prices only, e.g. €299. Leave blank to show the section's \"Text when a tile has no price\".",
          "placeholder": "€299"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Before the price",
          "default": "From"
        },
        {
          "type": "text",
          "id": "price_suffix",
          "label": "After the price",
          "info": "e.g. fitted. Leave blank when the price is not a fitted price.",
          "default": "fitted"
        },
        {
          "type": "header",
          "content": "Picture"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Fills the tile under a dark shade: portrait on small tiles, landscape on the big ones. Set a focal point. Don't use car-maker logos."
        },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Photo when no image is picked",
          "info": "The stock mood photos suit these full-photo tiles best. The Japan-to-Europe graphics carry their own lettering, so avoid them here.",
          "options": [
            {
              "value": "none",
              "label": "None (use the icon)"
            },
            {
              "value": "mg-img-sys-carplay",
              "label": "CarPlay on a dash screen (stock)"
            },
            {
              "value": "mg-img-sys-screens",
              "label": "Widescreen map display (stock)"
            },
            {
              "value": "mg-img-sys-android-radio",
              "label": "Double-DIN head unit (stock)"
            },
            {
              "value": "mg-img-sys-speakers",
              "label": "Speaker cone close-up (stock)"
            },
            {
              "value": "mg-img-sys-subs-amps",
              "label": "Boot subwoofer install (stock)"
            },
            {
              "value": "mg-img-sys-dashcam",
              "label": "Dash cam on a windscreen (stock)"
            },
            {
              "value": "mg-img-sys-reverse-camera",
              "label": "Reversing camera view (stock)"
            },
            {
              "value": "mg-img-sys-conversion",
              "label": "Tokyo street at night (stock)"
            },
            {
              "value": "mg-audi-carplay-screen",
