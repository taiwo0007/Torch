{%- liquid
  assign heading_id = 'MgSystemsHeading-' | append: section.id
  assign cols = section.settings.columns_desktop | default: 4
  assign link_url = section.settings.link_url | default: '/collections'
  assign price_fallback = section.settings.price_fallback | strip

  if cols == 3
    assign img_sizes = '(min-width: 1184px) 352px, (min-width: 750px) calc((100vw - 96px) / 3), calc((100vw - 56px) / 2)'
  else
    assign img_sizes = '(min-width: 1184px) 244px, (min-width: 750px) calc((100vw - 120px) / 4), calc((100vw - 56px) / 2)'
  endif
-%}

<div
  class="mg-section mg-systems"
  style="--mg-systems-cols: {{ cols }};"
>
  <div class="mg-container">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="mg-head">
        <div class="mg-head__text">
          {%- if section.settings.heading != blank -%}
            <h2
              class="mg-head__title"
              id="{{ heading_id }}"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="mg-head__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}
          <a
            class="mg-link mg-head__link"
            href="{{ link_url }}"
          >
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="mg-grid mg-systems__grid"
        role="list"
        {% if section.settings.heading != blank %}
          aria-labelledby="{{ heading_id }}"
        {% endif %}
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign title = block.settings.title | strip
            if title == blank
              continue
            endif

            assign tile_url = block.settings.url | default: '/collections/all'
            assign price = block.settings.price | strip
            assign price_label = block.settings.price_label | strip
            assign price_suffix = block.settings.price_suffix | strip
            assign asset = block.settings.fallback_asset | default: 'none'
            assign icon = block.settings.icon | default: 'none'

            assign asset_w = 1536
            assign asset_h = 1024
            assign asset_small_h = 533
            assign asset_has_small = true
            case asset
              when 'mg-bmw-carplay-screen'
                assign asset_h = 840
                assign asset_small_h = 438
              when 'mg-showroom'
                assign asset_w = 1600
                assign asset_h = 1200
                assign asset_small_h = 600
              when 'mg-dash-radio', 'mg-door-speaker', 'mg-single-din-radio', 'mg-speaker-pair'
                assign asset_w = 1024
                assign asset_h = 1024
                assign asset_has_small = false
            endcase

            assign media = 'none'
            if block.settings.image != blank
              assign media = 'image'
            elsif asset != 'none'
              assign media = 'asset'
            elsif icon != 'none'
              assign media = 'icon'
            endif
          -%}
          <li
            class="mg-systems__item"
            {{ block.shopify_attributes }}
          >
            <a
              class="mg-tile mg-systems__tile{% if media == 'none' %} mg-systems__tile--text{% endif %}"
              href="{{ tile_url }}"
            >
              {%- case media -%}
                {%- when 'image' -%}
                  <span class="mg-tile__media">
                    {{-
                      block.settings.image
                      | image_url: width: 800
                      | image_tag:
                        widths: '240, 360, 480, 640, 800',
                        sizes: img_sizes,
                        loading: 'lazy',
                        alt: ''
                    -}}
                  </span>
                {%- when 'asset' -%}
                  <span class="mg-tile__media">
                    {%- if asset_has_small -%}
                      {%- assign asset_small = asset | append: '-800.webp' -%}
                      <img
                        src="{{ asset_small | asset_url }}"
                        srcset="{{ asset_small | asset_url }} 800w, {{ asset | append: '.webp' | asset_url }} {{ asset_w }}w"
                        sizes="{{ img_sizes }}"
                        width="800"
                        height="{{ asset_small_h }}"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      >
                    {%- else -%}
                      <img
                        src="{{ asset | append: '.webp' | asset_url }}"
                        width="{{ asset_w }}"
                        height="{{ asset_h }}"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      >
                    {%- endif -%}
                  </span>
                {%- when 'icon' -%}
                  <span class="mg-tile__media mg-systems__media--icon">
                    {%- render 'mg-icon', icon: icon -%}
                  </span>
              {%- endcase -%}
              <span class="mg-tile__label">{{ title | escape }}</span>
              {% if price != blank -%}
                <span class="mg-tile__meta">
                  {%- if price_label != blank %}{{ price_label | escape }} {% endif -%}
                  <span class="mg-price mg-price--red">{{ price | escape }}</span>
                  {%- if price_suffix != blank %} {{ price_suffix | escape }}{% endif -%}
                </span>
              {%- elsif price_fallback != blank -%}
                <span class="mg-tile__meta mg-systems__note">{{ price_fallback | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .mg-systems__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mg-systems__item {
    display: flex;
    min-width: 0;
  }

  .mg-systems__tile {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Every row is as tall as the tallest tile (grid-auto-rows: 1fr); the price line sits at the
     bottom so it lines up across a row whether the label takes one line or two */
  .mg-systems__tile .mg-tile__meta {
    margin-block-start: auto;
  }

  /* A tile with no picture keeps its label and price together at the bottom */
  .mg-systems__tile--text .mg-tile__label {
    margin-block-start: auto;
  }

  .mg-systems__tile--text .mg-tile__meta {
    margin-block-start: 0;
  }

  /* No photo: a large line icon drawn straight on the tile, in the photo's place (no inner
     well, which read as a missing image beside the photo tiles) */
  .mg-systems .mg-systems__media--icon .mg-icon {
    width: 46%;
    height: 46%;
    stroke-width: 1.25;
  }

  .mg-systems__note {
    color: var(--mg-ink-2);
  }

  @media screen and (min-width: 750px) {
    .mg-systems__grid {
      grid-template-columns: repeat(var(--mg-systems-cols, 4), minmax(0, 1fr));
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "MG shop by system",
  "tag": "section",
  "class": "mg-systems-section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by system"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Line under the heading",
      "info": "Optional. One short sentence."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "Shown on the right of the heading. Leave blank to hide the link.",
      "default": "See all"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link",
      "info": "Leave blank to link to /collections (every collection)."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on tablet and desktop",
      "info": "Phones show 2 columns. 8 tiles fill 2 rows of 4. With 3 columns, use 6 or 9 tiles so no row is left short.",
      "min": 3,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "price_fallback",
      "label": "Text when a tile has no price",
      "info": "Shown under a tile whose price is blank. Leave blank (recommended) so only real prices show, in one red price line. Placeholder: add prices for screen upgrades, speakers, subwoofers and amps, dash cams and reverse cameras once MG confirms them."
    }
  ],
  "blocks": [
    {
      "type": "system",
      "name": "System tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "CarPlay & Android Auto"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Usually a collection, e.g. /collections/speakers. Leave blank to link to /collections/all."
        },
        {
          "type": "header",
          "content": "Price line"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "info": "Real prices only, e.g. €299. Leave blank to show the section's \"Text when a tile has no price\".",
          "placeholder": "€299"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Before the price",
          "default": "From"
        },
        {
          "type": "text",
          "id": "price_suffix",
          "label": "After the price",
          "info": "e.g. fitted. Leave blank when the price is not a fitted price.",
          "default": "fitted"
        },
        {
          "type": "header",
          "content": "Picture"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown at 4:3 with rounded corners. Don't use car-maker logos."
        },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Photo when no image is picked",
          "info": "Product and install photos suit the tiles best. The Japan-to-Europe graphics carry their own lettering, so a tile without a real photo uses its icon instead. Placeholder: upload a real conversion photo when one exists.",
          "options": [
            { "value": "none", "label": "None (use the icon)" },
            { "value": "mg-audi-carplay-screen", "label": "Audi dash with CarPlay" },
            { "value": "mg-bmw-carplay-screen", "label": "BMW widescreen with CarPlay" },
            { "value": "mg-android-auto-dash", "label": "Dash with Android Auto" },
            { "value": "mg-dash-radio", "label": "Dash with head unit" },
            { "value": "mg-single-din-radio", "label": "Single-DIN radio" },
            { "value": "mg-door-speaker", "label": "Door speaker" },
            { "value": "mg-speaker-pair", "label": "Pair of speakers" },
            { "value": "mg-showroom", "label": "MG showroom" },
            { "value": "mg-bmw-japan-to-europe", "label": "BMW Japan-to-Europe graphic" },
            { "value": "mg-mercedes-japan-to-europe", "label": "Mercedes Japan-to-Europe graphic" },
            { "value": "mg-vw-japan-to-europe", "label": "VW Japan-to-Europe graphic" },
            { "value": "mg-radio-frequency-conversion", "label": "Radio frequency conversion graphic" }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon when there is no photo",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "screen", "label": "Screen" },
            { "value": "radio", "label": "Radio" },
            { "value": "speaker", "label": "Speaker" },
            { "value": "camera", "label": "Camera" },
            { "value": "car", "label": "Car" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "globe", "label": "Globe" },
            { "value": "shield", "label": "Shield" },
            { "value": "tag", "label": "Price tag" }
          ],
          "default": "car"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MG shop by system",
      "category": "MG Car Audio",
      "blocks": [
        {
          "type": "system",
          "settings": {
            "title": "CarPlay & Android Auto",
            "url": "/collections/carplay-android-auto",
            "price": "€299",
            "price_label": "From",
            "price_suffix": "fitted",
            "fallback_asset": "mg-audi-carplay-screen",
            "icon": "screen"
          }
        },
        {
          "type": "system",
          "settings": {
            "title": "Screen upgrades",
            "url": "/collections/screen-upgrades",
            "fallback_asset": "mg-android-auto-dash",
            "icon": "screen"
          }
        },
        {
          "type": "system",
          "settings": {
            "title": "Android radios",
            "url": "/collections/android-radios",
            "price": "€150",
            "price_label": "Fitting from",
            "price_suffix": "",
            "fallback_asset": "mg-single-din-radio",
            "icon": "radio"
          }
        },
        {
          "type": "system",
          "settings": {
            "title": "Speakers",
            "url": "/collections/speakers",
            "fallback_asset": "mg-speaker-pair",
            "icon": "speaker"
          }
        },
        {
          "type": "system",
          "settings": {
            "title": "Subwoofers & amps",
            "url": "/collections/subwoofers",
            "fallback_asset": "mg-door-speaker",
            "icon": "speaker"
          }
        },
        {
          "type": "system",
          "settings": {
            "title": "Dash cams",
            "url": "/collections/dashcams",
            "fallback_asset": "none",
            "icon": "camera"
          }
        },
        {
          "type": "system",
          "settings": {
            "title": "Reverse cameras",
            "url": "/collections/reverse-cameras",
            "fallback_asset": "none",
            "icon": "car"
          }
        },
        {
          "type": "system",
          "settings": {
            "title": "Japanese import conversion",
            "url": "/products/bmw-japan-to-europe-conversion",
            "price": "€450",
            "price_label": "From",
            "price_suffix": "",
            "fallback_asset": "none",
            "icon": "globe"
          }
        }
      ]
    }
  ]
}
{% endschema %}
