{%- liquid
  assign is_above_fold = true
  if section.index > 2
    assign is_above_fold = false
  endif

  assign heading_tag = 'h2'
  if section.settings.heading_is_h1
    assign heading_tag = 'h1'
  endif

  assign line_1 = section.settings.heading_line_1 | strip
  assign line_2 = section.settings.heading_line_2 | strip

  assign quote_url = section.settings.quote_url | default: '/pages/get-a-quote'
  assign reg_id = 'MgHeroReg-' | append: section.id
  assign reg_label = section.settings.plate_label | strip | default: 'Your registration'
  assign button_label = section.settings.button_label | strip | default: 'Get a quote'

  assign wa_message = section.settings.whatsapp_message | default: settings.mg_whatsapp_message
  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_enabled and settings.mg_whatsapp_number != blank and section.settings.whatsapp_text != blank
    assign show_whatsapp = true
  endif

  assign fallback_alt = 'BMW widescreen showing Apple CarPlay, fitted by ' | append: settings.mg_business_name
  assign image_sizes = '(min-width: 1200px) 520px, (min-width: 990px) 44vw, (min-width: 750px) calc(100vw - 112px), calc(100vw - 80px)'

  if is_above_fold
    assign image_loading = 'eager'
    assign image_priority = 'high'
  else
    assign image_loading = 'lazy'
    assign image_priority = 'auto'
  endif
-%}

<div class="mg-section mg-hero">
  <div class="mg-container">
    <div class="mg-panel mg-surface-red mg-hero__banner">
      <div class="mg-hero__content">
        {%- if line_1 != blank or line_2 != blank -%}
          <{{ heading_tag }} class="mg-display mg-display--hero mg-hero__title">
            {%- if line_1 != blank -%}
              <span class="mg-hero__line">{{ line_1 | escape }}</span>
            {%- endif -%}
            {%- if line_1 != blank and line_2 != blank %} {% endif -%}
            {%- if line_2 != blank -%}
              <em class="mg-hero__line">{{ line_2 | escape }}</em>
            {%- endif -%}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.lede != blank -%}
          <p class="mg-lede mg-hero__lede">{{ section.settings.lede | escape }}</p>
        {%- endif -%}

        <form
          class="mg-hero__form"
          action="{{ quote_url }}"
          method="get"
        >
          <label
            class="mg-label mg-hero__label{% if section.settings.plate_label == blank %} mg-visually-hidden{% endif %}"
            for="{{ reg_id }}"
          >
            {{- reg_label | escape -}}
          </label>
          <div class="mg-plate-group">
            <div class="mg-plate">
              <span
                class="mg-plate__band"
                aria-hidden="true"
                >IRL</span
              >
              <input
                class="mg-plate__input"
                id="{{ reg_id }}"
                name="reg"
                type="text"
                placeholder="{{ section.settings.plate_placeholder | escape }}"
                autocomplete="off"
                autocapitalize="characters"
                autocorrect="off"
                spellcheck="false"
                enterkeyhint="go"
                maxlength="12"
              >
            </div>
            <button
              class="mg-btn mg-btn--on-red mg-btn--lg"
              type="submit"
            >
              {{ button_label | escape }}
            </button>
          </div>
        </form>

        {%- if show_whatsapp -%}
          <a
            class="mg-link mg-hero__whatsapp"
            href="https://wa.me/{{ settings.mg_whatsapp_number }}?text={{ wa_message | url_encode }}"
            target="_blank"
            rel="noopener"
          >
            {%- render 'mg-icon', icon: 'whatsapp' -%}
            <span>{{ section.settings.whatsapp_text | escape }}</span>
            <span class="mg-visually-hidden"> (opens WhatsApp)</span>
          </a>
        {%- endif -%}
      </div>

      <div class="mg-hero__media">
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign image_alt = section.settings.image.alt | default: fallback_alt
            assign focal_style = 'object-position: ' | append: section.settings.image.presentation.focal_point
          -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '400, 600, 800, 1040, 1300, 1600',
              sizes: image_sizes,
              loading: image_loading,
              fetchpriority: image_priority,
              alt: image_alt,
              style: focal_style,
              class: 'mg-hero__img'
          }}
        {%- else -%}
          <img
            class="mg-hero__img mg-hero__img--fallback"
            src="{{ 'mg-bmw-carplay-screen.webp' | asset_url }}"
            srcset="{{ 'mg-bmw-carplay-screen-800.webp' | asset_url }} 800w, {{ 'mg-bmw-carplay-screen.webp' | asset_url }} 1536w"
            sizes="{{ image_sizes }}"
            alt="{{ fallback_alt | escape }}"
            width="1536"
            height="840"
            loading="{{ image_loading }}"
            fetchpriority="{{ image_priority }}"
            {% unless is_above_fold %}
              decoding="async"
            {% endunless %}
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /*
   * MG hero: a rounded MG red banner inside the container (Back Market's banner grammar).
   * Phones and tablets: photo on top, copy below. From 990px: copy left, photo right.
   * Colour, type, radius and states come from mg-theme.css (.mg-panel, .mg-surface-red,
   * .mg-display--hero, .mg-lede, .mg-plate-group, .mg-btn--on-red, .mg-link). Layout only
   * here; rules that adjust a shared component are scoped under .mg-hero so they win
   * whatever order the stylesheets load in.
   */
  .mg-hero__banner {
    display: grid;
    gap: var(--mg-space-5);
  }

  .mg-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  /* Each heading setting starts its own line; line 2 is the italic <em> */
  .mg-hero__line {
    display: block;
  }

  .mg-hero .mg-hero__lede {
    text-wrap: balance;
  }

  .mg-hero__form {
    display: grid;
    gap: var(--mg-space-2);
    align-self: stretch;
    margin-top: var(--mg-space-5);
  }

  /* The label sits on red: it follows the banner's text colour */
  .mg-hero .mg-hero__label {
    color: inherit;
  }

  .mg-hero__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--mg-space-2);
    min-height: var(--mg-tap);
    margin-top: var(--mg-space-2);
    border-radius: var(--mg-radius-xs);
    font-size: var(--mg-fs-small);
  }

  .mg-hero__whatsapp .mg-icon {
    flex: none;
    width: 20px;
    height: 20px;
  }

  /*
   * A flex container does not pass its underline on to its items, and Horizon's base.css
   * makes link underlines transparent: draw the .mg-link underline on the text itself.
   */
  .mg-hero__whatsapp > span {
    text-decoration: inherit;
    text-decoration-color: currentcolor;
  }

  .mg-hero__media {
    order: -1;
    min-width: 0;
  }

  .mg-hero__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--mg-radius-md);
    object-fit: cover;
  }

  .mg-hero__img--fallback {
    object-position: 50% 30%;
  }

  /* Small phones (under 375px): a tighter banner keeps the WhatsApp link on one line */
  @media screen and (max-width: 374px) {
    .mg-hero .mg-hero__banner {
      padding: var(--mg-space-4);
    }
  }

  @media screen and (min-width: 750px) {
    .mg-hero__banner {
      gap: var(--mg-space-6);
    }

    .mg-hero__img {
      aspect-ratio: 2 / 1;
    }
  }

  @media screen and (min-width: 990px) {
    /* A wide copy column, so the headline is two lines: line 1, then the italic line 2 */
    .mg-hero__banner {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--mg-space-6);
    }

    .mg-hero__content {
      container-type: inline-size;
    }

    /*
     * The hero size follows the copy column: "Your car already has the screen." is about
     * 13.5 times the font size wide, so 7.2cqi keeps it on one line at every desktop width
     * (about 44px at 1440, 36px at 990). A longer line 1 wraps. 4.4vw is the fallback.
     */
    .mg-hero .mg-hero__title {
      font-size: min(var(--mg-fs-hero), 4.4vw);
      font-size: max(2.25rem, min(var(--mg-fs-hero), 7.2cqi));
    }

    .mg-hero__media {
      order: 0;
    }

    .mg-hero__img {
      aspect-ratio: 16 / 11;
    }

    .mg-hero__img--fallback {
      object-position: 52% 45%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG hero",
  "tag": "section",
  "class": "mg-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Your car already has the screen."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "info": "Shown on its own line in italic. Keep it short, two or three words.",
      "default": "Add CarPlay."
    },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "Use heading as the page's main title (H1)",
      "info": "Each page should have exactly one H1. On the home page keep this on: the header's hidden H1 (the shop name) is then hidden for everyone, so the page still has one H1.",
      "default": true
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Text under the heading",
      "info": "One short sentence, 20 words or fewer.",
      "default": "Wireless CarPlay and Android Auto on your factory screen, fitted at our Dublin 12 workshop."
    },
    {
      "type": "header",
      "content": "Reg lookup"
    },
    {
      "type": "paragraph",
      "content": "Visitors type their reg and go to the quote page with it filled in (for example /pages/get-a-quote?reg=241-D-12345)."
    },
    {
      "type": "text",
      "id": "plate_label",
      "label": "Label above the plate",
      "info": "Leave blank to hide it visually. Screen readers still announce 'Your registration'.",
      "default": "Enter your reg"
    },
    {
      "type": "text",
      "id": "plate_placeholder",
      "label": "Example reg inside the plate",
      "default": "241-D-12345"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get a quote"
    },
    {
      "type": "url",
      "id": "quote_url",
      "label": "Quote page",
      "info": "Leave blank to use /pages/get-a-quote. The reg is sent as ?reg=."
    },
    {
      "type": "header",
      "content": "WhatsApp link"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp link",
      "info": "Uses the WhatsApp number in Theme settings > MG Car Audio: business details. Hidden when 'Show WhatsApp buttons' is off there.",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_text",
      "label": "Link text",
      "default": "Or WhatsApp us a photo of your dash",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp pre-filled message",
      "info": "Leave blank to use the message from Theme settings.",
      "default": "Hi MG Car Audio, here's a photo of my dash for a quote. My car is: ",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Leave blank to use MG's BMW CarPlay photo. Use a landscape photo at least 1600px wide and set a focal point on the screen. It is cropped to 16:9 on phones and 16:11 on desktop."
    }
  ],
  "presets": [
    {
      "name": "MG hero",
      "category": "MG Car Audio"
    }
  ]
}
{% endschema %}
