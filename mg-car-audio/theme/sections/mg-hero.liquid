{%- liquid
  assign is_above_fold = true
  if section.index > 2
    assign is_above_fold = false
  endif

  assign heading_tag = 'h2'
  if section.settings.heading_is_h1
    assign heading_tag = 'h1'
  endif

  assign line_1 = section.settings.heading_line_1 | strip
  assign line_2 = section.settings.heading_line_2 | strip

  assign quote_url = section.settings.quote_url | default: '/pages/get-a-quote'
  assign reg_id = 'MgHeroReg-' | append: section.id
  assign stage_id = 'MgHeroStage-' | append: section.id
  assign reg_label = section.settings.plate_label | strip | default: 'Your registration'
  assign button_label = section.settings.button_label | strip | default: 'Get a quote'

  assign wa_message = section.settings.whatsapp_message | default: settings.mg_whatsapp_message
  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_enabled and settings.mg_whatsapp_number != blank and section.settings.whatsapp_text != blank
    assign show_whatsapp = true
  endif

  if is_above_fold
    assign image_loading = 'eager'
    assign image_priority = 'high'
  else
    assign image_loading = 'lazy'
    assign image_priority = 'auto'
  endif

  # Slides: the first photo always shows; photos 2 and 3 join it when the crossfade is on
  assign slide_count = 1
  if section.settings.slideshow
    if section.settings.image_2 != blank or section.settings.fallback_2 != 'none'
      assign slide_count = slide_count | plus: 1
    endif
    if section.settings.image_3 != blank or section.settings.fallback_3 != 'none'
      assign slide_count = slide_count | plus: 1
    endif
  endif
  assign slide_seconds = section.settings.slide_seconds | default: 7
-%}

<div
  class="mg-section mg-section--top mg-hero mg-hero--slides-{{ slide_count }}"
  style="--mg-hero-slide: {{ slide_seconds }}s;"
  data-mg-pause-offscreen
  id="{{ stage_id }}"
>
  <div class="mg-hero__stage mg-surface-night mg-red-line">
    <div class="mg-hero__slides">
      {%- assign rendered = 0 -%}
      {%- for i in (1..3) -%}
        {%- liquid
          if i == 1
            assign slide_image = section.settings.image
            assign slide_fallback = section.settings.fallback_image | default: 'mg-img-hero-1'
          elsif i == 2
            unless section.settings.slideshow
              break
            endunless
            assign slide_image = section.settings.image_2
            assign slide_fallback = section.settings.fallback_2
          else
            assign slide_image = section.settings.image_3
            assign slide_fallback = section.settings.fallback_3
          endif

          if slide_image == blank and slide_fallback == 'none'
            continue
          endif
          assign rendered = rendered | plus: 1

          case slide_fallback
            when 'mg-img-hero-1'
              assign slide_pos = '62% 50%'
              assign slide_alt = 'Driving at night with the dashboard touchscreen lit up'
            when 'mg-img-hero-2'
              assign slide_pos = '55% 50%'
              assign slide_alt = 'Lit gauges and navigation screen on a night drive'
            when 'mg-img-hero-3'
              assign slide_pos = '50% 50%'
              assign slide_alt = 'Car cabin at night with blue ambient lighting'
            when 'mg-bmw-carplay-screen'
              assign slide_pos = '50% 35%'
              assign slide_alt = 'BMW widescreen showing Apple CarPlay, fitted by ' | append: settings.mg_business_name
            when 'mg-audi-carplay-screen'
              assign slide_pos = '50% 50%'
              assign slide_alt = 'Audi dashboard showing Apple CarPlay, fitted by ' | append: settings.mg_business_name
            else
              assign slide_pos = '50% 50%'
              assign slide_alt = 'Car dashboard with Android Auto, fitted by ' | append: settings.mg_business_name
          endcase

          assign slide_loading = image_loading
          assign slide_priority = image_priority
          if rendered > 1
            assign slide_loading = 'lazy'
            assign slide_priority = 'low'
            assign slide_alt = ''
          endif
        -%}
        <div
          class="mg-hero__slide"
          {% if rendered > 1 %}
            aria-hidden="true"
          {% endif %}
        >
          {%- if slide_image != blank -%}
            {%- liquid
              assign focal_style = 'object-position: ' | append: slide_image.presentation.focal_point
              if rendered == 1
                assign slide_alt = slide_image.alt | default: slide_alt
              endif
            -%}
            {{
              slide_image
              | image_url: width: 2400
              | image_tag:
                widths: '600, 800, 1000, 1300, 1600, 2000, 2400',
                sizes: '100vw',
                loading: slide_loading,
                fetchpriority: slide_priority,
                alt: slide_alt,
                style: focal_style,
                class: 'mg-hero__img'
            }}
          {%- else -%}
            {%- assign pos_style = 'object-position: ' | append: slide_pos -%}
            {%- render 'mg-asset-image',
              asset: slide_fallback,
              sizes: '100vw',
              loading: slide_loading,
              priority: slide_priority,
              alt: slide_alt,
              class: 'mg-hero__img',
              style: pos_style
            -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="mg-container mg-hero__inner">
      <div class="mg-hero__content">
        {%- if line_1 != blank or line_2 != blank -%}
          <{{ heading_tag }} class="mg-display mg-display--hero mg-hero__title">
            {%- if line_1 != blank -%}
              <span
                class="mg-hero__line mg-load-rise"
                style="--mg-load-delay: 80ms;"
                >{{ line_1 | escape }}</span
              >
            {%- endif -%}
            {%- if line_1 != blank and line_2 != blank %} {% endif -%}
            {%- if line_2 != blank -%}
              <em
                class="mg-hero__line mg-hero__accent mg-load-rise"
                style="--mg-load-delay: 180ms;"
                >{{ line_2 | escape }}</em
              >
            {%- endif -%}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.lede != blank -%}
          <p
            class="mg-lede mg-hero__lede mg-load-rise"
            style="--mg-load-delay: 280ms;"
          >
            {{ section.settings.lede | escape }}
          </p>
        {%- endif -%}

        <form
          class="mg-hero__form mg-load-rise"
          style="--mg-load-delay: 380ms;"
          action="{{ quote_url }}"
          method="get"
        >
          <label
            class="mg-label mg-hero__label{% if section.settings.plate_label == blank %} mg-visually-hidden{% endif %}"
            for="{{ reg_id }}"
          >
            {{- reg_label | escape -}}
          </label>
          <div class="mg-plate-group">
            <div class="mg-plate">
              <span
                class="mg-plate__band"
                aria-hidden="true"
                >IRL</span
              >
              <input
                class="mg-plate__input"
                id="{{ reg_id }}"
                name="reg"
                type="text"
                placeholder="{{ section.settings.plate_placeholder | escape }}"
                autocomplete="off"
                autocapitalize="characters"
                autocorrect="off"
                spellcheck="false"
                enterkeyhint="go"
                maxlength="12"
              >
            </div>
            <button
              class="mg-btn mg-btn--primary mg-btn--lg"
              type="submit"
            >
              {{ button_label | escape }}
            </button>
          </div>
        </form>

        {%- if show_whatsapp -%}
          <a
            class="mg-link mg-hero__whatsapp mg-load-rise"
            style="--mg-load-delay: 460ms;"
            href="https://wa.me/{{ settings.mg_whatsapp_number }}?text={{ wa_message | url_encode }}"
            target="_blank"
            rel="noopener"
          >
            {%- render 'mg-icon', icon: 'whatsapp' -%}
            <span>{{ section.settings.whatsapp_text | escape }}</span>
            <span class="mg-visually-hidden"> (opens WhatsApp)</span>
          </a>
        {%- endif -%}
      </div>

      {%- if slide_count > 1 -%}
        <button
          class="mg-motion-toggle mg-hero__toggle"
          type="button"
          aria-controls="{{ stage_id }}"
          aria-pressed="false"
          aria-label="Pause background photos"
          data-mg-motion-toggle
          hidden
        >
          {%- render 'mg-icon', icon: 'pause' -%}
          {%- render 'mg-icon', icon: 'play' -%}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  /*
   * MG hero: a full-bleed night photo (or a slow crossfade of up to three) with a dark scrim,
   * the serif headline, the Irish plate input and the WhatsApp link on top, and a thin MG red
   * tail-light line along the bottom edge. Phones: copy at the bottom over the photo, sized so
   * the plate sits in the first screen at 390x844. From 990px: copy on the left.
   * Colours come from .mg-surface-night; motion keyframes live here and in mg-theme.css.
   */
  .mg-hero__stage {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(540px, calc(100svh - 196px), 700px);
    overflow: hidden;
  }

  .mg-hero__slides,
  .mg-hero__slide {
    position: absolute;
    inset: 0;
  }

  .mg-hero__slides {
    z-index: -1;
    overflow: hidden;
  }

  /* Photos 2 and 3 stay hidden unless the crossfade runs (no motion: the first photo only) */
  .mg-hero__slide + .mg-hero__slide {
    opacity: 0;
  }

  .mg-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Scrim: dark at the bottom where the copy sits, a little shade under the header */
  .mg-hero__slides::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(var(--mg-night-rgb) / 0.96) 0%, rgb(var(--mg-night-rgb) / 0.86) 38%, rgb(var(--mg-night-rgb) / 0.3) 70%, rgb(var(--mg-night-rgb) / 0.45) 100%);
  }

  .mg-hero__inner {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding-block: var(--mg-space-7) var(--mg-space-6);
  }

  .mg-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
  }

  /* Each heading setting starts its own line; line 2 is the italic <em> */
  .mg-hero__line {
    display: block;
  }

  .mg-hero .mg-hero__title {
    text-wrap: balance;
    text-shadow: 0 2px 24px rgb(var(--mg-night-rgb) / 0.5);
  }

  .mg-hero .mg-hero__accent {
    color: var(--mg-red-ink);
  }

  .mg-hero .mg-hero__lede {
    max-width: 44ch;
    text-wrap: balance;
  }

  .mg-hero__form {
    display: grid;
    gap: var(--mg-space-2);
    align-self: stretch;
    max-width: 520px;
    margin-top: var(--mg-space-5);
  }

  .mg-hero .mg-hero__label {
    color: var(--mg-ink-2);
  }

  /* Phones: the plate gets the full width, so the whole example reg shows; the button sits below */
  @media screen and (max-width: 749px) {
    .mg-hero .mg-plate-group > .mg-plate {
      flex-basis: 100%;
    }
  }

  .mg-hero__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--mg-space-2);
    min-height: var(--mg-tap);
    margin-top: var(--mg-space-2);
    border-radius: var(--mg-radius-xs);
    font-size: var(--mg-fs-small);
  }

  .mg-hero__whatsapp .mg-icon {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--mg-whatsapp);
  }

  /*
   * A flex container does not pass its underline on to its items, and Horizon's base.css
   * makes link underlines transparent: draw the .mg-link underline on the text itself.
   */
  .mg-hero__whatsapp > span {
    text-decoration: inherit;
    text-decoration-color: currentcolor;
  }

  .mg-hero__toggle {
    position: absolute;
    inset-block-start: var(--mg-space-4);
    inset-inline-end: max(var(--mg-gutter), env(safe-area-inset-right, 0px));
    background-color: rgb(var(--mg-night-rgb) / 0.4);
  }

  /* Small phones: a slightly smaller headline keeps the plate in the first screen */
  @media screen and (max-width: 374px) {
    .mg-hero .mg-hero__title {
      font-size: 2rem;
    }

    .mg-hero__inner {
      padding-block-end: var(--mg-space-5);
    }
  }

  @media screen and (min-width: 750px) {
    .mg-hero__stage {
      min-height: clamp(560px, calc(100svh - 200px), 720px);
    }

    .mg-hero__inner {
      padding-block: var(--mg-space-8);
    }

    .mg-hero__content {
      max-width: 600px;
    }

    .mg-hero__toggle {
      inset-block-start: auto;
      inset-block-end: var(--mg-space-5);
    }
  }

  @media screen and (min-width: 990px) {
    .mg-hero__inner {
      align-items: center;
    }

    /* Scrim: from the left under the copy, plus a soft floor */
    .mg-hero__slides::after {
      background:
        linear-gradient(to right, rgb(var(--mg-night-rgb) / 0.94) 0%, rgb(var(--mg-night-rgb) / 0.78) 30%, rgb(var(--mg-night-rgb) / 0.18) 62%, rgb(var(--mg-night-rgb) / 0) 100%),
        linear-gradient(to top, rgb(var(--mg-night-rgb) / 0.6) 0%, rgb(var(--mg-night-rgb) / 0) 40%);
    }

    .mg-hero__content {
      max-width: 620px;
    }
  }

  /* Motion: a slow settle on the photo, and the crossfade with a gentle Ken Burns zoom */
  @keyframes mg-hero-settle {
    from {
      transform: scale(1.08);
    }

    to {
      transform: scale(1);
    }
  }

  @keyframes mg-hero-zoom {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.08);
    }
  }

  @keyframes mg-hero-fade-2 {
    0%,
    50% {
      opacity: 0;
    }

    60%,
    92% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes mg-hero-fade-3 {
    0%,
    33.3% {
      opacity: 0;
    }

    40%,
    66.7% {
      opacity: 1;
    }

    73.3%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mg-hero--slides-1 .mg-hero__img {
      animation: mg-hero-settle 9s var(--mg-ease-out) both;
    }

    .mg-hero--slides-2 .mg-hero__img,
    .mg-hero--slides-3 .mg-hero__img {
      animation: mg-hero-zoom calc(var(--mg-hero-slide) * 2) ease-in-out infinite alternate both;
    }

    .mg-hero--slides-2 .mg-hero__slide:nth-child(2) {
      animation: mg-hero-fade-2 calc(var(--mg-hero-slide) * 2) linear infinite both;
    }

    .mg-hero--slides-3 .mg-hero__slide:nth-child(n + 2) {
      animation: mg-hero-fade-3 calc(var(--mg-hero-slide) * 3) linear infinite both;
    }

    .mg-hero--slides-3 .mg-hero__slide:nth-child(3) {
      animation-delay: var(--mg-hero-slide);
    }

    /* Pause on hover, while the form or a link has focus, offscreen, or when paused by the button */
    .mg-hero:is(:hover, :focus-within, [data-mg-offscreen], [data-mg-user-paused]) :is(.mg-hero__slide, .mg-hero__img) {
      animation-play-state: paused;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG hero",
  "tag": "section",
  "class": "mg-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Your car already has the screen."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "info": "Shown on its own line in red italic. Keep it short, two or three words.",
      "default": "Add CarPlay."
    },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "Use heading as the page's main title (H1)",
      "info": "Each page should have exactly one H1. On the home page keep this on: the header's hidden H1 (the shop name) is then hidden for everyone, so the page still has one H1.",
      "default": true
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Text under the heading",
      "info": "One short sentence, 20 words or fewer.",
      "default": "Wireless CarPlay and Android Auto on your factory screen, fitted at our Dublin 12 workshop."
    },
    {
      "type": "header",
      "content": "Reg lookup"
    },
    {
      "type": "paragraph",
      "content": "Visitors type their reg and go to the quote page with it filled in (for example /pages/get-a-quote?reg=241-D-12345)."
    },
    {
      "type": "text",
      "id": "plate_label",
      "label": "Label above the plate",
      "info": "Leave blank to hide it visually. Screen readers still announce 'Your registration'.",
      "default": "Enter your reg"
    },
    {
      "type": "text",
      "id": "plate_placeholder",
      "label": "Example reg inside the plate",
      "default": "241-D-12345"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get a quote"
    },
    {
      "type": "url",
      "id": "quote_url",
      "label": "Quote page",
      "info": "Leave blank to use /pages/get-a-quote. The reg is sent as ?reg=."
    },
    {
      "type": "header",
      "content": "WhatsApp link"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp link",
      "info": "Uses the WhatsApp number in Theme settings > MG Car Audio: business details. Hidden when 'Show WhatsApp buttons' is off there.",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_text",
      "label": "Link text",
      "default": "Or WhatsApp us a photo of your dash",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp pre-filled message",
      "info": "Leave blank to use the message from Theme settings.",
      "default": "Hi MG Car Audio, here's a photo of my dash for a quote. My car is: ",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "paragraph",
      "content": "The photo fills the hero behind a dark shade, so the text stays readable. Use a dark, landscape photo at least 2000px wide and set its focal point. The theme's stock photos are mood shots, not MG's own work."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Photo to use until one is uploaded",
      "options": [
        { "value": "mg-img-hero-1", "label": "Night drive with dash screen (stock)" },
        { "value": "mg-img-hero-2", "label": "Night dashboard and city lights (stock)" },
        { "value": "mg-img-hero-3", "label": "Cabin with blue ambient light (stock)" },
        { "value": "mg-bmw-carplay-screen", "label": "BMW CarPlay screen (MG photo)" },
        { "value": "mg-audi-carplay-screen", "label": "Audi CarPlay with iPhone (MG photo)" },
        { "value": "mg-android-auto-dash", "label": "Android Auto dash (MG photo)" }
      ],
      "default": "mg-img-hero-1"
    },
    {
      "type": "header",
      "content": "Crossfade"
    },
    {
      "type": "checkbox",
      "id": "slideshow",
      "label": "Crossfade between up to 3 photos",
      "info": "A slow fade with a gentle zoom. It pauses on hover, while someone types their reg, when the hero is off screen and with its pause button. Visitors who turn off motion see the first photo only.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Photo 2",
      "visible_if": "{{ section.settings.slideshow }}"
    },
    {
      "type": "select",
      "id": "fallback_2",
      "label": "Photo 2 until one is uploaded",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "mg-img-hero-1", "label": "Night drive with dash screen (stock)" },
        { "value": "mg-img-hero-2", "label": "Night dashboard and city lights (stock)" },
        { "value": "mg-img-hero-3", "label": "Cabin with blue ambient light (stock)" },
        { "value": "mg-bmw-carplay-screen", "label": "BMW CarPlay screen (MG photo)" },
        { "value": "mg-audi-carplay-screen", "label": "Audi CarPlay with iPhone (MG photo)" },
        { "value": "mg-android-auto-dash", "label": "Android Auto dash (MG photo)" }
      ],
      "default": "mg-img-hero-2",
      "visible_if": "{{ section.settings.slideshow }}"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Photo 3",
      "visible_if": "{{ section.settings.slideshow }}"
    },
    {
      "type": "select",
      "id": "fallback_3",
      "label": "Photo 3 until one is uploaded",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "mg-img-hero-1", "label": "Night drive with dash screen (stock)" },
        { "value": "mg-img-hero-2", "label": "Night dashboard and city lights (stock)" },
        { "value": "mg-img-hero-3", "label": "Cabin with blue ambient light (stock)" },
        { "value": "mg-bmw-carplay-screen", "label": "BMW CarPlay screen (MG photo)" },
        { "value": "mg-audi-carplay-screen", "label": "Audi CarPlay with iPhone (MG photo)" },
        { "value": "mg-android-auto-dash", "label": "Android Auto dash (MG photo)" }
      ],
      "default": "mg-img-hero-3",
      "visible_if": "{{ section.settings.slideshow }}"
    },
    {
      "type": "range",
      "id": "slide_seconds",
      "label": "Seconds per photo",
      "min": 5,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 7,
      "visible_if": "{{ section.settings.slideshow }}"
    }
  ],
  "presets": [
    {
      "name": "MG hero",
      "category": "MG Car Audio"
    }
  ]
}
{% endschema %}
