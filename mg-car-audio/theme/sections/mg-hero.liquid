{%- liquid
  assign is_above_fold = true
  if section.index > 2
    assign is_above_fold = false
  endif

  assign heading_tag = 'h2'
  if section.settings.heading_is_h1
    assign heading_tag = 'h1'
  endif

  assign line_1 = section.settings.heading_line_1 | strip
  assign line_2 = section.settings.heading_line_2 | strip
  assign stage_id = 'MgHeroStage-' | append: section.id

  assign primary_label = section.settings.primary_label | strip
  assign primary_url = section.settings.primary_url | default: '/collections/carplay-android-auto'
  assign secondary_label = section.settings.secondary_label | strip
  assign secondary_url = section.settings.secondary_url | default: '/pages/book-a-fitting'

  assign wa_message = section.settings.whatsapp_message | default: settings.mg_whatsapp_message
  assign show_whatsapp = false
  if section.settings.show_whatsapp and settings.mg_whatsapp_enabled and settings.mg_whatsapp_number != blank and section.settings.whatsapp_text != blank
    assign show_whatsapp = true
  endif

  assign promo_title = section.settings.promo_title | strip
  assign promo_price = section.settings.promo_price | strip
  assign promo_note = section.settings.promo_note | strip
  assign promo_url = section.settings.promo_url | default: '/products/carplay-installation-bmw'
  assign show_promo = false
  if section.settings.show_promo and promo_price != blank
    assign show_promo = true
  endif

  if is_above_fold
    assign image_loading = 'eager'
    assign image_priority = 'high'
  else
    assign image_loading = 'lazy'
    assign image_priority = 'auto'
  endif

  # Slides: the first photo always shows; photos 2 and 3 join it when the crossfade is on
  assign slide_count = 1
  if section.settings.slideshow
    if section.settings.image_2 != blank or section.settings.fallback_2 != 'none'
      assign slide_count = slide_count | plus: 1
    endif
    if section.settings.image_3 != blank or section.settings.fallback_3 != 'none'
      assign slide_count = slide_count | plus: 1
    endif
  endif
  assign slide_seconds = section.settings.slide_seconds | default: 7
-%}

<div
  class="mg-section mg-section--top mg-hero mg-hero--slides-{{ slide_count }}"
  style="--mg-hero-slide: {{ slide_seconds }}s;"
  data-mg-pause-offscreen
  id="{{ stage_id }}"
>
  <div class="mg-hero__stage mg-surface-night mg-red-line">
    <div class="mg-hero__media">
      <div class="mg-hero__slides">
        {%- assign rendered = 0 -%}
        {%- for i in (1..3) -%}
          {%- liquid
            if i == 1
              assign slide_image = section.settings.image
              assign slide_fallback = section.settings.fallback_image | default: 'mg-img-hero-1'
            elsif i == 2
              unless section.settings.slideshow
                break
              endunless
              assign slide_image = section.settings.image_2
              assign slide_fallback = section.settings.fallback_2
            else
              assign slide_image = section.settings.image_3
              assign slide_fallback = section.settings.fallback_3
            endif

            if slide_image == blank and slide_fallback == 'none'
              continue
            endif
            assign rendered = rendered | plus: 1

            # --mg-pos: desktop crop (wide panel on the right); --mg-pos-m: phone band (16:10).
            # Both keep the glowing screen in frame.
            case slide_fallback
              when 'mg-img-hero-1'
                assign slide_pos = '--mg-pos: 58% 55%; --mg-pos-m: 56% 58%;'
                assign slide_alt = 'Apple CarPlay music screen glowing in a dark dashboard'
              when 'mg-img-hero-2'
                assign slide_pos = '--mg-pos: 50% 62%; --mg-pos-m: 50% 66%;'
                assign slide_alt = 'Widescreen dash display with CarPlay under a starry night sky'
              when 'mg-img-hero-3'
                assign slide_pos = '--mg-pos: 64% 78%; --mg-pos-m: 66% 86%;'
                assign slide_alt = 'Large touchscreen head unit glowing in a car at night'
              when 'mg-bmw-carplay-screen'
                assign slide_pos = '--mg-pos: 50% 40%; --mg-pos-m: 50% 40%;'
                assign slide_alt = 'BMW widescreen showing Apple CarPlay, fitted by ' | append: settings.mg_business_name
              when 'mg-audi-carplay-screen'
                assign slide_pos = '--mg-pos: 50% 50%; --mg-pos-m: 50% 50%;'
                assign slide_alt = 'Audi dashboard showing Apple CarPlay, fitted by ' | append: settings.mg_business_name
              else
                assign slide_pos = '--mg-pos: 50% 50%; --mg-pos-m: 50% 50%;'
                assign slide_alt = 'Car dashboard with Android Auto, fitted by ' | append: settings.mg_business_name
            endcase

            assign slide_loading = image_loading
            assign slide_priority = image_priority
            if rendered > 1
              assign slide_loading = 'lazy'
              assign slide_priority = 'low'
              assign slide_alt = ''
            endif
          -%}
          <div
            class="mg-hero__slide"
            {% if rendered > 1 %}
              aria-hidden="true"
            {% endif %}
          >
            {%- if slide_image != blank -%}
              {%- liquid
                assign focal = slide_image.presentation.focal_point | default: '50% 50%'
                assign focal_style = '--mg-pos: ' | append: focal | append: '; --mg-pos-m: ' | append: focal | append: ';'
                if rendered == 1
                  assign slide_alt = slide_image.alt | default: slide_alt
                endif
              -%}
              {{
                slide_image
                | image_url: width: 2400
                | image_tag:
                  widths: '600, 800, 1000, 1300, 1600, 2000, 2400',
                  sizes: '(min-width: 990px) 64vw, 100vw',
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  alt: slide_alt,
                  style: focal_style,
                  class: 'mg-hero__img'
              }}
            {%- else -%}
              {%- render 'mg-asset-image',
                asset: slide_fallback,
                sizes: '(min-width: 990px) 64vw, 100vw',
                loading: slide_loading,
                priority: slide_priority,
                alt: slide_alt,
                class: 'mg-hero__img',
                style: slide_pos
              -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if show_promo -%}
        <a
          class="mg-hero__promo"
          href="{{ promo_url }}"
        >
          {%- if promo_title != blank -%}
            <span class="mg-hero__promo-title">{{ promo_title | escape }}</span>
          {%- endif -%}
          <span class="mg-hero__promo-price">{{ promo_price | escape }}</span>
          {%- if promo_note != blank -%}
            <span class="mg-hero__promo-note">{{ promo_note | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- if slide_count > 1 -%}
        <button
          class="mg-motion-toggle mg-hero__toggle"
          type="button"
          aria-controls="{{ stage_id }}"
          aria-pressed="false"
          aria-label="Pause background photos"
          data-mg-motion-toggle
          hidden
        >
          {%- render 'mg-icon', icon: 'pause' -%}
          {%- render 'mg-icon', icon: 'play' -%}
        </button>
      {%- endif -%}
    </div>

    <div class="mg-container mg-hero__inner">
      <div class="mg-hero__content">
        {%- if line_1 != blank or line_2 != blank -%}
          <{{ heading_tag }} class="mg-hero__title">
            {%- if line_1 != blank -%}
              <span
                class="mg-hero__line mg-load-rise"
                style="--mg-load-delay: 80ms;"
                >{{ line_1 | escape }}</span
              >
            {%- endif -%}
            {%- if line_1 != blank and line_2 != blank %} {% endif -%}
            {%- if line_2 != blank -%}
              <span
                class="mg-hero__line mg-hero__accent mg-load-rise"
                style="--mg-load-delay: 180ms;"
                >{{ line_2 | escape }}</span
              >
            {%- endif -%}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.lede != blank -%}
          <p
            class="mg-lede mg-hero__lede mg-load-rise"
            style="--mg-load-delay: 280ms;"
          >
            {{ section.settings.lede | escape }}
          </p>
        {%- endif -%}

        {%- if primary_label != blank or secondary_label != blank -%}
          <div
            class="mg-hero__actions mg-load-rise"
            style="--mg-load-delay: 380ms;"
          >
            {%- if primary_label != blank -%}
              <a
                class="mg-btn mg-btn--primary mg-btn--lg mg-hero__btn"
                href="{{ primary_url }}"
              >
                {{- primary_label | escape -}}
              </a>
            {%- endif -%}
            {%- if secondary_label != blank -%}
              <a
                class="mg-btn mg-btn--secondary mg-btn--lg mg-hero__btn"
                href="{{ secondary_url }}"
              >
                {%- render 'mg-icon', icon: 'calendar' -%}
                <span>{{ secondary_label | escape }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_whatsapp -%}
          <a
            class="mg-link mg-hero__whatsapp mg-load-rise"
            style="--mg-load-delay: 460ms;"
            href="https://wa.me/{{ settings.mg_whatsapp_number }}?text={{ wa_message | url_encode }}"
            target="_blank"
            rel="noopener"
          >
            {%- render 'mg-icon', icon: 'whatsapp' -%}
            <span>{{ section.settings.whatsapp_text | escape }}</span>
            <span class="mg-visually-hidden"> (opens WhatsApp)</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /*
   * MG hero: one headline, one line of copy, two actions (shop, book) and a WhatsApp link,
   * beside a big product-in-action photo (or a slow crossfade of up to three). Phones and
   * tablets: the photo is a clean band on top with the screen fully in view, the copy below.
   * From 990px: the copy on the left of the night surface, the photo filling the right 64% and
   * fading into it. An optional round promo sticker sits on the photo. Colours come from
   * .mg-surface-night; the red accent line is MG red, 3:1 or better as large text on night.
   */
  .mg-hero__stage {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .mg-hero__media {
    position: relative;
    z-index: 0;
    aspect-ratio: 16 / 10;
    width: 100%;
  }

  .mg-hero__slides,
  .mg-hero__slide {
    position: absolute;
    inset: 0;
  }

  .mg-hero__slides {
    overflow: hidden;
  }

  /* Photos 2 and 3 stay hidden unless the crossfade runs (no motion: the first photo only) */
  .mg-hero__slide + .mg-hero__slide {
    opacity: 0;
  }

  .mg-hero .mg-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--mg-pos-m, 50% 50%);
  }

  /* A short fade where the photo meets the copy, and a little shade under the header */
  .mg-hero__slides::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--mg-night) 0%, rgb(var(--mg-night-rgb) / 0) 24%),
      linear-gradient(to bottom, rgb(var(--mg-night-rgb) / 0.35) 0%, rgb(var(--mg-night-rgb) / 0) 22%);
    pointer-events: none;
  }

  .mg-hero__inner {
    position: relative;
    padding-block: var(--mg-space-3) var(--mg-space-6);
  }

  .mg-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .mg-hero .mg-hero__title {
    margin: 0;
    font-family: var(--mg-font-ui);
    font-size: clamp(2rem, 8.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--mg-ink);
    text-wrap: balance;
  }

  /* Each heading setting starts its own line; line 2 is the MG red accent */
  .mg-hero__line {
    display: block;
  }

  .mg-hero .mg-hero__accent {
    color: var(--mg-red);
  }

  .mg-hero .mg-hero__lede {
    max-width: 44ch;
    margin-block-start: var(--mg-space-3);
    text-wrap: pretty;
  }

  .mg-hero__actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--mg-space-3);
    align-self: stretch;
    margin-block-start: var(--mg-space-5);
  }

  .mg-hero .mg-hero__btn {
    white-space: nowrap;
  }

  .mg-hero__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--mg-space-2);
    min-height: var(--mg-tap);
    margin-block-start: var(--mg-space-2);
    border-radius: var(--mg-radius-xs);
    font-size: var(--mg-fs-small);
  }

  .mg-hero__whatsapp .mg-icon {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--mg-whatsapp);
  }

  /* Horizon's base.css makes link underlines transparent: draw the .mg-link underline on the text */
  .mg-hero__whatsapp > span {
    text-decoration: inherit;
    text-decoration-color: currentcolor;
  }

  /* Promo sticker: one round MG red badge on the photo, slightly turned */
  .mg-hero__promo {
    position: absolute;
    inset-block-start: var(--mg-space-3);
    inset-inline-end: max(var(--mg-gutter), env(safe-area-inset-right, 0px));
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 92px;
    aspect-ratio: 1;
    padding: var(--mg-space-2);
    border-radius: var(--mg-radius-pill);
    background-color: var(--mg-red);
    box-shadow: 0 10px 28px -10px rgb(var(--mg-night-rgb) / 0.8), inset 0 0 0 3px rgb(255 255 255 / 0.18);
    color: var(--mg-on-red);
    text-align: center;
    text-decoration: none;
    transform: rotate(-8deg);
    transition: transform var(--mg-dur) var(--mg-ease), background-color var(--mg-dur) var(--mg-ease);
  }

  .mg-hero__promo-title,
  .mg-hero__promo-note {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mg-hero__promo-price {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) {
    .mg-hero__promo:hover {
      background-color: var(--mg-red-deep);
      transform: rotate(-4deg) scale(1.04);
    }
  }

  .mg-hero__promo:focus-visible {
    outline: 2px solid var(--mg-white);
    outline-offset: 3px;
  }

  .mg-hero__toggle {
    position: absolute;
    inset-block-end: var(--mg-space-4);
    inset-inline-start: max(var(--mg-gutter), env(safe-area-inset-left, 0px));
    z-index: 1;
    background-color: rgb(var(--mg-night-rgb) / 0.45);
  }

  /* Small phones: a little smaller, so both buttons stay in the first screen */
  @media screen and (max-width: 374px) {
    .mg-hero .mg-hero__title {
      font-size: 1.875rem;
    }

    .mg-hero__promo {
      width: 80px;
    }

    .mg-hero__promo-price {
      font-size: 1.25rem;
    }
  }

  /* Tablet: still stacked, a wider band, the buttons side by side */
  @media screen and (min-width: 750px) {
    .mg-hero__media {
      aspect-ratio: 21 / 9;
    }

    .mg-hero__inner {
      padding-block: var(--mg-space-4) var(--mg-space-7);
    }

    .mg-hero__content {
      max-width: 640px;
    }

    .mg-hero .mg-hero__title {
      font-size: 3rem;
    }

    .mg-hero__actions {
      display: flex;
      flex-wrap: wrap;
      align-self: flex-start;
    }

    .mg-hero__promo {
      inset-block-start: var(--mg-space-5);
      width: 112px;
    }

    .mg-hero__promo-title,
    .mg-hero__promo-note {
      font-size: 0.75rem;
    }

    .mg-hero__promo-price {
      font-size: 1.875rem;
    }
  }

  /* Desktop: copy on the left, the photo fills the right and fades into the night surface */
  @media screen and (min-width: 990px) {
    .mg-hero__stage {
      justify-content: center;
      min-height: clamp(560px, calc(100svh - 150px), 720px);
    }

    .mg-hero__media {
      position: absolute;
      inset: 0 0 0 auto;
      width: 62%;
      aspect-ratio: auto;
    }

    .mg-hero .mg-hero__img {
      object-position: var(--mg-pos, 50% 50%);
    }

    .mg-hero__slides::after {
      background:
        linear-gradient(to right, var(--mg-night) 0%, rgb(var(--mg-night-rgb) / 0.7) 14%, rgb(var(--mg-night-rgb) / 0) 42%),
        linear-gradient(to top, rgb(var(--mg-night-rgb) / 0.5) 0%, rgb(var(--mg-night-rgb) / 0) 30%);
    }

    .mg-hero__inner {
      width: 100%;
      padding-block: var(--mg-space-8);
    }

    .mg-hero__content {
      max-width: min(600px, 46%);
    }

    .mg-hero .mg-hero__title {
      font-size: clamp(3rem, 4.2vw, 3.75rem);
      letter-spacing: -0.03em;
    }

    .mg-hero .mg-hero__lede {
      margin-block-start: var(--mg-space-4);
    }

    .mg-hero__actions {
      margin-block-start: var(--mg-space-6);
    }

    /* Top right, clear of the screens (they sit low in the photos) and under the pause button */
    .mg-hero__promo {
      inset-block-start: var(--mg-space-9);
      inset-inline-end: var(--mg-space-7);
      width: 128px;
    }

    .mg-hero__promo-price {
      font-size: 2.125rem;
    }

    .mg-hero__toggle {
      inset-inline-start: auto;
      inset-inline-end: var(--mg-space-5);
      inset-block-end: auto;
      inset-block-start: var(--mg-space-5);
    }
  }

  /* Motion: a slow settle on the photo, and the crossfade with a gentle Ken Burns zoom */
  @keyframes mg-hero-settle {
    from {
      transform: scale(1.08);
    }

    to {
      transform: scale(1);
    }
  }

  @keyframes mg-hero-zoom {
    from {
      transform: scale(1);
    }

    to {
      transform: scale(1.06);
    }
  }

  @keyframes mg-hero-fade-2 {
    0%,
    50% {
      opacity: 0;
    }

    60%,
    92% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes mg-hero-fade-3 {
    0%,
    33.3% {
      opacity: 0;
    }

    40%,
    66.7% {
      opacity: 1;
    }

    73.3%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mg-hero--slides-1 .mg-hero__img {
      animation: mg-hero-settle 9s var(--mg-ease-out) both;
    }

    .mg-hero--slides-2 .mg-hero__img,
    .mg-hero--slides-3 .mg-hero__img {
      animation: mg-hero-zoom calc(var(--mg-hero-slide) * 2) ease-in-out infinite alternate both;
    }

    .mg-hero--slides-2 .mg-hero__slide:nth-child(2) {
      animation: mg-hero-fade-2 calc(var(--mg-hero-slide) * 2) linear infinite both;
    }

    .mg-hero--slides-3 .mg-hero__slide:nth-child(n + 2) {
      animation: mg-hero-fade-3 calc(var(--mg-hero-slide) * 3) linear infinite both;
    }

    .mg-hero--slides-3 .mg-hero__slide:nth-child(3) {
      animation-delay: var(--mg-hero-slide);
    }

    /* Pause on hover, while a link has focus, offscreen, or when paused by the button */
    .mg-hero:is(:hover, :focus-within, [data-mg-offscreen], [data-mg-user-paused]) :is(.mg-hero__slide, .mg-hero__img) {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mg-hero__promo {
      transition: none;
    }

    .mg-hero__promo:hover {
      transform: rotate(-8deg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG hero",
  "tag": "section",
  "class": "mg-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Your car already has the screen."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "info": "Shown on its own line in MG red. Keep it short, two or three words.",
      "default": "Add CarPlay."
    },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "Use heading as the page's main title (H1)",
      "info": "Each page should have exactly one H1. On the home page keep this on: the header's hidden H1 (the shop name) is then hidden for everyone, so the page still has one H1.",
      "default": true
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Text under the heading",
      "info": "One short sentence, 20 words or fewer.",
      "default": "Wireless CarPlay and Android Auto on your factory screen, fitted at our Dublin 12 workshop."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Main button",
      "info": "Leave blank to hide it.",
      "default": "Shop CarPlay & radios"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Main button link",
      "info": "Leave blank to use /collections/carplay-android-auto."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second button",
      "info": "Leave blank to hide it.",
      "default": "Book a fitting"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Second button link",
      "info": "Leave blank to use /pages/book-a-fitting."
    },
    {
      "type": "header",
      "content": "WhatsApp link"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp link",
      "info": "Uses the WhatsApp number in Theme settings > MG Car Audio: business details. Hidden when 'Show WhatsApp buttons' is off there.",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_text",
      "label": "Link text",
      "default": "Or WhatsApp us a photo of your dash",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "WhatsApp pre-filled message",
      "info": "Leave blank to use the message from Theme settings.",
      "default": "Hi MG Car Audio, here's a photo of my dash for a quote. My car is: ",
      "visible_if": "{{ section.settings.show_whatsapp }}"
    },
    {
      "type": "header",
      "content": "Promo sticker"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show a promo sticker on the photo",
      "info": "One round MG red sticker for a real offer or headline price. Hidden when the price is blank.",
      "default": true
    },
