{%- liquid
  assign heading = section.settings.heading | strip
  assign heading_id = 'MgReviewsHeading-' | append: section.id
  assign background = section.settings.background | default: 'photo'
  assign section_classes = 'mg-section mg-reviews mg-reviews--' | append: background
  if background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--band'
  elsif background == 'photo'
    assign section_classes = section_classes | append: ' mg-section--band mg-surface-night mg-red-line'
  endif

  assign rating_text = settings.mg_review_rating | strip
  assign rating_value = rating_text | replace: ',', '.' | plus: 0 | at_least: 0 | at_most: 5
  assign review_count = settings.mg_review_count | strip
  assign review_url = settings.mg_review_url
  assign link_label = section.settings.reviews_link_label | strip

  assign show_summary = false
  if section.settings.show_rating and rating_value > 0
    assign show_summary = true
  endif
  assign show_sample = section.settings.show_placeholder_note
-%}

{%- render 'mg-carousel-script' -%}

<section
  class="{{ section_classes }}"
  {% if heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  {%- if background == 'photo' -%}
    <div
      class="mg-reviews__bg"
      aria-hidden="true"
    >
      {%- render 'mg-asset-image', asset: 'mg-img-bg-night-drive', sizes: '100vw', loading: 'lazy', alt: '' -%}
    </div>
  {%- endif -%}

  <div class="mg-container">
    <mg-carousel class="mg-carousel mg-carousel--bleed mg-reviews__carousel">
      <div class="mg-reviews__layout">
        <div
          class="mg-reviews__summary"
          data-mg-reveal
        >
          <div class="mg-head mg-head--caps mg-reviews__head">
            <div class="mg-head__text">
              {%- if heading != blank -%}
                <h2
                  id="{{ heading_id }}"
                  class="mg-head__title"
                >
                  {{ heading | escape }}
                </h2>
              {%- endif -%}
              {%- if section.settings.text != blank -%}
                <p class="mg-head__sub">{{ section.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>

          {%- if show_summary -%}
            <div class="mg-reviews__rating">
              <p class="mg-reviews__score">
                <span aria-hidden="true">{{ rating_text | escape }}</span>
                <span class="mg-visually-hidden">
                  Rated {{ rating_text | escape }} out of 5
                  {%- if review_count != blank %} from {{ review_count | escape }} Google reviews{% else %} on Google{% endif -%}
                </span>
              </p>
              <div
                class="mg-reviews__rating-text"
                aria-hidden="true"
              >
                <span
                  class="mg-stars mg-stars--lg"
                  style="--mg-rating: {{ rating_value }};"
                ></span>
                <span class="mg-reviews__count">
                  {%- if review_count != blank -%}
                    from {{ review_count | escape }} Google reviews
                  {%- else -%}
                    on Google
                  {%- endif -%}
                </span>
              </div>
            </div>
            {%- if review_url != blank and link_label != blank -%}
              <a
                class="mg-link mg-reviews__link"
                href="{{ review_url }}"
                target="_blank"
                rel="noopener"
              >
                {{- link_label | escape -}}
                <span class="mg-visually-hidden"> (opens in a new tab)</span>
              </a>
            {%- endif -%}
          {%- endif -%}

          {%- if section.blocks.size > 1 -%}
            <div class="mg-carousel__nav mg-carousel__nav--desktop mg-reviews__nav">
              <button
                class="mg-carousel__btn"
                type="button"
                data-mg-carousel-prev
                aria-label="Previous reviews"
              >
                {%- render 'mg-icon', icon: 'chevron-left' -%}
              </button>
              <button
                class="mg-carousel__btn"
                type="button"
                data-mg-carousel-next
                aria-label="Next reviews"
              >
                {%- render 'mg-icon', icon: 'chevron-right' -%}
              </button>
            </div>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <ul
            class="mg-carousel__track mg-reviews__track"
            data-mg-reveal-stagger
            role="list"
            tabindex="0"
            aria-label="Customer reviews"
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign bs = block.settings
                assign rating = bs.rating | default: 5

                # Name: first name and the initial of the last name ("Aoife Murphy" -> "Aoife M.")
                assign name_parts = bs.author | strip | split: ' '
                assign display_name = name_parts.first
                if name_parts.size > 1
                  assign last_initial = name_parts.last | slice: 0 | upcase
                  assign display_name = display_name | append: ' ' | append: last_initial | append: '.'
                endif
                assign initial = display_name | slice: 0 | upcase

                # One paragraph: the card clamps the quote
                assign quote = bs.text | newline_to_br | replace: '<br />', ' ' | strip_newlines | strip

                assign car = bs.car | strip
                assign job = bs.job | strip

                assign fallback_file = ''
                case bs.fallback
                  when 'bmw-carplay'
                    assign fallback_file = 'mg-bmw-carplay-screen'
                  when 'audi-carplay'
                    assign fallback_file = 'mg-audi-carplay-screen'
                  when 'android-auto'
                    assign fallback_file = 'mg-android-auto-dash'
                  when 'showroom'
                    assign fallback_file = 'mg-showroom'
                  when 'dash-radio'
                    assign fallback_file = 'mg-dash-radio'
                  when 'door-speaker'
                    assign fallback_file = 'mg-door-speaker'
                endcase

                assign photo_alt = 'Install photo'
                if car != blank
                  assign photo_alt = 'Install photo: ' | append: car
                endif
                if bs.image != blank and bs.image.alt != blank
                  assign photo_alt = bs.image.alt
                endif
              -%}
              <li
                class="mg-carousel__slide"
                {{ block.shopify_attributes }}
              >
                <figure class="mg-review">
                  {%- if bs.image != blank or fallback_file != blank -%}
                    <div class="mg-review__media">
                      {%- if bs.image != blank -%}
                        {{
                          bs.image
                          | image_url: width: 900
                          | image_tag:
                            widths: '400, 600, 900',
                            sizes: '(min-width: 990px) 280px, (min-width: 750px) 45vw, 85vw',
                            loading: 'lazy',
                            alt: photo_alt
                        }}
                      {%- else -%}
                        {%- render 'mg-asset-image', asset: fallback_file, sizes: '(min-width: 990px) 280px, (min-width: 750px) 45vw, 85vw', loading: 'lazy', alt: photo_alt -%}
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="mg-review__body">
                    <div class="mg-review__top">
                      {%- if initial != blank -%}
                        <span
                          class="mg-review__avatar"
                          aria-hidden="true"
                          >{{ initial | escape }}</span
                        >
                      {%- endif -%}
                      <span class="mg-review__who">
                        {%- if display_name != blank -%}
                          <span class="mg-review__name">{{ display_name | escape }}</span>
                        {%- endif -%}
                        <span class="mg-review__source">Google review</span>
                      </span>
                      {%- if show_sample -%}
                        <span class="mg-sample-tag">Sample review</span>
                      {%- endif -%}
                    </div>

                    <p class="mg-review__rating">
                      <span
                        class="mg-stars mg-stars--sm"
                        style="--mg-rating: {{ rating }};"
                        role="img"
                        aria-label="Rated {{ rating }} out of 5"
                      ></span>
                    </p>

                    {%- if quote != blank -%}
                      <blockquote class="mg-review__quote">
                        <p>{{ quote | escape }}</p>
                      </blockquote>
                    {%- endif -%}

                    {%- if car != blank or job != blank -%}
                      <figcaption class="mg-review__footer">
                        {%- render 'mg-icon', icon: 'car' -%}
                        <span class="mg-review__car-text">
                          {%- if car != blank -%}
                            <span class="mg-review__car"><span class="mg-visually-hidden">Car: </span>{{ car | escape }}</span>
                          {%- endif -%}
                          {%- if job != blank -%}
                            <span class="mg-review__job"><span class="mg-visually-hidden">Job: </span>{{ job | escape }}</span>
                          {%- endif -%}
                        </span>
                      </figcaption>
                    {%- endif -%}
                  </div>
                </figure>
              </li>
            {%- endfor -%}
          </ul>
        {%- elsif request.design_mode -%}
          <p class="mg-help">Add "Review" blocks to fill the carousel.</p>
        {%- endif -%}
      </div>
    </mg-carousel>
  </div>
</section>

{% javascript %}
  if (!window.mgReviewsEditorBound) {
    window.mgReviewsEditorBound = true;
    document.addEventListener('shopify:block:select', (event) => {
      const slide = event.target;
      if (!(slide instanceof HTMLElement) || !slide.closest('.mg-reviews')) return;
      const track = slide.closest('.mg-carousel__track');
      if (!track) return;
      const offset = slide.getBoundingClientRect().left - track.getBoundingClientRect().left;
      const inset = parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0;
      track.scrollBy({ left: offset - inset, behavior: 'auto' });
    });
  }
{% endjavascript %}
{% stylesheet %}
  /*
   * Reviews: the Google rating summary (big score, stars, count, link, arrows) on the left and
   * a carousel of review cards on the right; stacked on phones. "Night photo" puts a darkened
   * light-trails photo behind it (a fixed dark band in both themes, like the hero).
   */
  .mg-reviews--photo {
    isolation: isolate;
    overflow: hidden;
  }

  .mg-reviews__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .mg-reviews__bg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }

  .mg-reviews__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgb(var(--mg-night-rgb) / 0.94) 0%, rgb(var(--mg-night-rgb) / 0.8) 45%, rgb(var(--mg-night-rgb) / 0.7) 100%),
      linear-gradient(to top, rgb(var(--mg-night-rgb) / 0.6), rgb(var(--mg-night-rgb) / 0) 40%);
  }

  .mg-reviews__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--mg-space-5);
  }

  .mg-reviews__summary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--mg-space-3);
    min-width: 0;
  }

  .mg-reviews .mg-reviews__head {
    margin: 0;
  }

  .mg-reviews__rating {
    display: flex;
    align-items: center;
    gap: var(--mg-space-3);
  }

  .mg-reviews__score {
    margin: 0;
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--mg-ink);
  }

  .mg-reviews__rating-text {
    display: grid;
    gap: var(--mg-space-1);
  }

  .mg-reviews__count {
    font-size: var(--mg-fs-small);
    color: var(--mg-ink-2);
  }

  .mg-reviews__link {
    font-size: var(--mg-fs-small);
  }

  .mg-reviews__nav {
    margin-block-start: var(--mg-space-2);
  }

  .mg-reviews .mg-reviews__carousel {
    --mg-carousel-mobile: 1.12;
    --mg-carousel-tablet: 2.2;
    --mg-carousel-desktop: 3;
  }

  /* Review card */
  .mg-review {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--mg-line);
    border-radius: var(--mg-radius-md);
    background-color: var(--mg-card);
  }

  .mg-reviews--photo .mg-review {
    background-color: rgb(var(--mg-night-rgb) / 0.72);
  }

  @supports (backdrop-filter: blur(1px)) {
    .mg-reviews--photo .mg-review {
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
  }

  .mg-review__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .mg-review__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mg-review__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--mg-space-3);
    padding: var(--mg-space-4);
  }

  .mg-review__top {
    display: flex;
    align-items: center;
    gap: var(--mg-space-3);
  }

  .mg-review__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--mg-radius-pill);
    background-color: var(--mg-red);
    color: var(--mg-on-red);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
  }

  .mg-review__who {
    display: grid;
    flex: 1 1 auto;
    gap: 2px;
    min-width: 0;
  }

  .mg-review__name {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--mg-ink);
  }

  .mg-review__source {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--mg-ink-3);
  }

  .mg-review__rating {
    margin: 0;
    line-height: 1;
  }

  .mg-review__quote {
    flex: 1 1 auto;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mg-review__quote p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mg-ink);
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
  }

  .mg-review__footer {
    display: flex;
    align-items: center;
    gap: var(--mg-space-2);
    padding-block-start: var(--mg-space-3);
    border-block-start: 1px solid var(--mg-line);
    color: var(--mg-ink-2);
  }

  .mg-review__footer .mg-icon {
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--mg-ink-3);
  }

  .mg-review__car-text {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--mg-space-2);
    min-width: 0;
    font-size: var(--mg-fs-micro);
    line-height: 1.35;
  }

  .mg-review__car {
    font-weight: 600;
    color: var(--mg-ink);
  }

  @media screen and (min-width: 750px) {
    .mg-reviews__score {
      font-size: 3.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .mg-reviews__layout {
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
      gap: var(--mg-space-7);
      align-items: center;
    }

    .mg-reviews__score {
      font-size: 4.5rem;
    }

    .mg-reviews__rating {
      flex-direction: column;
      align-items: flex-start;
    }

    .mg-review__body {
      padding: var(--mg-space-5);
    }
  }
{% endstylesheet %}

{% schema %}
{
