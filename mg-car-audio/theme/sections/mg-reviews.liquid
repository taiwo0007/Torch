      "info": "PLACEHOLDER: the preset reviews are sample text, not real customers. Keep this on until every card is a real Google review (copied with the customer's permission), then turn it off.",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "page",
