  "tag": "div",
  "class": "mg-reviews-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Dublin drivers say"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Intro text",
      "info": "Optional. One short line under the rating."
    },
    {
      "type": "header",
      "content": "Google rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
