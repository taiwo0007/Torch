{%- liquid
  assign heading = section.settings.heading | strip
  assign heading_id = 'MgReviewsHeading-' | append: section.id
  assign section_classes = 'mg-section mg-reviews'
  if section.settings.background == 'surface'
    assign section_classes = section_classes | append: ' mg-section--band'
  endif

  assign rating_text = settings.mg_review_rating | strip
  assign rating_value = rating_text | replace: ',', '.' | plus: 0 | at_least: 0 | at_most: 5
  assign review_count = settings.mg_review_count | strip
  assign review_url = settings.mg_review_url
  assign link_label = section.settings.reviews_link_label | strip

  assign show_summary = false
  if section.settings.show_rating and rating_value > 0
    assign show_summary = true
  endif
  assign show_sample = section.settings.show_placeholder_note
-%}

{%- render 'mg-carousel-script' -%}

<section
  class="{{ section_classes }}"
  {% if heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="mg-container">
    <mg-carousel class="mg-carousel mg-carousel--bleed mg-reviews__carousel">
      <div class="mg-head">
        <div class="mg-head__text">
          {%- if heading != blank -%}
            <h2
              id="{{ heading_id }}"
              class="mg-head__title"
            >
              {{ heading | escape }}
            </h2>
          {%- endif -%}
          {%- if show_summary -%}
            <p class="mg-head__sub mg-reviews__summary">
              <span
                class="mg-stars"
                style="--mg-rating: {{ rating_value }};"
                aria-hidden="true"
              ></span>
              <span class="mg-visually-hidden">
                Rated {{ rating_text | escape }} out of 5
                {%- if review_count != blank %} from {{ review_count | escape }} Google reviews{% else %} on Google{% endif -%}
              </span>
              <span aria-hidden="true">
                <strong class="mg-reviews__score">{{ rating_text | escape }}</strong>/5
                {%- if review_count != blank %} from {{ review_count | escape }} Google reviews{% else %} on Google{% endif -%}
              </span>
              {%- if review_url != blank and link_label != blank -%}
                <a
                  class="mg-link"
                  href="{{ review_url }}"
                  target="_blank"
                  rel="noopener"
                >
                  {{- link_label | escape -}}
                  <span class="mg-visually-hidden"> (opens in a new tab)</span>
                </a>
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="mg-head__sub">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
        {%- if section.blocks.size > 1 -%}
          <div class="mg-head__actions mg-reviews__actions">
            <div class="mg-carousel__nav mg-carousel__nav--desktop">
              <button
                class="mg-carousel__btn"
                type="button"
                data-mg-carousel-prev
                aria-label="Previous reviews"
              >
                {%- render 'mg-icon', icon: 'chevron-left' -%}
              </button>
              <button
                class="mg-carousel__btn"
                type="button"
                data-mg-carousel-next
                aria-label="Next reviews"
              >
                {%- render 'mg-icon', icon: 'chevron-right' -%}
              </button>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul
          class="mg-carousel__track"
          role="list"
          tabindex="0"
          aria-label="Customer reviews"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign bs = block.settings
              assign rating = bs.rating | default: 5

              # Name tag: first name and the initial of the last name ("Aoife Murphy" -> "Aoife M.")
              assign name_parts = bs.author | strip | split: ' '
              assign display_name = name_parts.first
              if name_parts.size > 1
                assign last_initial = name_parts.last | slice: 0 | upcase
                assign display_name = display_name | append: ' ' | append: last_initial | append: '.'
              endif

              # One paragraph: the card clamps the quote to 3 lines
              assign quote = bs.text | newline_to_br | replace: '<br />', ' ' | strip_newlines | strip

              assign car = bs.car | strip
              assign job = bs.job | strip

              assign fallback_file = ''
              case bs.fallback
                when 'bmw-carplay'
                  assign fallback_file = 'mg-bmw-carplay-screen'
                  assign fallback_w = 1536
                  assign fallback_h = 840
                  assign fallback_alt = 'BMW widescreen running Apple CarPlay'
                when 'audi-carplay'
                  assign fallback_file = 'mg-audi-carplay-screen'
                  assign fallback_w = 1536
                  assign fallback_h = 1024
                  assign fallback_alt = 'Audi dashboard showing Apple CarPlay with an iPhone connected'
                when 'android-auto'
                  assign fallback_file = 'mg-android-auto-dash'
                  assign fallback_w = 1536
                  assign fallback_h = 1024
                  assign fallback_alt = 'Dashboard with an Android Auto touchscreen'
                when 'showroom'
                  assign fallback_file = 'mg-showroom'
                  assign fallback_w = 1600
                  assign fallback_h = 1200
                  assign fallback_alt = 'MG Car Audio showroom with screens and speakers on display'
                when 'dash-radio'
                  assign fallback_file = 'mg-dash-radio'
                  assign fallback_w = 1024
                  assign fallback_h = 1024
                  assign fallback_alt = 'Dashboard with a newly fitted head unit'
                when 'door-speaker'
                  assign fallback_file = 'mg-door-speaker'
                  assign fallback_w = 1024
                  assign fallback_h = 1024
                  assign fallback_alt = 'Upgraded speaker fitted in a car door'
              endcase

              assign has_photo = false
              if bs.image != blank or fallback_file != blank
                assign has_photo = true
              endif

              assign photo_alt = 'Install photo'
              if car != blank
                assign photo_alt = 'Install photo: ' | append: car
              endif
              if bs.image != blank and bs.image.alt != blank
                assign photo_alt = bs.image.alt
              endif
            -%}
            <li
              class="mg-carousel__slide"
              {{ block.shopify_attributes }}
            >
              <figure class="mg-card mg-review{% unless has_photo %} mg-review--text{% endunless %}">
                <div class="mg-card__media mg-review__media">
                  {%- if bs.image != blank -%}
                    {{
                      bs.image
                      | image_url: width: 1200
                      | image_tag:
                        widths: '400, 560, 720, 960, 1200',
                        sizes: '(min-width: 1184px) 268px, (min-width: 990px) calc((100vw - 112px) / 4), (min-width: 750px) calc((100vw - 80px) / 2.4), 78vw',
                        loading: 'lazy',
                        alt: photo_alt,
                        class: 'mg-review__img'
                    }}
                  {%- elsif fallback_file != blank -%}
                    {%- liquid
                      assign fallback_src = fallback_file | append: '.webp'
                      if fallback_w > 1024
                        assign fallback_small = fallback_file | append: '-800.webp'
                      else
                        assign fallback_small = ''
                      endif
                    -%}
                    <img
                      class="mg-review__img"
                      src="{{ fallback_src | asset_url }}"
                      {% if fallback_small != blank %}
                        srcset="{{ fallback_small | asset_url }} 800w, {{ fallback_src | asset_url }} {{ fallback_w }}w"
                        sizes="(min-width: 990px) 520px, (min-width: 750px) 60vw, 150vw"
                      {% endif %}
                      width="{{ fallback_w }}"
                      height="{{ fallback_h }}"
                      alt="{{ fallback_alt | escape }}"
                      loading="lazy"
                      decoding="async"
                    >
                  {%- endif -%}

                  {%- if display_name != blank or show_sample -%}
                    <div class="mg-review__tags">
                      {%- if display_name != blank -%}
                        <span class="mg-badge mg-badge--card mg-review__name">{{ display_name | escape }}</span>
                      {%- endif -%}
                      {%- if show_sample -%}
                        <span class="mg-sample-tag">Sample review</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="mg-review__overlay">
                    {%- if quote != blank -%}
                      <blockquote class="mg-review__quote">
                        <p>{{ quote | escape }}</p>
                      </blockquote>
                    {%- endif -%}
                    <p class="mg-review__rating">
                      <span
                        class="mg-stars mg-stars--sm"
                        style="--mg-rating: {{ rating }};"
                        role="img"
                        aria-label="Rated {{ rating }} out of 5"
                      ></span>
                      <span aria-hidden="true">{{ rating }}/5</span>
                    </p>
                  </div>
                </div>

                {%- if car != blank or job != blank -%}
                  <figcaption class="mg-review__footer">
                    <span
                      class="mg-review__car-icon"
                      aria-hidden="true"
                    >
                      {%- render 'mg-icon', icon: 'car' -%}
                    </span>
                    <span class="mg-review__car-text">
                      {%- if car != blank -%}
                        <span class="mg-review__car"><span class="mg-visually-hidden">Car: </span>{{ car | escape }}</span>
                      {%- endif -%}
                      {%- if job != blank -%}
                        <span class="mg-review__job"><span class="mg-visually-hidden">Job: </span>{{ job | escape }}</span>
                      {%- endif -%}
                    </span>
                  </figcaption>
                {%- endif -%}
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <p class="mg-help">Add "Review" blocks to fill the carousel.</p>
      {%- endif -%}
    </mg-carousel>
  </div>
</section>

{% javascript %}
  if (!window.mgReviewsEditorBound) {
    window.mgReviewsEditorBound = true;
    document.addEventListener('shopify:block:select', (event) => {
      const slide = event.target;
      if (!(slide instanceof HTMLElement) || !slide.closest('.mg-reviews')) return;
      const track = slide.closest('.mg-carousel__track');
      if (!track) return;
      const offset = slide.getBoundingClientRect().left - track.getBoundingClientRect().left;
      const inset = parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0;
      track.scrollBy({ left: offset - inset, behavior: 'auto' });
    });
  }
{% endjavascript %}

{% stylesheet %}
  /* Rating summary under the heading */
  .mg-reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mg-space-1) var(--mg-space-2);
  }

  .mg-reviews__score {
    color: var(--mg-ink);
    font-variant-numeric: tabular-nums;
  }

  /* Phones swipe: the arrows (and their slot in the head) only show from 750px */
  @media screen and (max-width: 749px) {
    .mg-reviews__actions {
      display: none;
    }

    .mg-reviews__summary {
      font-size: var(--mg-fs-small);
    }
  }

  /* Review card: photo with a name tag, the quote over a scrim, the car below */
  .mg-review {
    display: flex;
    flex-direction: column;
    margin: 0;
    overflow: hidden;
  }

  .mg-review__media {
    --mg-media-ratio: 4 / 5;
    position: relative;
    flex: none;
  }

  .mg-review__media .mg-review__img {
    position: absolute;
    inset: 0;
  }

  .mg-review__tags {
    position: absolute;
    inset: var(--mg-space-3) var(--mg-space-3) auto;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--mg-space-2);
  }

  .mg-review__overlay {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: grid;
    gap: var(--mg-space-3);
    padding: var(--mg-space-8) var(--mg-space-4) var(--mg-space-4);
    background: var(--mg-scrim), var(--mg-scrim);
    color: var(--mg-white);
    text-shadow: 0 1px 2px color-mix(in srgb, var(--mg-black) 45%, transparent);
  }

  .mg-review__quote {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mg-review__quote p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .mg-review__rating {
    display: flex;
    align-items: center;
    gap: var(--mg-space-2);
    margin: 0;
    font-size: var(--mg-fs-micro);
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .mg-review__overlay .mg-stars {
    --mg-star: var(--mg-white);
    --mg-star-empty: color-mix(in srgb, var(--mg-white) 40%, transparent);
  }

  .mg-review__footer {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--mg-space-3);
    min-height: 72px;
    padding: var(--mg-space-3) var(--mg-space-4);
  }

  .mg-review__car-icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--mg-radius-sm);
    background-color: var(--mg-band);
    color: var(--mg-ink-2);
  }

  .mg-review__car-icon .mg-icon {
    width: 20px;
    height: 20px;
  }

  .mg-review__car-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .mg-review__car {
    font-size: var(--mg-fs-small);
    font-weight: 600;
    line-height: 1.3;
    color: var(--mg-ink);
  }

  .mg-review__job {
    font-size: var(--mg-fs-micro);
    line-height: 1.35;
    color: var(--mg-ink-2);
  }

  /* A review without a photo: no empty picture area. Name tag, the quote in serif and the stars
     sit in the card's own flow, then the car line; cards in a row still share one height. */
  .mg-review--text .mg-review__media {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--mg-space-4);
    aspect-ratio: auto;
    padding: var(--mg-space-4);
    background-color: var(--mg-red-tint);
  }

  .mg-review--text .mg-review__tags {
    position: static;
  }

  .mg-review--text .mg-review__overlay {
    position: static;
    flex: 1 1 auto;
    align-content: space-between;
    padding: 0;
    background: none;
    color: var(--mg-ink);
    text-shadow: none;
  }

  .mg-review--text .mg-review__footer {
    flex: none;
  }

  .mg-review--text .mg-review__quote p {
    font-family: var(--mg-font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    -webkit-line-clamp: 6;
    line-clamp: 6;
  }

  .mg-review--text .mg-review__overlay .mg-stars {
    --mg-star: var(--mg-ink);
    --mg-star-empty: var(--mg-line-strong);
  }

  .mg-reviews.mg-section--band .mg-review--text .mg-review__media {
    background-color: var(--mg-card);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MG reviews",
  "tag": "div",
  "class": "mg-reviews-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Dublin drivers say"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Intro text",
      "info": "Optional. One short line under the rating."
    },
    {
      "type": "header",
      "content": "Google rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating summary",
      "info": "Rating, review count and link come from Theme settings > MG Car Audio: business details. The link is hidden until a Google reviews link is added there.",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_link_label",
      "label": "Reviews link label",
      "default": "See all reviews"
    },
    {
      "type": "header",
      "content": "Sample reviews"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder_note",
      "label": "Show \"Sample review\" tags",
      "info": "PLACEHOLDER: the preset reviews are sample text, not real customers. Keep this on until every card is a real Google review (copied with the customer's permission), then turn it off.",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background",
