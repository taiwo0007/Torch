          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "bmw-carplay",
              "label": "BMW CarPlay screen"
            },
            {
              "value": "audi-carplay",
              "label": "Audi CarPlay dash"
            },
            {
              "value": "android-auto",
              "label": "Android Auto dash"
            },
            {
              "value": "dash-radio",
              "label": "Dash head unit"
            },
            {
