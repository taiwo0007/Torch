          "info": "Shown when no install photo is uploaded. Choose None for a text-only card.",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "bmw-carplay",
              "label": "BMW CarPlay screen"
            },
            {
              "value": "audi-carplay",
              "label": "Audi CarPlay dash"
            },
            {
              "value": "android-auto",
              "label": "Android Auto dash"
            },
            {
              "value": "dash-radio",
              "label": "Dash head unit"
            },
            {
              "value": "door-speaker",
              "label": "Door speaker"
            },
            {
              "value": "showroom",
              "label": "Showroom"
            }
          ],
          "default": "none"
