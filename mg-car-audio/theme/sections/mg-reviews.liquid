      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "surface",
          "label": "Grey band"
        }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "paragraph",
          "content": "PLACEHOLDER: the preset reviews are sample text, not real customers. Replace them with real Google reviews (with the customer's permission), or switch to a reviews app later."
        },
        {
          "type": "image_picker",
          "id": "image",
