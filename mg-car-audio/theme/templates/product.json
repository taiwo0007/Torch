            "mgcard_fit": {
              "type": "custom-liquid",
              "name": "Fitment line and badge",
              "settings": {
                "custom_liquid": "{%- liquid\n  assign p = closest.product\n  assign makes = p.metafields.custom.car_make.value\n  assign screen = p.metafields.custom.screen_size.value | strip\n  assign names = ''\n  assign universal = false\n  assign make_count = 0\n  for make in makes\n    assign make_down = make | strip | downcase\n    if make_down == 'universal'\n      assign universal = true\n    elsif make_down != blank\n      assign make_count = make_count | plus: 1\n      if make_count <= 2\n        if names != blank\n          assign names = names | append: ', '\n        endif\n        assign names = names | append: make\n      endif\n    endif\n  endfor\n  assign extra_makes = make_count | minus: 2\n  assign badge = ''\n  for tag in p.tags\n    if tag contains 'badge:'\n      assign badge = tag | remove_first: 'badge:' | strip\n      break\n    endif\n  endfor\n-%}\n{%- if names != blank or universal or screen != blank -%}\n  <p class=\"mg-card-fit\">\n    {%- if names != blank -%}\n      <span>Fits {{ names | escape }}{% if extra_makes > 0 %} +{{ extra_makes }}{% endif %}</span>\n    {%- elsif universal -%}\n      <span>Fits most cars</span>\n    {%- endif -%}\n    {%- if screen != blank -%}\n      <span>{{ screen | escape }} screen</span>\n    {%- endif -%}\n  </p>\n{%- endif -%}\n{%- if badge != blank -%}\n  <span class=\"mg-card-badge\">{{ badge | escape }}</span>\n{%- endif -%}"
