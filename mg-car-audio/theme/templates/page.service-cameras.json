        "q_1": {
          "type": "question",
          "settings": {
            "question": "Will the camera show on my factory screen?",
            "answer": "<p>On most cars with a screen, yes. We match the camera and interface to your car.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "What does hard-wired mean for a dash cam?",
            "answer": "<p>We power the camera from the fuse box and hide the cable behind the trim, so nothing trails across the dash and it starts with the car.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "How much is a reverse camera?",
