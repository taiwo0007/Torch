    "faq": {
      "type": "mg-faq",
      "blocks": {
        "faq_time": {
          "type": "question",
          "settings": {
            "question": "How long does a CarPlay installation take?",
            "answer": "<p>Most Apple CarPlay and Android Auto installs take between one and two hours. Bigger jobs, such as Japanese-to-European conversions, can take a little longer. We'll confirm the expected time when you book.</p>"
          }
        },
        "faq_wired_wireless": {
          "type": "question",
          "settings": {
            "question": "What's the difference between wired and wireless CarPlay?",
            "answer": "<p>Wired CarPlay starts when you plug your phone in with a USB cable. Wireless connects automatically a few seconds after you start the car, so your phone can stay in your pocket or bag. We fit both, and we'll tell you which options suit your car when we quote.</p>"
          }
        },
        "faq_factory_features": {
          "type": "question",
          "settings": {
            "question": "Will I keep my steering wheel controls, reverse camera and microphone?",
            "answer": "<p>In most cases, yes. We choose parts that work with your car's original screen, steering wheel buttons, reverse camera and microphone wherever possible. If there's anything on your car that can't be kept, we'll tell you before you book, not after.</p>"
          }
        },
