{
  "sections": {
    "main": {
      "type": "main-page",
      "blocks": {
        "title": {
          "type": "custom-liquid",
          "name": "Page title",
          "settings": {
            "custom_liquid": "<h1 class=\"mg-h1-banner\">{{ page.title | escape }}</h1>"
          },
          "blocks": {}
        },
        "page-content": {
          "type": "page-content",
          "settings": {},
          "blocks": {}
        }
      },
      "block_order": [
        "title",
        "page-content"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 16,
        "padding-block-start": 36,
        "padding-block-end": 36
      }
    },
    "gallery": {
      "type": "mg-gallery",
      "blocks": {
        "install_bmw": {
          "type": "image",
          "settings": {
            "fallback": "bmw-carplay",
            "car_label": "BMW",
            "caption": "Wireless CarPlay on the factory widescreen"
          }
        },
        "install_audi": {
          "type": "image",
          "settings": {
            "fallback": "audi-carplay",
            "car_label": "Audi",
            "caption": "CarPlay retrofit"
          }
        },
        "install_android_auto": {
          "type": "image",
          "settings": {
            "fallback": "android-auto",
            "car_label": "Screen upgrade",
            "caption": "Wireless Android Auto"
          }
        },
        "install_radio": {
          "type": "image",
          "settings": {
            "fallback": "dash-radio",
            "car_label": "Radio upgrade",
            "caption": "New head unit fitted"
          }
        },
        "install_speakers": {
          "type": "image",
          "settings": {
            "fallback": "door-speaker",
            "car_label": "Speaker upgrade",
            "caption": "Front door speakers"
          }
        },
        "install_showroom": {
          "type": "image",
          "settings": {
            "fallback": "showroom",
            "car_label": "Our Ballymount showroom",
            "caption": "Screens and speakers on display"
          }
        }
      },
      "block_order": [
        "install_bmw",
        "install_audi",
        "install_android_auto",
        "install_radio",
        "install_speakers",
        "install_showroom"
      ],
      "settings": {
        "heading": "Latest jobs",
        "text": "",
        "follow_label": "Follow our installs",
        "background": "page"
      }
    },
    "cta": {
      "type": "mg-service-cta",
      "settings": {
        "style": "red",
        "show_details": false,
        "show_whatsapp": true,
        "whatsapp_label": "WhatsApp us",
        "show_call": true,
        "call_label": "Call",
        "book_label": "Book a fitting",
        "book_url": "/pages/book-a-fitting",
        "heading": "Let's upgrade your car next",
        "text": "Send your reg and a photo of your dash on WhatsApp and we'll come back with the right option for your car and a fitted price.",
        "whatsapp_message": "Hi MG Car Audio, I saw your work on the website. Can you tell me what fits my car? My reg is: "
      }
    }
  },
  "order": [
    "main",
    "gallery",
    "cta"
  ]
}
