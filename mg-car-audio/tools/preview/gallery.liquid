{%- comment -%} Review card: photo, name tag, stars, sample tag {%- endcomment -%}
<section class="mg-section">
  <div class="mg-container">
    <div class="mg-head">
      <div class="mg-head__text">
        <h2 class="mg-head__title">What Dublin drivers say</h2>
        <p class="mg-head__sub">
          <span
            class="mg-stars"
            style="--mg-rating: 4.9;"
            role="img"
            aria-label="Rated 4.9 out of 5"
          ></span>
          4.9 from 120 Google reviews
        </p>
      </div>
      <span class="mg-sample-tag">Sample reviews</span>
    </div>
    <div class="pv-gallery-split">
      <article class="mg-card">
        <span
          class="mg-card__media"
          style="position: relative;"
          ><img
            src="{{ 'mg-showroom-800.webp' | asset_url }}"
            alt="Finished install in the workshop"
            width="800"
            height="600"
            loading="lazy"
          ><span
            class="mg-badge mg-badge--card"
            style="position: absolute; top: 12px; left: 12px;"
            >Aoife K.</span
          ></span
        >
        <div class="mg-card__body">
          <span
            class="mg-stars mg-stars--sm"
            style="--mg-rating: 5;"
            role="img"
            aria-label="Rated 5 out of 5"
          ></span>
          <p
            class="mg-card__meta"
            style="color: var(--mg-ink);"
          >
            Demo review: replace with real Google reviews. Wireless CarPlay in my 3 Series, done in an hour.
          </p>
          <p class="mg-card__meta">Car: BMW 3 Series</p>
        </div>
      </article>
      <div class="pv-gallery-stack">
        <div class="pv-gallery-row">
          <span class="mg-badge">Fitted price</span>
          <span class="mg-badge mg-badge--red">Best seller</span>
          <span class="mg-badge mg-badge--ink">New</span>
          <span class="mg-sample-tag">Sample photo</span>
        </div>
        <div class="pv-gallery-row">
          <span class="mg-price">€350</span>
          <span class="mg-price mg-price--lg">€149<span class="mg-price__cents">00</span></span>
          <span class="mg-price mg-price--red"><span class="mg-price__label">From </span>€299<span class="mg-price__label"> fitted</span></span>
        </div>
        <div class="pv-gallery-row">
          <span
            class="mg-stars mg-stars--lg"
            style="--mg-rating: 3.5;"
            role="img"
            aria-label="Rated 3.5 out of 5"
          ></span>
          <span class="mg-chip">Static chip</span>
          <a
            class="mg-chip"
            href="/pages/bmw-carplay"
            >BMW</a
          >
          <a
            class="mg-chip"
            href="/pages/audi-carplay"
            aria-current="page"
            >Audi</a
          >
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Buttons, links, fields, theme control {%- endcomment -%}
<section class="mg-section mg-section--band">
  <div class="mg-container pv-gallery-split">
    <div class="pv-gallery-stack">
      <h2 class="mg-heading">Buttons and links</h2>
      <div class="mg-actions">
        <a
          class="mg-btn mg-btn--primary"
          href="/pages/book-a-fitting"
          >{% render 'mg-icon', icon: 'calendar' %}Book a fitting</a
        >
        <a
          class="mg-btn mg-btn--whatsapp"
          href="https://wa.me/{{ settings.mg_whatsapp_number }}"
          >{% render 'mg-icon', icon: 'whatsapp' %}WhatsApp us</a
        >
      </div>
      <div class="pv-gallery-row">
        <a
          class="mg-btn mg-btn--secondary mg-btn--sm"
          href="/pages/contact"
          >Contact</a
        >
        <a
          class="mg-btn mg-btn--primary mg-btn--lg"
          href="/pages/get-a-quote"
          >Get a quote</a
        >
        <button
          class="mg-btn mg-btn--primary"
          type="button"
          disabled
        >
          Disabled
        </button>
      </div>
      <p>Read the <a class="mg-link" href="/pages/faq">fitting FAQ</a> before you book.</p>
      {% render 'mg-theme-mode', control: true, id: 'pv-theme' %}
    </div>
    <form
      class="mg-card pv-gallery-form"
      style="padding: var(--mg-space-5);"
      action="/contact"
    >
      <div class="mg-field">
        <label
          class="mg-label"
          for="pv-name"
          >Your name</label
        >
        <input
          class="mg-input"
          id="pv-name"
          name="name"
          autocomplete="name"
        >
      </div>
      <div class="mg-field">
        <label
          class="mg-label"
          for="pv-phone"
          >Phone <span class="mg-label__optional">(optional)</span></label
        >
        <input
          class="mg-input"
          id="pv-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          aria-invalid="true"
          aria-describedby="pv-phone-error"
        >
        <p
          class="mg-error-text"
          id="pv-phone-error"
        >
          Enter a phone number, for example 087 123 4567.
        </p>
      </div>
      <div class="mg-field">
        <label
          class="mg-label"
          for="pv-msg"
          >What do you need?</label
        >
        <textarea
          class="mg-input"
          id="pv-msg"
          name="body"
          aria-describedby="pv-msg-help"
        ></textarea>
        <p
          class="mg-help"
          id="pv-msg-help"
        >
          Your car, the year and what you would like fitted.
        </p>
      </div>
      <button
        class="mg-btn mg-btn--primary mg-btn--block"
        type="submit"
      >
        Send
      </button>
    </form>
  </div>
</section>
