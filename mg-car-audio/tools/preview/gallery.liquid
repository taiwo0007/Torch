{%- comment -%}
  Component gallery for the MG design system v3 (docs/DESIGN.md §5).
  Rendered by: node tools/preview/render.mjs --gallery   (or shoot.mjs --gallery)
  Every block below is the reference markup for a component. Only .pv-gallery-* classes are
  preview-only (demo layout); everything else is the real Component API from assets/mg-theme.css.
{%- endcomment -%}
{%- render 'mg-carousel-script' -%}
<style>
  .pv-gallery-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pv-gallery-split { display: grid; gap: var(--mg-space-5); }
  .pv-gallery-stack { display: grid; gap: var(--mg-space-4); }
  .pv-gallery-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--mg-space-3); }
  .pv-gallery-hero { display: grid; gap: var(--mg-space-5); align-items: center; }
  .pv-gallery-hero img { display: block; width: 100%; height: auto; border-radius: var(--mg-radius-md); }
  .pv-gallery-check { display: grid; gap: var(--mg-space-3); margin: 0; padding: var(--mg-space-5); list-style: none; }
  .pv-gallery-check li { display: flex; gap: var(--mg-space-3); align-items: flex-start; }
  .pv-gallery-check .mg-icon { flex: none; width: 20px; height: 20px; color: var(--mg-red-ink); }
  .pv-gallery-form { display: grid; gap: var(--mg-space-4); max-width: 480px; }
  @media (min-width: 750px) {
    .pv-gallery-split { grid-template-columns: 1fr 1fr; align-items: center; }
  }
  @media (min-width: 990px) {
    .pv-gallery-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .pv-gallery-hero { grid-template-columns: 1.05fr 1fr; }
  }
</style>

{%- comment -%} Hero banner: red surface, serif h1, plate input {%- endcomment -%}
<section class="mg-section">
  <div class="mg-container">
    <div class="mg-panel mg-surface-red pv-gallery-hero">
      <img
        src="{{ 'mg-bmw-carplay-screen-800.webp' | asset_url }}"
        alt="BMW widescreen showing Apple CarPlay"
        width="800"
        height="533"
      >
      <div class="pv-gallery-stack">
        <h1 class="mg-display mg-display--hero">Your car already has the screen. <em>Add CarPlay.</em></h1>
        <p class="mg-lede">Wireless CarPlay and Android Auto, fitted in about an hour in Dublin 12.</p>
        <form
          class="mg-plate-group"
          action="/pages/get-a-quote"
          method="get"
        >
          <div class="mg-plate">
            <span
              class="mg-plate__band"
              aria-hidden="true"
              >IRL</span
            >
            <label
              class="mg-visually-hidden"
              for="pv-reg"
              >Your registration</label
            >
            <input
              class="mg-plate__input"
              id="pv-reg"
              name="reg"
              type="text"
              placeholder="241-D-12345"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              maxlength="12"
            >
          </div>
          <button
            class="mg-btn mg-btn--on-red mg-btn--lg"
            type="submit"
          >
            Get a quote
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Statement + trust strip {%- endcomment -%}
<section class="mg-section">
