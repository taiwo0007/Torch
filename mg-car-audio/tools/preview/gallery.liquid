{%- comment -%} Band: chips + carousel of cards {%- endcomment -%}
<section class="mg-section mg-section--band">
  <div class="mg-container">
    <mg-carousel class="mg-carousel">
      <div class="mg-head">
        <div class="mg-head__text">
          <h2 class="mg-head__title">Fitted prices</h2>
          <p class="mg-head__sub">Real prices for the jobs we do most.</p>
        </div>
        <div class="mg-head__actions">
          <div class="mg-carousel__nav">
            <button
              class="mg-carousel__btn"
              type="button"
              data-mg-carousel-prev
              aria-label="Previous"
            >
              {% render 'mg-icon', icon: 'chevron-left' %}
            </button>
            <button
              class="mg-carousel__btn"
              type="button"
              data-mg-carousel-next
              aria-label="Next"
            >
              {% render 'mg-icon', icon: 'chevron-right' %}
            </button>
          </div>
        </div>
      </div>
      <div
        class="mg-chips mg-chips--bleed"
        role="group"
        aria-label="Filter services"
        style="margin-bottom: var(--mg-head-gap);"
      >
        <button
          class="mg-chip"
          type="button"
          aria-pressed="true"
        >
          All
        </button>
        <button
          class="mg-chip"
          type="button"
          aria-pressed="false"
        >
          CarPlay
        </button>
        <button
          class="mg-chip"
          type="button"
          aria-pressed="false"
        >
          Screens
        </button>
        <button
          class="mg-chip"
          type="button"
          aria-pressed="false"
        >
          Radios
        </button>
        <button
          class="mg-chip"
          type="button"
          aria-pressed="false"
        >
          Conversions
        </button>
        <button
          class="mg-chip"
          type="button"
          aria-pressed="false"
        >
          Speakers and subs
        </button>
      </div>
      <ul
        class="mg-carousel__track"
        role="list"
        tabindex="0"
        aria-label="Fitted prices"
      >
        {%- assign pv_cards = 'BMW Apple CarPlay|€350|About 1 hour|mg-bmw-carplay-screen-800.webp,BMW Android Auto (iDrive 7)|€299|About 1 hour|mg-android-auto-dash-800.webp,Android radio install|€150|About 90 minutes|mg-dash-radio.webp,BMW Japanese-to-European conversion|€450|About 2 hours|mg-bmw-japan-to-europe-800.webp,iDrive 7 video in motion|€149|Under an hour|mg-audi-carplay-screen-800.webp,Mercedes Japanese-to-European conversion|Price on request|Half a day|mg-mercedes-japan-to-europe-800.webp' | split: ',' -%}
        {%- for card in pv_cards -%}
          {%- assign c = card | split: '|' -%}
          <li class="mg-carousel__slide">
            <a
              class="mg-card mg-card--link"
              href="/pages/book-a-fitting"
            >
              <span class="mg-card__media"
                ><img
                  src="{{ c[3] | asset_url }}"
                  alt=""
                  width="800"
                  height="533"
                  loading="lazy"
              ></span>
              <span class="mg-card__body">
                {%- if forloop.first -%}
                  <span class="mg-badge mg-badge--red">Most booked</span>
                {%- endif -%}
                <span class="mg-card__title">{{ c[0] }}</span>
                <span class="mg-card__meta">{{ c[2] }}</span>
                {%- if c[1] contains '€' -%}
                  <span class="mg-price mg-price--lg"
                    ><span class="mg-price__label">From </span>{{ c[1] }}<span class="mg-price__cents">00</span
                    ><span class="mg-price__label"> fitted</span></span
                  >
                {%- else -%}
                  <span class="mg-price">{{ c[1] }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </mg-carousel>
  </div>
</section>

